<Window
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Window.AlphaUpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dev="using:DevWinUI"
    xmlns:markup="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:update="using:Snap.Hutao.Remastered.Service.Update">
    <Grid x:Name="RootGrid" Loaded="OnLoaded">
        <Grid.Resources>
            <DataTemplate x:Key="CommitTemplate" x:DataType="update:AlphaGitHubCommit">
                <StackPanel Padding="0,8" Spacing="3">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind Summary}"
                        TextTrimming="CharacterEllipsis"/>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Byline}"
                        TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="DragRegion" Background="Transparent">
            <TextBlock
                Margin="16,0,144,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{markup:ResourceString Name=AppName}"
                TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <dev:WelcomeHero
                x:Name="Hero"
                LogoAsset="ms-appx:///Assets/InAppLogo.png"
                ModuleInvoked="OnHeroModuleInvoked"
                Playback="Intro"/>
            <StackPanel
                Grid.Row="1"
                Margin="20,0"
                HorizontalAlignment="Center"
                Spacing="5">
                <TextBlock
                    x:Name="WelcomeTitle"
                    HorizontalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{markup:ResourceString Name=ViewWindowAlphaUpdateTitle}"/>
                <TextBlock
                    x:Name="BuildLabel"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <HyperlinkButton
                    x:Name="CompareLink"
                    Padding="0,4"
                    HorizontalAlignment="Center"
                    Content="{markup:ResourceString Name=ViewWindowAlphaUpdateOpenComparison}"
                    Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="2"
            Margin="20,12,20,16"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="RangeLabel"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"/>
                    <TextBlock x:Name="HistoryStatus" TextWrapping="Wrap"/>
                    <Button
                        x:Name="RetryButton"
                        Click="OnRetryClicked"
                        Content="{markup:ResourceString Name=ViewWindowAlphaUpdateRetry}"
                        Visibility="Collapsed"/>
                </StackPanel>
                <Pivot Grid.Row="1">
                    <PivotItem Margin="0" Header="{markup:ResourceString Name=ViewWindowAlphaUpdateNewCommits}">
                        <ListView
                            x:Name="UpdateCommits"
                            ItemTemplate="{StaticResource CommitTemplate}"
                            SelectionChanged="OnCommitSelected"/>
                    </PivotItem>
                    <PivotItem Margin="0" Header="{markup:ResourceString Name=ViewWindowAlphaUpdateOlderCommits}">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListView
                                x:Name="OlderCommits"
                                ItemTemplate="{StaticResource CommitTemplate}"
                                SelectionChanged="OnCommitSelected"/>
                            <StackPanel Grid.Row="1" Spacing="6">
                                <TextBlock x:Name="OlderStatus" TextWrapping="Wrap"/>
                                <Button
                                    x:Name="OlderButton"
                                    Click="OnOlderClicked"
                                    Content="{markup:ResourceString Name=ViewWindowAlphaUpdateLoadOlder}"
                                    Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="CommitMessage"
                        MaxHeight="90"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"/>
                    <HyperlinkButton
                        x:Name="CommitLink"
                        Padding="0,4"
                        Content="{markup:ResourceString Name=ViewWindowAlphaUpdateOpenCommit}"
                        Visibility="Collapsed"/>
                    <TextBlock x:Name="DetailStatus" TextWrapping="Wrap"/>
                </StackPanel>
                <dev:SidebarView
                    x:Name="FileSidebar"
                    Grid.Row="1"
                    AutomationProperties.Name="{markup:ResourceString Name=ViewWindowAlphaUpdateChangedFiles}"
                    ExpanderStyle="Tree"
                    ItemInvoked="OnFileInvoked"
                    MenuItemsSource="{x:Bind SidebarViewItems, Mode=OneWay}"
                    OpenPaneLength="200"
                    SupportsExpansion="True"
                    Visibility="Collapsed">
                    <dev:SidebarView.Resources>
                        <ResourceDictionary Source="ms-appx:///UI/Xaml/View/Window/AlphaUpdateSidebarResources.xaml"/>
                    </dev:SidebarView.Resources>
                    <dev:DiffView
                        x:Name="Diff"
                        Margin="8,0,0,0"
                        Visibility="Collapsed"
                        WrapLines="True"/>
                </dev:SidebarView>
            </Grid>
        </Grid>
    </Grid>
</Window>

<shuxcth:MaterialCardButton
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Card.SignInCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwconv="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvs="using:Snap.Hutao.Remastered.ViewModel.Sign"
    xmlns:wl="using:WinUI.LiquidGlass"
    Height="{ThemeResource HomeAdaptiveCardHeight}"
    Padding="0"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    d:DataContext="{d:DesignInstance shvs:SignInViewModel}"
    Background="Transparent"
    BorderBrush="{x:Null}"
    BorderThickness="0"
    mc:Ignorable="d">

    <shuxcth:MaterialCardButton.Resources>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
        <cwconv:BoolToObjectConverter x:Key="BoolToOpacityConverter">
            <cwconv:BoolToObjectConverter.TrueValue>
                <x:Double>0.3</x:Double>
            </cwconv:BoolToObjectConverter.TrueValue>
            <cwconv:BoolToObjectConverter.FalseValue>
                <x:Double>1</x:Double>
            </cwconv:BoolToObjectConverter.FalseValue>
        </cwconv:BoolToObjectConverter>

        <DataTemplate x:Key="AwardTemplate" x:DataType="shvs:AwardView">
            <shuxcc:VerticalCard>
                <shuxcc:VerticalCard.Top>
                    <Grid Margin="4">
                        <shuxci:CachedImage
                            Grid.Row="0"
                            Width="32"
                            Height="32"
                            Opacity="{x:Bind IsClaimed, Converter={StaticResource BoolToOpacityConverter}, Mode=OneWay}"
                            Source="{x:Bind Icon, Mode=OneWay}"/>
                        <StackPanel
                            Grid.Row="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Opacity="{x:Bind IsClaimed, Converter={StaticResource BoolToOpacityConverter}, Mode=OneWay}"
                            Orientation="Horizontal">
                            <TextBlock FontSize="10" Text="×"/>
                            <TextBlock FontSize="10" Text="{x:Bind Count, Mode=OneWay}"/>
                        </StackPanel>
                        <FontIcon
                            Grid.Row="0"
                            FontSize="16"
                            Glyph="&#xE73E;"
                            Visibility="{x:Bind IsClaimed, Mode=OneWay}"/>
                    </Grid>
                </shuxcc:VerticalCard.Top>
                <shuxcc:VerticalCard.Bottom>
                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Index, Mode=OneWay}"/>
                </shuxcc:VerticalCard.Bottom>
            </shuxcc:VerticalCard>
        </DataTemplate>
    </shuxcth:MaterialCardButton.Resources>

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind DataContext.LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Grid>
        <Grid Visibility="{x:Bind DataContext.IsInitialized, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <Grid
                Padding="12"
                CornerRadius="8"
                RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    Margin="-12"
                    Padding="12"
                    Canvas.ZIndex="1"
                    Style="{ThemeResource HomeCardOverlayGridStyle}">
                    <Grid
                        Height="48"
                        Padding="12"
                        ColumnSpacing="12"
                        Style="{ThemeResource GridShimmerStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="0"
                            Width="24"
                            Height="24"
                            Margin="-4"
                            Source="ms-appx:///Resource/Navigation/CheckIn.png"/>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind DataContext.TotalSignInDaysHint, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"/>

                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="{x:Bind DataContext.CurrentUid, Mode=OneWay}"/>
                    </Grid>

                </Grid>

                <ScrollViewer
                    x:Name="AwardScrollViewer"
                    Grid.Row="1"
                    Padding="0"
                    cw:UIElementExtensions.ClipToBounds="True"
                    CanContentRenderOutsideBounds="False">
                    <ItemsControl ItemTemplate="{StaticResource AwardTemplate}" ItemsSource="{x:Bind DataContext.Awards, Mode=OneWay}">
                        <mxi:Interaction.Behaviors>
                            <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind DataContext.ScrollToNextAwardCommand, Mode=OneWay}"/>
                        </mxi:Interaction.Behaviors>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <cwc:UniformGrid
                                    ColumnSpacing="4"
                                    Columns="7"
                                    RowSpacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <Grid
                    Grid.Row="2"
                    Margin="-12"
                    Padding="12"
                    Canvas.ZIndex="1"
                    ColumnSpacing="6"
                    Style="{ThemeResource HomeCardOverlayGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <!--  待签到  -->
                    <Grid
                        Margin="8,0"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind DataContext.IsTodaySigned, Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource InfoBarInformationalSeverityIconBackground}"
                            Glyph="{ThemeResource InfoBarIconBackgroundGlyph}"/>
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource InfoBarInformationalSeverityIconForeground}"
                            Glyph="{ThemeResource InfoBarInformationalIconGlyph}"/>
                    </Grid>
                    <!--  已签到  -->
                    <Grid
                        Margin="8,0"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind DataContext.IsTodaySigned, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource InfoBarSuccessSeverityIconBackground}"
                            Glyph="{ThemeResource InfoBarIconBackgroundGlyph}"/>
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource InfoBarSuccessSeverityIconForeground}"
                            Glyph="{ThemeResource InfoBarSuccessIconGlyph}"/>
                    </Grid>

                    <wl:LiquidGlassButton
                        Grid.Column="0"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Command="{x:Bind DataContext.ClaimSignInRewardCommand, Mode=OneWay}"
                        Content="{shuxm:ResourceString Name=ViewCardSignInClaimSignInAction}"
                        IsEnabled="{x:Bind DataContext.IsTodaySigned, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                        Style="{ThemeResource SettingButtonStyle}"/>
                    <wl:LiquidGlassButton
                        Grid.Column="1"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Command="{x:Bind DataContext.ClaimResignInRewardCommand, Mode=OneWay}"
                        Content="{shuxm:ResourceString Name=ViewCardSignInClaimReSignInAction}"
                        Style="{ThemeResource SettingButtonStyle}"/>
                </Grid>
            </Grid>
        </Grid>

        <shuxc:Loading IsLoading="{x:Bind DataContext.IsInitialized, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" Style="{ThemeResource DefaultLoadingCardStyle}"/>
    </Grid>
</shuxcth:MaterialCardButton>

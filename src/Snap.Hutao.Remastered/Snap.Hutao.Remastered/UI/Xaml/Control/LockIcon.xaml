<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control">

    <BitmapImage x:Key="LockIcon_Locked" UriSource="ms-appx:///Resource/Icon/UI_Icon_Locked.png"/>
    <BitmapImage x:Key="LockIcon_Unlock" UriSource="ms-appx:///Resource/Icon/UI_Icon_Unlock.png"/>

    <Style BasedOn="{StaticResource DefaultLockIconStyle}" TargetType="shuxc:LockIcon"/>

    <Style x:Key="DefaultLockIconStyle" TargetType="shuxc:LockIcon">
        <Setter Property="Height" Value="80"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shuxc:LockIcon">
                    <Grid Background="#FF6A6A6A" CornerRadius="{StaticResource ControlCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LockStates">
                                <VisualState x:Name="Locked">
                                    <VisualState.Setters>
                                        <Setter Target="IconImage.Source" Value="{StaticResource LockIcon_Locked}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unlock">
                                    <VisualState.Setters>
                                        <Setter Target="IconImage.Source" Value="{StaticResource LockIcon_Unlock}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Image x:Name="IconImage" Source="{StaticResource LockIcon_Unlock}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Width" Value="80"/>
    </Style>

</ResourceDictionary>

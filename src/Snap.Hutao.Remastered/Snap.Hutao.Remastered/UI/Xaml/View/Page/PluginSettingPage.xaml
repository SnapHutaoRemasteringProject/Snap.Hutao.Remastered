<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.PluginSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cw1="using:CommunityToolkit.WinUI.Converters"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxd="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvp="using:Snap.Hutao.Remastered.ViewModel.Plugin"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance shvp:PluginSettingViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shvp:PluginSettingViewModel)DataContext).LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <cw1:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <cw1:BoolNegationConverter x:Key="BoolNegationConverter"/>

        <shuxd:ValueTypeVisibilityConverter x:Key="StringTypeConverter" TargetType="System.String"/>
        <shuxd:ValueTypeVisibilityConverter x:Key="Int32TypeConverter" TargetType="System.Int32"/>
        <shuxd:ValueTypeVisibilityConverter x:Key="BooleanTypeConverter" TargetType="System.Boolean"/>
        <shuxd:ValueTypeVisibilityConverter x:Key="DefaultTypeConverter" TargetType=""/>
    </Page.Resources>

    <Grid x:Name="Root">
        <shuxc:StandardView ShowCondition="{x:Bind ((shvp:PluginSettingViewModel)DataContext).IsInitialized, Mode=OneWay}">
            <shuxc:StandardView.EmptyContent>
                <Grid>
                    <ProgressRing
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="True"/>
                </Grid>
            </shuxc:StandardView.EmptyContent>

            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--  标题栏  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,16"
                    cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <StackPanel
                            Padding="16"
                            Orientation="Horizontal"
                            Spacing="12">
                            <cwc:SwitchPresenter
                                x:Name="GlassPresenter_2876"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsTabStop="False"
                                Tag="LiquidGlass:Button"
                                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>0</x:Int32>
                                    </cwc:Case.Value>
                                    <Button
                                        Command="{x:Bind ((shvp:PluginSettingViewModel)DataContext).GoBackCommand, Mode=OneWay}"
                                        Content="{shuxm:ResourceString Name=ViewPagePluginSettingBackButton}"
                                        Style="{StaticResource DefaultButtonStyle}">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE72B;"/>
                                                    <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginSettingBackButton}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                </cwc:Case>
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>1</x:Int32>
                                    </cwc:Case.Value>
                                    <wl:LiquidGlassButton
                                        shuxcth:ControlMaterialState.IsManaged="True"
                                        Command="{x:Bind ((shvp:PluginSettingViewModel)DataContext).GoBackCommand, Mode=OneWay}"
                                        Content="{shuxm:ResourceString Name=ViewPagePluginSettingBackButton}"
                                        Style="{StaticResource DefaultButtonStyle}">
                                        <wl:LiquidGlassButton.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE72B;"/>
                                                    <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginSettingBackButton}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </wl:LiquidGlassButton.ContentTemplate>
                                    </wl:LiquidGlassButton>
                                </cwc:Case>
                            </cwc:SwitchPresenter>

                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind ((shvp:PluginSettingViewModel)DataContext).PluginName, Mode=OneWay}"/>

                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{shuxm:ResourceString Name=ViewPagePluginSettingTitle}"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!--  设置列表  -->
                <Border Grid.Row="1" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Grid Style="{ThemeResource AcrylicGridCardStyle}">
                        <shuxc:StandardView ShowCondition="{x:Bind ((shvp:PluginSettingViewModel)DataContext).Settings.Count, Converter={StaticResource Int32ToBoolConverter}, Mode=OneWay}">
                            <shuxc:StandardView.EmptyContent>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="16">
                                    <FontIcon
                                        FontSize="48"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE713;"/>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{shuxm:ResourceString Name=ViewPagePluginSettingEmptyTitle}"/>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{shuxm:ResourceString Name=ViewPagePluginSettingEmptyDescription}"/>
                                </StackPanel>
                            </shuxc:StandardView.EmptyContent>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    Margin="16"
                                    ItemContainerTransitions="{ThemeResource ListViewLikeThemeTransitions}"
                                    ItemsPanel="{ThemeResource StackPanelSpacing8Template}"
                                    ItemsSource="{x:Bind ((shvp:PluginSettingViewModel)DataContext).Settings, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12" Style="{ThemeResource BorderCardStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!--  设置名称和描述  -->
                                                    <StackPanel Grid.Row="0">
                                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Name}"/>

                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{Binding Description}"
                                                            TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <!--  字符串类型  -->
                                                            <cwc:SwitchPresenter
                                                                x:Name="GlassPresenter_8575"
                                                                HorizontalContentAlignment="Stretch"
                                                                VerticalContentAlignment="Stretch"
                                                                IsTabStop="False"
                                                                Tag="LiquidGlass:TextBox"
                                                                Visibility="{Binding Converter={StaticResource StringTypeConverter}}"
                                                                Value="{Binding TextBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                                                <cwc:Case>
                                                                    <cwc:Case.Value>
                                                                        <x:Int32>0</x:Int32>
                                                                    </cwc:Case.Value>
                                                                    <TextBox PlaceholderText="{shuxm:ResourceString Name=ViewPagePluginSettingStringPlaceholder}" Text="{Binding CurrentValue, Mode=TwoWay}"/>
                                                                </cwc:Case>
                                                                <cwc:Case>
                                                                    <cwc:Case.Value>
                                                                        <x:Int32>1</x:Int32>
                                                                    </cwc:Case.Value>
                                                                    <wl:LiquidGlassTextBox
                                                                        shuxcth:ControlMaterialState.IsManaged="True"
                                                                        PlaceholderText="{shuxm:ResourceString Name=ViewPagePluginSettingStringPlaceholder}"
                                                                        Text="{Binding CurrentValue, Mode=TwoWay}"/>
                                                                </cwc:Case>
                                                            </cwc:SwitchPresenter>

                                                            <!--  整数类型  -->
                                                            <NumberBox
                                                                PlaceholderText="{shuxm:ResourceString Name=ViewPagePluginSettingIntPlaceholder}"
                                                                Visibility="{Binding Converter={StaticResource Int32TypeConverter}}"
                                                                Value="{Binding CurrentValue, Mode=TwoWay}"/>

                                                            <!--  布尔类型  -->
                                                            <cwc:SwitchPresenter
                                                                x:Name="GlassPresenter_9650"
                                                                HorizontalContentAlignment="Stretch"
                                                                VerticalContentAlignment="Stretch"
                                                                IsTabStop="False"
                                                                Tag="LiquidGlass:ToggleSwitch"
                                                                Visibility="{Binding Converter={StaticResource BooleanTypeConverter}}"
                                                                Value="{Binding ToggleSwitchMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                                                <cwc:Case>
                                                                    <cwc:Case.Value>
                                                                        <x:Int32>0</x:Int32>
                                                                    </cwc:Case.Value>
                                                                    <ToggleSwitch
                                                                        IsOn="{Binding CurrentValue, Mode=TwoWay}"
                                                                        OffContent="{shuxm:ResourceString Name=ViewPagePluginSettingToggleOff}"
                                                                        OnContent="{shuxm:ResourceString Name=ViewPagePluginSettingToggleOn}"/>
                                                                </cwc:Case>
                                                                <cwc:Case>
                                                                    <cwc:Case.Value>
                                                                        <x:Int32>1</x:Int32>
                                                                    </cwc:Case.Value>
                                                                    <wl:LiquidGlassToggleSwitch
                                                                        shuxcth:ControlMaterialState.IsManaged="True"
                                                                        IsOn="{Binding CurrentValue, Mode=TwoWay}"
                                                                        OffContent="{shuxm:ResourceString Name=ViewPagePluginSettingToggleOff}"
                                                                        OnContent="{shuxm:ResourceString Name=ViewPagePluginSettingToggleOn}"/>
                                                                </cwc:Case>
                                                            </cwc:SwitchPresenter>

                                                            <!--  默认类型  -->
                                                            <cwc:SwitchPresenter
                                                                x:Name="GlassPresenter_10315"
                                                                HorizontalContentAlignment="Stretch"
                                                                VerticalContentAlignment="Stretch"
                                                                IsTabStop="False"
                                                                Tag="LiquidGlass:TextBox"
                                                                Visibility="{Binding Converter={StaticResource DefaultTypeConverter}}"
                                                                Value="{Binding TextBoxMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                                                <cwc:Case>
                                                                    <cwc:Case.Value>
                                                                        <x:Int32>0</x:Int32>
                                                                    </cwc:Case.Value>
                                                                    <TextBox PlaceholderText="{shuxm:ResourceString Name=ViewPagePluginSettingDefaultPlaceholder}" Text="{Binding CurrentValue, Mode=TwoWay}"/>
                                                                </cwc:Case>
                                                                <cwc:Case>
                                                                    <cwc:Case.Value>
                                                                        <x:Int32>1</x:Int32>
                                                                    </cwc:Case.Value>
                                                                    <wl:LiquidGlassTextBox
                                                                        shuxcth:ControlMaterialState.IsManaged="True"
                                                                        PlaceholderText="{shuxm:ResourceString Name=ViewPagePluginSettingDefaultPlaceholder}"
                                                                        Text="{Binding CurrentValue, Mode=TwoWay}"/>
                                                                </cwc:Case>
                                                            </cwc:SwitchPresenter>
                                                        </StackPanel>
                                                        <!--  操作按钮  -->
                                                        <StackPanel
                                                            Grid.Column="1"
                                                            Margin="12,0,0,0"
                                                            Orientation="Horizontal"
                                                            Spacing="8">
                                                            <cwc:SwitchPresenter
                                                                x:Name="GlassPresenter_11300"
                                                                HorizontalContentAlignment="Stretch"
                                                                VerticalContentAlignment="Stretch"
                                                                IsTabStop="False"
                                                                Tag="LiquidGlass:Button"
                                                                Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                                                <cwc:Case>
                                                                    <cwc:Case.Value>
                                                                        <x:Int32>0</x:Int32>
                                                                    </cwc:Case.Value>
                                                                    <Button
                                                                        Command="{Binding ElementName=Root, Path=DataContext.SaveSettingCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="{shuxm:ResourceString Name=ViewPagePluginSettingSaveButton}"
                                                                        Style="{StaticResource AccentButtonStyle}"/>
                                                                </cwc:Case>
                                                                <cwc:Case>
                                                                    <cwc:Case.Value>
                                                                        <x:Int32>1</x:Int32>
                                                                    </cwc:Case.Value>
                                                                    <wl:LiquidGlassButton
                                                                        shuxcth:ControlMaterialState.IsManaged="True"
                                                                        Command="{Binding ElementName=Root, Path=DataContext.SaveSettingCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="{shuxm:ResourceString Name=ViewPagePluginSettingSaveButton}"
                                                                        Style="{StaticResource AccentButtonStyle}"/>
                                                                </cwc:Case>
                                                            </cwc:SwitchPresenter>

                                                            <cwc:SwitchPresenter
                                                                x:Name="GlassPresenter_11843"
                                                                HorizontalContentAlignment="Stretch"
                                                                VerticalContentAlignment="Stretch"
                                                                IsTabStop="False"
                                                                Tag="LiquidGlass:Button"
                                                                Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                                                <cwc:Case>
                                                                    <cwc:Case.Value>
                                                                        <x:Int32>0</x:Int32>
                                                                    </cwc:Case.Value>
                                                                    <Button
                                                                        Command="{Binding ElementName=Root, Path=DataContext.ResetSettingCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="{shuxm:ResourceString Name=ViewPagePluginSettingResetButton}"
                                                                        Style="{StaticResource DefaultButtonStyle}"/>
                                                                </cwc:Case>
                                                                <cwc:Case>
                                                                    <cwc:Case.Value>
                                                                        <x:Int32>1</x:Int32>
                                                                    </cwc:Case.Value>
                                                                    <wl:LiquidGlassButton
                                                                        shuxcth:ControlMaterialState.IsManaged="True"
                                                                        Command="{Binding ElementName=Root, Path=DataContext.ResetSettingCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="{shuxm:ResourceString Name=ViewPagePluginSettingResetButton}"
                                                                        Style="{StaticResource DefaultButtonStyle}"/>
                                                                </cwc:Case>
                                                            </cwc:SwitchPresenter>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!--  默认值提示  -->
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Margin="0,4,0,0"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}">
                                                        <Run Text="{shuxm:ResourceString Name=ViewPagePluginSettingDefaultValueText}"/>
                                                        <Run Text="{Binding DefaultValue}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </shuxc:StandardView>
                    </Grid>
                </Border>
            </Grid>
        </shuxc:StandardView>
    </Grid>
</shuxc:ScopedPage>

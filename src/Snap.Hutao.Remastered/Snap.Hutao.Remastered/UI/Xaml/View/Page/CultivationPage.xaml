<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.CultivationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwconv="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxca="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shhuxcp="using:Snap.Hutao.Remastered.UI.Xaml.Control.Panel"
    xmlns:shmca="using:Snap.Hutao.Remastered.Model.Calculable"
    xmlns:shux="using:Snap.Hutao.Remastered.UI.Xaml"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxba="using:Snap.Hutao.Remastered.UI.Xaml.Behavior.Action"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxca="using:Snap.Hutao.Remastered.UI.Xaml.Control.AutoSuggestBox"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcl="using:Snap.Hutao.Remastered.UI.Xaml.Control.Layout"
    xmlns:shuxcpd="using:Snap.Hutao.Remastered.UI.Xaml.Control.Panel.DataTable"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxdc="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvcu="using:Snap.Hutao.Remastered.ViewModel.Cultivation"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance shvcu:CultivationViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <cwconv:BoolToObjectConverter
                        x:Key="BoolToBrushSelector"
                        FalseValue="{StaticResource SolidBackgroundFillColorTransparentBrush}"
                        TrueValue="{StaticResource CultivationHighlightColorBrush}"/>
                    <cwconv:BoolToObjectConverter
                        x:Key="BoolToStatisticsBrushSelector"
                        FalseValue="{StaticResource CardBackgroundFillColorDefaultBrush}"
                        TrueValue="{StaticResource CultivationHighlightColorBrush}"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <cwconv:BoolToObjectConverter
                        x:Key="BoolToBrushSelector"
                        FalseValue="{StaticResource SolidBackgroundFillColorTransparentBrush}"
                        TrueValue="{StaticResource CultivationHighlightColorBrush}"/>
                    <cwconv:BoolToObjectConverter
                        x:Key="BoolToStatisticsBrushSelector"
                        FalseValue="{StaticResource CardBackgroundFillColorDefaultBrush}"
                        TrueValue="{StaticResource CultivationHighlightColorBrush}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <shux:BindingProxy x:Key="BindingProxy" DataContext="{x:Bind DataContext, Mode=OneWay}"/>

            <DataTemplate x:Key="FlyoutSkillTemplate" x:DataType="shmca:CalculableSkill">
                <Border Margin="0,2,0,0" Style="{StaticResource BorderCardStyle}">
                    <Grid Margin="8" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <shuxci:CachedImage
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            ShowAsMonoChrome="True"
                            Source="{x:Bind Icon, Mode=OneWay}"/>
                        <TextBlock
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"/>
                        <NumberBox
                            Grid.Column="3"
                            MinWidth="80"
                            VerticalAlignment="Center"
                            essential:NumberBoxHelper.AcrylicWorkaround="True"
                            Maximum="{x:Bind LevelMax, Mode=OneWay}"
                            Minimum="{x:Bind LevelMin, Mode=OneWay}"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind LevelCurrent, Mode=TwoWay}"/>
                        <FontIcon
                            Grid.Column="4"
                            Margin="4,0"
                            FontSize="12"
                            Glyph="&#xEBE7;"/>
                        <NumberBox
                            Grid.Column="5"
                            MinWidth="80"
                            VerticalAlignment="Center"
                            essential:NumberBoxHelper.AcrylicWorkaround="True"
                            Maximum="{x:Bind LevelMax, Mode=OneWay}"
                            Minimum="{x:Bind LevelCurrent, Mode=OneWay}"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind LevelTarget, Mode=TwoWay}"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="CultivateEntryFlyoutContentTemplate" x:DataType="shvcu:CultivateEntryView">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <!--  Avatar section  -->
                    <StackPanel Grid.Row="0" Visibility="{x:Bind Avatar, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                        <Grid
                            Padding="8"
                            ColumnSpacing="6"
                            DataContext="{x:Bind Avatar, Mode=OneWay}"
                            Style="{ThemeResource GridCardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <shuxc:ItemIcon
                                Grid.Column="0"
                                Width="32"
                                Height="32"
                                Icon="{x:Bind Avatar.Icon, Mode=OneWay}"
                                Quality="{x:Bind Avatar.Quality, Mode=OneWay}"/>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind Avatar.Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"/>
                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Visibility="{x:Bind Avatar.IsPromotionAvailable, Mode=OneWay}">
                                <wl:LiquidGlassCheckBox
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    VerticalAlignment="Center"
                                    Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                    IsChecked="{x:Bind Avatar.IsPromoted, Mode=TwoWay}"/>
                            </StackPanel>
                            <NumberBox
                                Grid.Column="3"
                                MinWidth="80"
                                VerticalAlignment="Center"
                                essential:NumberBoxHelper.AcrylicWorkaround="True"
                                Maximum="{x:Bind Avatar.LevelMax, Mode=OneWay}"
                                Minimum="{x:Bind Avatar.LevelMin, Mode=OneWay}"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind Avatar.LevelCurrent, Mode=TwoWay}"/>
                            <FontIcon
                                Grid.Column="4"
                                Margin="4,0"
                                FontSize="12"
                                Glyph="&#xEBE7;"/>
                            <NumberBox
                                Grid.Column="5"
                                MinWidth="80"
                                VerticalAlignment="Center"
                                essential:NumberBoxHelper.AcrylicWorkaround="True"
                                Maximum="{x:Bind Avatar.LevelMax, Mode=OneWay}"
                                Minimum="{x:Bind Avatar.LevelCurrent, Mode=OneWay}"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind Avatar.LevelTarget, Mode=TwoWay}"/>
                        </Grid>

                        <ItemsControl ItemTemplate="{StaticResource FlyoutSkillTemplate}" ItemsSource="{x:Bind Avatar.Skills, Mode=OneWay}"/>
                    </StackPanel>

                    <!--  Weapon section  -->
                    <StackPanel Grid.Row="1" Visibility="{x:Bind Weapon, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                        <Grid
                            Padding="8"
                            ColumnSpacing="6"
                            DataContext="{x:Bind Weapon, Mode=OneWay}"
                            Style="{ThemeResource GridCardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <shuxc:ItemIcon
                                Grid.Column="0"
                                Width="32"
                                Height="32"
                                Icon="{x:Bind Weapon.Icon, Mode=OneWay}"
                                Quality="{x:Bind Weapon.Quality, Mode=OneWay}"/>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind Weapon.Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"/>
                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Visibility="{x:Bind Weapon.IsPromotionAvailable, Mode=OneWay}">
                                <wl:LiquidGlassCheckBox
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    VerticalAlignment="Center"
                                    Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                    IsChecked="{x:Bind Weapon.IsPromoted, Mode=TwoWay}"/>
                            </StackPanel>
                            <NumberBox
                                Grid.Column="3"
                                MinWidth="80"
                                VerticalAlignment="Center"
                                essential:NumberBoxHelper.AcrylicWorkaround="True"
                                Maximum="{x:Bind Weapon.LevelMax, Mode=OneWay}"
                                Minimum="{x:Bind Weapon.LevelMin, Mode=OneWay}"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind Weapon.LevelCurrent, Mode=TwoWay}"/>
                            <FontIcon
                                Grid.Column="4"
                                Margin="4,0"
                                FontSize="12"
                                Glyph="&#xEBE7;"/>
                            <NumberBox
                                Grid.Column="5"
                                MinWidth="80"
                                VerticalAlignment="Center"
                                essential:NumberBoxHelper.AcrylicWorkaround="True"
                                Maximum="{x:Bind Weapon.LevelMax, Mode=OneWay}"
                                Minimum="{x:Bind Weapon.LevelCurrent, Mode=OneWay}"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind Weapon.LevelTarget, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>

                    <!--  Action buttons  -->
                    <Grid
                        Grid.Row="2"
                        Margin="0,6,0,0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <wl:LiquidGlassButton
                            Grid.Column="0"
                            shuxcth:ControlMaterialState.IsManaged="True"
                            HorizontalAlignment="Stretch"
                            Command="{Binding Path=DataContext.ModifyEntryCommand, Source={StaticResource BindingProxy}}"
                            CommandParameter="{x:Bind}"
                            Style="{StaticResource AccentButtonStyle}">
                            <mxi:Interaction.Behaviors>
                                <mxi:EventTriggerBehavior EventName="Click">
                                    <shuxba:HideAttachedFlyoutAction/>
                                </mxi:EventTriggerBehavior>
                            </mxi:Interaction.Behaviors>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="14" Glyph="&#xE73E;"/>
                                <TextBlock Text="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"/>
                            </StackPanel>
                        </wl:LiquidGlassButton>
                        <wl:LiquidGlassButton
                            Grid.Column="1"
                            shuxcth:ControlMaterialState.IsManaged="True"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource DefaultButtonStyle}">
                            <mxi:Interaction.Behaviors>
                                <mxi:EventTriggerBehavior EventName="Click">
                                    <shuxba:HideAttachedFlyoutAction/>
                                </mxi:EventTriggerBehavior>
                            </mxi:Interaction.Behaviors>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="14" Glyph="&#xE711;"/>
                                <TextBlock Text="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"/>
                            </StackPanel>
                        </wl:LiquidGlassButton>
                    </Grid>
                </Grid>
            </DataTemplate>

            <Flyout
                x:Key="CultivateEntryFlyout"
                essential:FlyoutHelper.AcrylicWorkaround="True"
                Placement="RightEdgeAlignedTop"
                ShouldConstrainToRootBounds="False">
                <Flyout.FlyoutPresenterStyle>
                    <Style BasedOn="{StaticResource FlyoutPresenterPadding8Style}" TargetType="FlyoutPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="MaxWidth" Value="Infinity"/>
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <ContentControl HorizontalContentAlignment="Stretch" ContentTemplate="{StaticResource CultivateEntryFlyoutContentTemplate}"/>
            </Flyout>

            <cwconv:BoolToObjectConverter x:Key="BoolToOpacityConverter">
                <cwconv:BoolToObjectConverter.TrueValue>
                    <x:Double>0.4</x:Double>
                </cwconv:BoolToObjectConverter.TrueValue>
                <cwconv:BoolToObjectConverter.FalseValue>
                    <x:Double>1</x:Double>
                </cwconv:BoolToObjectConverter.FalseValue>
            </cwconv:BoolToObjectConverter>

            <cwconv:BoolToObjectConverter
                x:Key="BoolToStyleSelector"
                FalseValue="{StaticResource BodyTextBlockStyle}"
                TrueValue="{StaticResource BaseTextBlockStyle}"/>

            <shuxdc:SpecificStringToVisibilityConverter x:Key="MaterialListSelectedItemIsEntryViewConverter" Value="Entry"/>
            <shuxdc:SpecificStringToVisibilityConverter x:Key="MaterialListSelectedItemIsStatisticsViewConverter" Value="Statistics"/>
            <shuxdc:BoolToAnimatedIconStateConverter x:Key="BoolToAnimatedIconStateConverter"/>

            <DataTemplate x:Key="TokenTemplate" x:DataType="shuxca:SearchToken">
                <Grid Height="22" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Grid.Column="0"
                        Width="12"
                        Height="12"
                        Margin="1,1,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Visibility="{x:Bind Quality, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{x:Bind QualityColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <BitmapIcon
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="-3,2,7,0"
                        ShowAsMonochrome="True"
                        UriSource="{x:Bind PackageIconUri, Mode=OneTime}"
                        Visibility="{x:Bind PackageIconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}"/>
                    <shuxci:CachedImage
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="-3,2,7,0"
                        ShowAsMonoChrome="True"
                        Source="{x:Bind IconUri, Mode=OneTime}"
                        Visibility="{x:Bind IconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}"/>
                    <shuxci:CachedImage
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="-4,-2,8,2"
                        Source="{x:Bind SideIconUri, Mode=OneTime}"
                        Visibility="{x:Bind SideIconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}"/>
                    <TextBlock
                        Grid.Column="1"
                        Height="20"
                        VerticalAlignment="Center"
                        Text="{x:Bind Value, Mode=OneTime}"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CultivateEntryItemTemplate" x:DataType="shvcu:CultivateItemView">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <shuxc:ItemIcon
                            Width="32"
                            Height="32"
                            Icon="{x:Bind Inner.Icon, Converter={StaticResource ItemIconConverter}, Mode=OneWay}"
                            Opacity="{x:Bind IsFinished, Converter={StaticResource BoolToOpacityConverter}, Mode=OneWay}"
                            Quality="{x:Bind Inner.RankLevel, Mode=OneWay}"/>

                        <AnimatedIcon
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            State="{x:Bind IsFinished, Converter={StaticResource BoolToAnimatedIconStateConverter}, Mode=OneWay}">
                            <muxca:AnimatedAcceptVisualSource/>
                            <AnimatedIcon.FallbackIconSource>
                                <FontIconSource FontSize="24" Glyph="&#xE73E;"/>
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Grid>
                    <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                    <wl:LiquidGlassButton
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Height="32"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{Binding IsToday, Converter={ThemeResource BoolToBrushSelector}, Mode=OneWay}"
                        Command="{Binding Path=DataContext.FinishStateCommand, Source={StaticResource BindingProxy}}"
                        CommandParameter="{x:Bind Mode=OneWay}"
                        Style="{StaticResource ButtonRevealStyle}">
                        <Grid Opacity="{x:Bind IsFinished, Converter={StaticResource BoolToOpacityConverter}, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,0,0"
                                VerticalAlignment="Center"
                                Style="{x:Bind IsToday, Converter={StaticResource BoolToStyleSelector}, Mode=OneWay}"
                                Text="{x:Bind Inner.Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{x:Bind IsToday, Converter={StaticResource BoolToStyleSelector}, Mode=OneWay}"
                                Text="{x:Bind Entity.Count, Mode=OneWay}"/>
                        </Grid>
                    </wl:LiquidGlassButton>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CultivateEntryTemplate" x:DataType="shvcu:CultivateEntryView">
                <Border cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="PointerPressed">
                            <shuxba:ShowAttachedFlyoutAction Data="{x:Bind Mode=OneWay}"/>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                    <FlyoutBase.AttachedFlyout>
                        <StaticResource ResourceKey="CultivateEntryFlyout"/>
                    </FlyoutBase.AttachedFlyout>
                    <Grid Style="{ThemeResource AcrylicGridCardStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <shuxc:ItemIcon
                                Width="52"
                                Height="52"
                                Icon="{x:Bind Icon, Mode=OneWay}"
                                Quality="{x:Bind Quality, Mode=OneWay}"/>
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"/>
                                <TextBlock
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Description, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                                <wl:LiquidGlassButton
                                    Margin="8,0,0,0"
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    Width="48"
                                    Height="48"
                                    Background="Transparent"
                                    Command="{Binding Path=DataContext.RemoveEntryCommand, Source={StaticResource BindingProxy}}"
                                    CommandParameter="{x:Bind Mode=OneWay}"
                                    Content="&#xE74D;"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    Style="{StaticResource ButtonRevealStyle}"
                                    ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageCultivationRemoveEntry}"/>
                            </StackPanel>
                        </Grid>
                        <MenuFlyoutSeparator Grid.Row="1"/>
                        <ScrollViewer Grid.Row="2" Margin="0,2,0,0">
                            <ItemsControl
                                Margin="8,0,8,8"
                                ItemTemplate="{ThemeResource CultivateEntryItemTemplate}"
                                ItemsSource="{x:Bind Items, Mode=OneWay}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="StatisticsItemTemplate" x:DataType="shvcu:StatisticsCultivateItem">
                <shuxcc:HorizontalCard Background="{Binding IsToday, Converter={ThemeResource BoolToStatisticsBrushSelector}, Mode=OneWay}">
                    <shuxcc:HorizontalCard.Left>
                        <Grid Grid.Column="0">
                            <shuxc:ItemIcon
                                Width="40"
                                Height="40"
                                Icon="{x:Bind Inner.Icon, Converter={StaticResource ItemIconConverter}, Mode=OneWay}"
                                Opacity="{x:Bind IsFinished, Converter={StaticResource BoolToOpacityConverter}, Mode=OneWay}"
                                Quality="{x:Bind Inner.RankLevel, Mode=OneWay}"/>
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Glyph="&#xE73E;"
                                Visibility="{x:Bind IsFinished, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                        </Grid>
                    </shuxcc:HorizontalCard.Left>
                    <shuxcc:HorizontalCard.Right>
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,0,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind Inner.Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Grid.Column="1"
                                Margin="0,0,0,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind FormattedCount, Mode=OneWay}"/>
                        </Grid>
                    </shuxcc:HorizontalCard.Right>
                </shuxcc:HorizontalCard>
            </DataTemplate>

            <DataTemplate x:Key="InventoryItemTemplate" x:DataType="shvcu:InventoryItemView">
                <wl:LiquidGlassButton
                    shuxcth:ControlMaterialState.IsManaged="True"
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="{x:Null}"
                    BorderThickness="0">
                    <shuxcc:HorizontalCard Width="300">
                        <shuxcc:HorizontalCard.Left>
                            <shuxc:ItemIcon
                                Width="40"
                                Height="40"
                                Icon="{x:Bind Inner.Icon, Converter={StaticResource ItemIconConverter}, Mode=OneWay}"
                                Quality="{x:Bind Inner.RankLevel, Mode=OneWay}"/>
                        </shuxcc:HorizontalCard.Left>
                        <shuxcc:HorizontalCard.Right>
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Inner.Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Count, Mode=OneWay}"/>
                            </Grid>
                        </shuxcc:HorizontalCard.Right>
                    </shuxcc:HorizontalCard>
                    <wl:LiquidGlassButton.Flyout>
                        <Flyout essential:FlyoutHelper.AcrylicWorkaround="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{x:Bind Inner.Name, Mode=OneWay}"/>
                                <NumberBox
                                    Grid.Row="1"
                                    MinWidth="160"
                                    Margin="0,16,0,0"
                                    essential:NumberBoxHelper.AcrylicWorkaround="True"
                                    Maximum="4294967295"
                                    Minimum="0"
                                    Value="{x:Bind Count, Mode=TwoWay}"/>
                            </Grid>
                        </Flyout>
                    </wl:LiquidGlassButton.Flyout>
                </wl:LiquidGlassButton>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind DataContext.LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <shuxc:StandardView HideCondition="{x:Bind DataContext.IsInitialized, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" ShowCondition="{x:Bind DataContext.Projects.Count, Converter={StaticResource Int32ToBoolConverter}, Mode=OneWay}">
        <shuxc:StandardView.EmptyContent>
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border
                    MinWidth="480"
                    Padding="16"
                    Style="{ThemeResource AcrylicBorderCardStyle}">
                    <StackPanel>
                        <shuxci:CachedImage
                            Width="120"
                            Height="120"
                            Source="{StaticResource UI_EmotionIcon293}"/>
                        <TextBlock
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{shuxm:ResourceString Name=ViewPageCultivationAddProjectContinue}"/>
                        <StackPanel Margin="0,24,0,0">
                            <cwc:SettingsCard
                                ActionIconToolTip="{shuxm:ResourceString Name=ViewPageCultivationAddProjectAction}"
                                Command="{x:Bind DataContext.AddProjectCommand, Mode=OneWay}"
                                Description="{shuxm:ResourceString Name=ViewPageCultivationAddProjectDescription}"
                                Header="{shuxm:ResourceString Name=ViewPageCultivationAddProject}"
                                HeaderIcon="{shuxm:FontIcon Glyph=&#xE710;}"
                                IsClickEnabled="True"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </shuxc:StandardView.EmptyContent>
        <Pivot Style="{ThemeResource CardPivotStyle}">
            <Pivot.RightHeader>
                <CommandBar DefaultLabelPosition="Right">
                    <AppBarElementContainer>
                        <shuxc:SizeRestrictedContentControl Margin="6,6,6,6">
                            <wl:LiquidGlassComboBox
                                shuxcth:ControlMaterialState.IsManaged="True"
                                shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                DisplayMemberPath="Name"
                                ItemsSource="{x:Bind DataContext.Projects, Mode=OneWay}"
                                SelectedItem="{x:Bind DataContext.Projects.CurrentItem, Mode=TwoWay}"
                                Style="{ThemeResource CommandBarComboBoxStyle}"/>
                        </shuxc:SizeRestrictedContentControl>
                    </AppBarElementContainer>
                    <AppBarButton
                        Command="{x:Bind DataContext.ClearInventoryCommand, Mode=OneWay}"
                        CommandParameter="{x:Bind DataContext.Projects.CurrentItem, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xE894;}"
                        Label="{shuxm:ResourceString Name=ViewPageCultivationClearInventory}"/>
                    <AppBarButton Icon="{shuxm:FontIcon Glyph=&#xE895;}" Label="{shuxm:ResourceString Name=ViewPageCultivationRefreshInventory}">
                        <AppBarButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    Command="{x:Bind DataContext.RefreshInventoryByEmbeddedYaeCommand, Mode=OneWay}"
                                    Icon="{shuxm:FontIcon Glyph=&#xE7FC;}"
                                    Text="{shuxm:ResourceString Name=ViewPageCultivationRefreshInventoryByEmbeddedYae}"/>
                                <MenuFlyoutItem
                                    Command="{x:Bind DataContext.RefreshInventoryByBackpackArchiveCommand, Mode=OneWay}"
                                    Icon="{shuxm:FontIcon Glyph=&#xE895;}"
                                    Text="{shuxm:ResourceString Name=ViewPageCultivationRefreshInventoryByBackpackArchive}"/>
                                <MenuFlyoutItem
                                    Command="{x:Bind DataContext.RefreshInventoryByCalculatorCommand, Mode=OneWay}"
                                    Icon="{shuxm:FontIcon Glyph=&#xE8EF;}"
                                    Text="{shuxm:ResourceString Name=ViewPageCultivationRefreshInventoryByCalculator}"/>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton
                        Command="{x:Bind DataContext.SyncAvatarInfoByHoyolabGameRecordCommand, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xE77B;}"
                        Label="{shuxm:ResourceString Name=ViewPageCultivationSyncAvatarInfo}"/>
                    <AppBarButton
                        Command="{x:Bind DataContext.AddProjectCommand, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xE710;}"
                        Label="{shuxm:ResourceString Name=ViewPageCultivationAddProject}"/>
                    <AppBarButton
                        Command="{x:Bind DataContext.RemoveProjectCommand, Mode=OneWay}"
                        CommandParameter="{x:Bind DataContext.Projects.CurrentItem, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xE74D;}"
                        Label="{shuxm:ResourceString Name=ViewPageCultivationRemoveProject}"/>
                </CommandBar>
            </Pivot.RightHeader>

            <PivotItem Header="{shuxm:ResourceString Name=ViewPageCultivationMaterialList}">
                <shuxc:StandardView HideCondition="{x:Bind DataContext.EntriesUpdating, Mode=OneWay}" ShowCondition="{x:Bind DataContext.CultivateEntries.SourceCount, Converter={StaticResource Int32ToBoolConverter}, Mode=OneWay}">
                    <shuxc:StandardView.EmptyContent>
                        <Border
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                            <Border
                                MinWidth="480"
                                Padding="16"
                                Style="{ThemeResource AcrylicBorderCardStyle}">
                                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                                    <StackPanel.Resources>
                                        <!--  ReSharper disable Xaml.RedundantResource  -->
                                        <Thickness x:Key="SettingsCardPadding">16</Thickness>
                                        <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                                        <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                                        <x:Double x:Key="SettingsCardMinHeight">0</x:Double>
                                        <!--  ReSharper restore Xaml.RedundantResource  -->
                                    </StackPanel.Resources>
                                    <shuxci:CachedImage
                                        Height="120"
                                        Margin="0,0,0,16"
                                        Source="{StaticResource UI_EmotionIcon433}"/>
                                    <cwc:SettingsCard
                                        ActionIconToolTip="{shuxm:ResourceString Name=ViewPageCultivationNavigateAction}"
                                        Command="{x:Bind DataContext.NavigateToPageCommand, Mode=OneWay}"
                                        CommandParameter="Snap.Hutao.Remastered.UI.Xaml.View.Page.WikiAvatarPage"
                                        Description="{shuxm:ResourceString Name=ViewPageCultivationWikiAvatarDescription}"
                                        Header="{shuxm:ResourceString Name=ViewWikiAvatarHeader}"
                                        HeaderIcon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/WikiAvatar.png}"
                                        IsClickEnabled="True"/>
                                    <cwc:SettingsCard
                                        ActionIconToolTip="{shuxm:ResourceString Name=ViewPageCultivationNavigateAction}"
                                        Command="{x:Bind DataContext.NavigateToPageCommand, Mode=OneWay}"
                                        CommandParameter="Snap.Hutao.Remastered.UI.Xaml.View.Page.WikiWeaponPage"
                                        Description="{shuxm:ResourceString Name=ViewPageCultivationWikiWeaponDescription}"
                                        Header="{shuxm:ResourceString Name=ViewWikiWeaponHeader}"
                                        HeaderIcon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/WikiWeapon.png}"
                                        IsClickEnabled="True"/>
                                    <cwc:SettingsCard
                                        ActionIconToolTip="{shuxm:ResourceString Name=ViewPageCultivationNavigateAction}"
                                        Command="{x:Bind DataContext.NavigateToPageCommand, Mode=OneWay}"
                                        CommandParameter="Snap.Hutao.Remastered.UI.Xaml.View.Page.AvatarPropertyPage"
                                        Description="{shuxm:ResourceString Name=ViewPageCultivationAvatarPropertyDescription}"
                                        Header="{shuxm:ResourceString Name=ViewAvatarPropertyHeader}"
                                        HeaderIcon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/Cultivation.png}"
                                        IsClickEnabled="True"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </shuxc:StandardView.EmptyContent>
                    <Pivot x:Name="MaterialListPivot" Style="{ThemeResource CardPivotStyle}">
                        <Pivot.RightHeader>
                            <CommandBar DefaultLabelPosition="Right">
                                <AppBarElementContainer>
                                    <shuxca:AutoSuggestTokenBox
                                        Width="600"
                                        Height="44"
                                        Margin="6,-2,6,6"
                                        HorizontalAlignment="Right"
                                        VerticalContentAlignment="Center"
                                        AvailableTokens="{x:Bind DataContext.SearchData.AvailableTokens, Mode=OneWay}"
                                        FilterCommand="{x:Bind DataContext.FilterCommand, Mode=OneWay}"
                                        ItemsSource="{x:Bind DataContext.SearchData.FilterTokens, Mode=OneWay}"
                                        MaximumTokens="5"
                                        PlaceholderText="筛选养成物品"
                                        QueryIcon="{cw:FontIconSource Glyph=&#xE721;}"
                                        Style="{StaticResource DefaultAutoSuggestTokenBoxStyle}"
                                        SuggestedItemTemplate="{StaticResource TokenTemplate}"
                                        SuggestedItemsSource="{x:Bind DataContext.SearchData.AvailableTokens.Values, Mode=OneWay}"
                                        Text="{x:Bind DataContext.SearchData.FilterToken, Mode=TwoWay}"
                                        TokenItemTemplate="{StaticResource TokenTemplate}"
                                        Visibility="{x:Bind ((PivotItem)MaterialListPivot.SelectedItem).Tag, Converter={StaticResource MaterialListSelectedItemIsEntryViewConverter}, Mode=OneWay}"/>
                                </AppBarElementContainer>
                                <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                                <AppBarToggleButton
                                    Command="{x:Bind DataContext.RefreshStatisticsItemsCommand, Mode=OneWay}"
                                    Icon="{shuxm:FontIcon Glyph=&#xE8CB;}"
                                    IsChecked="{x:Bind DataContext.IncompleteFirst, Mode=TwoWay}"
                                    Label="{shuxm:ResourceString Name=ViewPageCultivationMaterialListIncompleteFirstLabel}"
                                    Visibility="{x:Bind ((PivotItem)MaterialListPivot.SelectedItem).Tag, Converter={StaticResource MaterialListSelectedItemIsStatisticsViewConverter}, Mode=OneWay}"/>
                                <AppBarButton Icon="{shuxm:FontIcon Glyph=&#xE946;}" Label="{shuxm:ResourceString Name=ViewPageCultivationMaterialListResinStatisticsLabel}">
                                    <AppBarButton.Flyout>
                                        <Flyout
                                            essential:FlyoutHelper.AcrylicWorkaround="True"
                                            FlyoutPresenterStyle="{ThemeResource FlyoutPresenterPadding0Style}"
                                            Placement="BottomEdgeAlignedRight">
                                            <StackPanel DataContext="{x:Bind DataContext.ResinStatistics, Mode=OneWay}">
                                                <Border
                                                    Padding="8"
                                                    Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,0,1">
                                                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto"/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Text="{shuxm:ResourceString Name=ViewPageCultivationMaterialListWorldLevelTitle}"/>
                                                        <shuxc:SizeRestrictedContentControl
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            AllowFocusOnInteraction="True">
                                                            <wl:LiquidGlassComboBox
                                                                shuxcth:ControlMaterialState.IsManaged="True"
                                                                shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                                                DisplayMemberPath="WorldLevel"
                                                                ItemsSource="{x:Bind DataContext.ResinStatistics.DropDistributions, Mode=OneWay}"
                                                                SelectedItem="{x:Bind DataContext.ResinStatistics.SelectedDropDistribution, Mode=TwoWay}"/>
                                                        </shuxc:SizeRestrictedContentControl>
                                                    </Grid>
                                                </Border>

                                                <cwc:HeaderedItemsControl Margin="0,8,0,4" ItemsSource="{x:Bind DataContext.ResinStatistics.ItemsSource, Mode=OneWay}">
                                                    <cwc:HeaderedItemsControl.Header>
                                                        <shuxcpd:DataTable ColumnSpacing="8">
                                                            <shuxcpd:DataColumn CanResize="False"/>
                                                            <shuxcpd:DataColumn CanResize="False"/>
                                                            <shuxcpd:DataColumn CanResize="False"/>
                                                            <shuxcpd:DataColumn CanResize="False"/>
                                                        </shuxcpd:DataTable>
                                                    </cwc:HeaderedItemsControl.Header>
                                                    <cwc:HeaderedItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="shvcu:ResinStatisticsItem">
                                                            <shuxcpd:DataRow Margin="16,0,16,8">
                                                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Title, Mode=OneWay}"/>

                                                                <StackPanel
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal"
                                                                    Spacing="2">
                                                                    <BitmapIcon
                                                                        Width="20"
                                                                        ShowAsMonochrome="False"
                                                                        UriSource="ms-appx:///Resource/Icon/UI_ItemIcon_106.png"/>
                                                                    <TextBlock Text="{x:Bind TotalResin, Mode=OneWay}"/>
                                                                </StackPanel>

                                                                <StackPanel
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal"
                                                                    Spacing="2">
                                                                    <BitmapIcon
                                                                        Width="20"
                                                                        ShowAsMonochrome="False"
                                                                        UriSource="ms-appx:///Resource/Icon/UI_ItemIcon_210.png"
                                                                        Visibility="{x:Bind FragileResin, Converter={StaticResource EmptyObjectToBoolConverter}, Mode=OneWay}"/>
                                                                    <TextBlock Text="{x:Bind FragileResin, Mode=OneWay}"/>
                                                                </StackPanel>

                                                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Days, Mode=OneWay}"/>
                                                            </shuxcpd:DataRow>
                                                        </DataTemplate>
                                                    </cwc:HeaderedItemsControl.ItemTemplate>
                                                </cwc:HeaderedItemsControl>
                                            </StackPanel>
                                        </Flyout>
                                    </AppBarButton.Flyout>
                                </AppBarButton>
                            </CommandBar>
                        </Pivot.RightHeader>
                        <PivotItem Header="{shuxm:ResourceString Name=ViewPageCultivationCultivateEntry}" Tag="Entry">
                            <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                                <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                                    <ScrollViewer Padding="16" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsRepeater ItemTemplate="{StaticResource CultivateEntryTemplate}" ItemsSource="{x:Bind DataContext.CultivateEntries, Mode=OneWay}">
                                            <mxi:Interaction.Behaviors>
                                                <shuxb:InvalidateMeasureOnCollectionResetBehavior ItemsSource="{x:Bind DataContext.CultivateEntries, Mode=OneWay}"/>
                                            </mxi:Interaction.Behaviors>
                                            <ItemsRepeater.Layout>
                                                <shuxcl:UniformStaggeredLayout
                                                    MinColumnSpacing="12"
                                                    MinItemWidth="300"
                                                    MinRowSpacing="12"/>
                                            </ItemsRepeater.Layout>
                                        </ItemsRepeater>
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </PivotItem>
                        <PivotItem Header="{shuxm:ResourceString Name=ViewPageCultivationMaterialStatistics}" Tag="Statistics">
                            <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                                <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                                    <ScrollViewer Padding="16" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemTemplate="{StaticResource StatisticsItemTemplate}" ItemsSource="{x:Bind DataContext.StatisticsItems, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <shhuxcp:UniformPanel
                                                        ColumnSpacing="12"
                                                        MinItemWidth="240"
                                                        RowSpacing="12"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </PivotItem>
                    </Pivot>
                </shuxc:StandardView>
            </PivotItem>
            <PivotItem Header="{shuxm:ResourceString Name=ViewPageCultivationInventoryItem}">
                <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <GridView
                            Padding="16,16,10,10"
                            ItemTemplate="{StaticResource InventoryItemTemplate}"
                            ItemsSource="{x:Bind DataContext.InventoryItems, Mode=OneWay}"
                            SelectionMode="None">
                            <GridView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>

                    </Border>
                </Border>
            </PivotItem>
        </Pivot>
    </shuxc:StandardView>
</shuxc:ScopedPage>

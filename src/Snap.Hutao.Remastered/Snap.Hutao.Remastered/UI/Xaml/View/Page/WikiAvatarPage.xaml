                                                            </StackPanel>
                                                        </Grid>
                                                    </Expander>
                                                </Border>

                                                <!--  料理  -->
                                                <Border Visibility="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.CookBonusView, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">

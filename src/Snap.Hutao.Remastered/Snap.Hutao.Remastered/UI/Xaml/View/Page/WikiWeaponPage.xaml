<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.WikiWeaponPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shmmi="using:Snap.Hutao.Remastered.Model.Metadata.Item"
    xmlns:shmmw="using:Snap.Hutao.Remastered.Model.Metadata.Weapon"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxca="using:Snap.Hutao.Remastered.UI.Xaml.Control.AutoSuggestBox"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxct="using:Snap.Hutao.Remastered.UI.Xaml.Control.TextBlock"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shuxvs="using:Snap.Hutao.Remastered.UI.Xaml.View.Specialized"
    xmlns:shvc="using:Snap.Hutao.Remastered.ViewModel.Complex"
    xmlns:shvw="using:Snap.Hutao.Remastered.ViewModel.Wiki"
    x:Name="RootPage"
    d:DataContext="{d:DesignInstance Type=shvw:WikiWeaponViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <DataTemplate x:Key="TokenTemplate" x:DataType="shuxca:SearchToken">
            <Grid Height="22" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Ellipse
                    Grid.Column="0"
                    Width="12"
                    Height="12"
                    Margin="1,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Visibility="{x:Bind Quality, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{x:Bind QualityColor}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <shuxci:CachedImage
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    Margin="-5,2,9,0"
                    ShowAsMonoChrome="True"
                    Source="{x:Bind IconUri, Mode=OneTime}"
                    Visibility="{x:Bind IconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}"/>
                <shuxci:CachedImage
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    Margin="-4,0,8,0"
                    Source="{x:Bind SideIconUri, Mode=OneTime}"
                    Visibility="{x:Bind SideIconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}"/>
                <TextBlock
                    Grid.Column="1"
                    Height="20"
                    VerticalAlignment="Center"
                    Text="{x:Bind Value, Mode=OneTime}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WeaponListTemplate" x:DataType="shmmw:Weapon">
            <Grid Background="Transparent">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Command="{Binding ElementName=RootPage, Path=DataContext.CultivateCommand}"
                            CommandParameter="{x:Bind Mode=OneWay}"
                            Text="{shuxm:ResourceString Name=ViewPageWiKiGeneralAddToDevPlanButtonLabel}"/>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <shuxci:CachedImage
                    Grid.Column="0"
                    Width="48"
                    Height="48"
                    Margin="0,0,12,6"
                    Source="{x:Bind Icon, Converter={StaticResource EquipIconConverter}, Mode=OneWay}"/>
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Text="{x:Bind Name, Mode=OneWay}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CultivationItemTemplate" x:DataType="shmmi:Material">
            <shuxcc:HorizontalCard>
                <shuxcc:HorizontalCard.Left>
                    <shuxc:ItemIcon
                        Width="40"
                        Height="40"
                        Icon="{x:Bind Icon, Converter={StaticResource ItemIconConverter}, Mode=OneWay}"
                        Quality="{x:Bind RankLevel, Mode=OneWay}"/>
                </shuxcc:HorizontalCard.Left>
                <shuxcc:HorizontalCard.Right>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{x:Bind Name, Mode=OneWay}"/>
                </shuxcc:HorizontalCard.Right>
            </shuxcc:HorizontalCard>
        </DataTemplate>

        <DataTemplate x:Key="AffixPivotHeaderTemplate" x:DataType="shmmw:LevelDescription">
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind FormattedLevel, Mode=OneWay}"/>
        </DataTemplate>

        <DataTemplate x:Key="AffixPivotItemTemplate" x:DataType="shmmw:LevelDescription">
            <shuxct:DescriptionTextBlock
                Margin="16,8,0,0"
                Description="{x:Bind Description, Mode=OneWay}"
                TextStyle="{StaticResource BodyTextBlockStyle}"/>
        </DataTemplate>

        <DataTemplate x:Key="CollocationTemplate" x:DataType="shvc:CollocationView">
            <shuxcc:HorizontalCard>
                <shuxcc:HorizontalCard.Left>
                    <shuxc:ItemIcon
                        Width="48"
                        Height="48"
                        Icon="{x:Bind Icon, Mode=OneWay}"
                        Quality="{x:Bind Quality, Mode=OneWay}"/>
                </shuxcc:HorizontalCard.Left>
                <shuxcc:HorizontalCard.Right>
                    <StackPanel Margin="8,0,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Rate, Mode=OneWay}"/>
                            <shuxct:RateDeltaTextBlock
                                Opacity="0.7"
                                Text="{x:Bind RateDelta, Mode=OneWay}"
                                TextStyle="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </shuxcc:HorizontalCard.Right>
            </shuxcc:HorizontalCard>
        </DataTemplate>

        <DataTemplate x:Key="WeaponGridTemplate" x:DataType="shmmw:Weapon">
            <shuxcc:VerticalCard Width="82">
                <shuxcc:VerticalCard.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Command="{Binding ElementName=RootPage, Path=DataContext.CultivateCommand}"
                            CommandParameter="{x:Bind Mode=OneWay}"
                            Text="{shuxm:ResourceString Name=ViewPageWiKiGeneralAddToDevPlanButtonLabel}"/>
                    </MenuFlyout>
                </shuxcc:VerticalCard.ContextFlyout>
                <shuxcc:VerticalCard.Top>
                    <shuxc:ItemIcon Icon="{x:Bind Icon, Converter={StaticResource EquipIconConverter}, Mode=OneWay}" Quality="{x:Bind Quality, Mode=OneWay}"/>
                </shuxcc:VerticalCard.Top>
                <shuxcc:VerticalCard.Bottom>
                    <TextBlock
                        Margin="2,0"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"/>
                </shuxcc:VerticalCard.Bottom>
            </shuxcc:VerticalCard>
        </DataTemplate>
    </Page.Resources>

    <shuxc:StandardView ShowCondition="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons, Converter={StaticResource EmptyObjectToBoolConverter}, Mode=OneWay}">
        <shuxc:StandardView.EmptyContent>
            <shuxc:Loading IsLoading="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons, Converter={StaticResource EmptyObjectToBoolRevertConverter}, Mode=OneWay}" Style="{ThemeResource DefaultLoadingViewStyle}"/>
        </shuxc:StandardView.EmptyContent>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border Style="{ThemeResource AcrylicSecondaryBorderCardStyle}">
                    <CommandBar
                        BorderBrush="{x:Null}"
                        BorderThickness="0"
                        DefaultLabelPosition="Right">
                        <CommandBar.Content>
                            <shuxc:LayoutSwitch
                                x:Name="ItemsPanelSelector"
                                Margin="6,8,0,0"
                                LocalSettingKeySuffixForCurrent="WikiWeaponPage.Weapons"/>
                        </CommandBar.Content>
                        <AppBarElementContainer>
                            <shuxca:AutoSuggestTokenBox
                                x:Name="WeaponSuggestBox"
                                Width="600"
                                Height="44"
                                Margin="6,-2,6,6"
                                HorizontalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                AvailableTokens="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).SearchData.AvailableTokens, Mode=OneWay}"
                                FilterCommand="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).FilterCommand, Mode=OneWay}"
                                ItemsSource="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).SearchData.FilterTokens, Mode=OneWay}"
                                MaximumTokens="5"
                                PlaceholderText="{shuxm:ResourceString Name=ViewPageWiKiWeaponAutoSuggestBoxPlaceHolder}"
                                QueryIcon="{cw:FontIconSource Glyph=&#xE721;}"
                                Style="{StaticResource DefaultAutoSuggestTokenBoxStyle}"
                                SuggestedItemTemplate="{StaticResource TokenTemplate}"
                                SuggestedItemsSource="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).SearchData.AvailableTokens.Values, Mode=OneWay}"
                                Text="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).SearchData.FilterToken, Mode=TwoWay}"
                                TokenItemTemplate="{StaticResource TokenTemplate}"/>
                        </AppBarElementContainer>
                        <AppBarButton
                            Command="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).CultivateCommand, Mode=OneWay}"
                            CommandParameter="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem, Mode=OneWay}"
                            Icon="{shuxm:FontIcon Glyph=&#xE8EF;}"
                            Label="{shuxm:ResourceString Name=ViewPageWiKiGeneralAddToDevPlanButtonLabel}"/>
                    </CommandBar>
                </Border>
            </Border>

            <cwc:SwitchPresenter
                Grid.Row="1"
                ContentTransitions="{ThemeResource EntranceThemeTransitions}"
                Value="{x:Bind ItemsPanelSelector.Current, Mode=OneWay}">
                <cwc:Case Value="List">
                    <Border Margin="16,0,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                        <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                            <SplitView
                                DisplayMode="Inline"
                                IsPaneOpen="True"
                                OpenPaneLength="{StaticResource CompatSplitViewOpenPaneLength}"
                                shuxcth:MaterialBackground.NativePaneBrush="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                shuxcth:MaterialBackground.GlassPaneBrush="{ThemeResource HutaoSurfaceBrush}">
                                <SplitView.Pane>
                                    <ListView
                                        Grid.Row="1"
                                        Padding="{ThemeResource ListViewInSplitPanePadding}"
                                        ItemTemplate="{StaticResource WeaponListTemplate}"
                                        ItemsSource="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons, Mode=OneWay}"
                                        SelectedItem="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <mxi:Interaction.Behaviors>
                                            <shuxb:SelectedItemInViewBehavior/>
                                        </mxi:Interaction.Behaviors>
                                    </ListView>
                                </SplitView.Pane>
                                <SplitView.Content>
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Visibility="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem, Converter={StaticResource EmptyObjectToVisibilityRevertConverter}, Mode=OneWay}">
                                            <shuxci:CachedImage
                                                Height="120"
                                                MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                                                Source="{StaticResource UI_EmotionIcon89}"/>
                                            <TextBlock
                                                Margin="0,5,0,21"
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                Text="{shuxm:ResourceString Name=ControlAutoSuggestBoxNotFoundValue}"/>
                                        </StackPanel>
                                        <ScrollViewer shuxc:ScrollViewerHelper.ScrollToTopAssociatedObject="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem, Mode=OneWay}" Visibility="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                                            <StackPanel Padding="16" Spacing="16">
                                                <StackPanel.ChildrenTransitions>
                                                    <EntranceThemeTransition FromVerticalOffset="50"/>
                                                    <RepositionThemeTransition IsStaggeringEnabled="False"/>
                                                </StackPanel.ChildrenTransitions>
                                                <Border Style="{ThemeResource BorderCardStyle}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="ms-appx:///Resource/Icon/UI_GachaShowPanel_Bg_Weapon.png"/>
                                                    </Border.Background>
                                                    <cwc:ConstrainedBox AspectRatio="2048:1024">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="auto"/>
                                                                <ColumnDefinition/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.ColumnSpan="2" Background="{ThemeResource DarkOnlyOverlayMaskColorBrush}"/>

                                                            <Grid Grid.Column="0" Grid.ColumnSpan="2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="176*"/>
                                                                    <ColumnDefinition Width="848*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <shuxci:CachedImage
                                                                    Grid.Column="1"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Stretch"
                                                                    Source="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem.Icon, Converter={StaticResource GachaEquipIconConverter}, Mode=OneWay}"/>
                                                            </Grid>
                                                            <ScrollViewer
                                                                Grid.Column="0"
                                                                Margin="16"
                                                                VerticalScrollBarVisibility="Hidden">
                                                                <StackPanel Spacing="16">
                                                                    <shuxcc:VerticalCard>
                                                                        <shuxcc:VerticalCard.Top>
                                                                            <shuxc:ItemIcon Icon="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem.Icon, Converter={StaticResource EquipIconConverter}, Mode=OneWay}" Quality="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem.RankLevel, Mode=OneWay}"/>
                                                                        </shuxcc:VerticalCard.Top>
                                                                        <shuxcc:VerticalCard.Bottom>
                                                                            <TextBlock
                                                                                MaxWidth="80"
                                                                                Text="{shuxm:ResourceString Name=ViewPageWiKiWeaponBeforeAscensionTitle}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                TextWrapping="NoWrap"/>
                                                                        </shuxcc:VerticalCard.Bottom>
                                                                    </shuxcc:VerticalCard>
                                                                    <shuxcc:VerticalCard>
                                                                        <shuxcc:VerticalCard.Top>
                                                                            <shuxc:ItemIcon Icon="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem.AwakenIcon, Converter={StaticResource EquipIconConverter}, Mode=OneWay}" Quality="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem.RankLevel, Mode=OneWay}"/>
                                                                        </shuxcc:VerticalCard.Top>
                                                                        <shuxcc:VerticalCard.Bottom>
                                                                            <TextBlock
                                                                                MaxWidth="80"
                                                                                Text="{shuxm:ResourceString Name=ViewPageWiKiWeaponAfterAscensionTitle}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                TextWrapping="NoWrap"/>
                                                                        </shuxcc:VerticalCard.Bottom>
                                                                    </shuxcc:VerticalCard>
                                                                </StackPanel>
                                                            </ScrollViewer>
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Margin="16"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                                Text="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem.Name, Mode=OneWay}"/>
                                                        </Grid>
                                                    </cwc:ConstrainedBox>
                                                </Border>

                                                <TextBlock
                                                    Margin="1,0,0,0"
                                                    Text="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem.Description, Mode=OneWay}"
                                                    TextWrapping="Wrap"/>
                                                <shuxvs:BaseValueSlider
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    BaseValueInfo="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).BaseValueInfo, Mode=OneWay}"/>

                                                <Border Padding="16" Style="{ThemeResource BorderShimmerStyle}">
                                                    <StackPanel Spacing="16">
                                                        <TextBlock
                                                            Margin="0,0,0,0"
                                                            Style="{StaticResource BaseTextBlockStyle}"
                                                            Text="{shuxm:ResourceString Name=ViewPageWiKiAvatarAscensionMaterialsHeader}"/>
                                                        <ItemsControl ItemTemplate="{StaticResource CultivationItemTemplate}" ItemsSource="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem.CultivationItemsView, Mode=OneWay}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <cwc:UniformGrid
                                                                        ColumnSpacing="8"
                                                                        Columns="3"
                                                                        RowSpacing="8"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <Border
                                                    Padding="16"
                                                    Style="{ThemeResource BorderShimmerStyle}"
                                                    Visibility="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem.Affix, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                                                    <StackPanel Spacing="16">
                                                        <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem.Affix.Name, Mode=OneWay}"/>
                                                        <Pivot
                                                            Margin="-16,-16,0,0"
                                                            HeaderTemplate="{StaticResource AffixPivotHeaderTemplate}"
                                                            ItemTemplate="{StaticResource AffixPivotItemTemplate}"
                                                            ItemsSource="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem.Affix.Descriptions, Mode=OneWay}"/>
                                                    </StackPanel>
                                                </Border>


                                                <Border
                                                    Padding="16"
                                                    Style="{ThemeResource BorderShimmerStyle}"
                                                    Visibility="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem.CollocationView, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                                                    <StackPanel Spacing="16">
                                                        <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageWiKiAvatarTeamCombinationHeader}"/>
                                                        <ItemsControl ItemTemplate="{StaticResource CollocationTemplate}" ItemsSource="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem.CollocationView.Avatars, Mode=OneWay}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <cwc:UniformGrid
                                                                        ColumnSpacing="8"
                                                                        Columns="3"
                                                                        RowSpacing="8"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </SplitView.Content>
                            </SplitView>
                        </Border>
                    </Border>
                </cwc:Case>
                <cwc:Case Value="Grid">
                    <Border Margin="16,0,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                        <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                            <Grid Padding="16,16,4,-6">
                                <StackPanel VerticalAlignment="Center" Visibility="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.Count, Converter={StaticResource Int32ToVisibilityRevertConverter}, Mode=OneWay}">
                                    <shuxci:CachedImage
                                        Height="120"
                                        MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                                        Source="{StaticResource UI_EmotionIcon89}"/>
                                    <TextBlock
                                        Margin="0,5,0,21"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{shuxm:ResourceString Name=ControlAutoSuggestBoxNotFoundValue}"/>
                                </StackPanel>
                                <GridView
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    ItemContainerStyle="{StaticResource LargeGridViewItemStyle}"
                                    ItemTemplate="{StaticResource WeaponGridTemplate}"
                                    ItemsSource="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons, Mode=OneWay}"
                                    SelectedItem="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.CurrentItem, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    Visibility="{x:Bind ((shvw:WikiWeaponViewModel)DataContext).Weapons.Count, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}">
                                    <mxi:Interaction.Behaviors>
                                        <shuxb:SelectedItemInViewBehavior/>
                                    </mxi:Interaction.Behaviors>
                                </GridView>
                            </Grid>
                        </Border>
                    </Border>
                </cwc:Case>
            </cwc:SwitchPresenter>

        </Grid>
    </shuxc:StandardView>
</shuxc:ScopedPage>

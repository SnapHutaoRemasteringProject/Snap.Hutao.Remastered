                        <shuxcp:UniformPanel
                            Margin="16"
                            ColumnSpacing="12"
                            MinItemWidth="300"
                            RowSpacing="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate" x:DataType="shuxcc:CardReference">
            <Border>
                <cw:Effects.Shadow>
                    <!--  Keep the shadow host unclipped; its inner cutout must match the card, not the default radius of 4.  -->
                    <cwm:AttachedCardShadow
                        BlurRadius="8"
                        CornerRadius="{x:Bind ((shuxcth:MaterialCardButton)Card).CornerRadius.TopLeft, Mode=OneWay}"
                        Opacity="{ThemeResource CompatShadowThemeOpacity}"
                        Offset="0,4,0"/>
                </cw:Effects.Shadow>
                <!--  The card owns its sole native/glass surface and corner radius.  -->
                <ContentControl HorizontalContentAlignment="Stretch" Content="{x:Bind Card, Mode=OneWay}"/>
            </Border>
        </DataTemplate>


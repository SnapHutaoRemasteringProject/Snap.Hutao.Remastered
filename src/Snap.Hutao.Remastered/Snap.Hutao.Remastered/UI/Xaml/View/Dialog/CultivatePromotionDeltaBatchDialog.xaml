<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.CultivatePromotionDeltaBatchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:wl="using:WinUI.LiquidGlass"
    Title="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaBatchTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <x:Double x:Key="NumberBoxMinWidth">180</x:Double>

        <x:Double x:Key="SettingsCardSpacing">3</x:Double>
        <x:Double x:Key="SettingsCardMinHeight">0</x:Double>
        <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
        <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
    </ContentDialog.Resources>
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <cwc:SettingsCard Header="{shuxm:ResourceString Name=ViewDialogCultivateBatchAvatarLevelTarget}">
            <NumberBox
                MinWidth="{StaticResource NumberBoxMinWidth}"
                VerticalAlignment="Center"
                Maximum="90"
                Minimum="1"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind PromotionDelta.AvatarLevelTarget, Mode=TwoWay}"/>
        </cwc:SettingsCard>
        <cwc:SettingsCard Header="{shuxm:ResourceString Name=ViewDialogCultivateBatchSkillATarget}">
            <NumberBox
                MinWidth="{StaticResource NumberBoxMinWidth}"
                VerticalAlignment="Center"
                Maximum="10"
                Minimum="1"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind PromotionDelta.SkillList[0].LevelTarget, Mode=TwoWay}"/>
        </cwc:SettingsCard>
        <cwc:SettingsCard Header="{shuxm:ResourceString Name=ViewDialogCultivateBatchSkillETarget}">
            <NumberBox
                MinWidth="{StaticResource NumberBoxMinWidth}"
                VerticalAlignment="Center"
                Maximum="10"
                Minimum="1"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind PromotionDelta.SkillList[1].LevelTarget, Mode=TwoWay}"/>
        </cwc:SettingsCard>
        <cwc:SettingsCard Header="{shuxm:ResourceString Name=ViewDialogCultivateBatchSkillQTarget}">
            <NumberBox
                MinWidth="{StaticResource NumberBoxMinWidth}"
                VerticalAlignment="Center"
                Maximum="10"
                Minimum="1"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind PromotionDelta.SkillList[2].LevelTarget, Mode=TwoWay}"/>
        </cwc:SettingsCard>
        <cwc:SettingsCard Header="{shuxm:ResourceString Name=ViewDialogCultivateBatchWeaponLevelTarget}">
            <!--  ReSharper disable once Xaml.PossibleNullReferenceException  -->
            <NumberBox
                MinWidth="{StaticResource NumberBoxMinWidth}"
                VerticalAlignment="Center"
                Maximum="90"
                Minimum="1"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind PromotionDelta.Weapon.LevelTarget, Mode=TwoWay}"/>
        </cwc:SettingsCard>

        <cwc:SwitchPresenter
            x:Name="MaterialSelector_SaveModeSelector"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Value="{x:Bind shuxcth:MaterialBindingSource.Current.RadioButtonMaterial, Mode=OneWay}">
            <cwc:Case Value="{shuxm:Int32 Value=0}">
                <RadioButtons
                    x:Name="SaveModeSelector"
                    Margin="0,13,0,0"
                    Header="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyHeader}"
                    SelectedIndex="0">
                    <RadioButton
                        x:Name="GlassNative_3863"
                        Content="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyPreserveExisting}"
                        DataContext="{x:Bind MaterialSelector_SaveModeSelector.DataContext, Mode=OneWay}"
                        shuxcth:ThemeSynchronization.Source="{x:Bind MaterialSelector_SaveModeSelector}"/>
                    <RadioButton
                        x:Name="GlassNative_3989"
                        Content="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyOverwriteExisting}"
                        DataContext="{x:Bind MaterialSelector_SaveModeSelector.DataContext, Mode=OneWay}"
                        shuxcth:ThemeSynchronization.Source="{x:Bind MaterialSelector_SaveModeSelector}"/>
                    <RadioButton
                        x:Name="GlassNative_4116"
                        Content="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyCreateNewEntry}"
                        DataContext="{x:Bind MaterialSelector_SaveModeSelector.DataContext, Mode=OneWay}"
                        shuxcth:ThemeSynchronization.Source="{x:Bind MaterialSelector_SaveModeSelector}"/>
                </RadioButtons>
            </cwc:Case>
            <cwc:Case Value="{shuxm:Int32 Value=1}">
                <RadioButtons
                    x:Name="SaveModeSelectorGlass"
                    Margin="0,13,0,0"
                    Header="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyHeader}"
                    SelectedIndex="{x:Bind SaveModeSelector.SelectedIndex, Mode=TwoWay}">
                    <wl:LiquidGlassRadioButton
                        x:Name="GlassNative_3863Glass"
                        Width="{x:Bind GlassNative_3863.Width, Mode=OneWay}"
                        Height="{x:Bind GlassNative_3863.Height, Mode=OneWay}"
                        MinWidth="{x:Bind GlassNative_3863.MinWidth, Mode=OneWay}"
                        MinHeight="{x:Bind GlassNative_3863.MinHeight, Mode=OneWay}"
                        MaxWidth="{x:Bind GlassNative_3863.MaxWidth, Mode=OneWay}"
                        MaxHeight="{x:Bind GlassNative_3863.MaxHeight, Mode=OneWay}"
                        Padding="{x:Bind GlassNative_3863.Padding, Mode=OneWay}"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassNative_3863, Mode=OneWay}"
                        shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                        BorderThickness="{x:Bind GlassNative_3863.BorderThickness, Mode=OneWay}"
                        Command="{x:Bind GlassNative_3863.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind GlassNative_3863.CommandParameter, Mode=OneWay}"
                        Content="{x:Bind GlassNative_3863.Content, Mode=OneWay}"
                        FlowDirection="{x:Bind GlassNative_3863.FlowDirection, Mode=OneWay}"
                        FontFamily="{x:Bind GlassNative_3863.FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind GlassNative_3863.FontSize, Mode=OneWay}"
                        FontStyle="{x:Bind GlassNative_3863.FontStyle, Mode=OneWay}"
                        FontWeight="{x:Bind GlassNative_3863.FontWeight, Mode=OneWay}"
                        IsEnabled="{x:Bind GlassNative_3863.IsEnabled, Mode=OneWay}"/>
                    <wl:LiquidGlassRadioButton
                        x:Name="GlassNative_3989Glass"
                        Width="{x:Bind GlassNative_3989.Width, Mode=OneWay}"
                        Height="{x:Bind GlassNative_3989.Height, Mode=OneWay}"
                        MinWidth="{x:Bind GlassNative_3989.MinWidth, Mode=OneWay}"
                        MinHeight="{x:Bind GlassNative_3989.MinHeight, Mode=OneWay}"
                        MaxWidth="{x:Bind GlassNative_3989.MaxWidth, Mode=OneWay}"
                        MaxHeight="{x:Bind GlassNative_3989.MaxHeight, Mode=OneWay}"
                        Padding="{x:Bind GlassNative_3989.Padding, Mode=OneWay}"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassNative_3989, Mode=OneWay}"
                        shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                        BorderThickness="{x:Bind GlassNative_3989.BorderThickness, Mode=OneWay}"
                        Command="{x:Bind GlassNative_3989.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind GlassNative_3989.CommandParameter, Mode=OneWay}"
                        Content="{x:Bind GlassNative_3989.Content, Mode=OneWay}"
                        FlowDirection="{x:Bind GlassNative_3989.FlowDirection, Mode=OneWay}"
                        FontFamily="{x:Bind GlassNative_3989.FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind GlassNative_3989.FontSize, Mode=OneWay}"
                        FontStyle="{x:Bind GlassNative_3989.FontStyle, Mode=OneWay}"
                        FontWeight="{x:Bind GlassNative_3989.FontWeight, Mode=OneWay}"
                        IsEnabled="{x:Bind GlassNative_3989.IsEnabled, Mode=OneWay}"/>
                    <wl:LiquidGlassRadioButton
                        x:Name="GlassNative_4116Glass"
                        Width="{x:Bind GlassNative_4116.Width, Mode=OneWay}"
                        Height="{x:Bind GlassNative_4116.Height, Mode=OneWay}"
                        MinWidth="{x:Bind GlassNative_4116.MinWidth, Mode=OneWay}"
                        MinHeight="{x:Bind GlassNative_4116.MinHeight, Mode=OneWay}"
                        MaxWidth="{x:Bind GlassNative_4116.MaxWidth, Mode=OneWay}"
                        MaxHeight="{x:Bind GlassNative_4116.MaxHeight, Mode=OneWay}"
                        Padding="{x:Bind GlassNative_4116.Padding, Mode=OneWay}"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassNative_4116, Mode=OneWay}"
                        shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                        BorderThickness="{x:Bind GlassNative_4116.BorderThickness, Mode=OneWay}"
                        Command="{x:Bind GlassNative_4116.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind GlassNative_4116.CommandParameter, Mode=OneWay}"
                        Content="{x:Bind GlassNative_4116.Content, Mode=OneWay}"
                        FlowDirection="{x:Bind GlassNative_4116.FlowDirection, Mode=OneWay}"
                        FontFamily="{x:Bind GlassNative_4116.FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind GlassNative_4116.FontSize, Mode=OneWay}"
                        FontStyle="{x:Bind GlassNative_4116.FontStyle, Mode=OneWay}"
                        FontWeight="{x:Bind GlassNative_4116.FontWeight, Mode=OneWay}"
                        IsEnabled="{x:Bind GlassNative_4116.IsEnabled, Mode=OneWay}"/>
                </RadioButtons>
            </cwc:Case>
        </cwc:SwitchPresenter>
    </StackPanel>
</ContentDialog>

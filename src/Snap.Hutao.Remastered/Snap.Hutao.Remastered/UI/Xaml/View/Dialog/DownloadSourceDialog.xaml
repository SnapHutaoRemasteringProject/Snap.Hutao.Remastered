<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.DownloadSourceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:wl="using:WinUI.LiquidGlass"
    Title="{shuxm:ResourceString Name=ViewDialogDownloadSourceTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="12">
        <TextBlock
            Opacity="0.8"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceHint}"
            TextWrapping="Wrap"/>
        <RadioButtons x:Name="DownloadSourceSelector" SelectedIndex="0">
            <cwc:SwitchPresenter
                x:Name="GlassPresenter_1125"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:RadioButton"
                Visibility="{x:Bind GlassNative_1125.Visibility, Mode=OneWay}"
                Value="{x:Bind shuxcth:MaterialBindingSource.Current.RadioButtonMaterial, Mode=OneWay}">
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>0</x:Int32>
                    </cwc:Case.Value>
                    <RadioButton
                        x:Name="GlassNative_1125"
                        DataContext="{x:Bind GlassPresenter_1125.DataContext, Mode=OneWay}"
                        GroupName="GlassRadioGroup_1024"
                        RequestedTheme="{x:Bind GlassPresenter_1125.ActualTheme, Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceOfficial}"/>
                            <TextBlock
                                Opacity="0.7"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceOfficialDescription}"/>
                        </StackPanel>
                    </RadioButton>
                </cwc:Case>
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>1</x:Int32>
                    </cwc:Case.Value>
                    <wl:LiquidGlassRadioButton
                        x:Name="GlassNative_1125Glass"
                        Width="{x:Bind GlassNative_1125.Width, Mode=OneWay}"
                        Height="{x:Bind GlassNative_1125.Height, Mode=OneWay}"
                        MinWidth="{x:Bind GlassNative_1125.MinWidth, Mode=OneWay}"
                        MinHeight="{x:Bind GlassNative_1125.MinHeight, Mode=OneWay}"
                        MaxWidth="{x:Bind GlassNative_1125.MaxWidth, Mode=OneWay}"
                        MaxHeight="{x:Bind GlassNative_1125.MaxHeight, Mode=OneWay}"
                        Padding="{x:Bind GlassNative_1125.Padding, Mode=OneWay}"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassNative_1125, Mode=OneWay}"
                        shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                        BorderThickness="{x:Bind GlassNative_1125.BorderThickness, Mode=OneWay}"
                        Command="{x:Bind GlassNative_1125.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind GlassNative_1125.CommandParameter, Mode=OneWay}"
                        FlowDirection="{x:Bind GlassNative_1125.FlowDirection, Mode=OneWay}"
                        FontFamily="{x:Bind GlassNative_1125.FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind GlassNative_1125.FontSize, Mode=OneWay}"
                        FontStyle="{x:Bind GlassNative_1125.FontStyle, Mode=OneWay}"
                        FontWeight="{x:Bind GlassNative_1125.FontWeight, Mode=OneWay}"
                        Foreground="{x:Bind GlassNative_1125.Foreground, Mode=OneWay}"
                        GroupName="GlassRadioGroup_1024Glass"
                        IsChecked="{x:Bind GlassNative_1125.IsChecked, Mode=TwoWay}"
                        IsEnabled="{x:Bind GlassNative_1125.IsEnabled, Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceOfficial}"/>
                            <TextBlock
                                Opacity="0.7"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceOfficialDescription}"/>
                        </StackPanel>
                    </wl:LiquidGlassRadioButton>
                </cwc:Case>
            </cwc:SwitchPresenter>
            <cwc:SwitchPresenter
                x:Name="GlassPresenter_1616"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:RadioButton"
                Visibility="{x:Bind GlassNative_1616.Visibility, Mode=OneWay}"
                Value="{x:Bind shuxcth:MaterialBindingSource.Current.RadioButtonMaterial, Mode=OneWay}">
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>0</x:Int32>
                    </cwc:Case.Value>
                    <RadioButton
                        x:Name="GlassNative_1616"
                        DataContext="{x:Bind GlassPresenter_1616.DataContext, Mode=OneWay}"
                        GroupName="GlassRadioGroup_1024"
                        RequestedTheme="{x:Bind GlassPresenter_1616.ActualTheme, Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceMirrorChyan}"/>
                            <TextBlock
                                Opacity="0.7"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceMirrorChyanDescription}"/>
                        </StackPanel>
                    </RadioButton>
                </cwc:Case>
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>1</x:Int32>
                    </cwc:Case.Value>
                    <wl:LiquidGlassRadioButton
                        x:Name="GlassNative_1616Glass"
                        Width="{x:Bind GlassNative_1616.Width, Mode=OneWay}"
                        Height="{x:Bind GlassNative_1616.Height, Mode=OneWay}"
                        MinWidth="{x:Bind GlassNative_1616.MinWidth, Mode=OneWay}"
                        MinHeight="{x:Bind GlassNative_1616.MinHeight, Mode=OneWay}"
                        MaxWidth="{x:Bind GlassNative_1616.MaxWidth, Mode=OneWay}"
                        MaxHeight="{x:Bind GlassNative_1616.MaxHeight, Mode=OneWay}"
                        Padding="{x:Bind GlassNative_1616.Padding, Mode=OneWay}"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassNative_1616, Mode=OneWay}"
                        shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                        BorderThickness="{x:Bind GlassNative_1616.BorderThickness, Mode=OneWay}"
                        Command="{x:Bind GlassNative_1616.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind GlassNative_1616.CommandParameter, Mode=OneWay}"
                        FlowDirection="{x:Bind GlassNative_1616.FlowDirection, Mode=OneWay}"
                        FontFamily="{x:Bind GlassNative_1616.FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind GlassNative_1616.FontSize, Mode=OneWay}"
                        FontStyle="{x:Bind GlassNative_1616.FontStyle, Mode=OneWay}"
                        FontWeight="{x:Bind GlassNative_1616.FontWeight, Mode=OneWay}"
                        Foreground="{x:Bind GlassNative_1616.Foreground, Mode=OneWay}"
                        GroupName="GlassRadioGroup_1024Glass"
                        IsChecked="{x:Bind GlassNative_1616.IsChecked, Mode=TwoWay}"
                        IsEnabled="{x:Bind GlassNative_1616.IsEnabled, Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceMirrorChyan}"/>
                            <TextBlock
                                Opacity="0.7"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewDialogDownloadSourceMirrorChyanDescription}"/>
                        </StackPanel>
                    </wl:LiquidGlassRadioButton>
                </cwc:Case>
            </cwc:SwitchPresenter>
        </RadioButtons>
    </StackPanel>
</ContentDialog>

                                                <cwc:SettingsCard.HeaderIcon>
                                                    <FontIcon Glyph="&#xEC8F;" Opacity="0.5"/>
                                                </cwc:SettingsCard.HeaderIcon>
                                                <wl:LiquidGlassToggleSwitch
                                                    shuxcth:ControlMaterialState.IsManaged="True"
                                                    IsOn="{x:Bind IsPresented, Mode=TwoWay}"
                                                    OffContent="{shuxm:ResourceString Name=ViewPageSettingHomeCardOff}"
                                                    OnContent="{shuxm:ResourceString Name=ViewPageSettingHomeCardOn}"/>
                                            </cwc:SettingsCard>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewPageSettingHomeCalendarServerTimeZoneOffsetDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingHomeCalendarServerTimeZoneOffsetHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xEC92;}">
                                    <shuxc:SizeRestrictedContentControl>
                                        <wl:LiquidGlassComboBox
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{x:Bind DataContext.Home.AppOptions.LazyCalendarServerTimeZoneOffsets.Value, Mode=OneWay}"
                                            SelectedItem="{x:Bind DataContext.Home.SelectedCalendarServerTimeZoneOffset, Mode=TwoWay}"/>
                                    </shuxc:SizeRestrictedContentControl>
                                </cwc:SettingsCard>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewPageSettingHomeAnnouncementRegionDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingHomeAnnouncementRegionHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE8E4;}">
                                    <shuxc:SizeRestrictedContentControl>
                                        <wl:LiquidGlassComboBox
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{x:Bind DataContext.Home.AppOptions.LazyRegions.Value, Mode=OneWay}"
                                            SelectedItem="{x:Bind DataContext.Home.SelectedRegion, Mode=TwoWay}"/>
                                    </shuxc:SizeRestrictedContentControl>
                                </cwc:SettingsCard>
                                <cwc:SettingsExpander
                                    Header="{shuxm:ResourceString Name=ViewPageSettingHomeAnnouncementActHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE8A1;}"
                                    IsExpanded="True">
                                    <cwc:SettingsExpander.Items>
                                        <cwc:SettingsCard Description="{shuxm:ResourceString Name=ViewPageSettingHomeAnnouncementActIsEnableDescription}" Header="{shuxm:ResourceString Name=ViewPageSettingHomeAnnouncementActIsEnableHeader}">
                                            <shuxc:SizeRestrictedContentControl>
                                                <wl:LiquidGlassToggleSwitch
                                                    shuxcth:ControlMaterialState.IsManaged="True"
                                                    IsOn="{x:Bind DataContext.Home.IsHomeAnnouncementActivityCalendarPresented, Mode=TwoWay}"
                                                    OffContent="{shuxm:ResourceString Name=ViewPageSettingHomeCardOff}"
                                                    OnContent="{shuxm:ResourceString Name=ViewPageSettingHomeCardOn}"/>
                                            </shuxc:SizeRestrictedContentControl>
                                        </cwc:SettingsCard>
                                        <cwc:SettingsCard Description="{shuxm:ResourceString Name=ViewPageSettingHomeAnnouncementActPreviewDescription}" Header="{shuxm:ResourceString Name=ViewPageSettingHomeAnnouncementActPreviewHeader}">
                                            <shuxc:SizeRestrictedContentControl>
                                                <wl:LiquidGlassToggleSwitch
                                                    shuxcth:ControlMaterialState.IsManaged="True"
                                                    IsOn="{x:Bind DataContext.Home.IsHomeAnnouncementActPreviewEnabled, Mode=TwoWay}"
                                                    OffContent="{shuxm:ResourceString Name=ViewPageSettingHomeCardOff}"
                                                    OnContent="{shuxm:ResourceString Name=ViewPageSettingHomeCardOn}"/>
                                            </shuxc:SizeRestrictedContentControl>
                                        </cwc:SettingsCard>
                                    </cwc:SettingsExpander.Items>
                                </cwc:SettingsExpander>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!--  游戏  -->
                    <Border cw:Effects.Shadow="{ThemeResource CompatCardShadow}" DataContext="{x:Bind DataContext.Game, Mode=OneWay}">
                        <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                            <StackPanel Spacing="{ThemeResource SettingsCardSpacing}">
                                <TextBlock Style="{StaticResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageSettingGameHeader}"/>
                                <cwc:SettingsCard
                                    ActionIcon="{shuxm:FontIcon Glyph=&#xE76C;}"
                                    ActionIconToolTip="{shuxm:ResourceString Name=ViewPageSettingDeleteCacheAction}"
                                    Command="{x:Bind DataContext.Game.DeleteGameWebCacheCommand, Mode=OneWay}"
                                    Description="{shuxm:ResourceString Name=ViewPageSettingDeleteCacheDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingDeleteCacheHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE74D;}"
                                    IsClickEnabled="True"/>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewPageSettingLaunchForceUsingTouchScreenDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingLaunchForceUsingTouchScreenHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xEDA4;}">
                                    <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.Game.ForceUsingTouchScreenWhenIntegratedTouchPresent, Mode=TwoWay}"/>
                                </cwc:SettingsCard>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewPageSettingSpeedLimitDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingSpeedLimitHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xEBD3;}">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <NumberBox
                                            MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                                            VerticalAlignment="Center"
                                            essential:NumberBoxHelper.AcrylicWorkaround="True"
                                            AcceptsExpression="False"
                                            Value="{x:Bind DataContext.Game.AppOptions.DownloadSpeedLimitPerSecondInKiloByte.Value, Mode=TwoWay}"/>
                                        <TextBlock VerticalAlignment="Center" Text="KB/s (1MB = 1024KB)"/>
                                    </StackPanel>
                                </cwc:SettingsCard>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewCardSignInAutoSignInDescription}"
                                    Header="{shuxm:ResourceString Name=ViewCardSignInAutoSignIn}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xEC8F;}">
                                    <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.Game.AutoSignInEnabled, Mode=TwoWay}"/>
                                </cwc:SettingsCard>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewPageSettingLaunchCloseWhenGameStartedDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingLaunchCloseWhenGameStartedHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE8BB;}">
                                    <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.Game.CloseWhenGameStarted, Mode=TwoWay}"/>
                                </cwc:SettingsCard>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!--  祈愿记录  -->
                    <Border
                        x:Name="GachaLogBorder"
                        cw:Effects.Shadow="{ThemeResource CompatCardShadow}"
                        DataContext="{x:Bind DataContext.GachaLog, Mode=OneWay}">
                        <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                            <StackPanel Spacing="{ThemeResource SettingsCardSpacing}">
                                <TextBlock Style="{StaticResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageSettingGachaLogHeader}"/>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewPageSettingEmptyOverviewWishVisibleDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingEmptyOverviewWishVisibleHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE8FD;}">
                                    <wl:LiquidGlassToggleSwitch
                                        shuxcth:ControlMaterialState.IsManaged="True"
                                        IsOn="{x:Bind DataContext.GachaLog.AppOptions.IsEmptyOverviewVisible.Value, Mode=TwoWay}"
                                        OffContent="{shuxm:ResourceString Name=ViewPageSettingEmptyHistoryVisibleOff}"
                                        OnContent="{shuxm:ResourceString Name=ViewPageSettingEmptyHistoryVisibleOn}"/>
                                </cwc:SettingsCard>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewPageSettingEmptyHistoryVisibleDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingEmptyHistoryVisibleHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE81C;}">
                                    <wl:LiquidGlassToggleSwitch
                                        shuxcth:ControlMaterialState.IsManaged="True"
                                        IsOn="{x:Bind DataContext.GachaLog.AppOptions.IsEmptyHistoryWishVisible.Value, Mode=TwoWay}"
                                        OffContent="{shuxm:ResourceString Name=ViewPageSettingEmptyHistoryVisibleOff}"
                                        OnContent="{shuxm:ResourceString Name=ViewPageSettingEmptyHistoryVisibleOn}"/>
                                </cwc:SettingsCard>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewPageSettingUnobtainedWishItemVisibleDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingUnobtainedWishItemVisibleHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE890;}">
                                    <wl:LiquidGlassToggleSwitch
                                        shuxcth:ControlMaterialState.IsManaged="True"
                                        IsOn="{x:Bind DataContext.GachaLog.AppOptions.IsUnobtainedWishItemVisible.Value, Mode=TwoWay}"
                                        OffContent="{shuxm:ResourceString Name=ViewPageSettingEmptyHistoryVisibleOff}"
                                        OnContent="{shuxm:ResourceString Name=ViewPageSettingEmptyHistoryVisibleOn}"/>
                                </cwc:SettingsCard>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewPageSettingUIGFExportImportDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingUIGFExportImportHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE8AF;}">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <wl:LiquidGlassHyperlinkButton
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            Content="{shuxm:ResourceString Name=ViewPageSettingUIGFUpgradeLegacyVersionContent}"
                                            NavigateUri="https://upgrader.uigf.org/"/>
                                        <wl:LiquidGlassComboBox
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            MinWidth="100"
                                            shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                            ItemsSource="{x:Bind DataContext.GachaLog.UIGFVersions, Mode=OneWay}"
                                            SelectedIndex="{x:Bind DataContext.GachaLog.SelectedUIGFVersionIndex, Mode=TwoWay}">
                                            <wl:LiquidGlassComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="shsu:UIGFVersion">
                                                    <TextBlock Text="{Binding Converter={StaticResource UIGFVersionToStringConverter}, Mode=OneWay}"/>
                                                </DataTemplate>
                                            </wl:LiquidGlassComboBox.ItemTemplate>
                                        </wl:LiquidGlassComboBox>
                                        <wl:LiquidGlassButton
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            Command="{x:Bind DataContext.GachaLog.ExportUIGFJsonCommand, Mode=OneWay}"
                                            Content="{shuxm:ResourceString Name=ViewPageSettingUIGFExportContent}"
                                            Style="{ThemeResource SettingButtonStyle}"/>
                                        <wl:LiquidGlassButton
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            Command="{x:Bind DataContext.GachaLog.ImportUIGFJsonCommand, Mode=OneWay}"
                                            Content="{shuxm:ResourceString Name=ViewPageSettingUIGFImportContent}"
                                            Style="{ThemeResource SettingButtonStyle}"/>
                                    </StackPanel>
                                </cwc:SettingsCard>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!--  WebView  -->
                    <Border cw:Effects.Shadow="{ThemeResource CompatCardShadow}" DataContext="{x:Bind DataContext.WebView, Mode=OneWay}">
                        <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                            <StackPanel Spacing="{ThemeResource SettingsCardSpacing}">
                                <TextBlock Style="{StaticResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageSettingWebViewHeader}"/>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewPageSettingShareSaveTypeDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingShareSaveTypeHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE792;}">
                                    <shuxc:SizeRestrictedContentControl>
                                        <wl:LiquidGlassComboBox
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{x:Bind DataContext.WebView.AppOptions.BridgeShareSaveTypes, Mode=OneWay}"
                                            SelectedItem="{x:Bind DataContext.WebView.SelectedShareSaveType, Mode=TwoWay}"/>
                                    </shuxc:SizeRestrictedContentControl>
                                </cwc:SettingsCard>
                            </StackPanel>
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <cw:ControlSizeTrigger MinWidth="1140" TargetElement="{x:Bind SettingPageGrid}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ScrollViewerRightPanel.Visibility" Value="Visible"/>
                        <Setter Target="ScrollViewerTopPanel.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>

</shuxc:ScopedPage>

<shuxcth:MaterialCardButton
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Card.LaunchGameCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shsg="using:Snap.Hutao.Remastered.Service.Game"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvg="using:Snap.Hutao.Remastered.ViewModel.Game"
    xmlns:wl="using:WinUI.LiquidGlass"
    Height="{ThemeResource HomeAdaptiveCardHeight}"
    Padding="0"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    d:DataContext="{d:DesignInstance shvg:LaunchGameViewModelSlim}"
    Background="Transparent"
    BorderBrush="{x:Null}"
    BorderThickness="0"
    Command="{x:Bind DataContext.NavigateCommand, Mode=OneWay}"
    mc:Ignorable="d">
    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind DataContext.LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>
    <Grid CornerRadius="{ThemeResource ControlCornerRadius}">
        <Grid
            Margin="12"
            RowSpacing="6"
            Visibility="{x:Bind DataContext.IsInitialized, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Grid.ColumnSpan="3"
                Height="48"
                Padding="12"
                Style="{ThemeResource GridShimmerStyle}">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <FontIcon
                        Width="24"
                        Height="24"
                        Margin="-4"
                        FontSize="24"
                        Glyph="{StaticResource FontIconContentGame}"/>

                    <TextBlock Text="{shuxm:ResourceString Name=ViewLaunchGameHeader}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="6">
                <cwc:SwitchPresenter Visibility="{x:Bind DataContext.LaunchOptions.UsingHoyolabAccount.Value, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" Value="{x:Bind shsg:LaunchOptions.IsGameRunning.Value, Mode=OneWay}">
                    <cwc:Case Value="{shuxm:Boolean Value=True}">
                        <Grid Padding="12" Style="{ThemeResource GridShimmerStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <shuxci:CachedImage
                                Grid.Column="0"
                                Height="32"
                                Margin="2,0"
                                HorizontalAlignment="Left"
                                Background="#FFDAB79B"
                                CornerRadius="{ThemeResource CornerRadiusAll16}"
                                Source="{x:Bind DataContext.LaunchStatusOptions.UserGameRole.ProfilePictureIcon, Converter={StaticResource AvatarIconCircleConverter}, Mode=OneWay}"/>
                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="{x:Bind DataContext.LaunchStatusOptions.UserGameRole.Nickname, Mode=OneWay}"/>
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Opacity="0.6"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind DataContext.LaunchStatusOptions.UserGameRole.Description, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </cwc:Case>
                    <cwc:Case Value="{shuxm:Boolean Value=False}">
                        <Grid Padding="12" Style="{ThemeResource GridShimmerStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <shuxci:CachedImage
                                Grid.Column="0"
                                Height="32"
                                Margin="2,0"
                                HorizontalAlignment="Left"
                                Background="#FFDAB79B"
                                CornerRadius="{ThemeResource CornerRadiusAll16}"
                                Source="{x:Bind DataContext.CurrentUserGameRole.ProfilePictureIcon, Converter={StaticResource AvatarIconCircleConverter}, Mode=OneWay}"/>
                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="{x:Bind DataContext.CurrentUserGameRole.Nickname, Mode=OneWay}"/>
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Opacity="0.6"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind DataContext.CurrentUserGameRole.Description, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </cwc:Case>
                </cwc:SwitchPresenter>

                <wl:LiquidGlassComboBox shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                    shuxcth:ControlMaterialState.IsManaged="True"
                    Padding="12"
                    DisplayMemberPath="Name"
                    ItemsSource="{x:Bind DataContext.CurrentSchemeFilteredGameAccountsView.View, Mode=OneWay}"
                    PlaceholderText="{shuxm:ResourceString Name=ViewCardLaunchGameSelectAccountPlaceholder}"
                    SelectedItem="{x:Bind DataContext.CurrentSchemeFilteredGameAccountsView.View.CurrentItem, FallbackValue={x:Null}, Mode=TwoWay}"
                    Style="{ThemeResource ShimmerComboBoxStyle}"
                    Visibility="{x:Bind DataContext.LaunchOptions.UsingHoyolabAccount.Value, Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}"/>
            </StackPanel>

            <wl:LiquidGlassButton
                Grid.Row="2"
                VerticalAlignment="Stretch"
                shuxcth:ControlMaterialState.IsManaged="True"
                Command="{x:Bind DataContext.LaunchCommand, Mode=OneWay}"
                IsEnabled="{x:Bind shsg:LaunchOptions.IsGameRunning.Value, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                Style="{ThemeResource SettingButtonStyle}">
                <StackPanel Spacing="3">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="{shuxm:ResourceString Name=ViewPageLaunchGameAction}"/>

                    <TextBlock
                        HorizontalAlignment="Center"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind DataContext.LaunchStatusOptions.LaunchStatus.Description, FallbackValue={x:Null}, Mode=OneWay}"
                        Visibility="{x:Bind DataContext.LaunchStatusOptions.LaunchStatus, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}"/>
                </StackPanel>
            </wl:LiquidGlassButton>
        </Grid>

        <shuxc:Loading IsLoading="{x:Bind DataContext.IsInitialized, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" Style="{ThemeResource DefaultLoadingCardStyle}"/>
    </Grid>
</shuxcth:MaterialCardButton>

<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwb="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwcvt="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shs="using:Snap.Hutao.Remastered.Service"
    xmlns:shsu="using:Snap.Hutao.Remastered.Service.UIGF"
    xmlns:shuih="using:Snap.Hutao.Remastered.UI.Input.HotKey"
    xmlns:shuil="using:Snap.Hutao.Remastered.UI.Input.LowLevel"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxdc="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvs="using:Snap.Hutao.Remastered.ViewModel.Setting"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance shvs:SettingViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind DataContext.LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <!--  Glass customization uses independent windows with native editors.  -->

        <shuxdc:UIGFVersionToStringConverter x:Key="UIGFVersionToStringConverter"/>
    </Page.Resources>

    <Grid x:Name="SettingPageGrid">
        <ScrollViewer x:Name="RootScrollViewer" Style="{StaticResource TwoPanelScrollViewerStyle}">
            <shuxc:ScrollViewerHelper.RightPanel>
                <Border
                    x:Name="ScrollViewerRightPanel"
                    Width="400"
                    Margin="0,16,16,16"
                    VerticalAlignment="Top"
                    cw:Effects.Shadow="{ThemeResource CompatCardShadow}"
                    Visibility="Collapsed">
                    <Grid Style="{ThemeResource AcrylicGridCardStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="16" Spacing="{ThemeResource SettingsCardSpacing}">

                                <Grid Style="{ThemeResource GridCardStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Image
                                        Grid.Row="0"
                                        MaxWidth="120"
                                        MaxHeight="120"
                                        Margin="48,48"
                                        Source="ms-appx:///Assets/InAppLogo.png"/>
                                    <cwc:UniformGrid
                                        Grid.Row="1"
                                        Margin="16"
                                        VerticalAlignment="Bottom"
                                        ColumnSpacing="8"
                                        Columns="2"
                                        RowSpacing="8">
                                        <wl:LiquidGlassHyperlinkButton
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Content="{shuxm:ResourceString Name=ViewPageSettingOfficialSiteNavigate}"
                                            NavigateUri="{StaticResource DocumentLink_Home}"/>
                                        <wl:LiquidGlassHyperlinkButton
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Content="{shuxm:ResourceString Name=ViewPageSettingFeedbackNavigate}"
                                            NavigateUri="{StaticResource DocumentLink_BugReport}"/>
                                        <wl:LiquidGlassHyperlinkButton
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Content="{shuxm:ResourceString Name=ViewPageSettingSponsorNavigate}"
                                            NavigateUri="{StaticResource DocumentLink_Sponsor}"/>
                                    </cwc:UniformGrid>
                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="8"
                                        HorizontalAlignment="Center"
                                        Opacity="0.7"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Copyright © 2022 - 2025 DGP Studio. All Rights Reserved."/>
                                    <TextBlock
                                        Grid.Row="3"
                                        Margin="8"
                                        HorizontalAlignment="Center"
                                        Opacity="0.7"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Copyright © 2026 SnapHutaoRemasteringProject. All Rights Reserved."
                                        TextWrapping="NoWrap"/>
                                </Grid>

                                <!--  应用行为 - 宽屏  -->
                                <TextBlock Style="{StaticResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageSettingAppBehaviorHeader}"/>

                                <cwc:SettingsCard
                                    Command="{x:Bind DataContext.CheckUpdateCommand, Mode=OneWay}"
                                    Description="{x:Bind DataContext.UpdateInfo, Mode=OneWay}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingCheckUpdateHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE895;}"
                                    IsClickEnabled="True"/>

                                <!--  Administor  -->
                                <cwc:SettingsExpander HeaderIcon="{shuxm:FontIcon Glyph=&#xE7EF;}" IsExpanded="True">
                                    <cwc:SettingsExpander.Header>
                                        <TextBlock Text="{shuxm:ResourceString Name=ViewPageSettingElevatedModeHeader}"/>
                                    </cwc:SettingsExpander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <wl:LiquidGlassButton
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            HorizontalAlignment="Right"
                                            Command="{x:Bind DataContext.RestartAsElevatedCommand, Mode=OneWay}"
                                            Content="{shuxm:ResourceString Name=ViewPageSettingElevatedModeRestartAction}"
                                            IsEnabled="{shuxm:IsProcessNotElevated}"/>
                                    </StackPanel>
                                    <cwc:SettingsExpander.Items>
                                        <cwc:SettingsCard Description="{shuxm:ResourceString Name=ViewPageSettingAutoRestartAsAdminDescription}" Header="{shuxm:ResourceString Name=ViewPageSettingAutoRestartAsAdminHeader}">
                                            <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.AutoRestartAsAdminEnabled, Mode=TwoWay}"/>
                                        </cwc:SettingsCard>
                                    </cwc:SettingsExpander.Items>
                                </cwc:SettingsExpander>

                                <!--  Auto start  -->
                                <cwc:SettingsExpander
                                    Description="{shuxm:ResourceString Name=ViewPageSettingAutoStartDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingAutoStartHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE7E8;}"
                                    IsEnabled="{x:Bind DataContext.IsStartupSettingsEnabled, Mode=OneWay}">
                                    <cwc:SettingsExpander.Items>
                                        <cwc:SettingsCard
                                            Header="{shuxm:ResourceString Name=ViewPageSettingAutoStartEnableCardHeader}"
                                            HeaderIcon="{shuxm:FontIcon Glyph=&#xE7EE;}"
                                            IsClickEnabled="False">
                                            <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.IsStartupEnabled, Mode=TwoWay}"/>
                                        </cwc:SettingsCard>

                                        <!--  Will keep enable if AutoRestartAsAdmin is enabled, because it will start as admin when startup and avoid UAC prompt and keep consistent with the behavior  -->
                                        <cwc:SettingsCard
                                            Description="{shuxm:ResourceString Name=ViewPageSettingAutoStartAdminActionCardDescription}"
                                            Header="{shuxm:ResourceString Name=ViewPageSettingAutoStartAdminActionCardHeader}"
                                            HeaderIcon="{shuxm:FontIcon Glyph=&#xE7EF;}"
                                            IsClickEnabled="False"
                                            IsEnabled="{x:Bind DataContext.IsStartupAsAdminCardEnabled, Mode=OneWay}">
                                            <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.IsStartupAsAdminEnabled, Mode=TwoWay}"/>
                                        </cwc:SettingsCard>
                                    </cwc:SettingsExpander.Items>
                                </cwc:SettingsExpander>

                                <cwc:SettingsCard
                                    ActionIconToolTip="{shuxm:ResourceString Name=ViewPageSettingCreateDesktopShortcutAction}"
                                    Command="{x:Bind DataContext.CreateDesktopShortcutCommand, Mode=OneWay}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingCreateDesktopShortcutHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE72D;}"
                                    IsClickEnabled="True"/>
                                <cwc:SettingsCard
                                    ActionIconToolTip="{shuxm:ResourceString Name=ViewPageSettingCreateDesktopShortcutAction}"
                                    Command="{x:Bind DataContext.CreateGameLaunchShortcutCommand, Mode=OneWay}"
                                    Header="{shuxm:ResourceString Name=ViewPageLaunchGameCreateGameLaunchShortcut}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE72D;}"
                                    IsClickEnabled="True"/>

                                <cwc:SettingsCard Header="{shuxm:ResourceString Name=ViewPageSettingMirrorChyanLinkHeader}" IsClickEnabled="False">
                                    <wl:LiquidGlassHyperlinkButton
                                        shuxcth:ControlMaterialState.IsManaged="True"
                                        Content="{shuxm:ResourceString Name=ViewPageSettingMirrorChyanLinkHeader}"
                                        NavigateUri="https://mirrorchyan.com?source=snap_hutao_app_settings"/>
                                </cwc:SettingsCard>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </shuxc:ScrollViewerHelper.RightPanel>
            <Grid HorizontalAlignment="Stretch">
                <StackPanel
                    Grid.Column="0"
                    Padding="16"
                    Spacing="16">

                    <!--  关于  -->
                    <Border x:Name="ScrollViewerTopPanel" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                        <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                            <StackPanel Spacing="{StaticResource SettingsCardSpacing}" Visibility="Visible">
                                <Grid MaxHeight="176" Style="{ThemeResource GridCardStyle}">
                                    <Grid Padding="48,28,48,28" ColumnSpacing="48">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            MaxWidth="120"
                                            MaxHeight="120"
                                            Source="ms-appx:///Assets/InAppLogo.png"/>
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            VerticalAlignment="Center">
                                            <cwc:UniformGrid
                                                VerticalAlignment="Center"
                                                ColumnSpacing="8"
                                                Columns="2"
                                                RowSpacing="8">
                                                <wl:LiquidGlassHyperlinkButton
                                                    shuxcth:ControlMaterialState.IsManaged="True"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingOfficialSiteNavigate}"
                                                    NavigateUri="{StaticResource DocumentLink_Home}"/>
                                                <wl:LiquidGlassHyperlinkButton
                                                    shuxcth:ControlMaterialState.IsManaged="True"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingFeedbackNavigate}"
                                                    NavigateUri="{StaticResource DocumentLink_BugReport}"/>
                                                <wl:LiquidGlassHyperlinkButton
                                                    shuxcth:ControlMaterialState.IsManaged="True"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingSponsorNavigate}"
                                                    NavigateUri="{StaticResource DocumentLink_Sponsor}"/>
                                            </cwc:UniformGrid>
                                            <TextBlock
                                                Margin="12,0,0,0"
                                                Opacity="0.7"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="Copyright © 2022 - 2025 DGP Studio. All Rights Reserved."/>
                                            <TextBlock
                                                Margin="12,0,0,0"
                                                Opacity="0.7"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="Copyright © 2026 SnapHutaoRemasteringProject. All Rights Reserved."/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!--  应用行为 - 窄屏  -->
                                <TextBlock Style="{StaticResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageSettingAppBehaviorHeader}"/>

                                <cwc:SettingsCard
                                    Command="{x:Bind DataContext.CheckUpdateCommand, Mode=OneWay}"
                                    Description="{x:Bind DataContext.UpdateInfo, Mode=OneWay}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingCheckUpdateHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE895;}"
                                    IsClickEnabled="True"/>

                                <!--  Administor  -->
                                <cwc:SettingsExpander HeaderIcon="{shuxm:FontIcon Glyph=&#xE7EF;}" IsExpanded="True">
                                    <cwc:SettingsExpander.Header>
                                        <TextBlock Text="{shuxm:ResourceString Name=ViewPageSettingElevatedModeHeader}"/>
                                    </cwc:SettingsExpander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <wl:LiquidGlassButton
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            HorizontalAlignment="Right"
                                            Command="{x:Bind DataContext.RestartAsElevatedCommand, Mode=OneWay}"
                                            Content="{shuxm:ResourceString Name=ViewPageSettingElevatedModeRestartAction}"
                                            IsEnabled="{shuxm:IsProcessNotElevated}"/>
                                    </StackPanel>
                                    <cwc:SettingsExpander.Items>
                                        <cwc:SettingsCard Description="{shuxm:ResourceString Name=ViewPageSettingAutoRestartAsAdminDescription}" Header="{shuxm:ResourceString Name=ViewPageSettingAutoRestartAsAdminHeader}">
                                            <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.AutoRestartAsAdminEnabled, Mode=TwoWay}"/>
                                        </cwc:SettingsCard>
                                    </cwc:SettingsExpander.Items>
                                </cwc:SettingsExpander>

                                <!--  Auto start  -->
                                <cwc:SettingsExpander
                                    Description="{shuxm:ResourceString Name=ViewPageSettingAutoStartDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingAutoStartHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE7E8;}"
                                    IsEnabled="{x:Bind DataContext.IsStartupSettingsEnabled, Mode=OneWay}"
                                    IsExpanded="True">
                                    <cwc:SettingsExpander.Items>
                                        <!--  当前用户自启动  -->
                                        <cwc:SettingsCard
                                            Header="{shuxm:ResourceString Name=ViewPageSettingAutoStartEnableCardHeader}"
                                            HeaderIcon="{shuxm:FontIcon Glyph=&#xE7EE;}"
                                            IsClickEnabled="False">
                                            <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.IsStartupEnabled, Mode=TwoWay}"/>
                                        </cwc:SettingsCard>

                                        <!--  Will keep enable if AutoRestartAsAdmin is enabled, because it will start as admin when startup and avoid UAC prompt and keep consistent with the behavior  -->
                                        <!--  自启动行为权限设置：管理员权限  -->
                                        <cwc:SettingsCard
                                            Header="{shuxm:ResourceString Name=ViewPageSettingAutoStartAdminActionCardHeader}"
                                            HeaderIcon="{shuxm:FontIcon Glyph=&#xE7EF;}"
                                            IsClickEnabled="False"
                                            IsEnabled="{x:Bind DataContext.IsStartupAsAdminCardEnabled, Mode=OneWay}">
                                            <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.IsStartupAsAdminEnabled, Mode=TwoWay}"/>
                                        </cwc:SettingsCard>
                                    </cwc:SettingsExpander.Items>
                                </cwc:SettingsExpander>

                                <cwc:SettingsCard
                                    ActionIconToolTip="{shuxm:ResourceString Name=ViewPageSettingCreateDesktopShortcutAction}"
                                    Command="{x:Bind DataContext.CreateDesktopShortcutCommand, Mode=OneWay}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingCreateDesktopShortcutHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE72D;}"
                                    IsClickEnabled="True"/>
                                <cwc:SettingsCard
                                    ActionIconToolTip="{shuxm:ResourceString Name=ViewPageSettingCreateDesktopShortcutAction}"
                                    Command="{x:Bind DataContext.CreateGameLaunchShortcutCommand, Mode=OneWay}"
                                    Header="{shuxm:ResourceString Name=ViewPageLaunchGameCreateGameLaunchShortcut}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE72D;}"
                                    IsClickEnabled="True"/>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!--  无感验证  -->
                    <Border cw:Effects.Shadow="{ThemeResource CompatCardShadow}" DataContext="{x:Bind DataContext.Geetest, Mode=OneWay}">
                        <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                            <StackPanel Spacing="{ThemeResource SettingsCardSpacing}">
                                <TextBlock Style="{StaticResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageSettingGeetestVerificationHeader}"/>
                                <cwc:SettingsCard
                                    ActionIcon="{shuxm:FontIcon Glyph=&#xF32A;}"
                                    ActionIconToolTip="{shuxm:ResourceString Name=ViewPageSettingGeetestCustomUrlAction}"
                                    Command="{x:Bind DataContext.Geetest.ConfigureGeetestUrlCommand, Mode=OneWay}"
                                    Description="{shuxm:ResourceString Name=ViewPageSettingGeetestCustomUrlDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingGeetestCustomUrlHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE776;}"
                                    IsClickEnabled="True"/>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!--  外观  -->
                    <Border cw:Effects.Shadow="{ThemeResource CompatCardShadow}" DataContext="{x:Bind DataContext.Appearance, Mode=OneWay}">
                        <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                            <StackPanel Spacing="{ThemeResource SettingsCardSpacing}">
                                <TextBlock Style="{StaticResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageSettingApperanceHeader}"/>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewPageSettingApperanceLanguageDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingApperanceLanguageHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xF2B7;}">
                                    <shuxc:SizeRestrictedContentControl>
                                        <wl:LiquidGlassComboBox
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{x:Bind shs:CultureOptions.Cultures}"
                                            SelectedItem="{x:Bind DataContext.Appearance.SelectedCulture, Mode=TwoWay}"/>
                                    </shuxc:SizeRestrictedContentControl>
                                </cwc:SettingsCard>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewPageSettingApperanceFirstDayOfWeekDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingApperanceFirstDayOfWeekHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE8C0;}">
                                    <shuxc:SizeRestrictedContentControl>
                                        <wl:LiquidGlassComboBox
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{x:Bind DataContext.Appearance.CultureOptions.DayOfWeeks, Mode=OneWay}"
                                            SelectedItem="{x:Bind DataContext.Appearance.SelectedFirstDayOfWeek, Mode=TwoWay}"/>
                                    </shuxc:SizeRestrictedContentControl>
                                </cwc:SettingsCard>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewPageSettingBackdropMaterialDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingBackdropMaterialHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE7F7;}">
                                    <shuxc:SizeRestrictedContentControl>
                                        <wl:LiquidGlassComboBox
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                            DisplayMemberPath="Name"
                                            IsEnabled="{x:Bind DataContext.Appearance.IsBackdropSelectionEnabled, Mode=OneWay}"
                                            ItemsSource="{x:Bind DataContext.Appearance.AppOptions.BackdropTypes, Mode=OneWay}"
                                            SelectedItem="{x:Bind DataContext.Appearance.SelectedBackdropType, Mode=TwoWay}"/>
                                    </shuxc:SizeRestrictedContentControl>
                                </cwc:SettingsCard>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewPageSettingThemeDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingThemeHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE790;}">
                                    <shuxc:SizeRestrictedContentControl>
                                        <wl:LiquidGlassComboBox
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{x:Bind DataContext.Appearance.AppOptions.LazyElementThemes.Value, Mode=OneWay}"
                                            SelectedItem="{x:Bind DataContext.Appearance.SelectedElementTheme, Mode=TwoWay}"/>
                                    </shuxc:SizeRestrictedContentControl>
                                </cwc:SettingsCard>
                                <cwc:SettingsCard
                                    Description="{shuxm:ResourceString Name=ViewPageSettingControlMaterialDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingControlMaterialHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE790;}">
                                    <shuxc:SizeRestrictedContentControl>
                                        <wl:LiquidGlassComboBox
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{x:Bind DataContext.Appearance.AppOptions.ControlMaterials, Mode=OneWay}"
                                            SelectedItem="{x:Bind DataContext.Appearance.SelectedControlMaterial, Mode=TwoWay}"/>
                                    </shuxc:SizeRestrictedContentControl>
                                </cwc:SettingsCard>
                                <cwc:SettingsCard
                                    Click="OpenGlassControls"
                                    Description="{shuxm:ResourceString Name=GlassControlsCardDescription}"
                                    Header="{shuxm:ResourceString Name=LiquidGlassControlsWindowTitle}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE790;}"
                                    IsClickEnabled="True"/>
                                <cwc:SettingsCard
                                    Click="OpenGlassEffects"
                                    Description="{shuxm:ResourceString Name=GlassEffectsCardDescription}"
                                    Header="{shuxm:ResourceString Name=LiquidGlassEffectsWindowTitle}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE771;}"
                                    IsClickEnabled="True"/>
                                <cwc:SettingsExpander
                                    Description="{shuxm:ResourceString Name=ViewPageSettingBackgroundImageDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingBackgroundImageHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE8B9;}"
                                    IsExpanded="{x:Bind DataContext.Appearance.BackgroundImageOptions.Wallpaper, Converter={StaticResource EmptyObjectToBoolConverter}, Mode=OneWay}">
                                    <shuxc:SizeRestrictedContentControl VerticalAlignment="Center">
                                        <wl:LiquidGlassComboBox
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{x:Bind DataContext.Appearance.AppOptions.BackgroundImageTypes, Mode=OneWay}"
                                            SelectedItem="{x:Bind DataContext.Appearance.SelectedBackgroundImageType, Mode=TwoWay}"/>
                                    </shuxc:SizeRestrictedContentControl>
                                    <cwc:SettingsExpander.Items>
                                        <!--  SettingsExpander uses ItemsRepeater, where first item will behave abnormally in binding  -->
                                        <cwc:SettingsCard Header="{shuxm:ResourceString Name=ViewPageSettingBackgroundImageLocalFolderCopyrightHeader}" Visibility="{x:Bind DataContext.Appearance.BackgroundImageOptions.Wallpaper, Converter={StaticResource EmptyObjectToBoolRevertConverter}, Mode=OneWay}"/>
                                        <cwc:SettingsCard
                                            ActionIcon="{shuxm:FontIcon Glyph=&#xE76C;}"
                                            ActionIconToolTip="{shuxm:ResourceString Name=ViewPageSettingBackgroundImageSetFolderAction}"
                                            Command="{x:Bind DataContext.Appearance.SetBackgroundImageFolderCommand, Mode=OneWay}"
                                            Description="{x:Bind DataContext.Appearance.AppOptions.BackgroundImagePath.Value, Mode=OneWay}"
                                            Header="{shuxm:ResourceString Name=ViewPageSettingBackgroundImageCustomFolderHeader}"
                                            IsClickEnabled="True"
                                            Visibility="{x:Bind DataContext.Appearance.BackgroundImageOptions.Wallpaper, Converter={StaticResource EmptyObjectToBoolRevertConverter}, Mode=OneWay}"/>
                                        <cwc:SettingsCard
                                            Description="{x:Bind DataContext.Appearance.BackgroundImageOptions.Wallpaper.Author, Mode=OneWay}"
                                            Header="{shuxm:ResourceString Name=ViewPageSettingBackgroundImageCopyrightHeader}"
                                            IsClickEnabled="True"
                                            Visibility="{x:Bind DataContext.Appearance.BackgroundImageOptions.Wallpaper, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                                            <mxi:Interaction.Behaviors>
                                                <mxi:EventTriggerBehavior EventName="Click">
                                                    <cwb:NavigateToUriAction NavigateUri="{x:Bind DataContext.Appearance.BackgroundImageOptions.Wallpaper.SourceUrl, Mode=OneWay}"/>
                                                </mxi:EventTriggerBehavior>
                                            </mxi:Interaction.Behaviors>
                                        </cwc:SettingsCard>
                                    </cwc:SettingsExpander.Items>
                                </cwc:SettingsExpander>

                                <!--  Background Video  -->
                                <cwc:SettingsExpander
                                    Description="{shuxm:ResourceString Name=ViewPageSettingBackgroundVideoDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingBackgroundVideoHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE714;}"
                                    IsExpanded="False">
                                    <shuxc:SizeRestrictedContentControl>
                                        <wl:LiquidGlassComboBox
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                            DisplayMemberPath="Name"
                                            ItemsSource="{x:Bind DataContext.Appearance.AppOptions.BackgroundMediaTypes, Mode=OneWay}"
                                            SelectedItem="{x:Bind DataContext.Appearance.SelectedBackgroundMediaType, Mode=TwoWay}"/>
                                    </shuxc:SizeRestrictedContentControl>
                                    <cwc:SettingsExpander.Items>
                                        <cwc:SettingsCard Header="{shuxm:ResourceString Name=ViewPageSettingBackgroundVideoIsMutedHeader}" HeaderIcon="{shuxm:FontIcon Glyph=&#xE8D6;}">
                                            <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.Appearance.IsMuted, Mode=TwoWay}"/>
                                        </cwc:SettingsCard>

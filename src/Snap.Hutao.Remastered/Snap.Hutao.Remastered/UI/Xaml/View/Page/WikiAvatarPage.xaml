                                                    <Expander
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        shuxcth:MaterialBackground.NativeBrush="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                        shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoSurfaceBrush}"
                                                        Header="{shuxm:ResourceString Name=ViewPageWiKiAvatarFoodHeader}"
                                                        IsExpanded="True">
                                                        <Grid DataContext="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.CookBonusView, Mode=OneWay}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto"/>
                                                                <RowDefinition Height="auto"/>
                                                                <RowDefinition Height="auto"/>
                                                                <RowDefinition Height="auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="auto"/>
                                                                <ColumnDefinition Width="auto"/>
                                                                <ColumnDefinition/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Style="{StaticResource BaseTextBlockStyle}"
                                                                Text="{shuxm:ResourceString Name=ViewPageWiKiAvatarSpecialFoodTitle}"/>
                                                            <TextBlock
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                Margin="16,0,0,0"
                                                                Style="{StaticResource BaseTextBlockStyle}"
                                                                Text="{shuxm:ResourceString Name=ViewPageWiKiAvatarOriginalFoodTitle}"/>
                                                            <StackPanel
                                                                Grid.Row="0"
                                                                Grid.RowSpan="4"
                                                                Grid.Column="2"
                                                                Margin="16,0,0,0">
                                                                <TextBlock Text="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.CookBonusView.Item.Description, Mode=OneWay}" TextWrapping="Wrap"/>
                                                                <TextBlock
                                                                    Margin="0,16,0,0"
                                                                    Text="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.CookBonusView.Item.EffectDescription, Mode=OneWay}"
                                                                    TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <shuxcc:VerticalCard
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Margin="0,16,0,0">
                                                                <shuxcc:VerticalCard.Top>
                                                                    <shuxc:ItemIcon Icon="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.CookBonusView.Item.Icon, Converter={StaticResource ItemIconConverter}, Mode=OneWay}" Quality="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.CookBonusView.Item.RankLevel, Mode=OneWay}"/>
                                                                </shuxcc:VerticalCard.Top>
                                                                <shuxcc:VerticalCard.Bottom>
                                                                    <TextBlock
                                                                        MaxWidth="80"
                                                                        Text="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.CookBonusView.Item.Name, Mode=OneWay}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        TextWrapping="NoWrap"/>
                                                                </shuxcc:VerticalCard.Bottom>
                                                            </shuxcc:VerticalCard>
                                                            <shuxcc:VerticalCard
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Margin="16,16,0,0">
                                                                <shuxcc:VerticalCard.Top>
                                                                    <shuxc:ItemIcon Icon="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.CookBonusView.OriginItem.Icon, Converter={StaticResource ItemIconConverter}, Mode=OneWay}" Quality="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.CookBonusView.OriginItem.RankLevel, Mode=OneWay}"/>
                                                                </shuxcc:VerticalCard.Top>
                                                                <shuxcc:VerticalCard.Bottom>
                                                                    <TextBlock
                                                                        MaxWidth="80"
                                                                        Text="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.CookBonusView.OriginItem.Name, Mode=OneWay}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        TextWrapping="NoWrap"/>
                                                                </shuxcc:VerticalCard.Bottom>
                                                            </shuxcc:VerticalCard>
                                                        </Grid>
                                                    </Expander>
                                                </Border>

                                                <!--  资料  -->
                                                <Border>

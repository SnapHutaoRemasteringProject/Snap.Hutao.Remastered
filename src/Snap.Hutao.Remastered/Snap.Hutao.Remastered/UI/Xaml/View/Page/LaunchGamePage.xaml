<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.LaunchGamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shas="using:Snap.Hutao.Remastered.Service.Game.AdvancedStart.Model"
    xmlns:shme="using:Snap.Hutao.Remastered.Model.Entity"
    xmlns:shsg="using:Snap.Hutao.Remastered.Service.Game"
    xmlns:shsgp="using:Snap.Hutao.Remastered.Service.Game.PathAbstraction"
    xmlns:shuil="using:Snap.Hutao.Remastered.UI.Input.LowLevel"
    xmlns:shux="using:Snap.Hutao.Remastered.UI.Xaml"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxba="using:Snap.Hutao.Remastered.UI.Xaml.Behavior.Action"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxdcs="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter.Specialized"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvg="using:Snap.Hutao.Remastered.ViewModel.Game"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance shvg:LaunchGameViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shvg:LaunchGameViewModel)DataContext).LoadCommand, Mode=OneWay}"/>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageInstallViewModel.LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <shux:BindingProxy x:Key="BindingProxy" DataContext="{x:Bind ((shvg:LaunchGameViewModel)DataContext), Mode=OneWay}"/>

        <DataTemplate x:Key="GameAccountListTemplate" x:DataType="shme:GameAccount">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,16"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}"/>
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchAccountExpired}"
                        Visibility="{x:Bind IsExpired, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                </StackPanel>
                <StackPanel
                    x:Name="ButtonPanel"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                    <cwc:SwitchPresenter
                        x:Name="GlassPresenter_3044"
                        Margin="4,8"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:Button"
                        Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>0</x:Int32>
                            </cwc:Case.Value>
                            <Button
                                MinWidth="35.2"
                                VerticalAlignment="Stretch"
                                Command="{Binding DataContext.ModifyGameAccountCommand, Source={StaticResource BindingProxy}}"
                                CommandParameter="{Binding Mode=OneWay}"
                                Content="&#xE8AC;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchAccountRenameToolTip}"/>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>1</x:Int32>
                            </cwc:Case.Value>
                            <wl:LiquidGlassButton
                                MinWidth="35.2"
                                VerticalAlignment="Stretch"
                                shuxcth:ControlMaterialState.IsManaged="True"
                                Command="{Binding DataContext.ModifyGameAccountCommand, Source={StaticResource BindingProxy}}"
                                CommandParameter="{Binding Mode=OneWay}"
                                Content="&#xE8AC;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchAccountRenameToolTip}"/>
                        </cwc:Case>
                    </cwc:SwitchPresenter>
                    <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                    <cwc:SwitchPresenter
                        x:Name="GlassPresenter_3705"
                        Margin="4,8,0,8"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:Button"
                        Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>0</x:Int32>
                            </cwc:Case.Value>
                            <Button
                                MinWidth="35.2"
                                VerticalAlignment="Stretch"
                                Command="{Binding DataContext.RemoveGameAccountCommand, Source={StaticResource BindingProxy}}"
                                CommandParameter="{x:Bind Mode=OneWay}"
                                Content="&#xE74D;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchAccountRemoveToolTip}"/>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>1</x:Int32>
                            </cwc:Case.Value>
                            <wl:LiquidGlassButton
                                MinWidth="35.2"
                                VerticalAlignment="Stretch"
                                shuxcth:ControlMaterialState.IsManaged="True"
                                Command="{Binding DataContext.RemoveGameAccountCommand, Source={StaticResource BindingProxy}}"
                                CommandParameter="{x:Bind Mode=OneWay}"
                                Content="&#xE74D;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchAccountRemoveToolTip}"/>
                        </cwc:Case>
                    </cwc:SwitchPresenter>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GamePathEntryListTemplate" x:DataType="shsgp:GamePathEntry">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Padding="0,16"
                    VerticalAlignment="Center"
                    Text="{x:Bind Path, Mode=OneWay}"/>
                <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                <cwc:SwitchPresenter
                    x:Name="GlassPresenter_4911"
                    Grid.Column="1"
                    Margin="4,8,0,8"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False"
                    Tag="LiquidGlass:Button"
                    Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                    <cwc:Case>
                        <cwc:Case.Value>
                            <x:Int32>0</x:Int32>
                        </cwc:Case.Value>
                        <Button
                            MinWidth="48"
                            VerticalAlignment="Stretch"
                            Command="{Binding DataContext.RemoveGamePathEntryCommand, Source={StaticResource BindingProxy}}"
                            CommandParameter="{x:Bind Mode=OneWay}"
                            Content="&#xE74D;"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchAccountRemoveToolTip}"/>
                    </cwc:Case>
                    <cwc:Case>
                        <cwc:Case.Value>
                            <x:Int32>1</x:Int32>
                        </cwc:Case.Value>
                        <wl:LiquidGlassButton
                            MinWidth="48"
                            VerticalAlignment="Stretch"
                            shuxcth:ControlMaterialState.IsManaged="True"
                            Command="{Binding DataContext.RemoveGamePathEntryCommand, Source={StaticResource BindingProxy}}"
                            CommandParameter="{x:Bind Mode=OneWay}"
                            Content="&#xE74D;"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchAccountRemoveToolTip}"/>
                    </cwc:Case>
                </cwc:SwitchPresenter>
            </Grid>
        </DataTemplate>

        <shvg:AspectRatioComboBoxTemplateSelector x:Key="AspectRatioComboBoxTemplateSelector">
            <shvg:AspectRatioComboBoxTemplateSelector.ListTemplate>
                <DataTemplate x:DataType="shsg:AspectRatio">
                    <!--  ComboBoxItemThemePadding 11,5,11,7  -->
                    <Grid Margin="1,-1,-7,-3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center" Text="{Binding Mode=OneWay}"/>
                        <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_6260"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:Button"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <Button
                                    MinWidth="32"
                                    MinHeight="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.RemoveAspectRatioCommand, Source={StaticResource BindingProxy}}"
                                    CommandParameter="{Binding Mode=OneWay}"
                                    Content="&#xE711;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Style="{ThemeResource SettingButtonStyle}"/>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassButton
                                    MinWidth="32"
                                    MinHeight="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    Command="{Binding DataContext.RemoveAspectRatioCommand, Source={StaticResource BindingProxy}}"
                                    CommandParameter="{Binding Mode=OneWay}"
                                    Content="&#xE711;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Style="{ThemeResource SettingButtonStyle}"/>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                    </Grid>
                </DataTemplate>
            </shvg:AspectRatioComboBoxTemplateSelector.ListTemplate>
        </shvg:AspectRatioComboBoxTemplateSelector>

        <shuxdcs:IntToNameValueVirtualKeyConverter x:Key="IntToNameValueVirtualKeyConverter"/>
    </Page.Resources>

    <shuxc:StandardView ShowCondition="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePathEntryValid.Value, Mode=OneWay}" Style="{ThemeResource DefaultStandardViewStyle}">
        <shuxc:StandardView.EmptyContent>
            <Border
                Margin="128,0"
                Padding="16"
                VerticalAlignment="Center"
                Style="{ThemeResource AcrylicBorderCardStyle}">
                <StackPanel
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="3">
                    <shuxci:CachedImage
                        Height="120"
                        MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                        Source="{StaticResource UI_EmotionIcon445}"/>
                    <TextBlock
                        Margin="0,5,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{shuxm:ResourceString Name=ViewPageLaunchGameSelectGamePath}"/>
                    <TextBlock
                        Margin="0,5,0,21"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource SystemErrorTextColor}"
                        Text="{shuxm:ResourceString Name=ViewPageLaunchGameSelectGamePathHint}"/>
                    <Border Style="{ThemeResource BorderCardStyle}" Visibility="{x:Bind ((shvg:LaunchGameViewModel)DataContext).LaunchOptions.GamePathEntries.Value.Length, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}">
                        <ListView
                            ItemTemplate="{StaticResource GamePathEntryListTemplate}"
                            ItemsSource="{x:Bind ((shvg:LaunchGameViewModel)DataContext).LaunchOptions.GamePathEntries.Value, Mode=OneWay}"
                            SelectedItem="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePathEntry.Value, Mode=TwoWay}"/>
                    </Border>
                    <cwc:SettingsCard
                        ActionIcon="{shuxm:FontIcon Glyph=&#xE76C;}"
                        ActionIconToolTip="{shuxm:ResourceString Name=ViewPageSettingSetGamePathAction}"
                        Command="{x:Bind ((shvg:LaunchGameViewModel)DataContext).PickGamePathCommand, Mode=OneWay}"
                        Header="{shuxm:ResourceString Name=ViewPageSettingSetGamePathHeader}"
                        HeaderIcon="{shuxm:FontIcon Glyph=&#xE7FC;}"
                        IsClickEnabled="True">
                        <cwc:SettingsCard.Description>
                            <TextBlock Foreground="{ThemeResource SystemErrorTextColor}" Text="{shuxm:ResourceString Name=ViewPageSettingSetGamePathHint}"/>
                        </cwc:SettingsCard.Description>
                    </cwc:SettingsCard>
                    <cwc:SettingsCard
                        Padding="{ThemeResource SettingsExpanderItemHasIconPadding}"
                        Command="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageInstallViewModel.StartCommand, Mode=OneWay}"
                        Description="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageInstallViewModel.RemoteVersionText, Mode=OneWay}"
                        Header="{shuxm:ResourceString Name=ViewPageLaunchGamePackageOperationInstall}"
                        HeaderIcon="{shuxm:FontIcon Glyph={StaticResource FontIconContentCloudDownload}}"
                        IsClickEnabled="True"
                        IsEnabled="{shuxm:IsProcessElevated}">
                        <shuxc:Elevation Visibility="{shuxm:CollapsedWhenProcessElevated}"/>
                    </cwc:SettingsCard>
                </StackPanel>
            </Border>
        </shuxc:StandardView.EmptyContent>

        <Pivot Style="{ThemeResource CardPivotStyle}">
            <Pivot.RightHeader>
                <CommandBar DefaultLabelPosition="Right">
                    <CommandBar.Content>
                        <TextBlock
                            Margin="12,14,12,0"
                            VerticalAlignment="Center"
                            Text="{x:Bind ((shvg:LaunchGameViewModel)DataContext).LaunchStatusOptions.LaunchStatus.Description, Mode=OneWay}"/>
                    </CommandBar.Content>
                    <AppBarButton
                        Command="{x:Bind ((shvg:LaunchGameViewModel)DataContext).OpenScreenshotFolderCommand, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xED25;}"
                        Label="{shuxm:ResourceString Name=ViewPageOpenScreenshotFolderAction}"/>
                    <AppBarButton
                        Command="{x:Bind ((shvg:LaunchGameViewModel)DataContext).ResetGamePathCommand, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xEBC4;}"
                        IsEnabled="{x:Bind shsg:LaunchOptions.IsGameRunning.Value, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                        Label="{shuxm:ResourceString Name=ViewPageResetGamePathAction}"
                        ToolTipService.ToolTip="{x:Bind ((shvg:LaunchGameViewModel)DataContext).DisplayGamePath.Value, Mode=OneWay}"/>
                    <AppBarButton
                        Command="{x:Bind ((shvg:LaunchGameViewModel)DataContext).KillGameProcessCommand, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xE733;}"
                        IsEnabled="{x:Bind shsg:LaunchOptions.CanKillGameProcess.Value, Mode=OneWay}"
                        Label="{shuxm:ResourceString Name=ViewPageLaunchGameKillGameProcessAction}"/>
                    <AppBarButton
                        Command="{x:Bind ((shvg:LaunchGameViewModel)DataContext).LaunchCommand, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xE7FC;}"
                        IsEnabled="{x:Bind shsg:LaunchOptions.IsGameRunning.Value, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                        Label="{shuxm:ResourceString Name=ViewPageLaunchGameAction}"/>
                </CommandBar>
            </Pivot.RightHeader>

            <PivotItem Header="{shuxm:ResourceString Name=ViewPageLaunchGameOptionsHeader}">
                <ScrollViewer>
                    <StackPanel Margin="16" Spacing="16">
                        <StackPanel.ChildrenTransitions>
                            <EntranceThemeTransition FromVerticalOffset="50"/>
                            <RepositionThemeTransition IsStaggeringEnabled="False"/>
                        </StackPanel.ChildrenTransitions>
                        <!--  需要管理员权限的操作  -->
                        <Border cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                            <Grid Style="{ThemeResource AcrylicGridCardStyle}">
                                <Grid
                                    Margin="16"
                                    ColumnSpacing="12"
                                    Visibility="{shuxm:VisibleWhenProcessElevated}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <!--  修复/更新/预下载  -->
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Top"
                                        Spacing="12">
                                        <Grid Style="{ThemeResource GridCardStyle}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid
                                                Padding="16"
                                                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1"
                                                ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <shuxci:CachedImage
                                                    shux:FrameworkElementHelper.SquareLength="48"
                                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                                    Source="{StaticResource IconGame}"/>
                                                <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Vertical"
                                                    Spacing="{ThemeResource SettingsCardSpacing}">
                                                    <TextBlock Text="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.LocalVersionText, Mode=OneWay}"/>
                                                    <TextBlock Text="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.RemoteVersionText, Mode=OneWay}"/>
                                                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" Text="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.VersionSourcesText, Mode=OneWay}" />
                                                    <InfoBar IsClosable="False" Severity="Warning" IsOpen="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.HasInstallationWarning, Mode=OneWay}" Message="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.InstallationStatusText, Mode=OneWay}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel
                                                Grid.Row="1"
                                                Margin="-2,-6"
                                                Padding="16"
                                                Orientation="Horizontal">
                                                <AppBarButton Command="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.RefreshInstallationCommand, Mode=OneWay}" Icon="Refresh" Label="{shuxm:ResourceString Name=ViewPageGameRefreshInstallation}" IsEnabled="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.IsNotRefreshing, Mode=OneWay}" />
                                                <AppBarButton
                                                    IsEnabled="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.CanOperate, Mode=OneWay}"
                                                    Command="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.StartCommand, Mode=OneWay}"
                                                    CommandParameter="Verify"
                                                    Icon="{shuxm:FontIcon Glyph={StaticResource FontIconContentDeveloperTools}}"
                                                    Label="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.VerifyOperationLabel, Mode=OneWay}"
                                                    Style="{StaticResource DefaultAppBarButtonStyle}"/>
                                                <AppBarButton
                                                    Command="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.StartCommand, Mode=OneWay}"
                                                    CommandParameter="Update"
                                                    Icon="{shuxm:FontIcon Glyph={StaticResource FontIconContentUpArrowShiftKey}}"
                                                    IsEnabled="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.IsUpdateAvailable, Mode=OneWay}"
                                                    Label="{shuxm:ResourceString Name=ViewPageLaunchGamePackageOperationUpdate}"/>
                                                <Grid>
                                                    <AppBarButton
                                                        Command="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.StartCommand, Mode=OneWay}"
                                                        CommandParameter="Predownload"
                                                        Icon="{shuxm:FontIcon Glyph={StaticResource FontIconContentDownload}}"
                                                        IsEnabled="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.IsPredownloadButtonEnabled, Mode=OneWay}"
                                                        Label="{shuxm:ResourceString Name=ViewPageLaunchGamePackageOperationPredownload}"/>
                                                    <!--  预下载开放 Icon  -->
                                                    <Grid
                                                        Margin="4,8"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        ToolTipService.ToolTip="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.PreVersionText, Mode=OneWay}"
                                                        Visibility="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.IsPredownloadButtonEnabled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                                        <FontIcon
                                                            FontSize="16"
                                                            Foreground="{ThemeResource InfoBarInformationalSeverityIconBackground}"
                                                            Glyph="{ThemeResource InfoBarIconBackgroundGlyph}"/>
                                                        <FontIcon
                                                            FontSize="16"
                                                            Foreground="{ThemeResource InfoBarInformationalSeverityIconForeground}"
                                                            Glyph="{ThemeResource InfoBarInformationalIconGlyph}"/>
                                                    </Grid>
                                                    <!--  预下载进度  -->
                                                    <InfoBadge
                                                        Margin="4,8"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        ToolTipService.ToolTip="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.PredownloadProgressText, Mode=OneWay}"
                                                        Visibility="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.IsPredownloadInProgress, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                                        Value="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.PredownloadProgress, Mode=OneWay}"/>
                                                    <!--  预下载完成 Icon  -->
                                                    <Grid
                                                        Margin="4,8"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGamePackageOperationPredownloadCompleteBadgeContent}"
                                                        Visibility="{x:Bind ((shvg:LaunchGameViewModel)DataContext).GamePackageViewModel.IsPredownloadFinished, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                                        <FontIcon
                                                            FontSize="16"
                                                            Foreground="{ThemeResource InfoBarSuccessSeverityIconBackground}"
                                                            Glyph="{ThemeResource InfoBarIconBackgroundGlyph}"/>
                                                        <FontIcon
                                                            FontSize="16"
                                                            Foreground="{ThemeResource InfoBarSuccessSeverityIconForeground}"
                                                            Glyph="{ThemeResource InfoBarSuccessIconGlyph}"/>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="12">
                                        <!--  切换服务器  -->
                                        <cwc:SettingsCard
                                            VerticalAlignment="Top"
                                            Description="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchSchemeDescription}"
                                            Header="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchSchemeHeader}"
                                            HeaderIcon="{shuxm:FontIcon Glyph=&#xE8AB;}">
                                            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SettingsCardContentControlSpacing}">
                                                <cwc:SwitchPresenter
                                                    x:Name="GlassPresenter_23118"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    IsTabStop="False"
                                                    Tag="LiquidGlass:Button"
                                                    Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                                                    <cwc:Case>
                                                        <cwc:Case.Value>
                                                            <x:Int32>0</x:Int32>
                                                        </cwc:Case.Value>
                                                        <Button
                                                            Command="{x:Bind ((shvg:LaunchGameViewModel)DataContext).ConvertCommand, Mode=OneWay}"
                                                            Content="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchSchemeAction}"
                                                            Style="{ThemeResource SettingButtonStyle}"/>
                                                    </cwc:Case>
                                                    <cwc:Case>
                                                        <cwc:Case.Value>
                                                            <x:Int32>1</x:Int32>
                                                        </cwc:Case.Value>
                                                        <wl:LiquidGlassButton
                                                            shuxcth:ControlMaterialState.IsManaged="True"
                                                            Command="{x:Bind ((shvg:LaunchGameViewModel)DataContext).ConvertCommand, Mode=OneWay}"
                                                            Content="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchSchemeAction}"
                                                            Style="{ThemeResource SettingButtonStyle}"/>
                                                    </cwc:Case>
                                                </cwc:SwitchPresenter>
                                                <shuxc:SizeRestrictedContentControl>
                                                    <shuxc:ComboBox2
                                                        DisplayMemberPath="DisplayName"
                                                        EnableMemberPath="IsNotCompatOnly"
                                                        IsEnabled="{x:Bind shsg:LaunchOptions.IsGameRunning.Value, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                                                        ItemsSource="{x:Bind ((shvg:LaunchGameViewModel)DataContext).KnownSchemes, Mode=OneWay}"
                                                        SelectedItem="{x:Bind ((shvg:LaunchGameViewModel)DataContext).TargetSchemeFilteredGameAccountsView.Scheme, Mode=TwoWay}"
                                                        Style="{StaticResource DefaultComboBoxStyle}"/>
                                                </shuxc:SizeRestrictedContentControl>
                                            </StackPanel>
                                        </cwc:SettingsCard>
                                        <!--  悬浮窗  -->
                                        <ScrollViewer>
                                            <cwc:SettingsExpander
                                                shuxc:SettingsExpanderHelper.IsItemsEnabled="{x:Bind ((shvg:LaunchGameViewModel)DataContext).LaunchOptions.UsingOverlay.Value, Mode=OneWay}"
                                                Description="{shuxm:ResourceString Name=ViewPageLaunchGameOverlayDescription}"
                                                Header="{shuxm:ResourceString Name=ViewPageLaunchGameOverlayHeader}"
                                                HeaderIcon="{shuxm:FontIcon Glyph=&#xEB91;}"
                                                IsExpanded="True">
                                                <cwc:SwitchPresenter

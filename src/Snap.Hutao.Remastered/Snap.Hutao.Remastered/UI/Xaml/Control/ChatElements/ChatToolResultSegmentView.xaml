<UserControl
    x:Class="Snap.Hutao.Remastered.UI.Xaml.Control.ChatElements.ChatToolResultSegmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:snsao="using:Snap.Hutao.Remastered.Service.AI.Observables"
    xmlns:snuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.ChatElements"
    xmlns:snuxd="using:Snap.Hutao.Remastered.UI.Xaml.Data.AI">

    <UserControl.Resources>
        <snuxd:EmptyObjectToVisibilityConverter x:Key="ContentVisibilityConverter" />

        <DataTemplate x:Key="FunctionToolResultTemplate" x:DataType="snsao:ObservableFunctionResultContent">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xEC7A;" />
                    <FontIcon
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xE76B;" />
                    <TextBlock
                        Grid.Column="2"
                        Opacity="0.7"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding Result}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ContentCollectionToolResultTemplate">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xEC7A;" />
                        <FontIcon
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xE76B;" />
                        <TextBlock
                            Grid.Column="2"
                            Opacity="0.7"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding CallId}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Outputs}" Visibility="{Binding Outputs, Converter={StaticResource ContentVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <snuxcc:ChatObjectSegmentView Value="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FallbackToolResultTemplate" x:DataType="snsao:ObservableToolResultContent">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xEC7A;" />
                    <FontIcon
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xE76B;" />
                    <TextBlock
                        Grid.Column="2"
                        Opacity="0.7"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding CallId}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>

        <snuxcc:ChatToolResultTemplateSelector
            x:Key="ToolResultTemplateSelector"
            CodeInterpreterTemplate="{StaticResource ContentCollectionToolResultTemplate}"
            FallbackTemplate="{StaticResource FallbackToolResultTemplate}"
            FunctionTemplate="{StaticResource FunctionToolResultTemplate}"
            ImageGenerationTemplate="{StaticResource ContentCollectionToolResultTemplate}"
            McpServerTemplate="{StaticResource ContentCollectionToolResultTemplate}"
            WebSearchTemplate="{StaticResource ContentCollectionToolResultTemplate}" />
    </UserControl.Resources>

    <ContentControl
        HorizontalContentAlignment="Stretch"
        Content="{x:Bind ToolResult, Mode=OneWay}"
        ContentTemplateSelector="{StaticResource ToolResultTemplateSelector}" />
</UserControl>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <BitmapImage x:Key="LockIcon_Unlock" UriSource="ms-appx:///Resource/Icon/UI_Icon_Unlock_Dark.png"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <BitmapImage x:Key="LockIcon_Unlock" UriSource="ms-appx:///Resource/Icon/UI_Icon_Unlock.png"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <BitmapImage x:Key="LockIcon_Locked" UriSource="ms-appx:///Resource/Icon/UI_Icon_Locked.png"/>

    <Style BasedOn="{StaticResource DefaultLockIconStyle}" TargetType="shuxc:LockIcon"/>

    <Style x:Key="DefaultLockIconStyle" TargetType="shuxc:LockIcon">
        <Setter Property="Height" Value="80"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shuxc:LockIcon">
                    <Grid
                        Background="#FF6A6A6A"
                        BorderBrush="#FFCCCCCC"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <Border Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                            <Image
                                x:Name="IconImage"
                                Margin="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{ThemeResource LockIcon_Unlock}"/>
                        </Border>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LockStates">
                                <VisualState x:Name="Locked">
                                    <VisualState.Setters>
                                        <Setter Target="IconImage.Source" Value="{StaticResource LockIcon_Locked}"/>
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Unlock">
                                    <VisualState.Setters>
                                        <Setter Target="IconImage.Source" Value="{ThemeResource LockIcon_Unlock}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Width" Value="80"/>
    </Style>

</ResourceDictionary>

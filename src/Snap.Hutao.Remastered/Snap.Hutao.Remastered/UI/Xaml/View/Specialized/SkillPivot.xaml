<UserControl
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Specialized.SkillPivot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shmma="using:Snap.Hutao.Remastered.Model.Metadata.Avatar"
    xmlns:shmmc="using:Snap.Hutao.Remastered.Model.Metadata.Converter"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    mc:Ignorable="d">

    <UserControl.Resources>
        <shmmc:SkillIconConverter x:Key="SkillIconConverter"/>
        <!--  ReSharper disable once Xaml.RedundantResource  -->
        <Thickness x:Key="PivotHeaderItemMargin">0,0,16,0</Thickness>
        <Style BasedOn="{StaticResource DefaultPivotHeaderItemStyle}" TargetType="PivotHeaderItem">
            <Setter Property="Height" Value="80"/>
        </Style>

        <DataTemplate x:Key="SkillHeaderTemplate" x:DataType="shmma:Skill">
            <StackPanel
                Background="Transparent"
                Spacing="4"
                ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}">
                <shuxci:CachedImage
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    Source="{x:Bind Icon, Mode=OneWay, Converter={StaticResource SkillIconConverter}}"/>
                <TextBlock
                    HorizontalAlignment="Center"
                    Opacity="0.8"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind Name, Mode=OneWay}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <cwc:Segmented
            HorizontalAlignment="Stretch"
            ItemTemplate="{StaticResource SkillHeaderTemplate}"
            ItemsSource="{x:Bind Skills, Mode=OneWay}"
            SelectedItem="{x:Bind Selected, Mode=TwoWay}"/>
        <ContentPresenter Content="{x:Bind Selected, Mode=OneWay}" ContentTemplate="{x:Bind ItemTemplate}"/>
    </StackPanel>
</UserControl>

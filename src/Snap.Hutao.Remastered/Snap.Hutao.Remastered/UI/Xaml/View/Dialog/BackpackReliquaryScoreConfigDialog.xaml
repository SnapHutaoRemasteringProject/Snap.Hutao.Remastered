<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.BackpackReliquaryScoreConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:wl="using:WinUI.LiquidGlass"
    Title="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigApply}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Width="420" Spacing="12">
        <!--  Preset selector + buttons  -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <wl:LiquidGlassComboBox
                x:Name="PresetComboBox"
                Grid.Column="0"
                shuxcth:ControlMaterialState.IsManaged="True"
                shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                DisplayMemberPath="DisplayName"
                Header="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigPresetHeader}"
                SelectionChanged="OnPresetComboBoxSelectionChanged"/>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <wl:LiquidGlassButton
                    shuxcth:ControlMaterialState.IsManaged="True"
                    Click="OnNewConfigClick"
                    Content="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigNewConfig}"/>
                <wl:LiquidGlassButton
                    x:Name="DeleteButton"
                    shuxcth:ControlMaterialState.IsManaged="True"
                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                    Click="OnDeleteConfigClick"
                    Content="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigDeleteConfig}"
                    Foreground="White"
                    Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!--  Name  -->
        <wl:LiquidGlassTextBox
            x:Name="NameTextBox"
            shuxcth:ControlMaterialState.IsManaged="True"
            Header="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigNameHeader}"
            TextChanged="OnNameTextChanged"/>

        <!--  Weight sliders  -->
        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigWeightsHeader}"/>
        <Grid ColumnSpacing="12" RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!--  Crit Rate  -->
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigCrit}"/>
            <shuxcth:MaterialSwap Grid.Row="0" Grid.Column="1">
                <shuxcth:MaterialSwap.Native>
                    <Slider
                        x:Name="CritSlider"
                        Maximum="1.0"
                        Minimum="0"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </shuxcth:MaterialSwap.Native>
                <shuxcth:MaterialSwap.Glass>
                    <wl:LiquidGlassSlider
                        x:Name="CritSliderGlass"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Maximum="1.0"
                        Minimum="0"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </shuxcth:MaterialSwap.Glass>
            </shuxcth:MaterialSwap>
            <TextBlock
                x:Name="CritLabel"
                Grid.Row="0"
                Grid.Column="2"
                VerticalAlignment="Center"
                TextAlignment="Right"/>

            <!--  Crit Hurt  -->
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigCritHurt}"/>
            <shuxcth:MaterialSwap Grid.Row="1" Grid.Column="1">
                <shuxcth:MaterialSwap.Native>
                    <Slider
                        x:Name="CritHurtSlider"
                        Maximum="1.0"
                        Minimum="0"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </shuxcth:MaterialSwap.Native>
                <shuxcth:MaterialSwap.Glass>
                    <wl:LiquidGlassSlider
                        x:Name="CritHurtSliderGlass"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Maximum="1.0"
                        Minimum="0"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </shuxcth:MaterialSwap.Glass>
            </shuxcth:MaterialSwap>
            <TextBlock
                x:Name="CritHurtLabel"
                Grid.Row="1"
                Grid.Column="2"
                VerticalAlignment="Center"
                TextAlignment="Right"/>

            <!--  ATK%  -->
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigAttackPercent}"/>
            <shuxcth:MaterialSwap Grid.Row="2" Grid.Column="1">
                <shuxcth:MaterialSwap.Native>
                    <Slider
                        x:Name="AttackPercentSlider"
                        Maximum="1.0"
                        Minimum="0"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </shuxcth:MaterialSwap.Native>
                <shuxcth:MaterialSwap.Glass>
                    <wl:LiquidGlassSlider
                        x:Name="AttackPercentSliderGlass"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Maximum="1.0"
                        Minimum="0"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </shuxcth:MaterialSwap.Glass>
            </shuxcth:MaterialSwap>
            <TextBlock
                x:Name="AttackPercentLabel"
                Grid.Row="2"
                Grid.Column="2"
                VerticalAlignment="Center"
                TextAlignment="Right"/>

            <!--  ER  -->
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigChargeEfficiency}"/>
            <shuxcth:MaterialSwap Grid.Row="3" Grid.Column="1">
                <shuxcth:MaterialSwap.Native>
                    <Slider
                        x:Name="ChargeEfficiencySlider"
                        Maximum="1.0"
                        Minimum="0"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </shuxcth:MaterialSwap.Native>
                <shuxcth:MaterialSwap.Glass>
                    <wl:LiquidGlassSlider
                        x:Name="ChargeEfficiencySliderGlass"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Maximum="1.0"
                        Minimum="0"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </shuxcth:MaterialSwap.Glass>
            </shuxcth:MaterialSwap>
            <TextBlock
                x:Name="ChargeEfficiencyLabel"
                Grid.Row="3"
                Grid.Column="2"
                VerticalAlignment="Center"
                TextAlignment="Right"/>

            <!--  EM  -->
            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigElementalMastery}"/>
            <shuxcth:MaterialSwap Grid.Row="4" Grid.Column="1">
                <shuxcth:MaterialSwap.Native>
                    <Slider
                        x:Name="ElementalMasterySlider"
                        Maximum="1.0"
                        Minimum="0"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </shuxcth:MaterialSwap.Native>
                <shuxcth:MaterialSwap.Glass>
                    <wl:LiquidGlassSlider
                        x:Name="ElementalMasterySliderGlass"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Maximum="1.0"
                        Minimum="0"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </shuxcth:MaterialSwap.Glass>
            </shuxcth:MaterialSwap>
            <TextBlock
                x:Name="ElementalMasteryLabel"
                Grid.Row="4"
                Grid.Column="2"
                VerticalAlignment="Center"
                TextAlignment="Right"/>

            <!--  HP%  -->
            <TextBlock
                Grid.Row="5"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigHpPercent}"/>
            <shuxcth:MaterialSwap Grid.Row="5" Grid.Column="1">
                <shuxcth:MaterialSwap.Native>
                    <Slider
                        x:Name="HpPercentSlider"
                        Maximum="1.0"
                        Minimum="0"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </shuxcth:MaterialSwap.Native>
                <shuxcth:MaterialSwap.Glass>
                    <wl:LiquidGlassSlider
                        x:Name="HpPercentSliderGlass"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Maximum="1.0"
                        Minimum="0"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </shuxcth:MaterialSwap.Glass>
            </shuxcth:MaterialSwap>
            <TextBlock
                x:Name="HpPercentLabel"
                Grid.Row="5"
                Grid.Column="2"
                VerticalAlignment="Center"
                TextAlignment="Right"/>

            <!--  DEF%  -->
            <TextBlock
                Grid.Row="6"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigDefensePercent}"/>
            <shuxcth:MaterialSwap Grid.Row="6" Grid.Column="1">
                <shuxcth:MaterialSwap.Native>
                    <Slider
                        x:Name="DefensePercentSlider"
                        Maximum="1.0"
                        Minimum="0"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </shuxcth:MaterialSwap.Native>
                <shuxcth:MaterialSwap.Glass>
                    <wl:LiquidGlassSlider
                        x:Name="DefensePercentSliderGlass"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Maximum="1.0"
                        Minimum="0"
                        StepFrequency="0.1"
                        ValueChanged="OnSliderValueChanged"/>
                </shuxcth:MaterialSwap.Glass>
            </shuxcth:MaterialSwap>
            <TextBlock
                x:Name="DefensePercentLabel"
                Grid.Row="6"
                Grid.Column="2"
                VerticalAlignment="Center"
                TextAlignment="Right"/>
        </Grid>

        <!--  Hint  -->
        <TextBlock
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigFlatHint}"
            TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>

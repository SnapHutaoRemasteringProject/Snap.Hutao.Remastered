        <DataTemplate x:Key="HutaoAnnouncementTemplate" x:DataType="shwhh:Announcement">
            <InfoBar
                Title="{x:Bind Title, Mode=OneWay}"
                Margin="0,0,0,0"
                shuxc:InfoBarHelper.IsTextSelectionEnabled="True"
                CloseButtonCommand="{x:Bind DismissCommand, Mode=OneWay}"
                CloseButtonCommandParameter="{x:Bind Mode=OneWay}"
                IsClosable="{x:Bind CanDismiss, Mode=OneWay}"
                IsOpen="True"
                Message="{x:Bind Content, Mode=OneWay}"
                Severity="{x:Bind Severity, Mode=OneWay}">
                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                    <cwc:SwitchPresenter
                        x:Name="GlassPresenter_2692"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:HyperlinkButton"
                        Visibility="{x:Bind Link, Converter={StaticResource EmptyStringToBoolConverter}, Mode=OneWay}"
                        Value="{x:Bind shuxcth:MaterialBindingSource.Current.HyperlinkButtonMaterial, Mode=OneWay}">
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>0</x:Int32>
                            </cwc:Case.Value>
                            <HyperlinkButton Content="{shuxm:ResourceString Name=ViewPageAnnouncementViewDetails}" NavigateUri="{x:Bind Link, Mode=OneWay}"/>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>1</x:Int32>
                            </cwc:Case.Value>
                            <wl:LiquidGlassHyperlinkButton
                                shuxcth:ControlMaterialState.IsManaged="True"
                                Content="{shuxm:ResourceString Name=ViewPageAnnouncementViewDetails}"
                                NavigateUri="{x:Bind Link, Mode=OneWay}"/>
                        </cwc:Case>
                    </cwc:SwitchPresenter>
                    <TextBlock
                        Margin="8,0,0,2"
                        VerticalAlignment="Center"
                        Opacity="0.7"
                        Text="{x:Bind UpdateTimeFormatted, Mode=OneWay}"/>
                </StackPanel>
            </InfoBar>
        </DataTemplate>

        <DataTemplate x:Key="AnnouncementTemplate" x:DataType="shwhhca:Announcement">
            <ItemContainer cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border Background="{ThemeResource SystemControlAcrylicElementMediumHighBrush}" Style="{StaticResource AcrylicBorderCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <!--  Image Layer  -->
                        <Border cw:UIElementExtensions.ClipToBounds="True" CornerRadius="{ThemeResource ControlCornerRadiusTop}">
                            <Grid>
                                <Border
                                    x:Name="ImageZoomBorder"
                                    VerticalAlignment="Top"
                                    cw:VisualExtensions.NormalizedCenterPoint="0.5">
                                    <cwc:ConstrainedBox
                                        Margin="-4"
                                        AspectRatio="1080:390"
                                        CornerRadius="{ThemeResource ControlCornerRadiusTop}">
                                        <shuxci:CachedImage
                                            VerticalAlignment="Center"
                                            PlaceholderSource="{StaticResource UI_EmotionIcon271}"
                                            Source="{x:Bind Banner, Mode=OneWay}"
                                            Stretch="UniformToFill"/>
                                    </cwc:ConstrainedBox>
                                    <cwa:Explicit.Animations>
                                        <cwa:AnimationSet x:Name="ImageZoomInAnimation">
                                            <shuxma:ImageZoomInAnimation/>
                                        </cwa:AnimationSet>
                                        <cwa:AnimationSet x:Name="ImageZoomOutAnimation">
                                            <shuxma:ImageZoomOutAnimation/>
                                        </cwa:AnimationSet>
                                    </cwa:Explicit.Animations>
                                </Border>
                                <Border Background="{ThemeResource DarkOnlyOverlayMaskColorBrush}" IsHitTestVisible="False"/>
                                <Border
                                    Margin="0,0,4,4"
                                    Padding="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    IsHitTestVisible="False">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{x:Bind TimeDescription, Mode=OneWay}"
                                        Visibility="{x:Bind ShouldShowTimeDescription, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <!--  General Description  -->
                        <Border Grid.Row="1">
                            <StackPanel
                                Margin="4"
                                Padding="4"
                                VerticalAlignment="Bottom"
                                Spacing="6">
                                <TextBlock
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind Subtitle, Mode=OneWay}"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="NoWrap"/>

                                <TextBlock
                                    Opacity="0.6"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextTrimming="WordEllipsis"
                                    TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Tapped">
                            <shuxba:ShowWebView2WindowAction>
                                <shuxba:ShowWebView2WindowAction.ContentProvider>
                                    <shuxvww:AnnouncementWebView2ContentProvider Announcement="{x:Bind Mode=OneWay}"/>
                                </shuxba:ShowWebView2WindowAction.ContentProvider>
                            </shuxba:ShowWebView2WindowAction>
                        </mxi:EventTriggerBehavior>
                        <mxi:EventTriggerBehavior EventName="PointerEntered">
                            <shuxba:StartAnimationActionNoThrow Animation="{x:Bind ImageZoomInAnimation, Mode=OneWay}" TargetObject="{x:Bind ImageZoomBorder, Mode=OneWay}"/>
                        </mxi:EventTriggerBehavior>
                        <mxi:EventTriggerBehavior EventName="PointerExited">
                            <shuxba:StartAnimationActionNoThrow Animation="{x:Bind ImageZoomOutAnimation, Mode=OneWay}" TargetObject="{x:Bind ImageZoomBorder, Mode=OneWay}"/>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                </Border>
            </ItemContainer>
        </DataTemplate>

        <DataTemplate x:Key="AnnouncementPivotItemContentTemplate" x:DataType="shwhhca:AnnouncementListWrapper">
            <ItemsControl ItemTemplate="{StaticResource AnnouncementTemplate}" ItemsSource="{x:Bind List, Mode=OneWay}">

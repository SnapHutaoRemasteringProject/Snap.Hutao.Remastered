    <IsPackable>false</IsPackable>
    <ValidateDatabaseSchemaSources>false</ValidateDatabaseSchemaSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.3.26522.148" />
    <Compile Include="../../src/Snap.Hutao.Remastered/Snap.Hutao.Remastered/Migrations/*.cs" Link="Migrations/%(Filename)%(Extension)" />
    <Compile Include="../../src/Snap.Hutao.Remastered/Snap.Hutao.Remastered/Core/Database/DatabaseSchema.cs" Link="Production/DatabaseSchema.cs" />
    <Compile Include="../../src/Snap.Hutao.Remastered/Snap.Hutao.Remastered/Core/Database/Schema/DatabaseMigrations.g.cs" Link="Production/DatabaseMigrations.g.cs" />
  </ItemGroup>
  <Import Project="../../src/Snap.Hutao.Remastered/Snap.Hutao.Remastered/Build/DatabaseSchema.targets" />
</Project>

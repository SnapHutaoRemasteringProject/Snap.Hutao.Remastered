<Window
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Window.AccountInsightsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup">
    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="DragRegion" Height="36">
            <TextBlock
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{shuxm:ResourceString Name=ViewDialogAccountInsightsTitle}"/>
        </Grid>
        <Grid
            Grid.Row="1"
            Padding="18,10,18,18"
            ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <TextBlock Text="{shuxm:ResourceString Name=ViewDialogAccountInsightsIntro}" TextWrapping="Wrap"/>
                    <TextBlock
                        x:Name="StatusText"
                        Text="{shuxm:ResourceString Name=ViewDialogAccountInsightsLoading}"
                        TextWrapping="Wrap"/>
                    <StackPanel x:Name="ChartsPanel" Spacing="24"/>
                    <Button
                        x:Name="CopyButton"
                        Content="{shuxm:ResourceString Name=ViewDialogAccountInsightsCopy}"
                        IsEnabled="False"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewDialogAccountInsightsAnalysisHeading}"/>
                    <Button x:Name="PrivacyInfoButton" Padding="6" AutomationProperties.Name="{shuxm:ResourceString Name=ViewDialogAccountInsightsPrivacyTitle}"><FontIcon FontSize="14" Glyph="&#xE946;"/></Button>
                    <Button x:Name="GenerateButton" Content="{shuxm:ResourceString Name=ViewDialogAccountInsightsGenerate}" IsEnabled="False"/>
                    <Button x:Name="AgentSettingsButton" Content="{shuxm:ResourceString Name=ViewDialogAccountInsightsModelSettings}">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"><Setter Property="MaxWidth" Value="1000"/><Setter Property="MaxHeight" Value="720"/></Style></Flyout.FlyoutPresenterStyle>
                                <shuxc:AgentSettingsView x:Name="AgentSettingsEditor" Width="840" Height="600"/>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <shuxc:AgentWorkspaceView x:Name="AgentWorkspace" Grid.Row="1" IsEnabled="False"/>
                <TeachingTip x:Name="PrivacyTeachingTip" Title="{shuxm:ResourceString Name=ViewDialogAccountInsightsPrivacyTitle}" IsLightDismissEnabled="True" Subtitle="{shuxm:ResourceString Name=ViewDialogAccountInsightsChatPrivacyBody}" Target="{x:Bind PrivacyInfoButton}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>

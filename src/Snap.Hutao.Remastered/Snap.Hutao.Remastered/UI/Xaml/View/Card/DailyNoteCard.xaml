<shuxcth:MaterialCardButton
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Card.DailyNoteCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shme="using:Snap.Hutao.Remastered.Model.Entity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvd="using:Snap.Hutao.Remastered.ViewModel.DailyNote"
    Height="{ThemeResource HomeAdaptiveCardHeight}"
    Padding="0"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    d:DataContext="{d:DesignInstance shvd:DailyNoteViewModelSlim}"
    Background="Transparent"
    BorderBrush="{x:Null}"
    BorderThickness="0"
    Command="{x:Bind ((shvd:DailyNoteViewModelSlim)DataContext).NavigateCommand, Mode=OneWay}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shvd:DailyNoteViewModelSlim)DataContext).LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <shuxcth:MaterialCardButton.Resources>
        <DataTemplate x:Key="DailyNoteTemplate" x:DataType="shme:DailyNoteEntry">
            <Grid
                Margin="12"
                ColumnSpacing="6"
                RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Height="48"
                    Padding="12"
                    Style="{ThemeResource GridShimmerStyle}">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Image
                            Width="24"
                            Height="24"
                            Margin="-4"
                            Source="ms-appx:///Resource/Navigation/DailyNote.png"/>

                        <TextBlock Text="{x:Bind Uid, Mode=OneWay}"/>
                    </StackPanel>

                    <TextBlock
                        Margin="0,0,34,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{x:Bind RefreshTimeFormatted, Mode=OneWay}"/>
                </Grid>


                <shuxcc:CardBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    DotVisibility="{x:Bind ResinDotVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                    IconSquareLength="64"
                    ImageSource="{StaticResource UI_ItemIcon_106}"
                    Text="{x:Bind DailyNote.FormattedResin, FallbackValue={x:Null}, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind DailyNote.ResinRecoveryTargetTime, Mode=OneWay}"/>

                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <shuxcc:CardBlock
                        Grid.Row="0"
                        DotVisibility="{x:Bind HomeCoinDotVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        ImageSource="{StaticResource UI_ItemIcon_204}"
                        Text="{x:Bind DailyNote.FormattedHomeCoin, FallbackValue={x:Null}, Mode=OneWay}"/>
                    <shuxcc:CardBlock
                        Grid.Row="1"
                        DotVisibility="{x:Bind DailyTaskDotVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        ImageSource="{StaticResource UI_MarkQuest_Events_Proce}"
                        Text="{x:Bind DailyNote.FormattedTask, FallbackValue={x:Null}, Mode=OneWay}"/>
                </Grid>
                <Grid
                    Grid.Row="1"
                    Grid.Column="2"
                    RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <shuxcc:CardBlock
                        Grid.Row="0"
                        ImageSource="{StaticResource UI_MarkTower}"
                        Text="{x:Bind DailyNote.FormattedResinDiscount, FallbackValue={x:Null}, Mode=OneWay}"/>
                    <shuxcc:CardBlock
                        Grid.Row="1"
                        DotVisibility="{x:Bind TransformerDotVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        ImageSource="{StaticResource UI_ItemIcon_220021}"
                        Text="{x:Bind DailyNote.Transformer.ObtainedAndReachedFormatted, FallbackValue={x:Null}, Mode=OneWay}"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </shuxcth:MaterialCardButton.Resources>

    <Grid>
        <Grid Visibility="{x:Bind ((shvd:DailyNoteViewModelSlim)DataContext).IsInitialized, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <Grid Visibility="{x:Bind ((shvd:DailyNoteViewModelSlim)DataContext).DailyNoteEntries.Count, FallbackValue=Collapsed, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}">
                <FlipView
                    x:Name="RootFlipView"
                    Background="{x:Null}"
                    ItemTemplate="{StaticResource DailyNoteTemplate}"
                    ItemsSource="{x:Bind ((shvd:DailyNoteViewModelSlim)DataContext).DailyNoteEntries, Mode=OneWay}"/>

                <PipsPager
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    NumberOfPages="{x:Bind ((shvd:DailyNoteViewModelSlim)DataContext).DailyNoteEntries.Count, FallbackValue=0, Mode=OneWay}"
                    SelectedPageIndex="{x:Bind Path=RootFlipView.SelectedIndex, Mode=TwoWay}"/>

                <Button
                    MinWidth="0"
                    MinHeight="0"
                    Margin="0,23,24,0"
                    Padding="6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    BorderThickness="0"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsRefreshing, Converter={StaticResource BoolNegationConverter}}"
                    Style="{ThemeResource DefaultButtonStyle}"
                    ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageDailyNoteRefresh}">
                    <Button.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="ButtonBackground" ResourceKey="ControlFillColorTransparentBrush"/>
                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="ControlFillColorTransparentBrush"/>
                                    <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush"/>
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Dark">
                                    <StaticResource x:Key="ButtonBackground" ResourceKey="ControlFillColorTransparentBrush"/>
                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="ControlFillColorTransparentBrush"/>
                                    <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush"/>
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </Button.Resources>
                    <Grid>
                        <FontIcon
                            FontSize="14"
                            Glyph="{StaticResource FontIconContentRefresh}"
                            Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibilityRevertConverter}}"/>
                        <ProgressRing
                            Width="14"
                            Height="14"
                            IsActive="{Binding IsRefreshing}"
                            Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Button>
            </Grid>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ((shvd:DailyNoteViewModelSlim)DataContext).DailyNoteEntries.Count, FallbackValue=Collapsed, Converter={StaticResource Int32ToVisibilityRevertConverter}, Mode=OneWay}">
                <Image
                    Width="80"
                    Height="80"
                    Source="ms-appx:///Resource/Navigation/DailyNote.png"/>
                <TextBlock HorizontalAlignment="Center" Text="{shuxm:ResourceString Name=ViewDailyNoteHeader}"/>
            </StackPanel>
        </Grid>

        <shuxc:Loading IsLoading="{x:Bind ((shvd:DailyNoteViewModelSlim)DataContext).IsInitialized, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" Style="{ThemeResource DefaultLoadingCardStyle}"/>
    </Grid>
</shuxcth:MaterialCardButton>

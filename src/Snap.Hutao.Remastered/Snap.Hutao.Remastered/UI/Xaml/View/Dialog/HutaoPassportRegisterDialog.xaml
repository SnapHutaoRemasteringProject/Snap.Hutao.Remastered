<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.HutaoPassportRegisterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:wl="using:WinUI.LiquidGlass"
    Title="{shuxm:ResourceString Name=ViewDialogHutaoPassportRegisterTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind IsAgreed.Value, Mode=OneWay, FallbackValue=False}"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Margin="0,8,0,0" Spacing="16">
        <cwc:SwitchPresenter
            x:Name="GlassPresenter_929"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:TextBox"
            Value="{x:Bind shuxcth:MaterialBindingSource.Current.TextBoxMaterial, Mode=OneWay}">
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>0</x:Int32>
                </cwc:Case.Value>
                <TextBox
                    InputScope="EmailSmtpAddress"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{shuxm:ResourceString Name=ViewPageHutaoPassportUserNameHint}"
                    Text="{x:Bind UserName, Mode=TwoWay}"/>
            </cwc:Case>
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>1</x:Int32>
                </cwc:Case.Value>
                <wl:LiquidGlassTextBox
                    shuxcth:ControlMaterialState.IsManaged="True"
                    InputScope="EmailSmtpAddress"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{shuxm:ResourceString Name=ViewPageHutaoPassportUserNameHint}"
                    Text="{x:Bind UserName, Mode=TwoWay}"/>
            </cwc:Case>
        </cwc:SwitchPresenter>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <cwc:SwitchPresenter
                x:Name="GlassPresenter_1370"
                Grid.Column="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:TextBox"
                Value="{x:Bind shuxcth:MaterialBindingSource.Current.TextBoxMaterial, Mode=OneWay}">
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>0</x:Int32>
                    </cwc:Case.Value>
                    <TextBox PlaceholderText="{shuxm:ResourceString Name=ViewPageHutaoPassportVerifyCodeHint}" Text="{x:Bind VerifyCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </cwc:Case>
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>1</x:Int32>
                    </cwc:Case.Value>
                    <wl:LiquidGlassTextBox
                        shuxcth:ControlMaterialState.IsManaged="True"
                        PlaceholderText="{shuxm:ResourceString Name=ViewPageHutaoPassportVerifyCodeHint}"
                        Text="{x:Bind VerifyCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </cwc:Case>
            </cwc:SwitchPresenter>
            <cwc:SwitchPresenter
                x:Name="GlassPresenter_1616"
                Grid.Column="1"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:Button"
                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>0</x:Int32>
                    </cwc:Case.Value>
                    <Button
                        VerticalAlignment="Stretch"
                        Command="{x:Bind VerifyCommand}"
                        Content="{shuxm:ResourceString Name=ViewPageHutaoPassportVerifyCodeAction}"/>
                </cwc:Case>
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>1</x:Int32>
                    </cwc:Case.Value>
                    <wl:LiquidGlassButton
                        VerticalAlignment="Stretch"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Command="{x:Bind VerifyCommand}"
                        Content="{shuxm:ResourceString Name=ViewPageHutaoPassportVerifyCodeAction}"/>
                </cwc:Case>
            </cwc:SwitchPresenter>
        </Grid>
        <StackPanel Spacing="4" Visibility="{x:Bind VerifyCode, Converter={StaticResource EmptyStringToVisibilityConverter}, Mode=OneWay}">
            <cwc:SwitchPresenter
                x:Name="GlassPresenter_2011"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:PasswordBox"
                Visibility="{x:Bind GlassNative_2011.Visibility, Mode=OneWay}"
                Value="{x:Bind shuxcth:MaterialBindingSource.Current.PasswordBoxMaterial, Mode=OneWay}">
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>0</x:Int32>
                    </cwc:Case.Value>
                    <PasswordBox
                        x:Name="GlassNative_2011"
                        DataContext="{x:Bind GlassPresenter_2011.DataContext, Mode=OneWay}"
                        IsEnabled="{x:Bind VerifyCode, Converter={StaticResource EmptyStringToBoolConverter}, Mode=OneWay}"
                        Password="{x:Bind Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PasswordChar="*"
                        PlaceholderText="{shuxm:ResourceString Name=ViewPageHutaoPassportPasswordHint}"
                        shuxcth:ThemeSynchronization.Source="{x:Bind GlassPresenter_2011}"/>
                </cwc:Case>
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>1</x:Int32>
                    </cwc:Case.Value>
                    <wl:LiquidGlassPasswordBox
                        x:Name="GlassNative_2011Glass"
                        Width="{x:Bind GlassNative_2011.Width, Mode=OneWay}"
                        Height="{x:Bind GlassNative_2011.Height, Mode=OneWay}"
                        MinWidth="{x:Bind GlassNative_2011.MinWidth, Mode=OneWay}"
                        MinHeight="{x:Bind GlassNative_2011.MinHeight, Mode=OneWay}"
                        MaxWidth="{x:Bind GlassNative_2011.MaxWidth, Mode=OneWay}"
                        MaxHeight="{x:Bind GlassNative_2011.MaxHeight, Mode=OneWay}"
                        Padding="{x:Bind GlassNative_2011.Padding, Mode=OneWay}"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassNative_2011, Mode=OneWay}"
                        shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                        BorderThickness="{x:Bind GlassNative_2011.BorderThickness, Mode=OneWay}"
                        FlowDirection="{x:Bind GlassNative_2011.FlowDirection, Mode=OneWay}"
                        FontFamily="{x:Bind GlassNative_2011.FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind GlassNative_2011.FontSize, Mode=OneWay}"
                        FontStyle="{x:Bind GlassNative_2011.FontStyle, Mode=OneWay}"
                        FontWeight="{x:Bind GlassNative_2011.FontWeight, Mode=OneWay}"
                        IsEnabled="{x:Bind GlassNative_2011.IsEnabled, Mode=OneWay}"
                        Password="{x:Bind GlassNative_2011.Password, Mode=TwoWay}"
                        PlaceholderText="{x:Bind GlassNative_2011.PlaceholderText, Mode=OneWay}"/>
                </cwc:Case>
            </cwc:SwitchPresenter>
            <TextBlock
                Opacity="0.7"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{shuxm:ResourceString Name=ViewPageHutaoPassportPasswordRequirementHint}"/>
        </StackPanel>
        <cwc:SwitchPresenter
            x:Name="GlassPresenter_2610"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:CheckBox"
            Value="{x:Bind shuxcth:MaterialBindingSource.Current.CheckBoxMaterial, Mode=OneWay}">
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>0</x:Int32>
                </cwc:Case.Value>
                <CheckBox IsChecked="{x:Bind IsAgreed, Mode=TwoWay}">
                    <TextBlock Text="{shuxm:ResourceString Name=ViewPageHutaoPassportRegisterAgreement}"/>
                </CheckBox>
            </cwc:Case>
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>1</x:Int32>
                </cwc:Case.Value>
                <wl:LiquidGlassCheckBox shuxcth:ControlMaterialState.IsManaged="True" IsChecked="{x:Bind IsAgreed, Mode=TwoWay}">
                    <TextBlock Text="{shuxm:ResourceString Name=ViewPageHutaoPassportRegisterAgreement}"/>
                </wl:LiquidGlassCheckBox>
            </cwc:Case>
        </cwc:SwitchPresenter>
    </StackPanel>
</ContentDialog>

<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.PluginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:clw="using:CommunityToolkit.Labs.WinUI"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwconv="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Snap.Hutao.Remastered.UI.Xaml.View.Page"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvp="using:Snap.Hutao.Remastered.ViewModel.Plugin"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance shvp:PluginViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shvp:PluginViewModel)DataContext).LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <!--  ReSharper disable Xaml.RedundantResource  -->
        <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="SettingsCardBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="SettingsCardBackgroundDisabled" Color="Transparent"/>
        <SolidColorBrush x:Key="SettingsCardBackgroundPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="SettingsCardBackgroundPressed" Color="Transparent"/>
        <!--  ReSharper restore Xaml.RedundantResource  -->

        <Style
            x:Key="DangerButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCritical}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCritical}"/>
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimary}"/>
        </Style>

        <cwconv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <cwconv:BoolNegationConverter x:Key="BoolNegationConverter"/>
        <cwconv:BoolToObjectConverter
            x:Key="BoolToPluginStatusConverter"
            FalseValue="{shuxm:ResourceString Name=ViewPagePluginStatusDisabled}"
            TrueValue="{shuxm:ResourceString Name=ViewPagePluginStatusEnabled}"/>
        <local:ListToStringConverter x:Key="ListToStringConverter"/>

        <DataTemplate x:Key="PluginItemTemplate">
            <Border Padding="12" Style="{ThemeResource BorderCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!--  插件图标  -->
                    <Border
                        Grid.Column="0"
                        Width="48"
                        Height="48"
                        Margin="0,0,12,0"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <Grid>
                            <Image
                                Source="{Binding IconPath}"
                                Stretch="Uniform"
                                Visibility="{Binding IconPath, Converter={StaticResource StringToVisibilityConverter}}"/>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="📦"
                                Visibility="{Binding IconPath, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverted}"/>
                        </Grid>
                    </Border>

                    <!--  插件信息  -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Manifest.Name}"/>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{Binding Manifest.Description}"/>
                        <StackPanel
                            Margin="0,4,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding Manifest.Version}"/>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="•"/>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding Manifest.Author, Converter={StaticResource ListToStringConverter}}"/>
                            <TextBlock
                                Foreground="{Binding IsEnabled, Converter={StaticResource BoolToColorConverter}}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding IsEnabled, Converter={StaticResource BoolToPluginStatusConverter}}"/>
                        </StackPanel>
                    </StackPanel>

                    <!--  操作按钮  -->
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_6594"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:Button"
                            Visibility="{Binding IsEnabled, Converter={StaticResource BoolNegationConverter}}"
                            Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <Button
                                    Command="{Binding ElementName=Root, Path=DataContext.EnablePluginCommand}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginEnableButton}"/>
                                    </StackPanel>
                                </Button>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassButton
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    Command="{Binding ElementName=Root, Path=DataContext.EnablePluginCommand}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginEnableButton}"/>
                                    </StackPanel>
                                </wl:LiquidGlassButton>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_7230"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:Button"
                            Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                            Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <Button
                                    Command="{Binding ElementName=Root, Path=DataContext.DisablePluginCommand}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DangerButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginDisableButton}"/>
                                    </StackPanel>
                                </Button>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassButton
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    Command="{Binding ElementName=Root, Path=DataContext.DisablePluginCommand}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DangerButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginDisableButton}"/>
                                    </StackPanel>
                                </wl:LiquidGlassButton>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_7872"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:Button"
                            Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <Button
                                    Command="{Binding ElementName=Root, Path=DataContext.OpenPluginSettingsCommand}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DefaultButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE713;"/>
                                        <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginSettingsButton}"/>
                                    </StackPanel>
                                </Button>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassButton
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    Command="{Binding ElementName=Root, Path=DataContext.OpenPluginSettingsCommand}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DefaultButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE713;"/>
                                        <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginSettingsButton}"/>
                                    </StackPanel>
                                </wl:LiquidGlassButton>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_8467"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:Button"
                            Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <Button
                                    Command="{Binding ElementName=Root, Path=DataContext.UninstallPluginCommand}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DefaultButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;"/>
                                        <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginUninstallButton}"/>
                                    </StackPanel>
                                </Button>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassButton
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    Command="{Binding ElementName=Root, Path=DataContext.UninstallPluginCommand}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DefaultButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;"/>
                                        <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginUninstallButton}"/>
                                    </StackPanel>
                                </wl:LiquidGlassButton>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <cwconv:BoolToObjectConverter x:Key="BoolToColorConverter">
            <cwconv:BoolToObjectConverter.TrueValue>
                <SolidColorBrush Color="{ThemeResource SystemFillColorSuccess}"/>
            </cwconv:BoolToObjectConverter.TrueValue>
            <cwconv:BoolToObjectConverter.FalseValue>
                <SolidColorBrush Color="{ThemeResource SystemFillColorCritical}"/>
            </cwconv:BoolToObjectConverter.FalseValue>
        </cwconv:BoolToObjectConverter>

        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Page.Resources>

    <Grid x:Name="Root">
        <shuxc:StandardView ShowCondition="{x:Bind ((shvp:PluginViewModel)DataContext).IsInitialized, Mode=OneWay}">
            <shuxc:StandardView.EmptyContent>
                <clw:Shimmer IsActive="{x:Bind ((shvp:PluginViewModel)DataContext).IsInitialized, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"/>
            </shuxc:StandardView.EmptyContent>

            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--  操作工具栏  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,16"
                    cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <StackPanel
                            Padding="16"
                            Orientation="Horizontal"
                            Spacing="12">
                            <cwc:SwitchPresenter
                                x:Name="GlassPresenter_10751"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsTabStop="False"
                                Tag="LiquidGlass:Button"
                                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>0</x:Int32>
                                    </cwc:Case.Value>
                                    <Button
                                        Command="{x:Bind ((shvp:PluginViewModel)DataContext).InstallPluginCommand, Mode=OneWay}"
                                        Content="{shuxm:ResourceString Name=ViewPagePluginInstallButton}"
                                        Style="{StaticResource AccentButtonStyle}">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE710;"/>
                                                    <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginInstallButton}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                </cwc:Case>
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>1</x:Int32>
                                    </cwc:Case.Value>
                                    <wl:LiquidGlassButton
                                        shuxcth:ControlMaterialState.IsManaged="True"
                                        Command="{x:Bind ((shvp:PluginViewModel)DataContext).InstallPluginCommand, Mode=OneWay}"
                                        Content="{shuxm:ResourceString Name=ViewPagePluginInstallButton}"
                                        Style="{StaticResource AccentButtonStyle}">
                                        <wl:LiquidGlassButton.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE710;"/>
                                                    <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginInstallButton}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </wl:LiquidGlassButton.ContentTemplate>
                                    </wl:LiquidGlassButton>
                                </cwc:Case>
                            </cwc:SwitchPresenter>

                            <cwc:SwitchPresenter
                                x:Name="GlassPresenter_11628"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsTabStop="False"
                                Tag="LiquidGlass:Button"
                                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>0</x:Int32>
                                    </cwc:Case.Value>
                                    <Button
                                        Command="{x:Bind ((shvp:PluginViewModel)DataContext).RefreshPluginsCommand, Mode=OneWay}"
                                        Content="{shuxm:ResourceString Name=ViewPagePluginRefreshButton}"
                                        Style="{StaticResource DefaultButtonStyle}">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE72C;"/>
                                                    <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginRefreshButton}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                </cwc:Case>
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>1</x:Int32>
                                    </cwc:Case.Value>
                                    <wl:LiquidGlassButton
                                        shuxcth:ControlMaterialState.IsManaged="True"
                                        Command="{x:Bind ((shvp:PluginViewModel)DataContext).RefreshPluginsCommand, Mode=OneWay}"
                                        Content="{shuxm:ResourceString Name=ViewPagePluginRefreshButton}"
                                        Style="{StaticResource DefaultButtonStyle}">
                                        <wl:LiquidGlassButton.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE72C;"/>
                                                    <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginRefreshButton}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </wl:LiquidGlassButton.ContentTemplate>
                                    </wl:LiquidGlassButton>
                                </cwc:Case>
                            </cwc:SwitchPresenter>

                            <cwc:SwitchPresenter
                                x:Name="GlassPresenter_12507"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsTabStop="False"
                                Tag="LiquidGlass:Button"
                                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>0</x:Int32>
                                    </cwc:Case.Value>
                                    <Button
                                        Command="{x:Bind ((shvp:PluginViewModel)DataContext).OpenPluginDirectoryCommand, Mode=OneWay}"
                                        Content="{shuxm:ResourceString Name=ViewPagePluginOpenDirectoryButton}"
                                        Style="{StaticResource DefaultButtonStyle}">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8DA;"/>
                                                    <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginOpenDirectoryButton}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                </cwc:Case>
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>1</x:Int32>
                                    </cwc:Case.Value>
                                    <wl:LiquidGlassButton
                                        shuxcth:ControlMaterialState.IsManaged="True"
                                        Command="{x:Bind ((shvp:PluginViewModel)DataContext).OpenPluginDirectoryCommand, Mode=OneWay}"
                                        Content="{shuxm:ResourceString Name=ViewPagePluginOpenDirectoryButton}"
                                        Style="{StaticResource DefaultButtonStyle}">
                                        <wl:LiquidGlassButton.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8DA;"/>
                                                    <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginOpenDirectoryButton}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </wl:LiquidGlassButton.ContentTemplate>
                                    </wl:LiquidGlassButton>
                                </cwc:Case>
                            </cwc:SwitchPresenter>

                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{shuxm:ResourceString Name=ViewPagePluginTotalText}"/>
                                <Run Text="{x:Bind ((shvp:PluginViewModel)DataContext).Plugins.Count, Mode=OneWay}"/>
                                <Run Text="{shuxm:ResourceString Name=ViewPagePluginCountText}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Border>

                <!--  插件列表  -->
                <Border Grid.Row="1" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Grid Style="{ThemeResource AcrylicGridCardStyle}">
                        <shuxc:StandardView ShowCondition="{x:Bind ((shvp:PluginViewModel)DataContext).Plugins.Count, Converter={StaticResource Int32ToBoolConverter}, Mode=OneWay}">
                            <shuxc:StandardView.EmptyContent>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="16">
                                    <shuxci:CachedImage Height="120" Source="{StaticResource UI_EmotionIcon776}"/>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{shuxm:ResourceString Name=ViewPagePluginEmptyTitle}"/>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{shuxm:ResourceString Name=ViewPagePluginEmptyDescription}"/>
                                </StackPanel>
                            </shuxc:StandardView.EmptyContent>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    ItemContainerTransitions="{ThemeResource ListViewLikeThemeTransitions}"
                                    ItemTemplate="{StaticResource PluginItemTemplate}"
                                    ItemsPanel="{ThemeResource StackPanelSpacing8Template}"
                                    ItemsSource="{x:Bind ((shvp:PluginViewModel)DataContext).Plugins, Mode=OneWay}"/>
                            </ScrollViewer>
                        </shuxc:StandardView>
                    </Grid>
                </Border>
            </Grid>
        </shuxc:StandardView>
    </Grid>
</shuxc:ScopedPage>

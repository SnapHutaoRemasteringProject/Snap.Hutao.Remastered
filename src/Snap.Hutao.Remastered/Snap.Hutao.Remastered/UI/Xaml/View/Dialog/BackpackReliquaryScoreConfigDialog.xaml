<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.BackpackReliquaryScoreConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    Title="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigApply}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="12" Width="420">
        <!-- Preset selector + buttons -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox
                Grid.Column="0"
                x:Name="PresetComboBox"
                DisplayMemberPath="DisplayName"
                Header="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigPresetHeader}"
                SelectionChanged="OnPresetComboBoxSelectionChanged"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button
                    Click="OnNewConfigClick"
                    Content="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigNewConfig}"/>
                <Button
                    x:Name="DeleteButton"
                    Click="OnDeleteConfigClick"
                    Content="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigDeleteConfig}"
                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                    Foreground="White"
                    Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- Name -->
        <TextBox
            x:Name="NameTextBox"
            Header="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigNameHeader}"
            TextChanged="OnNameTextChanged"/>

        <!-- Weight sliders -->
        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                   Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigWeightsHeader}"/>
        <Grid ColumnSpacing="12" RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Crit Rate -->
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigCrit}"/>
            <Slider
                Grid.Row="0"
                Grid.Column="1"
                x:Name="CritSlider"
                Minimum="0"
                Maximum="1.0"
                StepFrequency="0.1"
                ValueChanged="OnSliderValueChanged"/>
            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                x:Name="CritLabel"
                VerticalAlignment="Center"
                TextAlignment="Right"/>

            <!-- Crit Hurt -->
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigCritHurt}"/>
            <Slider
                Grid.Row="1"
                Grid.Column="1"
                x:Name="CritHurtSlider"
                Minimum="0"
                Maximum="1.0"
                StepFrequency="0.1"
                ValueChanged="OnSliderValueChanged"/>
            <TextBlock
                Grid.Row="1"
                Grid.Column="2"
                x:Name="CritHurtLabel"
                VerticalAlignment="Center"
                TextAlignment="Right"/>

            <!-- ATK% -->
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigAttackPercent}"/>
            <Slider
                Grid.Row="2"
                Grid.Column="1"
                x:Name="AttackPercentSlider"
                Minimum="0"
                Maximum="1.0"
                StepFrequency="0.1"
                ValueChanged="OnSliderValueChanged"/>
            <TextBlock
                Grid.Row="2"
                Grid.Column="2"
                x:Name="AttackPercentLabel"
                VerticalAlignment="Center"
                TextAlignment="Right"/>

            <!-- ER -->
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigChargeEfficiency}"/>
            <Slider
                Grid.Row="3"
                Grid.Column="1"
                x:Name="ChargeEfficiencySlider"
                Minimum="0"
                Maximum="1.0"
                StepFrequency="0.1"
                ValueChanged="OnSliderValueChanged"/>
            <TextBlock
                Grid.Row="3"
                Grid.Column="2"
                x:Name="ChargeEfficiencyLabel"
                VerticalAlignment="Center"
                TextAlignment="Right"/>

            <!-- EM -->
            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigElementalMastery}"/>
            <Slider
                Grid.Row="4"
                Grid.Column="1"
                x:Name="ElementalMasterySlider"
                Minimum="0"
                Maximum="1.0"
                StepFrequency="0.1"
                ValueChanged="OnSliderValueChanged"/>
            <TextBlock
                Grid.Row="4"
                Grid.Column="2"
                x:Name="ElementalMasteryLabel"
                VerticalAlignment="Center"
                TextAlignment="Right"/>

            <!-- HP% -->
            <TextBlock
                Grid.Row="5"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigHpPercent}"/>
            <Slider
                Grid.Row="5"
                Grid.Column="1"
                x:Name="HpPercentSlider"
                Minimum="0"
                Maximum="1.0"
                StepFrequency="0.1"
                ValueChanged="OnSliderValueChanged"/>
            <TextBlock
                Grid.Row="5"
                Grid.Column="2"
                x:Name="HpPercentLabel"
                VerticalAlignment="Center"
                TextAlignment="Right"/>

            <!-- DEF% -->
            <TextBlock
                Grid.Row="6"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigDefensePercent}"/>
            <Slider
                Grid.Row="6"
                Grid.Column="1"
                x:Name="DefensePercentSlider"
                Minimum="0"
                Maximum="1.0"
                StepFrequency="0.1"
                ValueChanged="OnSliderValueChanged"/>
            <TextBlock
                Grid.Row="6"
                Grid.Column="2"
                x:Name="DefensePercentLabel"
                VerticalAlignment="Center"
                TextAlignment="Right"/>
        </Grid>

        <!-- Hint -->
        <TextBlock
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{shuxm:ResourceString Name=ViewDialogBackpackReliquaryScoreConfigFlatHint}"
            TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>

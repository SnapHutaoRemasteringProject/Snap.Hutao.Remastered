                    <Rectangle
                        Grid.Row="3"
                        Height="1"
                        Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                    <ItemsControl
                        Grid.Row="4"
                        Margin="0,12"
                        ItemTemplate="{StaticResource AvatarReliquarySubPropertyTemplate}"
                        ItemsPanel="{ThemeResource StackPanelSpacing12Template}"
                        ItemsSource="{x:Bind ComposedSubProperties, Mode=OneWay}"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="TokenTemplate" x:DataType="shuxca:SearchToken">
                <Grid Height="22" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Grid.Column="0"
                        Width="12"
                        Height="12"
                        Margin="1,1,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Visibility="{x:Bind Quality, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{x:Bind QualityColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <shuxci:CachedImage
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="-3,2,7,0"
                        ShowAsMonoChrome="True"
                        Source="{x:Bind IconUri, Mode=OneTime}"
                        Visibility="{x:Bind IconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}"/>
                    <shuxci:CachedImage
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="-4,-2,8,2"
                        Source="{x:Bind SideIconUri, Mode=OneTime}"
                        Visibility="{x:Bind SideIconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}"/>
                    <TextBlock
                        Grid.Column="1"
                        Height="20"
                        VerticalAlignment="Center"
                        Text="{x:Bind Value, Mode=OneTime}"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="PromoteArrayTemplate" x:DataType="x:Boolean">
                <Grid>
                    <BitmapIcon
                        Width="12"
                        Foreground="#FFFFFFFF"
                        UriSource="ms-appx:///Resource/Icon/UI_IconKira.png"
                        Visibility="{Binding Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>

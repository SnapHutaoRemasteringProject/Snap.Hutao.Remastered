<UserControl
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.InfoBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:clw="using:CommunityToolkit.Labs.WinUI"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shsn="using:Snap.Hutao.Remastered.Service.Notification"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shuxv="using:Snap.Hutao.Remastered.UI.Xaml.View"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance Type=shuxv:InfoBarView}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="InfoBarTemplate" x:DataType="shsn:InfoBarOptions">
            <InfoBar
                Title="{x:Bind Title, Mode=OneWay}"
                shuxc:InfoBarHelper.IsTextSelectionEnabled="{x:Bind IsTextSelectionEnabled, Mode=OneWay}"
                Closed="OnInfoBarClosed"
                Content="{x:Bind Content, Mode=OneWay}"
                IsOpen="True"
                Message="{x:Bind Message, Mode=OneWay}"
                Severity="{x:Bind Severity, Mode=OneWay}">
                <mxi:Interaction.Behaviors>
                    <shuxb:InfoBarDelayCloseBehavior MilliSecondsDelay="{x:Bind MilliSecondsDelay, Mode=OneWay}"/>
                </mxi:Interaction.Behaviors>
            </InfoBar>
        </DataTemplate>

        <DataTemplate x:Key="InfoBarWithActionButtonTemplate" x:DataType="shsn:InfoBarOptions">
            <InfoBar
                Title="{x:Bind Title, Mode=OneWay}"
                shuxc:InfoBarHelper.IsTextSelectionEnabled="{x:Bind IsTextSelectionEnabled, Mode=OneWay}"
                Closed="OnInfoBarClosed"
                Content="{x:Bind Content, Mode=OneWay}"
                IsOpen="True"
                Message="{x:Bind Message, Mode=OneWay}"
                Severity="{x:Bind Severity, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Binding
                        Mode="OneWay"
                        Path="ButtonMaterial"
                        Source="{StaticResource ControlMaterialState}">
                        <Binding.Converter>
                            <shuxcth:ControlMaterialSelector>
                                <shuxcth:ControlMaterialSelector.Native>
                                    <Button Command="{x:Bind ActionButtonCommand, Mode=OneWay}" Content="{x:Bind ActionButtonContent, Mode=OneWay}"/>
                                </shuxcth:ControlMaterialSelector.Native>
                                <shuxcth:ControlMaterialSelector.Glass>
                                    <wl:LiquidGlassButton
                                        shuxcth:ControlMaterialState.IsManaged="True"
                                        Command="{x:Bind ActionButtonCommand, Mode=OneWay}"
                                        Content="{x:Bind ActionButtonContent, Mode=OneWay}"/>
                                </shuxcth:ControlMaterialSelector.Glass>
                            </shuxcth:ControlMaterialSelector>
                        </Binding.Converter>
                    </Binding>
                </InfoBar.ActionButton>
                <mxi:Interaction.Behaviors>
                    <shuxb:InfoBarDelayCloseBehavior MilliSecondsDelay="{x:Bind MilliSecondsDelay, Mode=OneWay}"/>
                </mxi:Interaction.Behaviors>
            </InfoBar>
        </DataTemplate>

        <shuxc:InfoBarTemplateSelector
            x:Key="InfoBarTemplateSelector"
            ActionButtonDisabled="{StaticResource InfoBarTemplate}"
            ActionButtonEnabled="{StaticResource InfoBarWithActionButtonTemplate}"/>

        <cw:TransitionHelper
            x:Key="InfoBarPanelTransitionHelper"
            x:Name="InfoBarPanelTransitionHelper"
            DefaultEasingMode="EaseOut"
            DefaultEasingType="Cubic"
            Duration="0:0:0.2">
            <cw:TransitionConfig Id="Body" ScaleMode="ScaleX"/>
            <cw:TransitionConfig Id="Header" ScaleMode="ScaleX"/>
        </cw:TransitionHelper>
    </UserControl.Resources>

    <Grid Name="VisibilityRoot" Visibility="Collapsed">

        <Border
            x:Name="ShowButtonBorder"
            Margin="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            cw:TransitionHelper.Id="Body"
            Background="{ThemeResource SystemControlAcrylicElementBrush}"
            CornerRadius="{ThemeResource ControlCornerRadius}">
            <cwc:SwitchPresenter
                x:Name="GlassPresenter_3551"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:Button"
                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>0</x:Int32>
                    </cwc:Case.Value>
                    <Button>
                        <mxi:Interaction.Behaviors>
                            <mxi:EventTriggerBehavior EventName="Click">
                                <cw:StartTransitionAction
                                    Source="{x:Bind ShowButtonBorder}"
                                    Target="{x:Bind InfoBarItemsBorder}"
                                    Transition="{StaticResource InfoBarPanelTransitionHelper}"/>
                            </mxi:EventTriggerBehavior>
                        </mxi:Interaction.Behaviors>
                        <Grid cw:TransitionHelper.Id="Header">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition MinWidth="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,6,0" Text="{shuxm:ResourceString Name=ViewInfoBarToggleTitle}"/>
                            <InfoBadge
                                Grid.Column="1"
                                Padding="0,1,0,0"
                                HorizontalAlignment="Right"
                                Style="{ThemeResource CriticalValueInfoBadgeStyle}"
                                Value="{x:Bind InfoBars.Count, Mode=OneWay}"/>
                        </Grid>
                    </Button>
                </cwc:Case>
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>1</x:Int32>
                    </cwc:Case.Value>
                    <wl:LiquidGlassButton shuxcth:ControlMaterialState.IsManaged="True">
                        <mxi:Interaction.Behaviors>
                            <mxi:EventTriggerBehavior EventName="Click">
                                <cw:StartTransitionAction
                                    Source="{x:Bind ShowButtonBorder}"
                                    Target="{x:Bind InfoBarItemsBorder}"
                                    Transition="{StaticResource InfoBarPanelTransitionHelper}"/>
                            </mxi:EventTriggerBehavior>
                        </mxi:Interaction.Behaviors>
                        <Grid cw:TransitionHelper.Id="Header">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition MinWidth="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,6,0" Text="{shuxm:ResourceString Name=ViewInfoBarToggleTitle}"/>
                            <InfoBadge
                                Grid.Column="1"
                                Padding="0,1,0,0"
                                HorizontalAlignment="Right"
                                Style="{ThemeResource CriticalValueInfoBadgeStyle}"
                                Value="{x:Bind InfoBars.Count, Mode=OneWay}"/>
                        </Grid>
                    </wl:LiquidGlassButton>
                </cwc:Case>
            </cwc:SwitchPresenter>
        </Border>

        <Border
            x:Name="InfoBarItemsBorder"
            Margin="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            cw:Effects.Shadow="{ThemeResource CompatCardShadow}"
            cw:TransitionHelper.Id="Body"
            Visibility="Collapsed">
            <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>

                        <RowDefinition/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <ScrollView Grid.Row="0">
                        <ItemsControl
                            MaxWidth="480"
                            ItemContainerTransitions="{StaticResource AddDeleteThemeTransitions}"
                            ItemTemplateSelector="{StaticResource InfoBarTemplateSelector}"
                            ItemsPanel="{StaticResource StackPanelSpacing8Template}"
                            ItemsSource="{Binding InfoBars, Mode=OneWay}"/>
                    </ScrollView>

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            cw:TransitionHelper.Id="Header"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{shuxm:ResourceString Name=ViewInfoBarPanelTitle}"/>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <cwc:SwitchPresenter
                                x:Name="GlassPresenter_6674"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsTabStop="False"
                                Tag="LiquidGlass:Button"
                                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>0</x:Int32>
                                    </cwc:Case.Value>
                                    <Button Click="OnClearAllButtonClick">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="19"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                Glyph="&#xE74D;"/>
                                            <TextBlock Grid.Column="1" Text="{shuxm:ResourceString Name=ViewInfoBarPanelClearAllContent}"/>
                                        </Grid>
                                    </Button>
                                </cwc:Case>
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>1</x:Int32>
                                    </cwc:Case.Value>
                                    <wl:LiquidGlassButton shuxcth:ControlMaterialState.IsManaged="True" Click="OnClearAllButtonClick">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="19"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                Glyph="&#xE74D;"/>
                                            <TextBlock Grid.Column="1" Text="{shuxm:ResourceString Name=ViewInfoBarPanelClearAllContent}"/>
                                        </Grid>
                                    </wl:LiquidGlassButton>
                                </cwc:Case>
                            </cwc:SwitchPresenter>
                            <cwc:SwitchPresenter
                                x:Name="GlassPresenter_7490"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsTabStop="False"
                                Tag="LiquidGlass:Button"
                                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>0</x:Int32>
                                    </cwc:Case.Value>
                                    <Button>
                                        <mxi:Interaction.Behaviors>
                                            <mxi:EventTriggerBehavior EventName="Click">
                                                <cw:StartTransitionAction
                                                    Source="{x:Bind InfoBarItemsBorder}"
                                                    Target="{x:Bind ShowButtonBorder}"
                                                    Transition="{StaticResource InfoBarPanelTransitionHelper}"/>
                                            </mxi:EventTriggerBehavior>
                                        </mxi:Interaction.Behaviors>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="19"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                Glyph="&#xEE49;"/>
                                            <TextBlock Grid.Column="1" Text="{shuxm:ResourceString Name=ViewInfoBarPanelContractContent}"/>
                                        </Grid>
                                    </Button>
                                </cwc:Case>
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>1</x:Int32>
                                    </cwc:Case.Value>
                                    <wl:LiquidGlassButton shuxcth:ControlMaterialState.IsManaged="True">
                                        <mxi:Interaction.Behaviors>
                                            <mxi:EventTriggerBehavior EventName="Click">
                                                <cw:StartTransitionAction
                                                    Source="{x:Bind InfoBarItemsBorder}"
                                                    Target="{x:Bind ShowButtonBorder}"
                                                    Transition="{StaticResource InfoBarPanelTransitionHelper}"/>
                                            </mxi:EventTriggerBehavior>
                                        </mxi:Interaction.Behaviors>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="19"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                Glyph="&#xEE49;"/>
                                            <TextBlock Grid.Column="1" Text="{shuxm:ResourceString Name=ViewInfoBarPanelContractContent}"/>
                                        </Grid>
                                    </wl:LiquidGlassButton>
                                </cwc:Case>
                            </cwc:SwitchPresenter>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>

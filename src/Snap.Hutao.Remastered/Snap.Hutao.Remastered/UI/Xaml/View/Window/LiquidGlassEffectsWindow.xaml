<Window
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Window.LiquidGlassEffectsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup">
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="DragRegion" Grid.Row="0">
            <TextBlock
                Margin="12,0,160,0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=LiquidGlassEffectsWindowTitle}"/>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Margin="24,12,24,16"
            Spacing="12">
            <TextBlock Text="{shuxm:ResourceString Name=GlassEffectsIntro}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <ComboBox shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                    x:Name="TypeSelector"
                    MinWidth="230"
                    ItemsSource="{x:Bind Profiles}"
                    Loaded="SelectorLoaded"
                    SelectionChanged="TypeChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="shuxcth:LiquidGlassProfile">
                            <TextBlock Text="{x:Bind Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Click="ResetClicked" Content="{shuxm:ResourceString Name=GlassResetType}"/>
            </StackPanel>
        </StackPanel>
        <Grid
            Grid.Row="2"
            Margin="24,0,24,24"
            ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <StackPanel Spacing="12">
                    <ToggleSwitch
                        Header="{shuxm:ResourceString Name=GlassPointerLighting}"
                        IsOn="{x:Bind SelectedProfile.PointerLightingEnabled, Mode=TwoWay}"/>
                    <TextBlock Text="{shuxm:ResourceString Name=GlassPointerLightingDescription}" TextWrapping="Wrap"/>
                    <TextBlock Text="{shuxm:ResourceString Name=GlassPointerLightInfluence}"/>
                    <Slider
                        AutomationProperties.Name="{shuxm:ResourceString Name=GlassPointerLightInfluence}"
                        Maximum="1"
                        Minimum="0"
                        StepFrequency="0.05"
                        Value="{x:Bind SelectedProfile.PointerLightInfluence, Mode=TwoWay}"/>
                    <ItemsControl ItemsSource="{x:Bind SelectedProfile.Parameters, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="shuxcth:LiquidGlassParameter">
                                <StackPanel Margin="0,0,12,16" Spacing="4">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind Label}"/>
                                        <Button
                                            Grid.Column="1"
                                            Click="{x:Bind Reset}"
                                            Content="{shuxm:ResourceString Name=GlassResetParameter}"/>
                                    </Grid>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="64"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider
                                            AutomationProperties.Name="{x:Bind Label}"
                                            Maximum="{x:Bind Maximum}"
                                            Minimum="{x:Bind Minimum}"
                                            StepFrequency="{x:Bind Step}"
                                            Value="{x:Bind Value, Mode=TwoWay}"/>
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind DisplayValue, Mode=OneWay}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{shuxm:ResourceString Name=GlassDefaultValue}"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind DefaultText}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{shuxm:ResourceString Name=GlassPreviewHeading}"/>
                <TextBlock Text="{x:Bind SelectedProfile.Name, Mode=OneWay}"/>
                <Border x:Name="PreviewHost" CornerRadius="12"/>
                <TextBlock Text="{shuxm:ResourceString Name=GlassEffectsPreviewHint}" TextWrapping="Wrap"/>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{shuxm:ResourceString Name=GlassPresetHint}"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

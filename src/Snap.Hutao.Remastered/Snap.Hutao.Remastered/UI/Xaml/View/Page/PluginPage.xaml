<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.PluginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:clw="using:CommunityToolkit.Labs.WinUI"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwconv="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shux="using:Snap.Hutao.Remastered.UI.Xaml"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvp="using:Snap.Hutao.Remastered.ViewModel.Plugin"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance shvp:PluginViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind DataContext.LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <!--  ReSharper disable Xaml.RedundantResource  -->
        <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="SettingsCardBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="SettingsCardBackgroundDisabled" Color="Transparent"/>
        <SolidColorBrush x:Key="SettingsCardBackgroundPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="SettingsCardBackgroundPressed" Color="Transparent"/>
        <!--  ReSharper restore Xaml.RedundantResource  -->

        <Style
            x:Key="DangerButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCritical}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCritical}"/>
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimary}"/>
        </Style>

        <cwconv:BoolNegationConverter x:Key="BoolNegationConverter"/>

        <DataTemplate x:Key="PluginItemTemplate" x:DataType="shvp:PluginListItem">
            <Border Padding="12" Style="{ThemeResource BorderCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!--  插件图标  -->
                    <Border
                        Grid.Column="0"
                        Width="48"
                        Height="48"
                        Margin="0,0,12,0"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <Grid>
                            <Image
                                Source="{x:Bind Icon}"
                                Stretch="Uniform"
                                Visibility="{x:Bind IconVisibility}"/>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="📦"
                                Visibility="{x:Bind PlaceholderVisibility}"/>
                        </Grid>
                    </Border>

                    <!--  插件信息  -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}"/>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Description}"/>
                        <StackPanel
                            Margin="0,4,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Version}"/>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="•"/>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Author}"/>
                            <TextBlock
                                Foreground="{x:Bind IsEnabled, Converter={StaticResource BoolToColorConverter}}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Status}"/>
                        </StackPanel>
                    </StackPanel>

                    <!--  操作按钮  -->
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <wl:LiquidGlassButton
                            shuxcth:ControlMaterialState.IsManaged="True"
                            Command="{x:Bind EnableCommand}"
                            IsEnabled="{x:Bind CanEnable}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind EnableVisibility}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginEnableButton}"/>
                            </StackPanel>
                        </wl:LiquidGlassButton>
                        <wl:LiquidGlassButton
                            shuxcth:ControlMaterialState.IsManaged="True"
                            Command="{x:Bind DisableCommand}"
                            IsEnabled="{x:Bind CanChangePackage}"
                            Style="{StaticResource DangerButtonStyle}"
                            Visibility="{x:Bind DisableVisibility}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginDisableButton}"/>
                            </StackPanel>
                        </wl:LiquidGlassButton>
                        <wl:LiquidGlassButton
                            shuxcth:ControlMaterialState.IsManaged="True"
                            Command="{x:Bind OpenSettingsCommand}"
                            Style="{StaticResource DefaultButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE713;"/>
                                <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginSettingsButton}"/>
                            </StackPanel>
                        </wl:LiquidGlassButton>
                        <wl:LiquidGlassButton
                            shuxcth:ControlMaterialState.IsManaged="True"
                            Command="{x:Bind UninstallCommand}"
                            IsEnabled="{x:Bind CanChangePackage}"
                            Style="{StaticResource DefaultButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;"/>
                                <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginUninstallButton}"/>
                            </StackPanel>
                        </wl:LiquidGlassButton>
                        <wl:LiquidGlassButton
                            shuxcth:ControlMaterialState.IsManaged="True"
                            AutomationProperties.Name="{shuxm:ResourceString Name=ViewPagePluginMoreActions}"
                            Style="{StaticResource DefaultButtonStyle}">
                            <FontIcon Glyph="&#xE712;"/>
                            <wl:LiquidGlassButton.Flyout>
                                <Flyout essential:FlyoutHelper.AcrylicWorkaround="True" Placement="BottomEdgeAlignedRight">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="MaxHeight" Value="Infinity"/>
                                            <Setter Property="MaxWidth" Value="Infinity"/>
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel MaxWidth="480" Spacing="8">
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind Details}"
                                            TextWrapping="Wrap"/>
                                        <Button
                                            Command="{x:Bind UpdateCommand}"
                                            Content="{shuxm:ResourceString Name=ViewPagePluginUpdateButton}"
                                            IsEnabled="{x:Bind CanChangePackage}"/>
                                        <Button
                                            Command="{x:Bind ApplyUpdateCommand}"
                                            Content="{shuxm:ResourceString Name=ViewPagePluginApplyUpdateButton}"
                                            IsEnabled="{x:Bind CanApply}"/>
                                        <Button
                                            Command="{x:Bind RollbackCommand}"
                                            Content="{shuxm:ResourceString Name=ViewPagePluginRollbackButton}"
                                            IsEnabled="{x:Bind CanRollback}"/>
                                        <ItemsControl ItemsSource="{x:Bind Commands}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="shvp:PluginListCommand">
                                                    <Button Command="{x:Bind Command}" Content="{x:Bind Title}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </wl:LiquidGlassButton.Flyout>
                        </wl:LiquidGlassButton>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <cwconv:BoolToObjectConverter x:Key="BoolToColorConverter">
            <cwconv:BoolToObjectConverter.TrueValue>
                <SolidColorBrush Color="{ThemeResource SystemFillColorSuccess}"/>
            </cwconv:BoolToObjectConverter.TrueValue>
            <cwconv:BoolToObjectConverter.FalseValue>
                <SolidColorBrush Color="{ThemeResource SystemFillColorCritical}"/>
            </cwconv:BoolToObjectConverter.FalseValue>
        </cwconv:BoolToObjectConverter>

    </Page.Resources>

    <Grid x:Name="Root">
        <shuxc:StandardView ShowCondition="{x:Bind DataContext.IsInitialized, Mode=OneWay}">
            <shuxc:StandardView.EmptyContent>
                <clw:Shimmer IsActive="{x:Bind DataContext.IsInitialized, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"/>
            </shuxc:StandardView.EmptyContent>

            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--  操作工具栏  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,16"
                    cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <StackPanel
                            Padding="16"
                            Orientation="Horizontal"
                            Spacing="12">
                            <wl:LiquidGlassButton
                                shuxcth:ControlMaterialState.IsManaged="True"
                                Command="{x:Bind DataContext.InstallPluginCommand, Mode=OneWay}"
                                Content="{shuxm:ResourceString Name=ViewPagePluginInstallButton}"
                                IsEnabled="{x:Bind DataContext.ActionsEnabled, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}">
                                <wl:LiquidGlassButton.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE710;"/>
                                            <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginInstallButton}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </wl:LiquidGlassButton.ContentTemplate>
                            </wl:LiquidGlassButton>

                            <wl:LiquidGlassButton
                                shuxcth:ControlMaterialState.IsManaged="True"
                                Command="{x:Bind DataContext.RefreshPluginsCommand, Mode=OneWay}"
                                Content="{shuxm:ResourceString Name=ViewPagePluginRefreshButton}"
                                IsEnabled="{x:Bind DataContext.ActionsEnabled, Mode=OneWay}"
                                Style="{StaticResource DefaultButtonStyle}">
                                <wl:LiquidGlassButton.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72C;"/>
                                            <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginRefreshButton}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </wl:LiquidGlassButton.ContentTemplate>
                            </wl:LiquidGlassButton>

                            <wl:LiquidGlassButton
                                shuxcth:ControlMaterialState.IsManaged="True"
                                Command="{x:Bind DataContext.OpenPluginDirectoryCommand, Mode=OneWay}"
                                Content="{shuxm:ResourceString Name=ViewPagePluginOpenDirectoryButton}"
                                IsEnabled="{x:Bind DataContext.ActionsEnabled, Mode=OneWay}"
                                Style="{StaticResource DefaultButtonStyle}">
                                <wl:LiquidGlassButton.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8DA;"/>
                                            <TextBlock Text="{shuxm:ResourceString Name=ViewPagePluginOpenDirectoryButton}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </wl:LiquidGlassButton.ContentTemplate>
                            </wl:LiquidGlassButton>

                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{shuxm:ResourceString Name=ViewPagePluginTotalText}"/>
                                <Run Text="{x:Bind DataContext.Plugins.Count, Mode=OneWay}"/>
                                <Run Text="{shuxm:ResourceString Name=ViewPagePluginCountText}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Border>

                <InfoBar
                    Grid.Row="1"
                    IsClosable="True"
                    IsOpen="{x:Bind DataContext.IsStatusOpen, Mode=TwoWay}"
                    Message="{x:Bind DataContext.StatusMessage, Mode=OneWay}"
                    Severity="{x:Bind DataContext.StatusSeverity, Mode=OneWay}"/>

                <!--  插件列表  -->
                <Border Grid.Row="2" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Grid Style="{ThemeResource AcrylicGridCardStyle}">
                        <shuxc:StandardView ShowCondition="{x:Bind DataContext.Plugins.Count, Converter={StaticResource Int32ToBoolConverter}, Mode=OneWay}">
                            <shuxc:StandardView.EmptyContent>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="16">
                                    <shuxci:CachedImage Height="120" Source="{StaticResource UI_EmotionIcon776}"/>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{shuxm:ResourceString Name=ViewPagePluginEmptyTitle}"/>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{shuxm:ResourceString Name=ViewPagePluginEmptyDescription}"/>
                                </StackPanel>
                            </shuxc:StandardView.EmptyContent>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    ItemContainerTransitions="{ThemeResource ListViewLikeThemeTransitions}"
                                    ItemTemplate="{StaticResource PluginItemTemplate}"
                                    ItemsPanel="{ThemeResource StackPanelSpacing8Template}"
                                    ItemsSource="{x:Bind shux:ItemsSourceHelper.Create(DataContext.Plugins, x:False), Mode=OneWay}"/>
                            </ScrollViewer>
                        </shuxc:StandardView>
                    </Grid>
                </Border>
            </Grid>
        </shuxc:StandardView>
    </Grid>
</shuxc:ScopedPage>

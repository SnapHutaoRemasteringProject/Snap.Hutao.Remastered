<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.BackpackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxba="using:Snap.Hutao.Remastered.UI.Xaml.Behavior.Action"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxca="using:Snap.Hutao.Remastered.UI.Xaml.Control.AutoSuggestBox"
    xmlns:shuxcas="using:Snap.Hutao.Remastered.UI.Xaml.Control.AutoSortBox"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxdcs="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter.Specialized"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shv="using:Snap.Hutao.Remastered.ViewModel.Backpack"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance shv:BackpackViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <shuxdcs:UInt32ToGradientColorConverter
                        x:Key="CountToGradientColorConverter"
                        Maximum="#FFFD0093"
                        Minimum="#FF4B00D9"/>
                    <shuxdcs:Int32ToGradientColorConverter
                        x:Key="ScoreToColorConverter"
                        Maximum="#FFFF8F00"
                        MaximumValue="50"
                        Minimum="#FF9E9E9E"
                        MinimumValue="0"/>
                    <shuxdcs:ReliquarySubStatStateToColorConverter
                        x:Key="ReliquarySubStatStateToColorConverter"
                        Crit="#FFE09600"
                        Effective="#E4000000"
                        Muted="#FF9E9E9E"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <shuxdcs:UInt32ToGradientColorConverter
                        x:Key="CountToGradientColorConverter"
                        Maximum="#FFFF69BF"
                        Minimum="#FF9F69FF"/>
                    <shuxdcs:Int32ToGradientColorConverter
                        x:Key="ScoreToColorConverter"
                        Maximum="#FFFF8F00"
                        MaximumValue="50"
                        Minimum="#FF9E9E9E"
                        MinimumValue="0"/>
                    <shuxdcs:ReliquarySubStatStateToColorConverter
                        x:Key="ReliquarySubStatStateToColorConverter"
                        Crit="#FFFFCC33"
                        Effective="#FFFFFFFF"
                        Muted="#FF8E8E8E"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Flyout x:Key="ItemDetailFlyout">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <shuxc:ItemFlyoutContent/>
            </Flyout>

            <!--  Properties defined by 祝圣之霜, only reachable from a reliquary crafted with it  -->
            <Flyout x:Key="PurchasedAppendPropFlyout">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                    <StackPanel MaxWidth="240" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <shuxc:SanctifyingElixirIcon Width="28" Height="28"/>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewPageBackpackPurchasedAppendPropTitle}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding PurchasedAppendPropNames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Flyout>

            <!--  Avatar that equips the item, overlaid on the top right corner of the item icon  -->
            <DataTemplate x:Key="EquippedAvatarBadgeTemplate" x:DataType="shv:BackpackItemView">
                <Grid
                    Width="24"
                    Height="24"
                    Visibility="{Binding HasEquippedAvatar, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.Clip>
                        <!--  Keep equal to the Width/Height above: the image is larger than the plate, a bigger Rect would clip nothing and let it spill onto the card  -->
                        <RectangleGeometry Rect="0,0,24,24"/>
                    </Grid.Clip>
                    <Border Background="{ThemeResource EquippedAvatarBadgeBackgroundBrush}" CornerRadius="{StaticResource ControlCornerRadius}"/>
                    <!--  AvatarSideIcon is a bottom cropped bust whose own padding varies per avatar, so a fixed shift can only center it on average; -6,-6 puts the right and bottom edges flush (nothing clipped there) and the clip above keeps the leftover top overflow off the card  -->
                    <shuxci:CachedImage
                        Width="30"
                        Height="30"
                        Margin="-4,-6,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Source="{Binding EquippedAvatarIconUri}"/>
                </Grid>
            </DataTemplate>

            <!--  Weapon card  -->
            <DataTemplate x:Key="WeaponCardTemplate" x:DataType="shv:BackpackWeaponItemView">
                <shuxcc:HorizontalCard Width="270">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Tapped">
                            <shuxba:ShowAttachedFlyoutAction/>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                    <FlyoutBase.AttachedFlyout>
                        <StaticResource ResourceKey="ItemDetailFlyout"/>
                    </FlyoutBase.AttachedFlyout>
                    <shuxcc:HorizontalCard.Left>
                        <Grid Margin="4,0" VerticalAlignment="Center">
                            <shuxc:ItemIcon
                                Width="54"
                                Height="54"
                                Icon="{x:Bind Weapon.Icon, Converter={StaticResource EquipIconConverter}, Mode=OneWay}"
                                Quality="{x:Bind Weapon.RankLevel, Mode=OneWay}"/>
                            <ContentControl
                                Content="{Binding}"
                                ContentTemplate="{StaticResource EquippedAvatarBadgeTemplate}"
                                HorizontalContentAlignment="Right"
                                VerticalContentAlignment="Bottom"/>
                        </Grid>
                    </shuxcc:HorizontalCard.Left>
                    <shuxcc:HorizontalCard.Right>
                        <Grid Margin="16,0">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    Text="{x:Bind Weapon.Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"/>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind WeaponTypeName, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind LevelRefinementInfo, Mode=OneWay}"/>
                            </StackPanel>
                            <shuxc:LockIcon
                                Width="20"
                                Height="20"
                                Margin="0,0,-10,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                IsLocked="{x:Bind IsLocked, Mode=OneWay}"/>
                        </Grid>
                    </shuxcc:HorizontalCard.Right>
                </shuxcc:HorizontalCard>
            </DataTemplate>

            <DataTemplate x:Key="ReliquaryCardTemplate" x:DataType="shv:BackpackReliquaryItemView">
                <Border Width="320" Style="{StaticResource BorderShimmerStyle}">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Tapped">
                            <shuxba:ShowAttachedFlyoutAction/>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                    <FlyoutBase.AttachedFlyout>
                        <StaticResource ResourceKey="ItemDetailFlyout"/>
                    </FlyoutBase.AttachedFlyout>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid
                            Margin="0,0,4,4"
                            HorizontalAlignment="Right"
                            ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <shuxc:SanctifyingElixirIcon
                                Grid.Column="0"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Bottom"
                                FlyoutBase.AttachedFlyout="{StaticResource PurchasedAppendPropFlyout}"
                                Tapped="OnPurchasedAppendPropIconTapped"
                                Visibility="{Binding HasPurchasedAppendProp, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <shuxc:LockIcon
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                IsLocked="{x:Bind IsLocked, Mode=OneWay}"/>
                            <shuxc:MarkIcon
                                Grid.Column="2"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                IsMarked="{x:Bind IsMarked, Mode=OneWay}"/>
                        </Grid>

                        <Grid
                            Grid.Row="0"
                            Padding="12"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <shuxc:ItemIcon
                                    Width="54"
                                    Height="54"
                                    Icon="{x:Bind Reliquary.Icon, Converter={StaticResource ItemIconConverter}, Mode=OneWay}"
                                    Quality="{x:Bind Reliquary.RankLevel, Mode=OneWay}"/>
                                <ContentControl
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource EquippedAvatarBadgeTemplate}"
                                    HorizontalContentAlignment="Right"
                                    VerticalContentAlignment="Bottom"/>
                            </Grid>
                            <Grid Grid.Column="1">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Reliquary.Name, Mode=OneWay}"/>
                                    <TextBlock
                                        Opacity="0.7"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind SetName, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontWeight="Bold"
                                        Style="{StaticResource BaseTextBlockStyle}">
                                        <Run Text="+"/>
                                        <Run Text="{x:Bind Level, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind DisplayScore, Mode=OneWay}"
                                        Visibility="{x:Bind HasScore, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding ScoreColorValue, Converter={ThemeResource ScoreToColorConverter}, Mode=OneWay}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Rectangle
                            Grid.Row="1"
                            Height="1"
                            Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>

                        <Grid Grid.Row="2" Padding="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontWeight="Bold"
                                Style="{StaticResource BaseTextBlockStyle}"
                                Text="{x:Bind MainPropName, Mode=OneWay}"/>
                            <TextBlock
                                Grid.Column="1"
                                FontWeight="Bold"
                                Style="{StaticResource BaseTextBlockStyle}"
                                Text="{x:Bind MainPropValue, Mode=OneWay}"/>
                        </Grid>

                        <Rectangle
                            Grid.Row="3"
                            Height="1"
                            Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>

                        <ItemsControl
                            Grid.Row="4"
                            Margin="0,12"
                            ItemTemplate="{StaticResource BackpackReliquarySubStatTemplate}"
                            ItemsSource="{x:Bind PaddedSubStats, Mode=OneWay}"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="BackpackReliquarySubStatTemplate" x:DataType="shv:BackpackReliquarySubStatView">
                <Grid
                    MinHeight="20"
                    Padding="12,0"
                    ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource BaseTextBlockStyle}"
                        Text="{x:Bind DisplayName, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        Visibility="{x:Bind HasValue, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="{Binding State, Converter={ThemeResource ReliquarySubStatStateToColorConverter}}"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind DisplayValue, Mode=OneWay}"
                        Visibility="{x:Bind HasValue, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="{Binding State, Converter={ThemeResource ReliquarySubStatStateToColorConverter}}"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <Grid Grid.Column="2" Visibility="{x:Bind HasValue, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <Ellipse
                            Width="16"
                            Height="16"
                            Opacity="0.8"
                            StrokeThickness="1">
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="{Binding EnhancedCount, Converter={ThemeResource CountToGradientColorConverter}, Mode=OneWay}"/>
                            </Ellipse.Stroke>
                        </Ellipse>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{ThemeResource InfoBadgeValueFontSize}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind EnhancedCount, Mode=OneWay}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{Binding EnhancedCount, Converter={ThemeResource CountToGradientColorConverter}, Mode=OneWay}"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>
                </Grid>
            </DataTemplate>

            <!--  Default card  -->
            <DataTemplate x:Key="DefaultCardTemplate" x:DataType="shv:BackpackItemView">
                <shuxcc:HorizontalCard Width="270">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Tapped">
                            <shuxba:ShowAttachedFlyoutAction/>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                    <FlyoutBase.AttachedFlyout>
                        <StaticResource ResourceKey="ItemDetailFlyout"/>
                    </FlyoutBase.AttachedFlyout>
                    <shuxcc:HorizontalCard.Left>
                        <shuxc:ItemIcon
                            Width="40"
                            Height="40"
                            Icon="{x:Bind Material.Icon, Converter={StaticResource ItemIconConverter}, Mode=OneWay}"
                            Quality="{x:Bind Material.RankLevel, Mode=OneWay}"/>
                    </shuxcc:HorizontalCard.Left>
                    <shuxcc:HorizontalCard.Right>
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind Material.Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind DisplayCount, Mode=OneWay}"/>
                        </Grid>
                    </shuxcc:HorizontalCard.Right>
                </shuxcc:HorizontalCard>
            </DataTemplate>

            <shv:BackpackItemTemplateSelector
                x:Key="BackpackItemTemplateSelector"
                DefaultTemplate="{StaticResource DefaultCardTemplate}"
                ReliquaryTemplate="{StaticResource ReliquaryCardTemplate}"
                WeaponTemplate="{StaticResource WeaponCardTemplate}"/>

            <DataTemplate x:Key="TokenTemplate" x:DataType="shuxca:SearchToken">
                <Grid Height="22" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <!--  IconUri  -->
                    <shuxci:CachedImage
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="-4,0,0,0"
                        HorizontalAlignment="Left"
                        ShowAsMonoChrome="True"
                        Source="{x:Bind IconUri, Mode=OneTime}"
                        Visibility="{x:Bind IconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}"/>
                    <!--  Quality dot  -->
                    <Ellipse
                        Grid.Column="0"
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind Quality, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{x:Bind QualityColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Grid Grid.Column="0">
                        <!--  SideIconUri  -->
                        <shuxci:CachedImage
                            Width="20"
                            Height="20"
                            Margin="-4,0,0,0"
                            HorizontalAlignment="Left"
                            Source="{x:Bind SideIconUri, Mode=OneTime}"
                            Visibility="{x:Bind SideIconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}"/>
                    </Grid>

                    <TextBlock
                        Grid.Column="1"
                        Height="20"
                        VerticalAlignment="Center"
                        Text="{x:Bind Value, Mode=OneTime}"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shv:BackpackViewModel)DataContext).LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <shuxc:StandardView HideCondition="{x:Bind ((shv:BackpackViewModel)DataContext).IsInitialized, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" ShowCondition="{x:Bind ((shv:BackpackViewModel)DataContext).Archives.CurrentItem, Converter={StaticResource EmptyObjectToBoolConverter}, Mode=OneWay}">
        <shuxc:StandardView.EmptyContent>
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border
                    MinWidth="480"
                    Padding="16"
                    Style="{ThemeResource AcrylicBorderCardStyle}">
                    <StackPanel>
                        <Image
                            Width="120"
                            Height="120"
                            Source="ms-appx:///Resource/Navigation/Backpack.png"/>
                        <TextBlock
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{shuxm:ResourceString Name=ViewPageBackpackAddArchiveHint}"/>
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_20193"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:Button"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <Button
                                    Padding="16,8"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ((shv:BackpackViewModel)DataContext).AddArchiveCommand, Mode=OneWay}"
                                    Content="{shuxm:ResourceString Name=ViewPageBackpackAddArchive}"/>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassButton
                                    Padding="16,8"
                                    HorizontalAlignment="Stretch"
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    Command="{x:Bind ((shv:BackpackViewModel)DataContext).AddArchiveCommand, Mode=OneWay}"
                                    Content="{shuxm:ResourceString Name=ViewPageBackpackAddArchive}"/>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                    </StackPanel>
                </Border>
            </Border>
        </shuxc:StandardView.EmptyContent>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!--  Filter bar  -->
            <Border
                Grid.Row="0"
                Margin="16"
                cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                    <Grid Margin="4,4" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <shuxca:AutoSuggestTokenBox
                            Width="800"
                            Height="44"
                            Margin="6,-2,6,6"
                            HorizontalAlignment="Right"
                            AvailableTokens="{x:Bind ((shv:BackpackViewModel)DataContext).SearchData.AvailableTokens, Mode=OneWay}"
                            FilterCommand="{x:Bind ((shv:BackpackViewModel)DataContext).FilterCommand, Mode=OneWay}"
                            ItemsSource="{x:Bind ((shv:BackpackViewModel)DataContext).SearchData.FilterTokens, Mode=OneWay}"
                            MaximumTokens="5"
                            PlaceholderText="{shuxm:ResourceString Name=ViewPageBackpackFilterPlaceholder}"
                            QueryIcon="{cw:FontIconSource Glyph=&#xE721;}"
                            Style="{StaticResource DefaultAutoSuggestTokenBoxStyle}"
                            SuggestedItemTemplate="{StaticResource TokenTemplate}"
                            SuggestedItemsSource="{x:Bind ((shv:BackpackViewModel)DataContext).SearchData.AvailableTokens.Values, Mode=OneWay}"
                            Text="{x:Bind ((shv:BackpackViewModel)DataContext).SearchData.FilterToken, Mode=TwoWay}"
                            TokenItemTemplate="{StaticResource TokenTemplate}"/>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <cwc:SwitchPresenter
                                x:Name="GlassPresenter_22704"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsTabStop="False"
                                Tag="LiquidGlass:Button"
                                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>0</x:Int32>
                                    </cwc:Case.Value>
                                    <Button VerticalAlignment="Center">
                                        <Button.Flyout>
                                            <Flyout>
                                                <shuxcas:AutoSortList
                                                    Width="260"
                                                    AvailableTokens="{x:Bind ((shv:BackpackViewModel)DataContext).AvailableSortTokens, Mode=OneWay}"
                                                    SortCommand="{x:Bind ((shv:BackpackViewModel)DataContext).ApplySortCommand, Mode=OneWay}"/>
                                            </Flyout>
                                        </Button.Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontSize="12" Glyph="&#xE8CB;"/>
                                            <TextBlock Text="{shuxm:ResourceString Name=ViewPageBackpackSortHeader}"/>
                                        </StackPanel>
                                    </Button>
                                </cwc:Case>
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>1</x:Int32>
                                    </cwc:Case.Value>
                                    <wl:LiquidGlassButton VerticalAlignment="Center" shuxcth:ControlMaterialState.IsManaged="True">
                                        <wl:LiquidGlassButton.Flyout>
                                            <Flyout>
                                                <shuxcas:AutoSortList
                                                    Width="260"
                                                    AvailableTokens="{x:Bind ((shv:BackpackViewModel)DataContext).AvailableSortTokens, Mode=OneWay}"
                                                    SortCommand="{x:Bind ((shv:BackpackViewModel)DataContext).ApplySortCommand, Mode=OneWay}"/>
                                            </Flyout>
                                        </wl:LiquidGlassButton.Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontSize="12" Glyph="&#xE8CB;"/>
                                            <TextBlock Text="{shuxm:ResourceString Name=ViewPageBackpackSortHeader}"/>
                                        </StackPanel>
                                    </wl:LiquidGlassButton>
                                </cwc:Case>
                            </cwc:SwitchPresenter>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
            <Pivot
                Grid.Row="1"
                Margin="0,-24"
                SelectedIndex="{x:Bind ((shv:BackpackViewModel)DataContext).SelectedCategoryIndex, Mode=TwoWay}"
                Style="{ThemeResource CardPivotStyle}">
                <Pivot.RightHeader>
                    <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                        <AppBarElementContainer AllowFocusOnInteraction="True">
                            <shuxc:SizeRestrictedContentControl Margin="2,6,3,6">
                                <cwc:SwitchPresenter
                                    x:Name="GlassPresenter_24224"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    IsTabStop="False"
                                    Tag="LiquidGlass:ComboBox"
                                    Visibility="{x:Bind GlassPresenter_24224_State.Visibility, Mode=OneWay}"
                                    Value="{x:Bind shuxcth:MaterialBindingSource.Current.ComboBoxMaterial, Mode=OneWay}">
                                    <cwc:Case>
                                        <cwc:Case.Value>
                                            <x:Int32>0</x:Int32>
                                        </cwc:Case.Value>
                                        <ComboBox shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                            x:Name="GlassPresenter_24224_State"
                                            DataContext="{x:Bind GlassPresenter_24224.DataContext, Mode=OneWay}"

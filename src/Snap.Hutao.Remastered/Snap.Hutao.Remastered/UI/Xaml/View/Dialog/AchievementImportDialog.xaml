<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.AchievementImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:wl="using:WinUI.LiquidGlass"
    Title="{shuxm:ResourceString Name=ViewDialogAchievementArchiveImportTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <cwc:UniformGrid
            Grid.Row="0"
            ColumnSpacing="16"
            Columns="3"
            RowSpacing="16">
            <cwc:HeaderedContentControl Header="{shuxm:ResourceString Name=ViewDialogImportExportApp}">
                <TextBlock
                    Margin="0,4,0,0"
                    Opacity="0.6"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind UIAF.Info.ExportApp, Mode=OneWay, TargetNullValue=Unknown}"/>
            </cwc:HeaderedContentControl>
            <cwc:HeaderedContentControl Header="{shuxm:ResourceString Name=ViewDialogImportExportTime}">
                <TextBlock
                    Margin="0,4,0,0"
                    Opacity="0.6"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind UIAF.Info.ExportDateTime.LocalDateTime, Mode=OneWay, TargetNullValue=Unknown}"/>
            </cwc:HeaderedContentControl>
            <cwc:HeaderedContentControl Header="{shuxm:ResourceString Name=ViewDialogImportExportAppVersion}">
                <TextBlock
                    Margin="0,4,0,0"
                    Opacity="0.6"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind UIAF.Info.ExportAppVersion, Mode=OneWay, TargetNullValue=Unknown}"/>
            </cwc:HeaderedContentControl>
            <cwc:HeaderedContentControl Header="{shuxm:ResourceString Name=ViewDialogImportUIAFExportUIAFVersion}">
                <TextBlock
                    Margin="0,4,0,0"
                    Opacity="0.6"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind UIAF.Info.UIAFVersion, Mode=OneWay, TargetNullValue=Unknown}"/>
            </cwc:HeaderedContentControl>
            <cwc:HeaderedContentControl Header="{shuxm:ResourceString Name=ViewDialogImportUIAFExportListCount}">
                <TextBlock
                    Margin="0,4,0,0"
                    Opacity="0.6"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind UIAF.List.Length, Mode=OneWay, TargetNullValue=Unknown}"/>
            </cwc:HeaderedContentControl>
        </cwc:UniformGrid>
        <cwc:SwitchPresenter
            x:Name="MaterialSelector_ImportModeSelector"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Value="{x:Bind shuxcth:MaterialBindingSource.Current.RadioButtonMaterial, Mode=OneWay}">
            <cwc:Case Value="{shuxm:Int32 Value=0}">
                <RadioButtons
                    x:Name="ImportModeSelector"
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    Header="{shuxm:ResourceString Name=ViewDialogAchievementArchiveImportStrategy}"
                    SelectedIndex="0">
                    <RadioButton
                        x:Name="GlassNative_3487"
                        Content="{shuxm:ResourceString Name=ViewDialogAchievementArchiveImportStrategyAggressive}"
                        DataContext="{x:Bind MaterialSelector_ImportModeSelector.DataContext, Mode=OneWay}"
                        shuxcth:ThemeSynchronization.Source="{x:Bind MaterialSelector_ImportModeSelector}"/>
                    <RadioButton
                        x:Name="GlassNative_3605"
                        Content="{shuxm:ResourceString Name=ViewDialogAchievementArchiveImportStrategyLazy}"
                        DataContext="{x:Bind MaterialSelector_ImportModeSelector.DataContext, Mode=OneWay}"
                        shuxcth:ThemeSynchronization.Source="{x:Bind MaterialSelector_ImportModeSelector}"/>
                    <RadioButton
                        x:Name="GlassNative_3717"
                        Content="{shuxm:ResourceString Name=ViewDialogAchievementArchiveImportStrategyOverwrite}"
                        DataContext="{x:Bind MaterialSelector_ImportModeSelector.DataContext, Mode=OneWay}"
                        shuxcth:ThemeSynchronization.Source="{x:Bind MaterialSelector_ImportModeSelector}"/>
                </RadioButtons>
            </cwc:Case>
            <cwc:Case Value="{shuxm:Int32 Value=1}">
                <RadioButtons
                    x:Name="ImportModeSelectorGlass"
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    Header="{shuxm:ResourceString Name=ViewDialogAchievementArchiveImportStrategy}"
                    SelectedIndex="{x:Bind ImportModeSelector.SelectedIndex, Mode=TwoWay}">
                    <wl:LiquidGlassRadioButton
                        x:Name="GlassNative_3487Glass"
                        Width="{x:Bind GlassNative_3487.Width, Mode=OneWay}"
                        Height="{x:Bind GlassNative_3487.Height, Mode=OneWay}"
                        MinWidth="{x:Bind GlassNative_3487.MinWidth, Mode=OneWay}"
                        MinHeight="{x:Bind GlassNative_3487.MinHeight, Mode=OneWay}"
                        MaxWidth="{x:Bind GlassNative_3487.MaxWidth, Mode=OneWay}"
                        MaxHeight="{x:Bind GlassNative_3487.MaxHeight, Mode=OneWay}"
                        Padding="{x:Bind GlassNative_3487.Padding, Mode=OneWay}"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassNative_3487, Mode=OneWay}"
                        shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                        BorderThickness="{x:Bind GlassNative_3487.BorderThickness, Mode=OneWay}"
                        Command="{x:Bind GlassNative_3487.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind GlassNative_3487.CommandParameter, Mode=OneWay}"
                        Content="{x:Bind GlassNative_3487.Content, Mode=OneWay}"
                        FlowDirection="{x:Bind GlassNative_3487.FlowDirection, Mode=OneWay}"
                        FontFamily="{x:Bind GlassNative_3487.FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind GlassNative_3487.FontSize, Mode=OneWay}"
                        FontStyle="{x:Bind GlassNative_3487.FontStyle, Mode=OneWay}"
                        FontWeight="{x:Bind GlassNative_3487.FontWeight, Mode=OneWay}"
                        IsEnabled="{x:Bind GlassNative_3487.IsEnabled, Mode=OneWay}"/>
                    <wl:LiquidGlassRadioButton
                        x:Name="GlassNative_3605Glass"
                        Width="{x:Bind GlassNative_3605.Width, Mode=OneWay}"
                        Height="{x:Bind GlassNative_3605.Height, Mode=OneWay}"
                        MinWidth="{x:Bind GlassNative_3605.MinWidth, Mode=OneWay}"
                        MinHeight="{x:Bind GlassNative_3605.MinHeight, Mode=OneWay}"
                        MaxWidth="{x:Bind GlassNative_3605.MaxWidth, Mode=OneWay}"
                        MaxHeight="{x:Bind GlassNative_3605.MaxHeight, Mode=OneWay}"
                        Padding="{x:Bind GlassNative_3605.Padding, Mode=OneWay}"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassNative_3605, Mode=OneWay}"
                        shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                        BorderThickness="{x:Bind GlassNative_3605.BorderThickness, Mode=OneWay}"
                        Command="{x:Bind GlassNative_3605.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind GlassNative_3605.CommandParameter, Mode=OneWay}"
                        Content="{x:Bind GlassNative_3605.Content, Mode=OneWay}"
                        FlowDirection="{x:Bind GlassNative_3605.FlowDirection, Mode=OneWay}"
                        FontFamily="{x:Bind GlassNative_3605.FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind GlassNative_3605.FontSize, Mode=OneWay}"
                        FontStyle="{x:Bind GlassNative_3605.FontStyle, Mode=OneWay}"
                        FontWeight="{x:Bind GlassNative_3605.FontWeight, Mode=OneWay}"
                        IsEnabled="{x:Bind GlassNative_3605.IsEnabled, Mode=OneWay}"/>
                    <wl:LiquidGlassRadioButton
                        x:Name="GlassNative_3717Glass"
                        Width="{x:Bind GlassNative_3717.Width, Mode=OneWay}"
                        Height="{x:Bind GlassNative_3717.Height, Mode=OneWay}"
                        MinWidth="{x:Bind GlassNative_3717.MinWidth, Mode=OneWay}"
                        MinHeight="{x:Bind GlassNative_3717.MinHeight, Mode=OneWay}"
                        MaxWidth="{x:Bind GlassNative_3717.MaxWidth, Mode=OneWay}"
                        MaxHeight="{x:Bind GlassNative_3717.MaxHeight, Mode=OneWay}"
                        Padding="{x:Bind GlassNative_3717.Padding, Mode=OneWay}"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassNative_3717, Mode=OneWay}"
                        shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                        BorderThickness="{x:Bind GlassNative_3717.BorderThickness, Mode=OneWay}"
                        Command="{x:Bind GlassNative_3717.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind GlassNative_3717.CommandParameter, Mode=OneWay}"
                        Content="{x:Bind GlassNative_3717.Content, Mode=OneWay}"
                        FlowDirection="{x:Bind GlassNative_3717.FlowDirection, Mode=OneWay}"
                        FontFamily="{x:Bind GlassNative_3717.FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind GlassNative_3717.FontSize, Mode=OneWay}"
                        FontStyle="{x:Bind GlassNative_3717.FontStyle, Mode=OneWay}"
                        FontWeight="{x:Bind GlassNative_3717.FontWeight, Mode=OneWay}"
                        IsEnabled="{x:Bind GlassNative_3717.IsEnabled, Mode=OneWay}"/>
                </RadioButtons>
            </cwc:Case>
        </cwc:SwitchPresenter>
    </Grid>
</ContentDialog>

<shuxcth:MaterialCardButton
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Card.LaunchGameCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shsg="using:Snap.Hutao.Remastered.Service.Game"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvg="using:Snap.Hutao.Remastered.ViewModel.Game"
    xmlns:wl="using:WinUI.LiquidGlass"
    Height="{ThemeResource HomeAdaptiveCardHeight}"
    Padding="0"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    d:DataContext="{d:DesignInstance shvg:LaunchGameViewModelSlim}"
    Background="Transparent"
    BorderBrush="{x:Null}"
    BorderThickness="0"
    Command="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).NavigateCommand, Mode=OneWay}"
    mc:Ignorable="d">
    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>
    <Grid CornerRadius="{ThemeResource ControlCornerRadius}">
        <Grid
            Margin="12"
            RowSpacing="6"
            Visibility="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).IsInitialized, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Grid.ColumnSpan="3"
                Height="48"
                Padding="12"
                Style="{ThemeResource GridShimmerStyle}">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <FontIcon
                        Width="24"
                        Height="24"
                        Margin="-4"
                        FontSize="24"
                        Glyph="{StaticResource FontIconContentGame}"/>

                    <TextBlock Text="{shuxm:ResourceString Name=ViewLaunchGameHeader}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="6">
                <cwc:SwitchPresenter Visibility="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).LaunchOptions.UsingHoyolabAccount.Value, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" Value="{x:Bind shsg:LaunchOptions.IsGameRunning.Value, Mode=OneWay}">
                    <cwc:Case Value="{shuxm:Boolean Value=True}">
                        <Grid Padding="12" Style="{ThemeResource GridShimmerStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <shuxci:CachedImage
                                Grid.Column="0"
                                Height="32"
                                Margin="2,0"
                                HorizontalAlignment="Left"
                                Background="#FFDAB79B"
                                CornerRadius="{ThemeResource CornerRadiusAll16}"
                                Source="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).LaunchStatusOptions.UserGameRole.ProfilePictureIcon, Converter={StaticResource AvatarIconCircleConverter}, Mode=OneWay}"/>
                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).LaunchStatusOptions.UserGameRole.Nickname, Mode=OneWay}"/>
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Opacity="0.6"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).LaunchStatusOptions.UserGameRole.Description, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </cwc:Case>
                    <cwc:Case Value="{shuxm:Boolean Value=False}">
                        <Grid Padding="12" Style="{ThemeResource GridShimmerStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <shuxci:CachedImage
                                Grid.Column="0"
                                Height="32"
                                Margin="2,0"
                                HorizontalAlignment="Left"
                                Background="#FFDAB79B"
                                CornerRadius="{ThemeResource CornerRadiusAll16}"
                                Source="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).CurrentUserGameRole.ProfilePictureIcon, Converter={StaticResource AvatarIconCircleConverter}, Mode=OneWay}"/>
                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).CurrentUserGameRole.Nickname, Mode=OneWay}"/>
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Opacity="0.6"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).CurrentUserGameRole.Description, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </cwc:Case>
                </cwc:SwitchPresenter>

                <cwc:SwitchPresenter
                    x:Name="GlassPresenter_5872"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False"
                    Tag="LiquidGlass:ComboBox"
                    Visibility="{x:Bind GlassPresenter_5872_State.Visibility, Mode=OneWay}"
                    Value="{x:Bind shuxcth:MaterialBindingSource.Current.ComboBoxMaterial, Mode=OneWay}">
                    <cwc:Case>
                        <cwc:Case.Value>
                            <x:Int32>0</x:Int32>
                        </cwc:Case.Value>
                        <ComboBox shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                            x:Name="GlassPresenter_5872_State"
                            Padding="12"
                            DataContext="{x:Bind GlassPresenter_5872.DataContext, Mode=OneWay}"
                            DisplayMemberPath="Name"
                            ItemsSource="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).CurrentSchemeFilteredGameAccountsView.View, Mode=OneWay}"
                            PlaceholderText="{shuxm:ResourceString Name=ViewCardLaunchGameSelectAccountPlaceholder}"
                            shuxcth:ThemeSynchronization.Source="{x:Bind GlassPresenter_5872}"
                            SelectedItem="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).CurrentSchemeFilteredGameAccountsView.View.CurrentItem, FallbackValue={x:Null}, Mode=TwoWay}"
                            Style="{ThemeResource ShimmerComboBoxStyle}"
                            Visibility="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).LaunchOptions.UsingHoyolabAccount.Value, Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}"/>
                    </cwc:Case>
                    <cwc:Case>
                        <cwc:Case.Value>
                            <x:Int32>1</x:Int32>
                        </cwc:Case.Value>
                        <wl:LiquidGlassComboBox shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                            x:Name="GlassPresenter_5872_StateGlass"
                            Width="{x:Bind GlassPresenter_5872_State.Width, Mode=OneWay}"
                            Height="{x:Bind GlassPresenter_5872_State.Height, Mode=OneWay}"
                            MinWidth="{x:Bind GlassPresenter_5872_State.MinWidth, Mode=OneWay}"
                            MinHeight="{x:Bind GlassPresenter_5872_State.MinHeight, Mode=OneWay}"
                            MaxWidth="{x:Bind GlassPresenter_5872_State.MaxWidth, Mode=OneWay}"
                            MaxHeight="{x:Bind GlassPresenter_5872_State.MaxHeight, Mode=OneWay}"
                            Padding="{x:Bind shuxcth:ControlMaterialState.ComboBoxPadding(GlassPresenter_5872_State.Padding), Mode=OneWay}"
                            shuxcth:ControlMaterialState.IsManaged="True"
                            shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassPresenter_5872_State, Mode=OneWay}"
                            shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                            BorderThickness="{x:Bind GlassPresenter_5872_State.BorderThickness, Mode=OneWay}"
                            DisplayMemberPath="{x:Bind GlassPresenter_5872_State.DisplayMemberPath, Mode=OneWay}"
                            FlowDirection="{x:Bind GlassPresenter_5872_State.FlowDirection, Mode=OneWay}"
                            FontFamily="{x:Bind GlassPresenter_5872_State.FontFamily, Mode=OneWay}"
                            FontSize="{x:Bind GlassPresenter_5872_State.FontSize, Mode=OneWay}"
                            FontStyle="{x:Bind GlassPresenter_5872_State.FontStyle, Mode=OneWay}"
                            FontWeight="{x:Bind GlassPresenter_5872_State.FontWeight, Mode=OneWay}"
                            Header="{x:Bind GlassPresenter_5872_State.Header, Mode=OneWay}"
                            HeaderTemplate="{x:Bind GlassPresenter_5872_State.HeaderTemplate, Mode=OneWay}"
                            IsEditable="{x:Bind GlassPresenter_5872_State.IsEditable, Mode=OneWay}"
                            IsEnabled="{x:Bind GlassPresenter_5872_State.IsEnabled, Mode=OneWay}"
                            IsTextSearchEnabled="{x:Bind GlassPresenter_5872_State.IsTextSearchEnabled, Mode=OneWay}"
                            ItemsSource="{x:Bind GlassPresenter_5872_State.ItemsSource, Mode=OneWay}"
                            MaxDropDownHeight="{x:Bind GlassPresenter_5872_State.MaxDropDownHeight, Mode=OneWay}"
                            PlaceholderText="{x:Bind GlassPresenter_5872_State.PlaceholderText, Mode=OneWay}"
                            SelectedIndex="{x:Bind GlassPresenter_5872_State.SelectedIndex, Mode=TwoWay}"
                            SelectedValuePath="{x:Bind GlassPresenter_5872_State.SelectedValuePath, Mode=OneWay}"/>
                    </cwc:Case>
                </cwc:SwitchPresenter>
            </StackPanel>

            <cwc:SwitchPresenter
                x:Name="GlassPresenter_6542"
                Grid.Row="2"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:Button"
                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>0</x:Int32>
                    </cwc:Case.Value>
                    <Button
                        VerticalAlignment="Stretch"
                        Command="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).LaunchCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind shsg:LaunchOptions.IsGameRunning.Value, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                        Style="{ThemeResource SettingButtonStyle}">
                        <StackPanel Spacing="3">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewPageLaunchGameAction}"/>

                            <TextBlock
                                HorizontalAlignment="Center"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).LaunchStatusOptions.LaunchStatus.Description, FallbackValue={x:Null}, Mode=OneWay}"
                                Visibility="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).LaunchStatusOptions.LaunchStatus, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}"/>
                        </StackPanel>
                    </Button>
                </cwc:Case>
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>1</x:Int32>
                    </cwc:Case.Value>
                    <wl:LiquidGlassButton
                        VerticalAlignment="Stretch"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Command="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).LaunchCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind shsg:LaunchOptions.IsGameRunning.Value, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                        Style="{ThemeResource SettingButtonStyle}">
                        <StackPanel Spacing="3">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewPageLaunchGameAction}"/>

                            <TextBlock
                                HorizontalAlignment="Center"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).LaunchStatusOptions.LaunchStatus.Description, FallbackValue={x:Null}, Mode=OneWay}"
                                Visibility="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).LaunchStatusOptions.LaunchStatus, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}"/>
                        </StackPanel>
                    </wl:LiquidGlassButton>
                </cwc:Case>
            </cwc:SwitchPresenter>
        </Grid>

        <shuxc:Loading IsLoading="{x:Bind ((shvg:LaunchGameViewModelSlim)DataContext).IsInitialized, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" Style="{ThemeResource DefaultLoadingCardStyle}"/>
    </Grid>
</shuxcth:MaterialCardButton>

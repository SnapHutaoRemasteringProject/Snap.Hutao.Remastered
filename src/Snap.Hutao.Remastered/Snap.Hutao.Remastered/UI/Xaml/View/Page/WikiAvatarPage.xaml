                                    SelectionMode="Single"
                                    Visibility="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.Count, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}">
                                    <mxi:Interaction.Behaviors>
                                        <shuxb:SelectedItemInViewBehavior/>
                                    </mxi:Interaction.Behaviors>
                                </GridView>
                            </Grid>
                        </Border>
                    </Border>
                </cwc:Case>
            </cwc:SwitchPresenter>
        </Grid>

    </shuxc:StandardView>

<UserControl
    x:Class="Snap.Hutao.Remastered.UI.Xaml.Control.ChatElements.ChatMessageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvt="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:snsao="using:Snap.Hutao.Remastered.Service.AI.Observables"
    xmlns:snuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.ChatElements"
    xmlns:snuxd="using:Snap.Hutao.Remastered.UI.Xaml.Data.AI"
    xmlns:snuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    mc:Ignorable="d">

    <UserControl.Resources>
        <cvt:BoolToObjectConverter
            x:Key="ReasoningContentTitleConverter"
            FalseValue="{snuxm:ResourceString Name=UIXamlControlsChatMessageViewLabelReasoningInProgress}"
            TrueValue="{snuxm:ResourceString Name=UIXamlControlsChatMessageViewLabelReasoningCompleted}" />
        <cvt:IFormattableToStringConverter x:Key="UsageCacheHitRateTextConverter" />
        <snuxcc:ChatRoleToVisibilityConverter x:Key="UserMessageVisibilityConverter" Role="User" />
        <snuxcc:ChatRoleToVisibilityConverter
            x:Key="NonUserMessageVisibilityConverter"
            IsInverted="True"
            Role="User" />
        <snuxd:EmptyObjectToVisibilityConverter x:Key="MessageVisibilityConverter" />
        <snuxd:EmptyObjectToVisibilityConverter x:Key="UsageCountVisibilityConverter" />
        <snuxd:EmptyStringToVisibilityConverter x:Key="AuthorNameVisibilityConverter" />
        <snuxd:EmptyStringToVisibilityConverter x:Key="EmptyAuthorNameVisibilityConverter" IsInverted="True" />
        <snuxd:EmptyStringToVisibilityConverter x:Key="ErrorMetadataVisibilityConverter" />

        <DataTemplate x:Key="TextContentTemplate" x:DataType="snsao:ObservableTextContent">
            <snuxcc:ChatMarkdownSegmentView Margin="1,0,0,0" Markdown="{Binding Text}" />
        </DataTemplate>

        <DataTemplate x:Key="ReasoningContentTemplate" x:DataType="snsao:ObservableTextReasoningContent">
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource ReasoningContentTitleConverter}}"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <snuxcc:ChatMarkdownSegmentView Markdown="{x:Bind Text, Mode=OneWay}" MarkdownOpacity="0.7" />
                </ScrollViewer>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="ToolCallContentTemplate" x:DataType="snsao:ObservableToolCallContent">
            <snuxcc:ChatToolCallSegmentView ToolCall="{Binding}" />
        </DataTemplate>

        <DataTemplate x:Key="ToolResultContentTemplate" x:DataType="snsao:ObservableToolResultContent">
            <snuxcc:ChatToolResultSegmentView ToolResult="{Binding}" />
        </DataTemplate>

        <DataTemplate x:Key="UsageContentTemplate" x:DataType="snsao:ObservableUsageContent">
            <StackPanel
                Margin="1,0,0,0"
                Opacity="0.7"
                Orientation="Horizontal"
                Spacing="6">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4"
                    ToolTipService.ToolTip="{snuxm:ResourceString Name=UIXamlControlsChatMessageViewToolTipTotalTokenCount}"
                    Visibility="{Binding TotalTokenCount, Converter={StaticResource UsageCountVisibilityConverter}}">
                    <FontIcon FontSize="14" Glyph="&#xE8A9;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding TotalTokenCount}" />
                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4"
                    ToolTipService.ToolTip="{snuxm:ResourceString Name=UIXamlControlsChatMessageViewToolTipInputTokenCount}"
                    Visibility="{Binding InputTokenCount, Converter={StaticResource UsageCountVisibilityConverter}}">
                    <FontIcon FontSize="14" Glyph="&#xE70E;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding InputTokenCount}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="4"
                    ToolTipService.ToolTip="{snuxm:ResourceString Name=UIXamlControlsChatMessageViewToolTipOutputTokenCount}"
                    Visibility="{Binding OutputTokenCount, Converter={StaticResource UsageCountVisibilityConverter}}">
                    <FontIcon FontSize="14" Glyph="&#xE70D;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding OutputTokenCount}" />
                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4"
                    ToolTipService.ToolTip="{snuxm:ResourceString Name=UIXamlControlsChatMessageViewToolTipReasoningTokenCount}"
                    Visibility="{Binding ReasoningTokenCount, Converter={StaticResource UsageCountVisibilityConverter}}">
                    <FontIcon FontSize="14" Glyph="&#xE794;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding ReasoningTokenCount}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="4"
                    Orientation="Horizontal"
                    Spacing="4"
                    ToolTipService.ToolTip="{snuxm:ResourceString Name=UIXamlControlsChatMessageViewToolTipCachedInputTokenCount}"
                    Visibility="{Binding CachedInputTokenCount, Converter={StaticResource UsageCountVisibilityConverter}}">
                    <FontIcon FontSize="14" Glyph="&#xE950;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding CachedInputTokenCount}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding CacheHitRate, Converter={StaticResource UsageCacheHitRateTextConverter}, ConverterParameter=P0}"
                        Visibility="{Binding CacheHitRate, Converter={StaticResource UsageCountVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ErrorContentTemplate" x:DataType="snsao:ObservableErrorContent">
            <Border
                Padding="8"
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xEA39;" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Message}" TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Opacity="0.75"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding ErrorCode}"
                            Visibility="{Binding ErrorCode, Converter={StaticResource ErrorMetadataVisibilityConverter}}" />
                        <TextBlock
                            Opacity="0.75"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding Details}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{Binding Details, Converter={StaticResource ErrorMetadataVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FallbackContentTemplate">
            <snuxcc:ChatObjectSegmentView Value="{Binding}" />
        </DataTemplate>

        <snuxcc:ChatContentTemplateSelector
            x:Key="ChatContentTemplateSelector"
            ErrorTemplate="{StaticResource ErrorContentTemplate}"
            FallbackTemplate="{StaticResource FallbackContentTemplate}"
            ReasoningTemplate="{StaticResource ReasoningContentTemplate}"
            TextTemplate="{StaticResource TextContentTemplate}"
            ToolCallTemplate="{StaticResource ToolCallContentTemplate}"
            ToolResultTemplate="{StaticResource ToolResultContentTemplate}"
            UsageTemplate="{StaticResource UsageContentTemplate}" />
    </UserControl.Resources>

    <Border
        Padding="8"
        HorizontalAlignment="Stretch"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource ControlCornerRadius}"
        Visibility="{x:Bind Message, Mode=OneWay, Converter={StaticResource MessageVisibilityConverter}}">
        <StackPanel HorizontalAlignment="Stretch" Spacing="4">
            <Grid Margin="1,0,0,0">
                <Grid Visibility="{x:Bind Message.Role, Mode=OneWay, Converter={StaticResource UserMessageVisibilityConverter}}">
                    <TextBlock
                        FontWeight="SemiBold"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Message.AuthorName, Mode=OneWay}"
                        Visibility="{x:Bind Message.AuthorName, Mode=OneWay, Converter={StaticResource AuthorNameVisibilityConverter}}" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{snuxm:ResourceString Name=UIXamlControlsChatMessageViewLabelUser}"
                        Visibility="{x:Bind Message.AuthorName, Mode=OneWay, Converter={StaticResource EmptyAuthorNameVisibilityConverter}}" />
                </Grid>
                <Grid Visibility="{x:Bind Message.Role, Mode=OneWay, Converter={StaticResource NonUserMessageVisibilityConverter}}">
                    <TextBlock
                        FontWeight="SemiBold"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Message.AuthorName, Mode=OneWay}"
                        Visibility="{x:Bind Message.AuthorName, Mode=OneWay, Converter={StaticResource AuthorNameVisibilityConverter}}" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{snuxm:ResourceString Name=UIXamlControlsChatMessageViewLabelAssistant}"
                        Visibility="{x:Bind Message.AuthorName, Mode=OneWay, Converter={StaticResource EmptyAuthorNameVisibilityConverter}}" />
                </Grid>
            </Grid>

            <ItemsControl ItemTemplateSelector="{StaticResource ChatContentTemplateSelector}" ItemsSource="{x:Bind Message.Contents, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>

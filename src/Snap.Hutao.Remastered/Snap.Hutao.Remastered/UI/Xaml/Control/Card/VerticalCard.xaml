<ResourceDictionary
    x:Class="Snap.Hutao.Remastered.UI.Xaml.Control.Card.VerticalCardResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme">

    <Style BasedOn="{StaticResource DefaultVerticalCardStyle}" TargetType="shuxcc:VerticalCard"/>

    <Style x:Key="DefaultVerticalCardStyle" TargetType="shuxcc:VerticalCard">
        <Setter Property="BottomPadding" Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shuxcc:VerticalCard">
                    <Border Background="{TemplateBinding Background}" Style="{StaticResource BorderShimmerStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="ContentHost"
                                HorizontalAlignment="{TemplateBinding HorizontalTopAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalTopAlignment}"
                                Child="{TemplateBinding Top}"/>
                            <!--
                                Do not cap the bottom content with ContentHost.ActualWidth.
                                A template x:Bind to a template part's ActualWidth captures the
                                part's initial 0 and is never refreshed, so MaxWidth stayed 0 and
                                every caption (sign-in day, pull count, ascension label) collapsed
                                to zero width. The card already sizes itself to its top content.
                            -->
                            <Border
                                Grid.Row="1"
                                Padding="{TemplateBinding BottomPadding}"
                                HorizontalAlignment="{TemplateBinding HorizontalBottomAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalBottomAlignment}"
                                Child="{TemplateBinding Bottom}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="shuxcth:MaterialBackground.GlassBrush" Value="{ThemeResource HutaoSurfaceBrush}"/>
        <Setter Property="shuxcth:MaterialBackground.NativeBrush" Value="{ThemeResource ControlAltFillColorSecondaryBrush}"/>
    </Style>

</ResourceDictionary>

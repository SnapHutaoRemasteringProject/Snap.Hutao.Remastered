<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shuxcas="using:Snap.Hutao.Remastered.UI.Xaml.Control.AutoSortBox"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup">

    <Style BasedOn="{StaticResource DefaultAutoSortListStyle}" TargetType="shuxcas:AutoSortList"/>

    <Style x:Key="DefaultAutoSortListStyle" TargetType="shuxcas:AutoSortList">
        <Setter Property="Template" Value="{StaticResource AutoSortListTemplate}"/>
    </Style>

    <ControlTemplate x:Key="AutoSortListTemplate" TargetType="shuxcas:AutoSortList">
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Padding="12,10,12,6"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{shuxm:ResourceString Name=ViewPageBackpackSortHeader}"/>
                <ListView
                    x:Name="TokenListView"
                    Grid.Row="1"
                    IsItemClickEnabled="True"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!--  Order badge (only when selected)  -->
                                <Border
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="10"
                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding SortOrder}"/>
                                </Border>

                                <!--  Icon + Name  -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border
                                        Width="20"
                                        Height="20"
                                        Visibility="{Binding IconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}}">
                                        <Image Source="{Binding IconUri}" Width="20" Height="20"/>
                                    </Border>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Value}"/>
                                </StackPanel>

                                <!--  Direction arrows (only when selected)  -->
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <FontIcon
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE74A;"
                                        Visibility="{Binding IsDescending, Converter={StaticResource BoolToVisibilityRevertConverter}}"/>
                                    <FontIcon
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE74B;"
                                        Visibility="{Binding IsDescending, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>

                                <!--  Remove button (only when selected)  -->
                                <Button
                                    Grid.Column="3"
                                    Width="24"
                                    Height="24"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    IsTabStop="False"
                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <FontIcon
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE894;"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </ControlTemplate>
</ResourceDictionary>

<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.UserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:wl="using:WinUI.LiquidGlass"
    Title="{shuxm:ResourceString Name=ViewDialogUserTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel>
        <cwc:SwitchPresenter
            x:Name="GlassPresenter_832"
            Margin="0,0,0,8"
            VerticalAlignment="Top"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:TextBox"
            Value="{x:Bind shuxcth:MaterialBindingSource.Current.TextBoxMaterial, Mode=OneWay}">
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>0</x:Int32>
                </cwc:Case.Value>
                <TextBox
                    VerticalAlignment="Top"
                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogUserInputPlaceholder}"
                    Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </cwc:Case>
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>1</x:Int32>
                </cwc:Case.Value>
                <wl:LiquidGlassTextBox
                    VerticalAlignment="Top"
                    shuxcth:ControlMaterialState.IsManaged="True"
                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogUserInputPlaceholder}"
                    Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </cwc:Case>
        </cwc:SwitchPresenter>
        <StackPanel Margin="0,0,0,0">
            <StackPanel.Resources>
                <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                <x:Double x:Key="SettingsCardMinHeight">0</x:Double>
            </StackPanel.Resources>
            <cwc:SettingsCard
                HorizontalAlignment="Stretch"
                Description="{shuxm:ResourceString Name=ViewDialogUserDocumentDescription}"
                Header="{shuxm:ResourceString Name=ViewDialogUserDocumentHeader}"
                HeaderIcon="{shuxm:FontIcon Glyph=&#xEB41;}">
                <cwc:SwitchPresenter
                    x:Name="GlassPresenter_1738"
                    Margin="12,0,0,0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False"
                    Tag="LiquidGlass:HyperlinkButton"
                    Value="{x:Bind shuxcth:MaterialBindingSource.Current.HyperlinkButtonMaterial, Mode=OneWay}">
                    <cwc:Case>
                        <cwc:Case.Value>
                            <x:Int32>0</x:Int32>
                        </cwc:Case.Value>
                        <HyperlinkButton
                            Padding="6"
                            Content="{shuxm:ResourceString Name=ViewDialogUserDocumentAction}"
                            NavigateUri="{StaticResource DocumentLink_MhyAccountSwitch}"/>
                    </cwc:Case>
                    <cwc:Case>
                        <cwc:Case.Value>
                            <x:Int32>1</x:Int32>
                        </cwc:Case.Value>
                        <wl:LiquidGlassHyperlinkButton
                            Padding="6"
                            shuxcth:ControlMaterialState.IsManaged="True"
                            Content="{shuxm:ResourceString Name=ViewDialogUserDocumentAction}"
                            NavigateUri="{StaticResource DocumentLink_MhyAccountSwitch}"/>
                    </cwc:Case>
                </cwc:SwitchPresenter>
            </cwc:SettingsCard>
        </StackPanel>
    </StackPanel>
</ContentDialog>

<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.GitSourcesSpeedTestDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shuxvd="using:Snap.Hutao.Remastered.UI.Xaml.View.Dialog"
    xmlns:shvg="using:Snap.Hutao.Remastered.ViewModel.Git"
    Title="{shuxm:ResourceString Name=ViewDialogGitSourcesSpeedTestDialogTitle}"
    d:DataContext="{d:DesignInstance Type=shvg:GitSourcesSpeedTestDialogViewModel}"
    PrimaryButtonText="{shuxm:ResourceString Name=ViewDialogCloseButtonBehaviorSetDialogTitle}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel
        MinWidth="600"
        Padding="16"
        Spacing="12">

        <TextBlock
            FontSize="12"
            Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
            Text="{Binding StatusMessage, Mode=OneWay}"
            TextWrapping="Wrap"/>

        <ProgressBar
            x:Name="Progress"
            Height="6"
            IsIndeterminate="True"
            Visibility="Collapsed"/>

        <ListView
            x:Name="ResultList"
            Height="300"
            AllowDrop="False"
            BorderThickness="1"
            CanDragItems="False"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{Binding Url}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                Text="{Binding Status}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="RunButton"
                Padding="16,8"
                Command="{Binding RunCommand}"
                Content="{shuxm:ResourceString Name=ViewDialogGitSourcesSpeedTestDialogRunButton}"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>

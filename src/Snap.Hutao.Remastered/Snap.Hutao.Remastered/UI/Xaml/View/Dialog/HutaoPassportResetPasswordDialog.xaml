<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.HutaoPassportResetPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:wl="using:WinUI.LiquidGlass"
    Title="{shuxm:ResourceString Name=ViewDialogHutaoPassportResetPasswordTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Margin="0,8,0,0" Spacing="16">
        <cwc:SwitchPresenter
            x:Name="GlassPresenter_852"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:TextBox"
            Visibility="{x:Bind UserNameTextBox.Visibility, Mode=OneWay}"
            Value="{x:Bind shuxcth:MaterialBindingSource.Current.TextBoxMaterial, Mode=OneWay}">
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>0</x:Int32>
                </cwc:Case.Value>
                <TextBox
                    x:Name="UserNameTextBox"
                    DataContext="{x:Bind GlassPresenter_852.DataContext, Mode=OneWay}"
                    InputScope="EmailSmtpAddress"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{shuxm:ResourceString Name=ViewPageHutaoPassportUserNameHint}"
                    shuxcth:ThemeSynchronization.Source="{x:Bind GlassPresenter_852}"
                    Text="{x:Bind UserName, Mode=TwoWay}"/>
            </cwc:Case>
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>1</x:Int32>
                </cwc:Case.Value>
                <wl:LiquidGlassTextBox
                    x:Name="UserNameTextBoxGlass"
                    Width="{x:Bind UserNameTextBox.Width, Mode=OneWay}"
                    Height="{x:Bind UserNameTextBox.Height, Mode=OneWay}"
                    MinWidth="{x:Bind UserNameTextBox.MinWidth, Mode=OneWay}"
                    MinHeight="{x:Bind UserNameTextBox.MinHeight, Mode=OneWay}"
                    MaxWidth="{x:Bind UserNameTextBox.MaxWidth, Mode=OneWay}"
                    MaxHeight="{x:Bind UserNameTextBox.MaxHeight, Mode=OneWay}"
                    Padding="{x:Bind UserNameTextBox.Padding, Mode=OneWay}"
                    shuxcth:ControlMaterialState.IsManaged="True"
                    shuxcth:ControlMaterialState.NativeControl="{x:Bind UserNameTextBox, Mode=OneWay}"
                    shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                    AcceptsReturn="{x:Bind UserNameTextBox.AcceptsReturn, Mode=OneWay}"
                    BorderThickness="{x:Bind UserNameTextBox.BorderThickness, Mode=OneWay}"
                    CharacterCasing="{x:Bind UserNameTextBox.CharacterCasing, Mode=OneWay}"
                    FlowDirection="{x:Bind UserNameTextBox.FlowDirection, Mode=OneWay}"
                    FontFamily="{x:Bind UserNameTextBox.FontFamily, Mode=OneWay}"
                    FontSize="{x:Bind UserNameTextBox.FontSize, Mode=OneWay}"
                    FontStyle="{x:Bind UserNameTextBox.FontStyle, Mode=OneWay}"
                    FontWeight="{x:Bind UserNameTextBox.FontWeight, Mode=OneWay}"
                    Header="{x:Bind UserNameTextBox.Header, Mode=OneWay}"
                    HeaderTemplate="{x:Bind UserNameTextBox.HeaderTemplate, Mode=OneWay}"
                    InputScope="{x:Bind UserNameTextBox.InputScope, Mode=OneWay}"
                    IsEnabled="{x:Bind UserNameTextBox.IsEnabled, Mode=OneWay}"
                    IsReadOnly="{x:Bind UserNameTextBox.IsReadOnly, Mode=OneWay}"
                    IsSpellCheckEnabled="False"
                    MaxLength="{x:Bind UserNameTextBox.MaxLength, Mode=OneWay}"
                    PlaceholderText="{x:Bind UserNameTextBox.PlaceholderText, Mode=OneWay}"
                    SelectionHighlightColor="{x:Bind UserNameTextBox.SelectionHighlightColor, Mode=OneWay}"
                    Text="{x:Bind UserNameTextBox.Text, Mode=TwoWay}"
                    TextAlignment="{x:Bind UserNameTextBox.TextAlignment, Mode=OneWay}"
                    TextWrapping="{x:Bind UserNameTextBox.TextWrapping, Mode=OneWay}"/>
            </cwc:Case>
        </cwc:SwitchPresenter>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <cwc:SwitchPresenter
                x:Name="GlassPresenter_1330"
                Grid.Column="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:TextBox"
                Value="{x:Bind shuxcth:MaterialBindingSource.Current.TextBoxMaterial, Mode=OneWay}">
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>0</x:Int32>
                    </cwc:Case.Value>
                    <TextBox PlaceholderText="{shuxm:ResourceString Name=ViewPageHutaoPassportVerifyCodeHint}" Text="{x:Bind VerifyCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </cwc:Case>
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>1</x:Int32>
                    </cwc:Case.Value>
                    <wl:LiquidGlassTextBox
                        shuxcth:ControlMaterialState.IsManaged="True"
                        PlaceholderText="{shuxm:ResourceString Name=ViewPageHutaoPassportVerifyCodeHint}"
                        Text="{x:Bind VerifyCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </cwc:Case>
            </cwc:SwitchPresenter>
            <cwc:SwitchPresenter
                x:Name="GlassPresenter_1576"
                Grid.Column="1"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:Button"
                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>0</x:Int32>
                    </cwc:Case.Value>
                    <Button
                        VerticalAlignment="Stretch"
                        Command="{x:Bind VerifyCommand}"
                        Content="{shuxm:ResourceString Name=ViewPageHutaoPassportVerifyCodeAction}"/>
                </cwc:Case>
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>1</x:Int32>
                    </cwc:Case.Value>
                    <wl:LiquidGlassButton
                        VerticalAlignment="Stretch"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Command="{x:Bind VerifyCommand}"
                        Content="{shuxm:ResourceString Name=ViewPageHutaoPassportVerifyCodeAction}"/>
                </cwc:Case>
            </cwc:SwitchPresenter>
        </Grid>
        <StackPanel Spacing="4" Visibility="{x:Bind VerifyCode, Converter={StaticResource EmptyStringToVisibilityConverter}, Mode=OneWay}">
            <cwc:SwitchPresenter
                x:Name="GlassPresenter_1971"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:PasswordBox"
                Visibility="{x:Bind GlassNative_1971.Visibility, Mode=OneWay}"
                Value="{x:Bind shuxcth:MaterialBindingSource.Current.PasswordBoxMaterial, Mode=OneWay}">
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>0</x:Int32>
                    </cwc:Case.Value>
                    <PasswordBox
                        x:Name="GlassNative_1971"
                        DataContext="{x:Bind GlassPresenter_1971.DataContext, Mode=OneWay}"
                        IsEnabled="{x:Bind VerifyCode, Converter={StaticResource EmptyStringToBoolConverter}, Mode=OneWay}"
                        Password="{x:Bind Password, Mode=TwoWay}"
                        PasswordChar="*"
                        PlaceholderText="{shuxm:ResourceString Name=ViewPageHutaoPassportPasswordHint}"
                        shuxcth:ThemeSynchronization.Source="{x:Bind GlassPresenter_1971}"/>
                </cwc:Case>
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>1</x:Int32>
                    </cwc:Case.Value>
                    <wl:LiquidGlassPasswordBox
                        x:Name="GlassNative_1971Glass"
                        Width="{x:Bind GlassNative_1971.Width, Mode=OneWay}"
                        Height="{x:Bind GlassNative_1971.Height, Mode=OneWay}"
                        MinWidth="{x:Bind GlassNative_1971.MinWidth, Mode=OneWay}"
                        MinHeight="{x:Bind GlassNative_1971.MinHeight, Mode=OneWay}"
                        MaxWidth="{x:Bind GlassNative_1971.MaxWidth, Mode=OneWay}"
                        MaxHeight="{x:Bind GlassNative_1971.MaxHeight, Mode=OneWay}"
                        Padding="{x:Bind GlassNative_1971.Padding, Mode=OneWay}"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassNative_1971, Mode=OneWay}"
                        shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                        BorderThickness="{x:Bind GlassNative_1971.BorderThickness, Mode=OneWay}"
                        FlowDirection="{x:Bind GlassNative_1971.FlowDirection, Mode=OneWay}"
                        FontFamily="{x:Bind GlassNative_1971.FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind GlassNative_1971.FontSize, Mode=OneWay}"
                        FontStyle="{x:Bind GlassNative_1971.FontStyle, Mode=OneWay}"
                        FontWeight="{x:Bind GlassNative_1971.FontWeight, Mode=OneWay}"
                        IsEnabled="{x:Bind GlassNative_1971.IsEnabled, Mode=OneWay}"
                        Password="{x:Bind GlassNative_1971.Password, Mode=TwoWay}"
                        PlaceholderText="{x:Bind GlassNative_1971.PlaceholderText, Mode=OneWay}"/>
                </cwc:Case>
            </cwc:SwitchPresenter>
            <TextBlock
                Margin="0,4,0,0"
                Opacity="0.7"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{shuxm:ResourceString Name=ViewPageHutaoPassportPasswordRequirementHint}"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>

                        <shuxvs:HutaoStatisticsCard DataContext="{x:Bind DataContext.HutaoCloudStatisticsViewModel.Statistics.WeaponEvent, Mode=OneWay}"/>
                        <shuxvs:HutaoStatisticsCard DataContext="{x:Bind DataContext.HutaoCloudStatisticsViewModel.Statistics.Chronicled, Mode=OneWay}" Visibility="{Binding Converter={StaticResource EmptyObjectToVisibilityConverter}, FallbackValue=Collapsed}"/>
                    </shuxcp:EqualPanel>
                </Grid>

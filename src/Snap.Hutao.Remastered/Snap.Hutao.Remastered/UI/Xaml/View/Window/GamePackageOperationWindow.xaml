<Window
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Window.GamePackageOperationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shuxvs="using:Snap.Hutao.Remastered.UI.Xaml.View.Specialized"
    xmlns:shvg="using:Snap.Hutao.Remastered.ViewModel.Game"
    xmlns:wl="using:WinUI.LiquidGlass"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" d:DataContext="{d:DesignInstance shvg:GamePackageOperationViewModel}">
        <mxi:Interaction.Behaviors>
            <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ViewModel.PeriodicRefreshUICommand, Mode=OneWay}"/>
        </mxi:Interaction.Behaviors>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Opacity="{x:Bind GetBackdropOpacity(ViewModel.AppOptions.BackdropType.Value), Mode=OneWay}">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:1"/>
            </Border.OpacityTransition>
        </Border>

        <Grid
            x:Name="DraggableGrid"
            Grid.Row="0"
            Height="32"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid
                Padding="16"
                shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoCardBrush}"
                shuxcth:MaterialBackground.NativeBrush="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,1"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="1,0,0,0"
                    IsHitTestVisible="False"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"/>
                <shuxvs:SophonProgressBar
                    Grid.Row="1"
                    Description="{x:Bind ViewModel.DownloadFileName, Mode=OneWay}"
                    IconGlyph="{StaticResource FontIconContentDownload}"
                    Maximum="{x:Bind ViewModel.DownloadTotalChunks, Mode=OneWay}"
                    RemainingTime="{x:Bind ViewModel.DownloadRemainingTime, Mode=OneWay}"
                    Speed="{x:Bind ViewModel.DownloadSpeed, Mode=OneWay}"
                    Value="{x:Bind ViewModel.DownloadedChunks, Mode=OneWay}">
                    <shuxvs:SophonProgressBar.HeaderContent>
                        <dev:SpeedGraph x:Name="DownloadSpeedGraph" Height="120"/>
                    </shuxvs:SophonProgressBar.HeaderContent>
                </shuxvs:SophonProgressBar>
                <shuxvs:SophonProgressBar
                    Grid.Row="3"
                    Description="{x:Bind ViewModel.InstallFileName, Mode=OneWay}"
                    IconGlyph="{StaticResource FontIconContentHardDrive}"
                    Maximum="{x:Bind ViewModel.InstallTotalChunks, Mode=OneWay}"
                    RemainingTime="{x:Bind ViewModel.InstallRemainingTime, Mode=OneWay}"
                    Speed="{x:Bind ViewModel.InstallSpeed, Mode=OneWay}"
                    Value="{x:Bind ViewModel.InstalledChunks, Mode=OneWay}">
                    <shuxvs:SophonProgressBar.HeaderContent>
                        <dev:SpeedGraph x:Name="InstallSpeedGraph" Height="120"/>
                    </shuxvs:SophonProgressBar.HeaderContent>
                </shuxvs:SophonProgressBar>
            </Grid>
        </ScrollViewer>

        <wl:LiquidGlassButton
            Grid.Row="2"
            Margin="16"
            MinWidth="120"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Visibility="{x:Bind GetVisibility(ViewModel.CanCancel), Mode=OneWay}"
            shuxcth:ControlMaterialState.IsManaged="True"
            Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}"
            Content="{shuxm:ResourceString Name=ContentDialogPauseButtonText}"/>
        <wl:LiquidGlassButton
            Grid.Row="2"
            Margin="16"
            MinWidth="120"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Visibility="{x:Bind GetVisibility(ViewModel.CanContinue), Mode=OneWay}"
            shuxcth:ControlMaterialState.IsManaged="True"
            Command="{x:Bind ViewModel.ContinueCommand, Mode=OneWay}"
            Content="{shuxm:ResourceString Name=ViewModelGamePackageOperationContinueDownloadButtonText}"/>
        <wl:LiquidGlassButton
            Grid.Row="2"
            Margin="16"
            MinWidth="120"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Visibility="{x:Bind GetVisibility(ViewModel.IsFinished), Mode=OneWay}"
            shuxcth:ControlMaterialState.IsManaged="True"
            Command="{x:Bind CloseCommand}"
            Content="{shuxm:ResourceString Name=ContentDialogCompletePrimaryButtonText}"/>
    </Grid>
</Window>

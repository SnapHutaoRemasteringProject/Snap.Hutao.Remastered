<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.WikiMonsterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:clw="using:CommunityToolkit.Labs.WinUI"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shm="using:Snap.Hutao.Remastered.Model"
    xmlns:shmmi="using:Snap.Hutao.Remastered.Model.Metadata.Item"
    xmlns:shmmm="using:Snap.Hutao.Remastered.Model.Metadata.Monster"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxca="using:Snap.Hutao.Remastered.UI.Xaml.Control.AutoSuggestBox"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxct="using:Snap.Hutao.Remastered.UI.Xaml.Control.TextBlock"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shuxvs="using:Snap.Hutao.Remastered.UI.Xaml.View.Specialized"
    xmlns:shvw="using:Snap.Hutao.Remastered.ViewModel.Wiki"
    d:DataContext="{d:DesignInstance Type=shvw:WikiMonsterViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <DataTemplate x:Key="TokenTemplate" x:DataType="shuxca:SearchToken">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <shuxci:CachedImage
                    Grid.Column="0"
                    Width="22"
                    Height="22"
                    Margin="0,0,8,0"
                    Source="{x:Bind SideIconUri, Mode=OneTime}"/>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{x:Bind Value, Mode=OneTime}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MonsterListTemplate" x:DataType="shmmm:Monster">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <shuxci:CachedImage
                    Grid.Column="0"
                    Width="48"
                    Height="48"
                    Margin="0,6,12,6"
                    Source="{x:Bind Icon, Converter={StaticResource MonsterIconConverter}, Mode=OneWay}"/>
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Text="{x:Bind Name, Mode=OneWay}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MonsterBaseValueTemplate" x:DataType="shm:NameStringValue">
            <cwc:SettingsCard
                MinHeight="40"
                Padding="0,0,16,0"
                shuxcth:MaterialBackground.NativeBrush="{ThemeResource ControlAltFillColorSecondaryBrush}"
                shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoSurfaceBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                <cwc:SettingsCard.Resources>
                    <!--  ReSharper disable Xaml.RedundantResource  -->
                    <x:Double x:Key="SettingsCardLeftIndention">16</x:Double>
                    <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                    <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                    <!--  ReSharper restore Xaml.RedundantResource  -->
                </cwc:SettingsCard.Resources>
                <cwc:SettingsCard.Header>
                    <TextBlock Text="{Binding Name, Mode=OneWay}" TextWrapping="NoWrap"/>
                </cwc:SettingsCard.Header>
                <TextBlock Text="{Binding Value, Mode=OneWay}"/>
            </cwc:SettingsCard>
        </DataTemplate>

        <DataTemplate x:Key="MonsterDropTemplate" x:DataType="shmmi:DisplayItem">
            <shuxcc:HorizontalCard>
                <shuxcc:HorizontalCard.Left>
                    <shuxc:ItemIcon
                        Width="40"
                        Height="40"
                        Icon="{x:Bind Icon, Converter={StaticResource ItemIconConverter}, Mode=OneWay}"
                        Quality="{x:Bind RankLevel, Mode=OneWay}"/>
                </shuxcc:HorizontalCard.Left>
                <shuxcc:HorizontalCard.Right>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{x:Bind Name, Mode=OneWay}"/>
                </shuxcc:HorizontalCard.Right>
            </shuxcc:HorizontalCard>
        </DataTemplate>

        <DataTemplate x:Key="MonsterGridTemplate" x:DataType="shmmm:Monster">
            <shuxcc:VerticalCard Width="82">
                <shuxcc:VerticalCard.Top>
                    <shuxc:ItemIcon Icon="{x:Bind Icon, Converter={StaticResource MonsterIconConverter}, Mode=OneWay}" Quality="QUALITY_NONE"/>
                </shuxcc:VerticalCard.Top>
                <shuxcc:VerticalCard.Bottom>
                    <TextBlock
                        Margin="2,0"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"/>
                </shuxcc:VerticalCard.Bottom>
            </shuxcc:VerticalCard>
        </DataTemplate>
    </Page.Resources>

    <shuxc:StandardView ShowCondition="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).Monsters, Converter={StaticResource EmptyObjectToBoolConverter}, Mode=OneWay}">
        <shuxc:StandardView.EmptyContent>
            <shuxc:Loading IsLoading="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).Monsters, Converter={StaticResource EmptyObjectToBoolRevertConverter}, Mode=OneWay}" Style="{ThemeResource DefaultLoadingViewStyle}"/>
        </shuxc:StandardView.EmptyContent>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border Style="{ThemeResource AcrylicSecondaryBorderCardStyle}">
                    <CommandBar
                        BorderBrush="{x:Null}"
                        BorderThickness="0"
                        DefaultLabelPosition="Right">
                        <CommandBar.Content>
                            <shuxc:LayoutSwitch
                                x:Name="ItemsPanelSelector"
                                Margin="6,8,0,0"
                                LocalSettingKeySuffixForCurrent="WikiMonsterPage.Monsters"/>
                        </CommandBar.Content>
                        <AppBarElementContainer>
                            <shuxca:AutoSuggestTokenBox
                                Width="600"
                                Height="44"
                                Margin="6,-2,6,6"
                                HorizontalAlignment="Right"
                                VerticalContentAlignment="Center"
                                AvailableTokens="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).SearchData.AvailableTokens, Mode=OneWay}"
                                FilterCommand="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).FilterCommand, Mode=OneWay}"
                                ItemsSource="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).SearchData.FilterTokens, Mode=OneWay}"
                                MaximumTokens="5"
                                PlaceholderText="{shuxm:ResourceString Name=ViewPageWiKiMonsterAutoSuggestBoxPlaceHolder}"
                                QueryIcon="{cw:FontIconSource Glyph=&#xE721;}"
                                Style="{StaticResource DefaultAutoSuggestTokenBoxStyle}"
                                SuggestedItemTemplate="{StaticResource TokenTemplate}"
                                SuggestedItemsSource="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).SearchData.AvailableTokens.Values, Mode=OneWay}"
                                Text="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).SearchData.FilterToken, Mode=TwoWay}"
                                TokenItemTemplate="{StaticResource TokenTemplate}"/>
                        </AppBarElementContainer>
                    </CommandBar>
                </Border>
            </Border>

            <cwc:SwitchPresenter
                Grid.Row="1"
                ContentTransitions="{ThemeResource EntranceThemeTransitions}"
                Value="{x:Bind ItemsPanelSelector.Current, Mode=OneWay}">
                <cwc:Case Value="List">
                    <Border Margin="16,0,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                        <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                            <SplitView
                                DisplayMode="Inline"
                                IsPaneOpen="True"
                                OpenPaneLength="{StaticResource CompatSplitViewOpenPaneLength2}"
                                shuxcth:MaterialBackground.NativePaneBrush="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                shuxcth:MaterialBackground.GlassPaneBrush="{ThemeResource HutaoSurfaceBrush}">
                                <SplitView.Pane>
                                    <ListView
                                        Grid.Row="1"
                                        Padding="{ThemeResource ListViewInSplitPanePadding}"
                                        ItemTemplate="{StaticResource MonsterListTemplate}"
                                        ItemsSource="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).Monsters, Mode=OneWay}"
                                        SelectedItem="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).Monsters.CurrentItem, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <mxi:Interaction.Behaviors>
                                            <shuxb:SelectedItemInViewBehavior/>
                                        </mxi:Interaction.Behaviors>
                                    </ListView>
                                </SplitView.Pane>
                                <SplitView.Content>
                                    <ScrollViewer shuxc:ScrollViewerHelper.ScrollToTopAssociatedObject="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).Monsters.CurrentItem, Mode=OneWay}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition MaxWidth="800"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Padding="16" Spacing="16">
                                                <StackPanel.ChildrenTransitions>
                                                    <EntranceThemeTransition FromVerticalOffset="50"/>
                                                    <RepositionThemeTransition IsStaggeringEnabled="False"/>
                                                </StackPanel.ChildrenTransitions>
                                                <TextBlock
                                                    Margin="1,0,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                                    Text="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).Monsters.CurrentItem.Title, Mode=OneWay}"/>
                                                <shuxct:DescriptionTextBlock
                                                    Margin="1,0,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Description="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).Monsters.CurrentItem.Description, Mode=OneWay}"
                                                    Opacity="0.7"
                                                    TextStyle="{StaticResource CaptionTextBlockStyle}"/>
                                                <clw:TokenView ItemsSource="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).Monsters.CurrentItem.Affixes, Mode=OneWay}" SelectionMode="None"/>
                                                <shuxvs:BaseValueSlider
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    BaseValueInfo="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).BaseValueInfo, Mode=OneWay}"
                                                    IsPromoteVisible="False"/>
                                                <ItemsControl
                                                    ItemTemplate="{StaticResource MonsterBaseValueTemplate}"
                                                    ItemsPanel="{StaticResource UniformGridColumns2Spacing4Template}"
                                                    ItemsSource="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).Monsters.CurrentItem.BaseValue.SubHurts, Mode=OneWay}">
                                                    <ItemsControl.Resources>
                                                        <!--  ReSharper disable Xaml.RedundantResource  -->
                                                        <x:Double x:Key="SettingsCardMinHeight">0</x:Double>
                                                        <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                                                        <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                                                        <!--  ReSharper restore Xaml.RedundantResource  -->
                                                    </ItemsControl.Resources>
                                                </ItemsControl>
                                                <Border Padding="16" Style="{ThemeResource BorderShimmerStyle}">
                                                    <StackPanel Spacing="16">
                                                        <TextBlock
                                                            Style="{StaticResource BaseTextBlockStyle}"
                                                            Text="{shuxm:ResourceString Name=ViewPageWikiMonsterDropItems}"
                                                            Visibility="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).Monsters.CurrentItem.DropsView, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}"/>
                                                        <ItemsControl
                                                            ItemTemplate="{StaticResource MonsterDropTemplate}"
                                                            ItemsSource="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).Monsters.CurrentItem.DropsView, Mode=OneWay}"
                                                            Visibility="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).Monsters.CurrentItem.DropsView, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <cwc:UniformGrid
                                                                        ColumnSpacing="8"
                                                                        Columns="3"
                                                                        RowSpacing="8"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </SplitView.Content>
                            </SplitView>
                        </Border>
                    </Border>
                </cwc:Case>
                <cwc:Case Value="Grid">
                    <Border Margin="16,0,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                        <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                            <GridView
                                Padding="16,16,4,4"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                ItemContainerStyle="{StaticResource LargeGridViewItemStyle}"
                                ItemTemplate="{StaticResource MonsterGridTemplate}"
                                ItemsSource="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).Monsters, Mode=OneWay}"
                                SelectedItem="{x:Bind ((shvw:WikiMonsterViewModel)DataContext).Monsters.CurrentItem, Mode=TwoWay}"
                                SelectionMode="Single">
                                <mxi:Interaction.Behaviors>
                                    <shuxb:SelectedItemInViewBehavior/>
                                </mxi:Interaction.Behaviors>
                            </GridView>
                        </Border>
                    </Border>
                </cwc:Case>
            </cwc:SwitchPresenter>
        </Grid>
    </shuxc:StandardView>
</shuxc:ScopedPage>

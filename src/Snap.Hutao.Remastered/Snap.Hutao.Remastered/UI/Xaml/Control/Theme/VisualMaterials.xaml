<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hlsl="using:WinUI.Composition.Hlsl">
    <shuxcth:ControlMaterialState xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme" x:Key="ControlMaterialState"/>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <hlsl:LiquidGlassBrush
                x:Key="HutaoTitleCardBrush"
                BlurRadius="0"
                BorderThickness="0"
                CornerRadius="8"
                DispersionStrength="1.2"
                FallbackColor="#E6FFFFFF"
                GlassThickness="10"
                HighlightStrength="1.6"
                InnerShadowStrength="0.1"
                IsEnabled="False"
                MagnificationStrength="45"
                MaterialOpacity="1"
                RefractionStrength="50"
                RefractiveIndex="3"
                Saturation="1"
                SpecularSaturation="1"/>
            <hlsl:LiquidGlassBrush
                x:Key="HutaoCardBrush"
                BlurRadius="0"
                BorderThickness="0"
                CornerRadius="4"
                DispersionStrength="1.2"
                FallbackColor="#E6FFFFFF"
                GlassThickness="10"
                HighlightStrength="1.6"
                InnerShadowStrength="0.1"
                IsEnabled="False"
                MagnificationStrength="45"
                MaterialOpacity="1"
                RefractionStrength="50"
                RefractiveIndex="3"
                Saturation="1"
                SpecularSaturation="1"/>
            <hlsl:LiquidGlassBrush
                x:Key="HutaoSurfaceBrush"
                BlurRadius="0"
                BorderThickness="0"
                CornerRadius="4"
                DispersionStrength="0.8"
                FallbackColor="#D9FFFFFF"
                GlassThickness="10"
                HighlightStrength="1.6"
                InnerShadowStrength="0.1"
                IsEnabled="False"
                MagnificationStrength="45"
                MaterialOpacity="1"
                RefractionStrength="50"
                RefractiveIndex="3"
                Saturation="1"
                SpecularSaturation="1"/>
            <hlsl:LiquidGlassBrush
                x:Key="HutaoGuideLiquidGlassBrush"
                BlurRadius="0"
                BorderThickness="0"
                CornerRadius="16"
                DispersionStrength="1.2"
                FallbackColor="#E6FFFFFF"
                GlassThickness="10"
                HighlightStrength="1.6"
                InnerShadowStrength="0.1"
                IsEnabled="False"
                MagnificationStrength="45"
                MaterialOpacity="1"
                RefractionStrength="50"
                RefractiveIndex="3"
                Saturation="1"
                SpecularSaturation="1"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <hlsl:LiquidGlassBrush
                x:Key="HutaoTitleCardBrush"
                BlurRadius="0"
                BorderThickness="0"
                CornerRadius="8"
                DispersionStrength="1.2"
                FallbackColor="#D92C2C2C"
                GlassThickness="10"
                HighlightStrength="1.6"
                InnerShadowStrength="0.1"
                IsEnabled="False"
                MagnificationStrength="45"
                MaterialOpacity="1"
                RefractionStrength="50"
                RefractiveIndex="3"
                Saturation="1"
                SpecularSaturation="1"/>
            <hlsl:LiquidGlassBrush
                x:Key="HutaoCardBrush"
                BlurRadius="0"
                BorderThickness="0"
                CornerRadius="4"
                DispersionStrength="1.2"
                FallbackColor="#D92C2C2C"
                GlassThickness="10"
                HighlightStrength="1.6"
                InnerShadowStrength="0.1"
                IsEnabled="False"
                MagnificationStrength="45"
                MaterialOpacity="1"
                RefractionStrength="50"
                RefractiveIndex="3"
                Saturation="1"
                SpecularSaturation="1"/>
            <hlsl:LiquidGlassBrush
                x:Key="HutaoSurfaceBrush"
                BlurRadius="0"
                BorderThickness="0"
                CornerRadius="4"
                DispersionStrength="0.8"
                FallbackColor="#CC2C2C2C"
                GlassThickness="10"
                HighlightStrength="1.6"
                InnerShadowStrength="0.1"
                IsEnabled="False"
                MagnificationStrength="45"
                MaterialOpacity="1"
                RefractionStrength="50"
                RefractiveIndex="3"
                Saturation="1"
                SpecularSaturation="1"/>
            <hlsl:LiquidGlassBrush
                x:Key="HutaoGuideLiquidGlassBrush"
                BlurRadius="0"
                BorderThickness="0"
                CornerRadius="16"
                DispersionStrength="1.2"
                FallbackColor="#D92C2C2C"
                GlassThickness="10"
                HighlightStrength="1.6"
                InnerShadowStrength="0.1"
                IsEnabled="False"
                MagnificationStrength="45"
                MaterialOpacity="1"
                RefractionStrength="50"
                RefractiveIndex="3"
                Saturation="1"
                SpecularSaturation="1"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="HutaoTitleCardBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="HutaoCardBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="HutaoSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="HutaoGuideLiquidGlassBrush" Color="{ThemeResource SystemColorWindowColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>

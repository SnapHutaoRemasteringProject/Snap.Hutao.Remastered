<UserControl
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Specialized.StatisticsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwconv="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shux="using:Snap.Hutao.Remastered.UI.Xaml"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxdcs="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter.Specialized"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shuxvs="using:Snap.Hutao.Remastered.UI.Xaml.View.Specialized"
    xmlns:shvg="using:Snap.Hutao.Remastered.ViewModel.GachaLog"
    xmlns:wl="using:WinUI.LiquidGlass"
    cw:Effects.Shadow="{ThemeResource CompatCardShadow}"
    d:DataContext="{d:DesignInstance shvg:TypedWishSummary}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <cwconv:BoolToObjectConverter
                        x:Key="BoolToBrushConverter"
                        FalseValue="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        TrueValue="{ThemeResource ControlAltFillColorSecondaryBrush}"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <cwconv:BoolToObjectConverter
                        x:Key="BoolToBrushConverter"
                        FalseValue="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        TrueValue="{ThemeResource ControlAltFillColorSecondaryBrush}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <shuxdcs:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter"/>
            <shuxdcs:BoolToGridLengthConverter
                x:Key="BoolToGridLengthSpacingConverter"
                FalseValue="0"
                TrueValue="4"/>

            <shuxdcs:Int32ToGradientColorConverter x:Key="Int32ToGradientColorConverter" MaximumValue="{Binding GuaranteeOrangeThreshold}"/>

            <DataTemplate x:Key="SummaryListTemplate" x:DataType="shvg:SummaryItem">
                <Grid Margin="0" Style="{ThemeResource GridShimmerStyle}">
                    <ToolTipService.ToolTip>
                        <TextBlock Text="{x:Bind FormattedTime, Mode=OneWay}"/>
                    </ToolTipService.ToolTip>

                    <ProgressBar
                        MinHeight="40"
                        Background="Transparent"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Maximum="{x:Bind GuaranteeOrangeThreshold, Mode=OneWay}"
                        Opacity="{StaticResource LargeBackgroundProgressBarOpacity}"
                        Value="{x:Bind LastPull, Mode=OneWay}">
                        <ProgressBar.Foreground>
                            <SolidColorBrush Color="{x:Bind LastPull, Converter={StaticResource Int32ToGradientColorConverter}, Mode=OneWay}"/>
                        </ProgressBar.Foreground>
                    </ProgressBar>

                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <shuxci:CachedImage
                            shux:FrameworkElementHelper.SquareLength="40"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Source="{x:Bind Icon, Mode=OneWay}"/>
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Text="{x:Bind Name, Mode=OneWay}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{x:Bind Color, Mode=OneWay}"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource GuaranteePullColorBrush}"
                            Text="{shuxm:ResourceString Name=ViewControlStatisticsCardGuaranteeText}"
                            Visibility="{x:Bind IsGuarantee, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource UpPullColorBrush}"
                            Text="{shuxm:ResourceString Name=ViewControlStatisticsCardUpText}"
                            Visibility="{x:Bind IsUp, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>

                        <TextBlock
                            MinWidth="24"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind LastPull, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="NoWrap"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="OrangeGridTemplate" x:DataType="shvg:SummaryItem">
                <shuxcc:VerticalCard
                    Background="{Binding IsUp, Converter={ThemeResource BoolToBrushConverter}, Mode=OneWay}"
                    BottomPadding="0,1"
                    ToolTipService.ToolTip="{x:Bind FormattedTime, Mode=OneWay}">
                    <shuxcc:VerticalCard.Top>
                        <shuxc:ItemIcon
                            shux:FrameworkElementHelper.SquareLength="40"
                            Icon="{x:Bind Icon, Mode=OneWay}"
                            Quality="{x:Bind Quality, Mode=OneWay}"/>
                    </shuxcc:VerticalCard.Top>
                    <shuxcc:VerticalCard.Bottom>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind LastPull, Mode=OneWay}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{x:Bind Color, Mode=OneWay}"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </shuxcc:VerticalCard.Bottom>
                </shuxcc:VerticalCard>
            </DataTemplate>
        </ResourceDictionary>

    </UserControl.Resources>

    <StackPanel Style="{ThemeResource AcrylicStackPanelCardStyle}">
        <StackPanel.ChildrenTransitions>
            <EntranceThemeTransition FromVerticalOffset="50"/>
            <RepositionThemeTransition IsStaggeringEnabled="False"/>
        </StackPanel.ChildrenTransitions>
        <Expander
            x:Name="DetailExpander"
            Padding="12,0,12,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Background="Transparent"
            BorderBrush="{x:Null}"
            BorderThickness="0"
            CornerRadius="4,4,0,0"
            IsExpanded="True">
            <Expander.Resources>
                <!--  ReSharper disable once Xaml.RedundantResource  -->
                <Thickness x:Key="ExpanderHeaderBorderThickness">0,0,0,1</Thickness>
            </Expander.Resources>
            <Expander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{Binding Name}"
                        TextWrapping="NoWrap"/>
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,-12,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Viewbox StretchDirection="DownOnly" Visibility="{x:Bind DetailExpander.IsExpanded, Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{Binding FormattedTotalCount}"
                                TextTrimming="None"
                                TextWrapping="NoWrap"/>
                        </Viewbox>
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_9122"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:ToggleButton"
                            Visibility="{x:Bind CombinedModeToggle.Visibility, Mode=OneWay}"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleButtonMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <ToggleButton
                                    x:Name="CombinedModeToggle"
                                    VerticalAlignment="Center"
                                    shuxcth:ThemeSynchronization.Source="{x:Bind GlassPresenter_9122}"
                                    DataContext="{x:Bind GlassPresenter_9122.DataContext, Mode=OneWay}"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    IsChecked="{x:Bind ShowCombinedTotal, Mode=TwoWay}"
                                    ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewControlStatisticsCardCombinedModeTooltip}"
                                    Visibility="{x:Bind ShowCombinedModeToggle, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <TextBlock FontSize="14" Text="&#x2605;"/>
                                </ToggleButton>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassToggleButton
                                    x:Name="CombinedModeToggleGlass"
                                    Width="{x:Bind CombinedModeToggle.Width, Mode=OneWay}"
                                    Height="{x:Bind CombinedModeToggle.Height, Mode=OneWay}"
                                    MinWidth="{x:Bind CombinedModeToggle.MinWidth, Mode=OneWay}"
                                    MinHeight="{x:Bind CombinedModeToggle.MinHeight, Mode=OneWay}"
                                    MaxWidth="{x:Bind CombinedModeToggle.MaxWidth, Mode=OneWay}"
                                    MaxHeight="{x:Bind CombinedModeToggle.MaxHeight, Mode=OneWay}"
                                    Padding="{x:Bind CombinedModeToggle.Padding, Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    shuxcth:ControlMaterialState.NativeControl="{x:Bind CombinedModeToggle, Mode=OneWay}"
                                    shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                                    BorderThickness="{x:Bind CombinedModeToggle.BorderThickness, Mode=OneWay}"
                                    Command="{x:Bind CombinedModeToggle.Command, Mode=OneWay}"
                                    CommandParameter="{x:Bind CombinedModeToggle.CommandParameter, Mode=OneWay}"
                                    FlowDirection="{x:Bind CombinedModeToggle.FlowDirection, Mode=OneWay}"
                                    FontFamily="{x:Bind CombinedModeToggle.FontFamily, Mode=OneWay}"
                                    FontSize="{x:Bind CombinedModeToggle.FontSize, Mode=OneWay}"
                                    FontStyle="{x:Bind CombinedModeToggle.FontStyle, Mode=OneWay}"
                                    FontWeight="{x:Bind CombinedModeToggle.FontWeight, Mode=OneWay}"
                                    IsChecked="{x:Bind ShowCombinedTotal, Mode=TwoWay}"
                                    IsEnabled="{x:Bind CombinedModeToggle.IsEnabled, Mode=OneWay}"
                                    ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewControlStatisticsCardCombinedModeTooltip}">
                                    <TextBlock FontSize="14" Text="&#x2605;"/>
                                </wl:LiquidGlassToggleButton>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                        <shuxc:LayoutSwitch
                            x:Name="ItemsPanelSelector"
                            Margin="6,0,0,0"
                            Current="Grid"
                            LocalSettingKeyExtraForCurrent="{Binding TypeName}"
                            LocalSettingKeySuffixForCurrent="StatisticsCard.SummaryList"
                            Visibility="{x:Bind DetailExpander.IsExpanded, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
            </Expander.Header>

            <StackPanel>
                <StackPanel Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,4,0,4"
                            FontFamily="{StaticResource CascadiaMonoAndMiSans}"
                            FontSize="48"
                            Text="{Binding TotalCount}"/>
                        <TextBlock
                            Margin="12,0,0,12"
                            VerticalAlignment="Bottom"
                            Text="{shuxm:ResourceString Name=ViewControlStatisticsCardPullText}"/>
                    </StackPanel>

                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <shuxcc:CardProgressBar
                            Grid.Column="0"
                            MinHeight="32"
                            Description="{Binding LastOrangePull}"
                            Header="{shuxm:ResourceString Name=ViewControlStatisticsCardToLastOrangeText}"
                            Maximum="{Binding GuaranteeOrangeThreshold}"
                            ProgressForeground="{StaticResource OrangeColorBrush}"
                            TextForeground="{StaticResource OrangeColorBrush}"
                            Value="{Binding LastOrangePull}"/>
                        <shuxcc:CardProgressBar
                            Grid.Column="1"
                            MinHeight="32"
                            Description="{Binding LastPurplePull}"
                            Header="{shuxm:ResourceString Name=ViewControlStatisticsCardToLastPurpleText}"
                            Maximum="{Binding GuaranteePurpleThreshold}"
                            ProgressForeground="{StaticResource PurpleColorBrush}"
                            TextForeground="{StaticResource PurpleColorBrush}"
                            Value="{Binding LastPurplePull}"/>
                    </Grid>
                </StackPanel>
                <Grid Margin="-12,-2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <MenuFlyoutSeparator Grid.Column="0"/>
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        Opacity="0.6"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{Binding FormattedTimeSpan}"/>
                    <MenuFlyoutSeparator Grid.Column="2"/>
                </Grid>

                <shuxvs:StatisticsSegmented
                    x:Name="StatisticsSegmented"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Stretch"
                    IsPredictPullAvailable="{Binding IsPredictPullAvailable}"
                    SelectedIndex="0"/>
                <cwc:SwitchPresenter
                    Height="96"
                    Padding="0,12"
                    Value="{x:Bind StatisticsSegmented.SelectedIndex, Mode=OneWay}">
                    <cwc:Case Value="{shuxm:Int32 Value=0}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="{x:Bind ShowUpPull, Converter={StaticResource BoolToGridLengthSpacingConverter}}"/>
                                <ColumnDefinition Width="{x:Bind ShowUpPull, Converter={StaticResource BoolToGridLengthConverter}}"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{ThemeResource BorderShimmerStyle}">
                                <Viewbox Margin="8,0" StretchDirection="DownOnly">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock
                                            Opacity="0.8"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{shuxm:ResourceString Name=ViewControlStatisticsCardOrangeAveragePullText}"/>
                                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{Binding FormattedAverageOrangePull}"/>
                                    </StackPanel>
                                </Viewbox>
                            </Border>
                            <Border Grid.Column="2" Style="{ThemeResource BorderShimmerStyle}">
                                <Viewbox Margin="8,0" StretchDirection="DownOnly">
                                    <Grid>
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ShowUpPull, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock
                                                Opacity="0.8"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{shuxm:ResourceString Name=ViewControlStatisticsCardUpAveragePullText}"/>
                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{Binding FormattedAverageUpOrangePull}"/>
                                        </StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="N/A"
                                            Visibility="{x:Bind ShowUpPull, Converter={StaticResource BoolToVisibilityRevertConverter}}"/>
                                    </Grid>
                                </Viewbox>
                            </Border>

                            <Grid Grid.Column="4" RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{ThemeResource BorderShimmerStyle}">
                                    <Viewbox Margin="8,0" StretchDirection="DownOnly">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{Binding FormattedMaxOrangePull}"/>
                                    </Viewbox>
                                </Border>
                                <Border Grid.Row="1" Style="{ThemeResource BorderShimmerStyle}">
                                    <Viewbox Margin="8,0" StretchDirection="DownOnly">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{Binding FormattedMinOrangePull}"/>
                                    </Viewbox>
                                </Border>
                            </Grid>
                        </Grid>
                    </cwc:Case>
                    <cwc:Case Value="{shuxm:Int32 Value=1}">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Style="{ThemeResource GridShimmerStyle}">
                                <StackPanel
                                    Margin="8,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Foreground="{StaticResource OrangeColorBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{shuxm:ResourceString Name=ViewControlStatisticsCardOrangeText}"/>
                                    <Viewbox StretchDirection="DownOnly">
                                        <TextBlock Foreground="{StaticResource OrangeColorBrush}" Text="{Binding FormattedTotalOrange}"/>
                                    </Viewbox>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Column="1" Style="{ThemeResource GridShimmerStyle}">
                                <StackPanel
                                    Margin="8,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Foreground="{StaticResource PurpleColorBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{shuxm:ResourceString Name=ViewControlStatisticsCardPurpleText}"/>
                                    <Viewbox StretchDirection="DownOnly">
                                        <TextBlock Foreground="{StaticResource PurpleColorBrush}" Text="{Binding FormattedTotalPurple}"/>
                                    </Viewbox>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Column="2" Style="{ThemeResource GridShimmerStyle}">
                                <StackPanel
                                    Margin="8,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Foreground="{StaticResource BlueColorBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{shuxm:ResourceString Name=ViewControlStatisticsCardBlueText}"/>
                                    <Viewbox StretchDirection="DownOnly">
                                        <TextBlock Foreground="{StaticResource BlueColorBrush}" Text="{Binding FormattedTotalBlue}"/>
                                    </Viewbox>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </cwc:Case>
                    <cwc:Case Value="{shuxm:Int32 Value=2}">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{ThemeResource BorderShimmerStyle}">
                                <Viewbox StretchDirection="DownOnly">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{Binding FormattedPredictedPullLeftToOrange}"/>
                                </Viewbox>
                            </Border>
                            <Border Grid.Row="1" Style="{ThemeResource BorderShimmerStyle}">
                                <Viewbox StretchDirection="DownOnly">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{Binding FormattedProbabilityOfNextPullIsOrange}"/>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </cwc:Case>
                </cwc:SwitchPresenter>
                <MenuFlyoutSeparator Margin="-12,0"/>
            </StackPanel>
        </Expander>

        <cwc:SwitchPresenter
            Grid.Row="2"
            Margin="12,0"
            ContentTransitions="{StaticResource EntranceThemeTransitions}"
            Value="{x:Bind ItemsPanelSelector.Current, Mode=OneWay}">
            <cwc:Case Value="List">
                <ListView
                    Padding="0,6,0,12"
                    ItemContainerStyle="{StaticResource NoneSelectionListViewItemStyle}"
                    ItemTemplate="{StaticResource SummaryListTemplate}"
                    ItemsSource="{Binding DisplayList}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="None"/>
            </cwc:Case>
            <cwc:Case Value="Grid">
                <GridView
                    Margin="0,0,-2,-4"
                    Padding="0,12"
                    ItemContainerStyle="{StaticResource NoneSelectionGridViewItemStyle}"
                    ItemTemplate="{ThemeResource OrangeGridTemplate}"
                    ItemsSource="{Binding DisplayList}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="None"/>
            </cwc:Case>
        </cwc:SwitchPresenter>

    </StackPanel>

</UserControl>

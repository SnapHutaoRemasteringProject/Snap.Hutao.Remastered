<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxctb="using:Snap.Hutao.Remastered.UI.Xaml.Control.TextBlock">

    <Style TargetType="shuxc:ItemFlyoutContent">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shuxc:ItemFlyoutContent">
                    <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                        <StackPanel MaxWidth="280" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <shuxc:ItemIcon
                                    Width="48"
                                    Height="48"
                                    Icon="{Binding IconUri}"
                                    Quality="{Binding Quality}"/>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Name}"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding TypeDescription}"/>
                                </StackPanel>
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                            <shuxctb:DescriptionTextBlock Description="{Binding Description}"/>
                            <Rectangle
                                Height="1"
                                Fill="{ThemeResource ControlStrokeColorDefaultBrush}"
                                Visibility="{Binding HasSetDescriptions, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{Binding SetDescriptions}" Visibility="{Binding HasSetDescriptions, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <shuxctb:DescriptionTextBlock Margin="0,2,0,0" Description="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Spacing="8" Visibility="{Binding HasEquippedAvatar, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Rectangle Height="1" Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!--  Same bust and same shift ratio as EquippedAvatarBadgeTemplate, only larger; the clip keeps it from poking through the separator above  -->
                                    <Grid Width="36" Height="36">
                                        <Grid.Clip>
                                            <RectangleGeometry Rect="0,0,36,36"/>
                                        </Grid.Clip>
                                        <shuxci:CachedImage
                                            Width="36"
                                            Height="36"
                                            Margin="0,-4,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Source="{Binding EquippedAvatarIconUri}"/>
                                    </Grid>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding EquippedAvatarDisplayName}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.GachaLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwconv="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxba="using:Snap.Hutao.Remastered.UI.Xaml.Behavior.Action"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcp="using:Snap.Hutao.Remastered.UI.Xaml.Control.Panel"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shuxvs="using:Snap.Hutao.Remastered.UI.Xaml.View.Specialized"
    xmlns:shvg="using:Snap.Hutao.Remastered.ViewModel.GachaLog"
    xmlns:wl="using:WinUI.LiquidGlass"
    x:Name="RootPage"
    d:DataContext="{d:DesignInstance shvg:GachaLogViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind DataContext.LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <cwconv:BoolNegationConverter x:Key="BoolNegationConverter"/>
        <cwconv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <cwconv:BoolToObjectConverter
            x:Key="BoolNegationToVisibilityConverter"
            FalseValue="Visible"
            TrueValue="Collapsed"/>
        <cwconv:DoubleToObjectConverter
            x:Key="DoubleToOpacityConverter"
            FalseValue="0.4"
            GreaterThan="0"
            TrueValue="1.0"/>

        <Flyout
            x:Key="HutaoCloudFlyout"
            essential:FlyoutHelper.AcrylicWorkaround="True"
            Placement="Bottom"
            ShouldConstrainToRootBounds="False">
            <Flyout.FlyoutPresenterStyle>
                <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </Flyout.FlyoutPresenterStyle>
            <Grid>
                <mxi:Interaction.Behaviors>
                    <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind DataContext.HutaoCloudViewModel.LoadCommand, Mode=OneWay}"/>
                </mxi:Interaction.Behaviors>
                <shuxc:StandardView ShowCondition="{x:Bind DataContext.HutaoCloudViewModel.Options.IsHutaoCloudAllowed, Mode=OneWay}" Visibility="{x:Bind DataContext.HutaoCloudViewModel.IsInitialized, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <shuxc:StandardView.EmptyContent>
                        <StackPanel Padding="16" Spacing="{StaticResource SettingsCardSpacing}">
                            <StackPanel.Resources>
                                <!--  ReSharper disable Xaml.RedundantResource  -->
                                <Thickness x:Key="SettingsCardPadding">16</Thickness>
                                <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                                <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                                <x:Double x:Key="SettingsCardMinHeight">0</x:Double>
                                <!--  ReSharper restore Xaml.RedundantResource  -->
                            </StackPanel.Resources>

                            <TextBlock
                                Margin="0,0,0,8"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewPageGachaLogHutaoCloudNotAllowed}"
                                TextAlignment="Center"/>
                            <cwc:SettingsCard
                                Command="{x:Bind DataContext.HutaoCloudViewModel.NavigateToSpiralAbyssRecordCommand, Mode=OneWay}"
                                Description="{shuxm:ResourceString Name=ViewPageGachaLogHutaoCloudSpiralAbyssActivityDescription}"
                                Header="{shuxm:ResourceString Name=ViewPageGachaLogHutaoCloudSpiralAbyssActivityHeader}"
                                IsClickEnabled="True"/>
                            <cwc:SettingsCard
                                Command="{x:Bind DataContext.HutaoCloudViewModel.NavigateToAfdianSkuCommand, Mode=OneWay}"
                                Description="{shuxm:ResourceString Name=ViewPageGachaLogHutaoCloudAfdianPurchaseDescription}"
                                Header="{shuxm:ResourceString Name=ViewPageGachaLogHutaoCloudAfdianPurchaseHeader}"
                                IsClickEnabled="True"/>
                        </StackPanel>
                    </shuxc:StandardView.EmptyContent>
                    <Grid ColumnSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel
                                shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoCardBrush}"
                                shuxcth:MaterialBackground.NativeBrush="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                Spacing="8">
                                <TextBlock
                                    Margin="16,8,16,0"
                                    HorizontalTextAlignment="Center"
                                    Text="{shuxm:ResourceString Name=ServiceHutaoUserGachaLogExpiredAt}"
                                    TextAlignment="Center"/>
                                <TextBlock
                                    Margin="16,0,16,8"
                                    HorizontalTextAlignment="Center"
                                    Text="{x:Bind DataContext.HutaoCloudViewModel.Options.CloudExpireAt, Mode=OneWay}"
                                    TextAlignment="Center"/>
                                <Border
                                    Padding="8"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0"
                                    Visibility="{x:Bind DataContext.HutaoCloudViewModel.Options.IsDeveloper, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <TextBlock
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{shuxm:ResourceString Name=ViewPageGachaLogHutaoCloudDeveloperHint}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Grid.Row="1"
                            Margin="16"
                            HorizontalAlignment="Center"
                            Text="{shuxm:ResourceString Name=ViewPageGachaLogHutaoCloudNoEntryHint}"
                            Visibility="{x:Bind DataContext.HutaoCloudViewModel.UidOperations.Count, Converter={StaticResource Int32ToVisibilityRevertConverter}, Mode=OneWay}"/>
                        <ScrollViewer
                            Grid.Row="1"
                            Margin="16,0"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{x:Bind DataContext.HutaoCloudViewModel.UidOperations.Count, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}">
                            <ScrollViewer.Resources>
                                <DataTemplate x:Key="UidOperationTemplate" x:DataType="shvg:HutaoCloudEntryOperationViewModel">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{x:Bind Uid, Mode=OneWay}"/>
                                            <TextBlock
                                                Opacity="0.7"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ItemCount, Mode=OneWay}"/>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Orientation="Horizontal">
                                            <wl:LiquidGlassButton
                                                Margin="6,0,0,0"
                                                shuxcth:ControlMaterialState.IsManaged="True"
                                                VerticalAlignment="Stretch"
                                                Background="Transparent"
                                                Command="{x:Bind RetrieveCommand, Mode=OneWay}"
                                                CommandParameter="{x:Bind Uid, Mode=OneWay}"
                                                Content="&#xE896;"
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                Style="{StaticResource ButtonRevealStyle}"
                                                ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageGachaLogHutaoCloudRetrieve}"/>
                                            <wl:LiquidGlassButton
                                                Margin="6,0,0,0"
                                                shuxcth:ControlMaterialState.IsManaged="True"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Stretch"
                                                Background="Transparent"
                                                Command="{x:Bind DeleteCommand, Mode=OneWay}"
                                                CommandParameter="{x:Bind Uid, Mode=OneWay}"
                                                Style="{StaticResource ButtonRevealStyle}"
                                                ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageGachaLogHutaoCloudDelete}">
                                                <TextBlock
                                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                    FontWeight="Bold"
                                                    Foreground="Red"
                                                    Text="&#xE74D;"/>
                                            </wl:LiquidGlassButton>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ScrollViewer.Resources>
                            <ItemsControl
                                Margin="0,16"
                                ItemTemplate="{StaticResource UidOperationTemplate}"
                                ItemsPanel="{StaticResource StackPanelSpacing8Template}"
                                ItemsSource="{x:Bind DataContext.HutaoCloudViewModel.UidOperations, Mode=OneWay}"/>
                        </ScrollViewer>
                        <Border
                            Grid.Row="2"
                            Padding="8"
                            HorizontalAlignment="Stretch"
                            shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoCardBrush}"
                            shuxcth:MaterialBackground.NativeBrush="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <wl:LiquidGlassButton
                                shuxcth:ControlMaterialState.IsManaged="True"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind DataContext.HutaoCloudViewModel.UploadCommand, Mode=OneWay}"
                                CommandParameter="{x:Bind DataContext.Archives.CurrentItem, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Glyph="&#xE898;"/>
                                    <TextBlock VerticalAlignment="Center" Text="{shuxm:ResourceString Name=ViewPageGachaLogHutaoCloudUpload}"/>
                                </StackPanel>
                            </wl:LiquidGlassButton>
                        </Border>
                    </Grid>
                </shuxc:StandardView>
                <shuxc:Loading
                    MinWidth="240"
                    IsLoading="{x:Bind DataContext.HutaoCloudViewModel.IsInitialized, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                    Style="{ThemeResource DefaultLoadingCardStyle}"/>
            </Grid>
        </Flyout>

        <DataTemplate x:Key="HistoryWishItemTemplate" x:DataType="shvg:StatisticsItem">
            <shuxcc:VerticalCard>
                <shuxcc:VerticalCard.Top>
                    <shuxc:ItemIcon
                        Width="40"
                        Height="40"
                        Icon="{x:Bind Icon, Mode=OneWay}"
                        Quality="{x:Bind Quality, Mode=OneWay}"/>
                </shuxcc:VerticalCard.Top>
                <shuxcc:VerticalCard.Bottom>
                    <TextBlock
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Count, Mode=OneWay}"
                        TextTrimming="None"
                        TextWrapping="NoWrap"/>
                </shuxcc:VerticalCard.Bottom>
            </shuxcc:VerticalCard>
        </DataTemplate>

        <DataTemplate x:Key="HistoryWishListTemplate" x:DataType="shvg:HistoryWish">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="4">
                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{x:Bind Version, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}"/>
                </StackPanel>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource BaseTextBlockStyle}"
                    Text="{x:Bind FormattedTotalCount, Mode=OneWay}"/>
                <ItemsControl
                    Grid.Row="1"
                    MaxWidth="134"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    ItemTemplate="{StaticResource HistoryWishItemTemplate}"
                    ItemsPanel="{StaticResource WrapPanelSpacing4Template}"
                    ItemsSource="{x:Bind OrangeUpList, Mode=OneWay}"/>
                <ItemsControl
                    Grid.Row="1"
                    MaxWidth="272"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Right"
                    ItemTemplate="{StaticResource HistoryWishItemTemplate}"
                    ItemsPanel="{StaticResource WrapPanelSpacing4Template}"
                    ItemsSource="{x:Bind PurpleUpList, Mode=OneWay}"/>
                <TextBlock
                    Grid.Row="2"
                    Margin="0,6,0,8"
                    Opacity="0.6"
                    Text="{x:Bind FormattedTimeSpan, Mode=OneWay}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HistoryWishGridTemplate" x:DataType="shvg:StatisticsItem">
            <Grid>
                <shuxc:ItemIcon
                    Badge="{x:Bind Badge, Mode=OneWay}"
                    Icon="{x:Bind Icon, Mode=OneWay}"
                    Opacity="{x:Bind Count, Converter={StaticResource DoubleToOpacityConverter}, Mode=OneWay}"
                    Quality="{x:Bind Quality, Mode=OneWay}"/>
                <Border
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#80000000"
                    CornerRadius="{ThemeResource ControlCornerRadiusTopRightAndBottomLeft}">
                    <TextBlock
                        Margin="6,0,6,2"
                        Foreground="#FFFFFFFF"
                        Text="{x:Bind Count, Mode=OneWay}"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <shuxc:StandardView HideCondition="{x:Bind DataContext.IsInitialized, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" ShowCondition="{x:Bind DataContext.Archives.CurrentItem, Converter={StaticResource EmptyObjectToBoolConverter}, Mode=OneWay}">
        <shuxc:StandardView.EmptyContent>
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border
                    MinWidth="480"
                    Padding="16"
                    Style="{ThemeResource AcrylicBorderCardStyle}">
                    <StackPanel>
                        <shuxci:CachedImage Height="120" Source="{StaticResource UI_EmotionIcon71}"/>
                        <TextBlock
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{shuxm:ResourceString Name=ViewPageGachaLogHint}"/>
                        <StackPanel Margin="0,24,0,0" Spacing="{StaticResource SettingsCardSpacing}">
                            <cwc:SettingsCard
                                ActionIconToolTip="{shuxm:ResourceString Name=ViewPageGachaLogRefreshAction}"
                                Command="{x:Bind DataContext.RefreshBySTokenCommand, Mode=OneWay}"
                                Description="{shuxm:ResourceString Name=ViewPageGachaLogRefreshBySTokenDescription}"
                                Header="{shuxm:ResourceString Name=ViewPageGachaLogRefreshBySToken}"
                                HeaderIcon="{shuxm:FontIcon Glyph=&#xE192;}"
                                IsClickEnabled="True"/>
                            <cwc:SettingsCard
                                ActionIconToolTip="{shuxm:ResourceString Name=ViewPageGachaLogRefreshAction}"
                                Command="{x:Bind DataContext.RefreshByWebCacheCommand, Mode=OneWay}"
                                Description="{shuxm:ResourceString Name=ViewPageGachaLogRefreshByWebCacheDescription}"
                                Header="{shuxm:ResourceString Name=ViewPageGachaLogRefreshByWebCache}"
                                HeaderIcon="{shuxm:FontIcon Glyph=&#xE81E;}"
                                IsClickEnabled="True"/>
                            <cwc:SettingsCard
                                ActionIconToolTip="{shuxm:ResourceString Name=ViewPageGachaLogInputAction}"
                                Command="{x:Bind DataContext.RefreshByManualInputCommand, Mode=OneWay}"
                                Description="{shuxm:ResourceString Name=ViewPageGachaLogRefreshByManualInputDescription}"
                                Header="{shuxm:ResourceString Name=ViewPageGachaLogRefreshByManualInput}"
                                HeaderIcon="{shuxm:FontIcon Glyph=&#xE765;}"
                                IsClickEnabled="True"/>
                            <cwc:SettingsCard
                                ActionIconToolTip="{shuxm:ResourceString Name=ViewPageGachaLogImportAction}"
                                Command="{x:Bind DataContext.ImportExportCommand, Mode=OneWay}"
                                Description="{shuxm:ResourceString Name=ViewPageGachaLogImportDescription}"
                                Header="{shuxm:ResourceString Name=ViewPageGachaLogImportHeader}"
                                HeaderIcon="{shuxm:FontIcon Glyph=&#xE8B5;}"
                                IsClickEnabled="True"/>
                            <cwc:SettingsCard
                                Description="{shuxm:ResourceString Name=ViewPageGachaLogRecoverFromHutaoCloudDescription}"
                                FlyoutBase.AttachedFlyout="{StaticResource HutaoCloudFlyout}"
                                Header="{shuxm:ResourceString Name=ViewPageGachaLogHutaoCloud}"
                                HeaderIcon="{shuxm:FontIcon Glyph=&#xE753;}"
                                IsClickEnabled="True">
                                <mxi:Interaction.Behaviors>
                                    <mxi:EventTriggerBehavior EventName="Click">
                                        <shuxba:ShowAttachedFlyoutAction/>
                                    </mxi:EventTriggerBehavior>
                                </mxi:Interaction.Behaviors>
                            </cwc:SettingsCard>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </shuxc:StandardView.EmptyContent>
        <Pivot x:Name="Pivot" Style="{ThemeResource CardPivotStyle}">
            <mxi:Interaction.Behaviors>
                <shuxb:PivotBeyondModeBehavior IsBeyondMode="{x:Bind DataContext.IsBeyondMode, Mode=OneWay}"/>
            </mxi:Interaction.Behaviors>
            <Pivot.LeftHeader>
                <shuxc:SizeRestrictedContentControl Margin="6,6,0,6">
                    <wl:LiquidGlassComboBox
                        shuxcth:ControlMaterialState.IsManaged="True"
                        shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                        DisplayMemberPath="Uid"
                        ItemsSource="{x:Bind DataContext.Archives, Mode=OneWay}"
                        SelectedItem="{x:Bind DataContext.Archives.CurrentItem, Mode=TwoWay}"
                        Style="{ThemeResource CommandBarComboBoxStyle}"/>
                </shuxc:SizeRestrictedContentControl>
            </Pivot.LeftHeader>
            <Pivot.RightHeader>
                <CommandBar DefaultLabelPosition="Right">
                    <CommandBar.Resources>
                        <StaticResource x:Key="CommandBarBackgroundOpen" ResourceKey="ControlFillColorTransparentBrush"/>
                        <!--  ReSharper disable once Xaml.RedundantResource  -->
                        <Thickness x:Key="CommandBarBorderThicknessOpen">0</Thickness>
                    </CommandBar.Resources>
                    <AppBarButton Icon="{shuxm:FontIcon Glyph=&#xE72C;}" Label="{shuxm:ResourceString Name=ViewPageGachaLogRefresh}">
                        <AppBarButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem
                                    Command="{x:Bind DataContext.RefreshBySTokenCommand, Mode=OneWay}"
                                    Icon="{shuxm:FontIcon Glyph=&#xE192;}"
                                    Text="{shuxm:ResourceString Name=ViewPageGachaLogRefreshBySToken}"/>
                                <MenuFlyoutItem
                                    Command="{x:Bind DataContext.RefreshByWebCacheCommand, Mode=OneWay}"
                                    Icon="{shuxm:FontIcon Glyph=&#xE81E;}"
                                    Text="{shuxm:ResourceString Name=ViewPageGachaLogRefreshByWebCache}"/>
                                <MenuFlyoutItem
                                    Command="{x:Bind DataContext.RefreshByManualInputCommand, Mode=OneWay}"
                                    Icon="{shuxm:FontIcon Glyph=&#xE765;}"
                                    Text="{shuxm:ResourceString Name=ViewPageGachaLogRefreshByManualInput}"/>
                                <ToggleMenuFlyoutItem
                                    Icon="{shuxm:FontIcon Glyph=&#xE1CD;}"
                                    IsChecked="{x:Bind DataContext.IsAggressiveRefresh, Mode=TwoWay}"
                                    Text="{shuxm:ResourceString Name=ViewPageGachaLogAggressiveRefresh}"/>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarSeparator/>
                    <AppBarToggleButton
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Icon/UI_ItemIcon_231.png}"
                        IsChecked="{x:Bind DataContext.IsBeyondMode, Mode=TwoWay}"
                        Label="{shuxm:ResourceString Name=ViewPageGachaLogSwitchToBeyondGachaModeHeader}">
                        <AppBarToggleButton.Resources>
                            <Style BasedOn="{StaticResource DefaultAppBarToggleButtonStyle}" TargetType="AppBarToggleButton">
                                <Setter Property="ToolTipService.ToolTip" Value="{shuxm:ResourceString Name=ViewPageGachaLogSwitchToBeyondGachaModeDescription}"/>
                            </Style>
                        </AppBarToggleButton.Resources>
                    </AppBarToggleButton>
                    <AppBarSeparator/>
                    <AppBarButton
                        Flyout="{StaticResource HutaoCloudFlyout}"
                        Icon="{shuxm:FontIcon Glyph=&#xE753;}"
                        Label="{shuxm:ResourceString Name=ViewPageGachaLogHutaoCloud}"/>
                    <AppBarSeparator/>
                    <CommandBar.SecondaryCommands>
                        <AppBarButton
                            Command="{x:Bind DataContext.OpenAccountInsightsCommand, Mode=OneWay}"
                            Icon="{shuxm:FontIcon Glyph=&#xE9D9;}"
                            Label="{shuxm:ResourceString Name=ViewDialogAccountInsightsOpen}"/>
                        <AppBarButton
                            Command="{x:Bind DataContext.ImportExportCommand, Mode=OneWay}"
                            Icon="{shuxm:FontIcon Glyph=&#xE8C9;}"
                            Label="{shuxm:ResourceString Name=ViewPageGachaLogImportExportAction}"/>
                        <AppBarButton
                            Command="{x:Bind DataContext.RemoveArchiveCommand, Mode=OneWay}"
                            Icon="{shuxm:FontIcon Glyph=&#xE74D;}"
                            Label="{shuxm:ResourceString Name=ViewPageGachaLogRemoveArchiveAction}"/>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </Pivot.RightHeader>
            <PivotItem x:Name="PivotOverview" Header="{shuxm:ResourceString Name=ViewPageGachaLogPivotOverview}">
                <ScrollViewer
                    Margin="16,0"
                    cw:ScrollViewerExtensions.HorizontalScrollBarMargin="0,0,-16,0"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Disabled">
                    <shuxcp:HorizontalEqualPanel
                        Margin="0,16"
                        MinItemWidth="302"
                        Spacing="16">
                        <shuxvs:StatisticsCard DataContext="{x:Bind DataContext.Statistics.AvatarWish, Mode=OneWay}" Visibility="{Binding DataContext.IsAvatarWishCardVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <shuxvs:StatisticsCard
                            DataContext="{x:Bind DataContext.Statistics.WeaponWish, Mode=OneWay}"
                            ShowCombinedModeToggle="False"
                            Visibility="{Binding DataContext.IsWeaponWishCardVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <shuxvs:StatisticsCard
                            DataContext="{x:Bind DataContext.Statistics.StandardWish, Mode=OneWay}"
                            ShowCombinedModeToggle="False"
                            ShowUpPull="False"
                            Visibility="{Binding DataContext.IsStandardWishCardVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <shuxvs:StatisticsCard
                            DataContext="{x:Bind DataContext.Statistics.ChronicledWish, Mode=OneWay}"
                            ShowCombinedModeToggle="False"
                            ShowUpPull="False"
                            Visibility="{Binding DataContext.IsChronicledWishCardVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <shuxvs:StatisticsCard
                            DataContext="{x:Bind DataContext.Statistics.NoviceWish, Mode=OneWay}"
                            ShowCombinedModeToggle="False"
                            ShowUpPull="False"
                            Visibility="{Binding DataContext.IsNoviceWishCardVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <shuxvs:BeyondStatisticsCard
                            DataContext="{x:Bind DataContext.Statistics.BeyondStandardWish, Mode=OneWay}"
                            ShowCombinedModeToggle="False"
                            ShowUpPull="False"
                            Visibility="{Binding DataContext.IsBeyondStandardWishCardVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <shuxvs:StatisticsCard
                            DataContext="{x:Bind DataContext.Statistics.BeyondEventWish, Mode=OneWay}"
                            ShowCombinedModeToggle="False"
                            ShowUpPull="True"
                            Visibility="{Binding DataContext.IsBeyondEventWishCardVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </shuxcp:HorizontalEqualPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem x:Name="PivotHistory" Header="{shuxm:ResourceString Name=ViewPageGachaLogPivotHistory}">
                <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <SplitView
                            shuxcth:MaterialBackground.GlassPaneBrush="{ThemeResource HutaoSurfaceBrush}"
                            shuxcth:MaterialBackground.NativePaneBrush="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            DisplayMode="Inline"
                            IsPaneOpen="True"
                            OpenPaneLength="439">
                            <SplitView.Pane>
                                <ListView
                                    Padding="{ThemeResource ListViewInSplitPanePadding}"
                                    ItemTemplate="{StaticResource HistoryWishListTemplate}"
                                    ItemsSource="{x:Bind DataContext.Statistics.HistoryWishes, Mode=OneWay}"
                                    SelectedItem="{x:Bind DataContext.Statistics.HistoryWishes.CurrentItem, Mode=TwoWay}"/>
                            </SplitView.Pane>
                            <SplitView.Content>
                                <ScrollViewer>
                                    <StackPanel>
                                        <Border
                                            Margin="16"
                                            HorizontalAlignment="Left"
                                            cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                                            <Grid HorizontalAlignment="Center" Style="{StaticResource AcrylicGridCardStyle}">
                                                <cwc:ConstrainedBox AspectRatio="1080:533">
                                                    <shuxci:CachedImage
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                                        Source="{x:Bind DataContext.Statistics.HistoryWishes.CurrentItem.BannerImage, Mode=OneWay}"
                                                        Stretch="UniformToFill"/>
                                                </cwc:ConstrainedBox>
                                                <Border
                                                    Grid.ColumnSpan="2"
                                                    Background="{ThemeResource DarkOnlyOverlayMaskColorBrush}"
                                                    IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Margin="16,0,0,0" Spacing="8">
                                            <TextBlock
                                                Margin="0,8,0,0"

<UserControl
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxdc="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter"
    xmlns:shuxdcs="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter.Specialized"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shuxv="using:Snap.Hutao.Remastered.UI.Xaml.View"
    xmlns:shuxvp="using:Snap.Hutao.Remastered.UI.Xaml.View.Page"
    xmlns:shvm="using:Snap.Hutao.Remastered.ViewModel"
    xmlns:sshuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance Type=shvm:MainViewModel}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shvm:MainViewModel)DataContext).LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <UserControl.Resources>
        <!--  ReSharper disable Xaml.RedundantResource  -->
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0,1,0,0</Thickness>
        <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">24</x:Double>
        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
        <!--  ReSharper restore Xaml.RedundantResource  -->
        <shuxdcs:BackdropTypeToOpacityConverter x:Key="BackdropTypeToOpacityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="{x:Bind ((shvm:MainViewModel)DataContext).AppOptions.BackdropType.Value, Converter={StaticResource BackdropTypeToOpacityConverter}, Mode=OneWay}">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:1"/>
            </Border.OpacityTransition>
        </Border>

        <Image
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0"
            Stretch="UniformToFill"
            UseLayoutRounding="False">
            <mxi:Interaction.Behaviors>
                <shuxb:ServiceRecipientBackgroundImagePresenterBehavior x:Name="BackgroundImageRecipient"/>
                <shuxb:PeriodicInvokeCommandOrOnActualThemeChangedBehavior Command="{x:Bind BackgroundImageRecipient.UpdateBackgroundCommand}" Period="0:5:0"/>
            </mxi:Interaction.Behaviors>
        </Image>

        <MediaPlayerElement
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0"
            Stretch="UniformToFill"
            UseLayoutRounding="False">
            <mxi:Interaction.Behaviors>
                <shuxb:ServiceRecipientMediaPlayerElementPresenterBehavior x:Name="MediaPlayerElementRecipient"/>
                <shuxb:PeriodicInvokeCommandOrOnActualThemeChangedBehavior Command="{x:Bind MediaPlayerElementRecipient.UpdateMediaPlayerElementCommand}" Period="0:5:0"/>
            </mxi:Interaction.Behaviors>
        </MediaPlayerElement>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TitleBar
                x:Name="TitleBar"
                Title="{x:Bind shvm:MainViewModel.Title, Mode=OneWay}"
                Grid.Row="0"
                x:FieldModifier="Public"
                IsBackButtonVisible="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
                IsPaneToggleButtonVisible="True">
                <TitleBar.Resources>
                    <x:Double x:Key="TitleBarCompactHeight">44</x:Double>
                    <x:Double x:Key="TitleBarExpandedHeight">44</x:Double>
                    <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
                </TitleBar.Resources>
                <mxi:Interaction.Behaviors>
                    <shuxb:ServiceRecipientTitleBarBehavior/>
                </mxi:Interaction.Behaviors>
                <TitleBar.RightHeader>
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        Orientation="Horizontal"
                        Spacing="6">

                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_4591"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:Button"
                            Visibility="{x:Bind shvm:MainViewModel.IsDebug}"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <Button
                                    Padding="6"
                                    Command="{x:Bind ((shvm:MainViewModel)DataContext).InvertAppThemeCommand, Mode=OneWay}"
                                    Content="[Dev] Invert Theme"
                                    Style="{ThemeResource SettingButtonStyle}"/>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassButton
                                    Padding="6"
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    Command="{x:Bind ((shvm:MainViewModel)DataContext).InvertAppThemeCommand, Mode=OneWay}"
                                    Content="[Dev] Invert Theme"
                                    Style="{ThemeResource SettingButtonStyle}"/>
                            </cwc:Case>
                        </cwc:SwitchPresenter>

                        <cwc:SwitchPresenter
                            x:Name="OfflineConnectionPresenter"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:Button"
                            Visibility="{x:Bind ((shvm:MainViewModel)DataContext).RepositoryCatalog.IsOffline, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <Button
                                    Padding="10,6"
                                    AutomationProperties.Name="{shuxm:ResourceString Name=RepositoryServerReconnect}"
                                    Command="{x:Bind ((shvm:MainViewModel)DataContext).RepositoryCatalog.ReconnectCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ((shvm:MainViewModel)DataContext).RepositoryCatalog.CanReconnect, Mode=OneWay}"
                                    Style="{ThemeResource SettingButtonStyle}"
                                    ToolTipService.ToolTip="{shuxm:ResourceString Name=RepositoryServerReconnect}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE72C;"/>
                                        <TextBlock Text="{x:Bind ((shvm:MainViewModel)DataContext).RepositoryCatalog.ConnectionStatus, Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassButton
                                    Padding="10,6"
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                                    AutomationProperties.Name="{shuxm:ResourceString Name=RepositoryServerReconnect}"
                                    Command="{x:Bind ((shvm:MainViewModel)DataContext).RepositoryCatalog.ReconnectCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ((shvm:MainViewModel)DataContext).RepositoryCatalog.CanReconnect, Mode=OneWay}"
                                    Style="{ThemeResource SettingButtonStyle}"
                                    ToolTipService.ToolTip="{shuxm:ResourceString Name=RepositoryServerReconnect}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE72C;"/>
                                        <TextBlock Text="{x:Bind ((shvm:MainViewModel)DataContext).RepositoryCatalog.ConnectionStatus, Mode=OneWay}"/>
                                    </StackPanel>
                                </wl:LiquidGlassButton>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_6177"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:Button"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <Button
                                    Padding="0"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    PointerEntered="OnBackgroundActivityButtonPointerEntered"
                                    PointerExited="OnBackgroundActivityButtonPointerExited"
                                    Style="{ThemeResource SettingButtonStyle}">
                                    <Button.Resources>
                                        <SineEase x:Key="EasingFunction" EasingMode="EaseInOut"/>
                                        <Storyboard x:Name="FocusStoryBoard">
                                            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                                <EasingColorKeyFrame
                                                    EasingFunction="{StaticResource EasingFunction}"
                                                    KeyTime="0:0:0"
                                                    Value="{ThemeResource ControlFillColorTransparent}"/>
                                                <EasingColorKeyFrame
                                                    EasingFunction="{StaticResource EasingFunction}"
                                                    KeyTime="0:0:0.5"
                                                    Value="{ThemeResource SystemFillColorCautionBackground}"/>
                                                <EasingColorKeyFrame
                                                    EasingFunction="{StaticResource EasingFunction}"
                                                    KeyTime="0:0:1"
                                                    Value="{ThemeResource ControlFillColorTransparent}"/>
                                                <EasingColorKeyFrame
                                                    EasingFunction="{StaticResource EasingFunction}"
                                                    KeyTime="0:0:1.5"
                                                    Value="{ThemeResource SystemFillColorCautionBackground}"/>
                                                <EasingColorKeyFrame
                                                    EasingFunction="{StaticResource EasingFunction}"
                                                    KeyTime="0:0:2"
                                                    Value="{ThemeResource ControlFillColorTransparent}"/>
                                            </ColorAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </Button.Resources>
                                    <Button.Content>
                                        <Border Padding="16,6">
                                            <Border.Background>
                                                <SolidColorBrush Color="{ThemeResource ControlFillColorTransparent}"/>
                                            </Border.Background>
                                            <mxi:Interaction.Behaviors>
                                                <shuxb:FocusAnimationBehavior Storyboard="{StaticResource FocusStoryBoard}" Watch="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.NotifyToken, Mode=OneWay}"/>
                                                <shuxb:FocusAnimationBehavior Storyboard="{StaticResource FocusStoryBoard}" Watch="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.FullTrustInitialization.NotifyToken, Mode=OneWay}"/>
                                            </mxi:Interaction.Behaviors>
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                    <ProgressRing
                                                        Width="16"
                                                        Height="16"
                                                        IsIndeterminate="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.IsIndeterminate, Mode=OneWay}"
                                                        Visibility="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.HasProgress, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Value="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.ProgressValue, Mode=OneWay}"/>
                                                    <InfoBadge
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="#C42B1C"
                                                        Visibility="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.IsFaulted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <InfoBadge.IconSource>
                                                            <FontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xF13C;"/>
                                                        </InfoBadge.IconSource>
                                                    </InfoBadge>
                                                    <InfoBadge
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SuccessIconInfoBadgeStyle}"
                                                        Visibility="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.IsCompletedSuccessfully, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </Grid>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{shuxm:ResourceString Name=UIViewMainTitleBarBackgroundActivityAction}"/>

                                                <cwc:SwitchPresenter
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    TargetType="x:Boolean"
                                                    Value="{x:Bind ((shvm:MainViewModel)DataContext).IsFlyoutOpen, Mode=OneWay}">
                                                    <cwc:Case Value="True">
                                                        <AnimatedIcon
                                                            x:Name="OpenedChevronAnimatedIcon"
                                                            Width="16"
                                                            Height="16">
                                                            <AnimatedIcon.Source>
                                                                <animatedvisuals:AnimatedChevronUpDownSmallVisualSource/>
                                                            </AnimatedIcon.Source>
                                                            <AnimatedIcon.FallbackIconSource>
                                                                <FontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE70D;"/>
                                                            </AnimatedIcon.FallbackIconSource>
                                                        </AnimatedIcon>
                                                    </cwc:Case>
                                                    <cwc:Case Value="False">
                                                        <AnimatedIcon
                                                            x:Name="ClosedChevronAnimatedIcon"
                                                            Width="16"
                                                            Height="16">
                                                            <AnimatedIcon.Source>
                                                                <animatedvisuals:AnimatedChevronDownSmallVisualSource/>
                                                            </AnimatedIcon.Source>
                                                            <AnimatedIcon.FallbackIconSource>
                                                                <FontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE70E;"/>
                                                            </AnimatedIcon.FallbackIconSource>
                                                        </AnimatedIcon>
                                                    </cwc:Case>
                                                </cwc:SwitchPresenter>
                                            </Grid>
                                        </Border>
                                    </Button.Content>
                                    <Button.Flyout>
                                        <Flyout
                                            shuxb:FlyoutOpenStateBinding.IsOpen="{x:Bind ((shvm:MainViewModel)DataContext).IsFlyoutOpen, Mode=TwoWay}"
                                            shuxb:FlyoutOpenStateBinding.IsTrackingEnabled="True"
                                            shuxb:FlyoutOpenStateBinding.SwitchDelayMilliseconds="120"
                                            FlyoutPresenterStyle="{ThemeResource FlyoutPresenterPadding8Style}"
                                            Placement="Bottom"
                                            ShouldConstrainToRootBounds="True">
                                            <StackPanel
                                                Width="320"
                                                DataContext="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions, Mode=OneWay}"
                                                Spacing="4">
                                                <sshuxcc:CardProgressBar
                                                    MinHeight="58"
                                                    Description="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.Description, Mode=OneWay}"
                                                    Header="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.Title, Mode=OneWay}"
                                                    IsIndeterminate="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.IsIndeterminate, Mode=OneWay}"
                                                    Maximum="1"
                                                    ProgressForeground="{ThemeResource SystemControlForegroundAccentBrush}"
                                                    Style="{ThemeResource CompactCardProgressBarStyle}"
                                                    Value="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.ProgressValue, Mode=OneWay}"/>
                                                <sshuxcc:CardProgressBar
                                                    MinHeight="58"
                                                    Description="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.FullTrustInitialization.Description, Mode=OneWay}"
                                                    Header="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.FullTrustInitialization.Title, Mode=OneWay}"
                                                    IsIndeterminate="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.FullTrustInitialization.IsIndeterminate, Mode=OneWay}"
                                                    Maximum="1"
                                                    ProgressForeground="{ThemeResource SystemControlForegroundAccentBrush}"
                                                    Style="{ThemeResource CompactCardProgressBarStyle}"
                                                    Value="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.FullTrustInitialization.ProgressValue, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassButton
                                    Padding="0"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    PointerEntered="OnBackgroundActivityButtonPointerEntered"
                                    PointerExited="OnBackgroundActivityButtonPointerExited"
                                    Style="{ThemeResource SettingButtonStyle}">
                                    <wl:LiquidGlassButton.Resources>
                                        <SineEase x:Key="EasingFunction" EasingMode="EaseInOut"/>
                                        <Storyboard x:Key="FocusStoryBoard" x:Name="FocusStoryBoardGlass">
                                            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                                <EasingColorKeyFrame
                                                    EasingFunction="{StaticResource EasingFunction}"
                                                    KeyTime="0:0:0"
                                                    Value="{ThemeResource ControlFillColorTransparent}"/>
                                                <EasingColorKeyFrame
                                                    EasingFunction="{StaticResource EasingFunction}"
                                                    KeyTime="0:0:0.5"
                                                    Value="{ThemeResource SystemFillColorCautionBackground}"/>
                                                <EasingColorKeyFrame
                                                    EasingFunction="{StaticResource EasingFunction}"
                                                    KeyTime="0:0:1"
                                                    Value="{ThemeResource ControlFillColorTransparent}"/>
                                                <EasingColorKeyFrame
                                                    EasingFunction="{StaticResource EasingFunction}"
                                                    KeyTime="0:0:1.5"
                                                    Value="{ThemeResource SystemFillColorCautionBackground}"/>
                                                <EasingColorKeyFrame
                                                    EasingFunction="{StaticResource EasingFunction}"
                                                    KeyTime="0:0:2"
                                                    Value="{ThemeResource ControlFillColorTransparent}"/>
                                            </ColorAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </wl:LiquidGlassButton.Resources>
                                    <wl:LiquidGlassButton.Content>
                                        <Border Padding="16,6">
                                            <Border.Background>
                                                <SolidColorBrush Color="{ThemeResource ControlFillColorTransparent}"/>
                                            </Border.Background>
                                            <mxi:Interaction.Behaviors>
                                                <shuxb:FocusAnimationBehavior Storyboard="{StaticResource FocusStoryBoard}" Watch="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.NotifyToken, Mode=OneWay}"/>
                                                <shuxb:FocusAnimationBehavior Storyboard="{StaticResource FocusStoryBoard}" Watch="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.FullTrustInitialization.NotifyToken, Mode=OneWay}"/>
                                            </mxi:Interaction.Behaviors>
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                    <ProgressRing
                                                        Width="16"
                                                        Height="16"
                                                        IsIndeterminate="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.IsIndeterminate, Mode=OneWay}"
                                                        Visibility="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.HasProgress, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Value="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.ProgressValue, Mode=OneWay}"/>
                                                    <InfoBadge
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="#C42B1C"
                                                        Visibility="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.IsFaulted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <InfoBadge.IconSource>
                                                            <FontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xF13C;"/>
                                                        </InfoBadge.IconSource>
                                                    </InfoBadge>
                                                    <InfoBadge
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SuccessIconInfoBadgeStyle}"
                                                        Visibility="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.IsCompletedSuccessfully, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </Grid>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{shuxm:ResourceString Name=UIViewMainTitleBarBackgroundActivityAction}"/>

                                                <cwc:SwitchPresenter
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    TargetType="x:Boolean"
                                                    Value="{x:Bind ((shvm:MainViewModel)DataContext).IsFlyoutOpen, Mode=OneWay}">
                                                    <cwc:Case Value="True">
                                                        <AnimatedIcon
                                                            x:Name="OpenedChevronAnimatedIconGlass"
                                                            Width="16"
                                                            Height="16">
                                                            <AnimatedIcon.Source>
                                                                <animatedvisuals:AnimatedChevronUpDownSmallVisualSource/>
                                                            </AnimatedIcon.Source>
                                                            <AnimatedIcon.FallbackIconSource>
                                                                <FontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE70D;"/>
                                                            </AnimatedIcon.FallbackIconSource>
                                                        </AnimatedIcon>
                                                    </cwc:Case>
                                                    <cwc:Case Value="False">
                                                        <AnimatedIcon
                                                            x:Name="ClosedChevronAnimatedIconGlass"
                                                            Width="16"
                                                            Height="16">
                                                            <AnimatedIcon.Source>
                                                                <animatedvisuals:AnimatedChevronDownSmallVisualSource/>
                                                            </AnimatedIcon.Source>
                                                            <AnimatedIcon.FallbackIconSource>
                                                                <FontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE70E;"/>
                                                            </AnimatedIcon.FallbackIconSource>
                                                        </AnimatedIcon>
                                                    </cwc:Case>
                                                </cwc:SwitchPresenter>
                                            </Grid>
                                        </Border>
                                    </wl:LiquidGlassButton.Content>
                                    <wl:LiquidGlassButton.Flyout>
                                        <Flyout
                                            shuxb:FlyoutOpenStateBinding.IsOpen="{x:Bind ((shvm:MainViewModel)DataContext).IsFlyoutOpen, Mode=TwoWay}"
                                            shuxb:FlyoutOpenStateBinding.IsTrackingEnabled="True"
                                            shuxb:FlyoutOpenStateBinding.SwitchDelayMilliseconds="120"
                                            FlyoutPresenterStyle="{ThemeResource FlyoutPresenterPadding8Style}"
                                            Placement="Bottom"
                                            ShouldConstrainToRootBounds="True">
                                            <StackPanel
                                                Width="320"
                                                DataContext="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions, Mode=OneWay}"
                                                Spacing="4">
                                                <sshuxcc:CardProgressBar
                                                    MinHeight="58"
                                                    Description="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.Description, Mode=OneWay}"
                                                    Header="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.Title, Mode=OneWay}"
                                                    IsIndeterminate="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.IsIndeterminate, Mode=OneWay}"
                                                    Maximum="1"
                                                    ProgressForeground="{ThemeResource SystemControlForegroundAccentBrush}"
                                                    Style="{ThemeResource CompactCardProgressBarStyle}"
                                                    Value="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.MetadataInitialization.ProgressValue, Mode=OneWay}"/>
                                                <sshuxcc:CardProgressBar
                                                    MinHeight="58"
                                                    Description="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.FullTrustInitialization.Description, Mode=OneWay}"
                                                    Header="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.FullTrustInitialization.Title, Mode=OneWay}"
                                                    IsIndeterminate="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.FullTrustInitialization.IsIndeterminate, Mode=OneWay}"
                                                    Maximum="1"
                                                    ProgressForeground="{ThemeResource SystemControlForegroundAccentBrush}"
                                                    Style="{ThemeResource CompactCardProgressBarStyle}"
                                                    Value="{x:Bind ((shvm:MainViewModel)DataContext).BackgroundActivityOptions.FullTrustInitialization.ProgressValue, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Flyout>
                                    </wl:LiquidGlassButton.Flyout>
                                </wl:LiquidGlassButton>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                    </StackPanel>
                </TitleBar.RightHeader>
            </TitleBar>

            <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
            <NavigationView
                Grid.Row="1"
                Margin="0,0,0,0"
                shuxc:NavigationViewHelper.PaneCornerRadius="0"
                CompactPaneLength="45"
                IsBackButtonVisible="Collapsed"
                IsEnabled="{Binding ElementName=ContentFrame, Path=Content.DataContext.IsInitialized, Mode=OneWay}"
                IsPaneOpen="True"
                IsPaneToggleButtonVisible="False"
                OpenPaneLength="205"
                PaneDisplayMode="Auto"
                UseLayoutRounding="False">
                <mxi:Interaction.Behaviors>
                    <shuxb:ServiceRecipientNavigationViewBehavior/>
                </mxi:Interaction.Behaviors>
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:AnnouncementPage"
                        Content="{shuxm:ResourceString Name=ViewAnnouncementHeader}"
                        Icon="{shuxm:BitmapIcon Source=ms-appx:///Resource/Navigation/Announcement.png}"/>
                    <NavigationViewItem
                        shuxc:NavigationViewItemHelper.NavigateTo="shuxvp:HutaoPassportPage"

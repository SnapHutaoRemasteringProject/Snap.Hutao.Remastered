<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.UserAccountPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:wl="using:WinUI.LiquidGlass"
    Title="{shuxm:ResourceString Name=ViewDialogUserAccountPasswordTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind IsLoginEnabled, Mode=OneWay}"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <cwc:SwitchPresenter
            x:Name="GlassPresenter_887"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:TextBox"
            Value="{x:Bind shuxcth:MaterialBindingSource.Current.TextBoxMaterial, Mode=OneWay}">
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>0</x:Int32>
                </cwc:Case.Value>
                <TextBox
                    KeyDown="OnTextKeyDown"
                    KeyUp="OnTextKeyUp"
                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogUserAccountPasswordAccountHint}"
                    Text="{x:Bind Account, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </cwc:Case>
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>1</x:Int32>
                </cwc:Case.Value>
                <wl:LiquidGlassTextBox
                    shuxcth:ControlMaterialState.IsManaged="True"
                    KeyDown="OnTextKeyDown"
                    KeyUp="OnTextKeyUp"
                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogUserAccountPasswordAccountHint}"
                    Text="{x:Bind Account, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </cwc:Case>
        </cwc:SwitchPresenter>
        <cwc:SwitchPresenter
            x:Name="GlassPresenter_1159"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:PasswordBox"
            Visibility="{x:Bind GlassNative_1159.Visibility, Mode=OneWay}"
            Value="{x:Bind shuxcth:MaterialBindingSource.Current.PasswordBoxMaterial, Mode=OneWay}">
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>0</x:Int32>
                </cwc:Case.Value>
                <PasswordBox
                    x:Name="GlassNative_1159"
                    DataContext="{x:Bind GlassPresenter_1159.DataContext, Mode=OneWay}"
                    KeyDown="OnTextKeyDown"
                    KeyUp="OnTextKeyUp"
                    Password="{x:Bind Password, Mode=TwoWay}"
                    PasswordChar="*"
                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogUserAccountPasswordPasswordHint}"
                    shuxcth:ThemeSynchronization.Source="{x:Bind GlassPresenter_1159}"/>
            </cwc:Case>
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>1</x:Int32>
                </cwc:Case.Value>
                <wl:LiquidGlassPasswordBox
                    x:Name="GlassNative_1159Glass"
                    Width="{x:Bind GlassNative_1159.Width, Mode=OneWay}"
                    Height="{x:Bind GlassNative_1159.Height, Mode=OneWay}"
                    MinWidth="{x:Bind GlassNative_1159.MinWidth, Mode=OneWay}"
                    MinHeight="{x:Bind GlassNative_1159.MinHeight, Mode=OneWay}"
                    MaxWidth="{x:Bind GlassNative_1159.MaxWidth, Mode=OneWay}"
                    MaxHeight="{x:Bind GlassNative_1159.MaxHeight, Mode=OneWay}"
                    Padding="{x:Bind GlassNative_1159.Padding, Mode=OneWay}"
                    shuxcth:ControlMaterialState.IsManaged="True"
                    shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassNative_1159, Mode=OneWay}"
                    shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                    BorderThickness="{x:Bind GlassNative_1159.BorderThickness, Mode=OneWay}"
                    FlowDirection="{x:Bind GlassNative_1159.FlowDirection, Mode=OneWay}"
                    FontFamily="{x:Bind GlassNative_1159.FontFamily, Mode=OneWay}"
                    FontSize="{x:Bind GlassNative_1159.FontSize, Mode=OneWay}"
                    FontStyle="{x:Bind GlassNative_1159.FontStyle, Mode=OneWay}"
                    FontWeight="{x:Bind GlassNative_1159.FontWeight, Mode=OneWay}"
                    IsEnabled="{x:Bind GlassNative_1159.IsEnabled, Mode=OneWay}"
                    KeyDown="OnTextKeyDown"
                    KeyUp="OnTextKeyUp"
                    Password="{x:Bind GlassNative_1159.Password, Mode=TwoWay}"
                    PlaceholderText="{x:Bind GlassNative_1159.PlaceholderText, Mode=OneWay}"/>
            </cwc:Case>
        </cwc:SwitchPresenter>
    </StackPanel>
</ContentDialog>

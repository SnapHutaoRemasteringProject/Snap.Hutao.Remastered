<Window
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Window.AccountInsightsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup">

    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="DragRegion" Height="36">
            <TextBlock
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{shuxm:ResourceString Name=ViewDialogAccountInsightsTitle}"/>
        </Grid>

        <Grid Grid.Row="1" Padding="18,10,18,18" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Native Charts: scroll independently of API configuration. -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                    <TextBlock
                        Text="{shuxm:ResourceString Name=ViewDialogAccountInsightsIntro}"
                        TextWrapping="Wrap"/>
                    <TextBlock
                        x:Name="StatusText"
                        Text="{shuxm:ResourceString Name=ViewDialogAccountInsightsLoading}"
                        TextWrapping="Wrap"/>
                    <StackPanel x:Name="ChartsPanel" Spacing="24"/>
                    <Button
                        x:Name="CopyButton"
                        Content="{shuxm:ResourceString Name=ViewDialogAccountInsightsCopy}"
                        IsEnabled="False"/>
                </StackPanel>
            </ScrollViewer>

            <Border
                Grid.Column="1"
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewDialogAccountInsightsAnalysisHeading}"/>
                            <Button x:Name="PrivacyInfoButton" Padding="4" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE946;" FontSize="12"/>
                            </Button>
                        </StackPanel>
                        <TeachingTip
                            x:Name="PrivacyTeachingTip"
                            Title="{shuxm:ResourceString Name=ViewDialogAccountInsightsPrivacyTitle}"
                            Subtitle="{shuxm:ResourceString Name=ViewDialogAccountInsightsPrivacyBody}"
                            IsLightDismissEnabled="True"
                            Target="{x:Bind PrivacyInfoButton}"/>
                        <TextBox
                            x:Name="EndpointBox"
                            Header="{shuxm:ResourceString Name=ViewDialogAccountInsightsEndpointHeader}"
                            PlaceholderText="{shuxm:ResourceString Name=ViewDialogAccountInsightsEndpointPlaceholder}"/>
                        <TextBox
                            x:Name="ModelBox"
                            Header="{shuxm:ResourceString Name=ViewDialogAccountInsightsModelHeader}"
                            PlaceholderText="{shuxm:ResourceString Name=ViewDialogAccountInsightsModelPlaceholder}"/>
                        <PasswordBox
                            x:Name="ApiKeyBox"
                            Header="{shuxm:ResourceString Name=ViewDialogAccountInsightsApiKeyHeader}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Name="TestButton"
                                Content="{shuxm:ResourceString Name=ViewDialogAccountInsightsTestConnection}"/>
                            <Button
                                x:Name="GenerateButton"
                                Content="{shuxm:ResourceString Name=ViewDialogAccountInsightsGenerate}"
                                IsEnabled="False"/>
                            <ProgressRing x:Name="ActivityRing" IsActive="False" Height="24" Width="24"/>
                        </StackPanel>
                        <TextBlock
                            x:Name="ResponseText"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>

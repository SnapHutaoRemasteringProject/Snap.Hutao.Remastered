<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.AvatarPropertyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwconv="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxca="using:Snap.Hutao.Remastered.UI.Xaml.Control.AutoSuggestBox"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcp="using:Snap.Hutao.Remastered.UI.Xaml.Control.Panel"
    xmlns:shuxct="using:Snap.Hutao.Remastered.UI.Xaml.Control.TextBlock"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxdcs="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter.Specialized"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shva="using:Snap.Hutao.Remastered.ViewModel.AvatarProperty"
    xmlns:wl="using:WinUI.LiquidGlass"
    x:Name="RootPage"
    d:DataContext="{d:DesignInstance shva:AvatarPropertyViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shva:AvatarPropertyViewModel)DataContext).LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <shuxdcs:UInt32ToGradientColorConverter
                        x:Key="CountToGradientColorConverter"
                        Maximum="#FFFD0093"
                        Minimum="#FF4B00D9"/>
                    <shuxdcs:Int32ToGradientColorConverter
                        x:Key="ScoreToColorConverter"
                        Maximum="#FFFF8F00"
                        MaximumValue="50"
                        Minimum="#FF9E9E9E"
                        MinimumValue="0"/>
                    <shuxdcs:Int32ToGradientColorConverter
                        x:Key="TotalScoreToColorConverter"
                        Maximum="#FFFF8F00"
                        MaximumValue="100"
                        Minimum="#FF9E9E9E"
                        MinimumValue="0"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <shuxdcs:UInt32ToGradientColorConverter
                        x:Key="CountToGradientColorConverter"
                        Maximum="#FFFF69BF"
                        Minimum="#FF9F69FF"/>
                    <shuxdcs:Int32ToGradientColorConverter
                        x:Key="ScoreToColorConverter"
                        Maximum="#FFFF8F00"
                        MaximumValue="50"
                        Minimum="#FF9E9E9E"
                        MinimumValue="0"/>
                    <shuxdcs:Int32ToGradientColorConverter
                        x:Key="TotalScoreToColorConverter"
                        Maximum="#FFFF8F00"
                        MaximumValue="100"
                        Minimum="#FF9E9E9E"
                        MinimumValue="0"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <cwconv:BoolToObjectConverter x:Key="BoolToOpacityConverter">
                <cwconv:BoolToObjectConverter.TrueValue>
                    <x:Double>1</x:Double>
                </cwconv:BoolToObjectConverter.TrueValue>
                <cwconv:BoolToObjectConverter.FalseValue>
                    <x:Double>0.5</x:Double>
                </cwconv:BoolToObjectConverter.FalseValue>
            </cwconv:BoolToObjectConverter>

            <cwconv:BoolToObjectConverter x:Key="BoolToSpecialBackgroundConverter" TrueValue="{StaticResource SpecialDescriptionSpecialBackgroundBrush}">
                <cwconv:BoolToObjectConverter.FalseValue>
                    <SolidColorBrush Color="Transparent"/>
                </cwconv:BoolToObjectConverter.FalseValue>
            </cwconv:BoolToObjectConverter>

            <shuxdcs:LayoutSwitchModeConverter x:Key="LayoutSwitchModeVisibilityConverter">
                <shuxdcs:LayoutSwitchModeConverter.ListValue>
                    <Visibility>Visible</Visibility>
                </shuxdcs:LayoutSwitchModeConverter.ListValue>
                <shuxdcs:LayoutSwitchModeConverter.GridValue>
                    <Visibility>Collapsed</Visibility>
                </shuxdcs:LayoutSwitchModeConverter.GridValue>
            </shuxdcs:LayoutSwitchModeConverter>

            <DataTemplate x:Key="AvatarGridViewSkillTemplate" x:DataType="shva:SkillView">
                <shuxcc:VerticalCard>
                    <shuxcc:VerticalCard.Top>
                        <shuxci:CachedImage
                            Width="40"
                            Height="40"
                            Margin="12"
                            HorizontalAlignment="Center"
                            ShowAsMonoChrome="True"
                            Source="{x:Bind Icon, Mode=OneWay}"/>
                    </shuxcc:VerticalCard.Top>
                    <shuxcc:VerticalCard.Bottom>
                        <Viewbox MaxWidth="52" StretchDirection="DownOnly">
                            <TextBlock Text="{x:Bind Level, Mode=OneWay}"/>
                        </Viewbox>
                    </shuxcc:VerticalCard.Bottom>
                </shuxcc:VerticalCard>
            </DataTemplate>

            <DataTemplate x:Key="AvatarGridViewTemplate" x:DataType="shva:AvatarView">
                <Grid Style="{ThemeResource GridShimmerStyle}">
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Command="{Binding ElementName=RootPage, Path=DataContext.AddAvatarToPlanCommand}"
                                CommandParameter="{x:Bind Mode=OneWay}"
                                Text="{shuxm:ResourceString Name=ViewPageAvatarPropertyAddAvatarToPlan}"/>
                            <MenuFlyoutItem
                                Command="{Binding ElementName=RootPage, Path=DataContext.AddWeaponToPlanCommand}"
                                CommandParameter="{x:Bind Mode=OneWay}"
                                Text="{shuxm:ResourceString Name=ViewPageAvatarPropertyAddWeaponToPlan}"/>
                            <MenuFlyoutItem
                                Command="{Binding ElementName=RootPage, Path=DataContext.CultivateCommand}"
                                CommandParameter="{x:Bind Mode=OneWay}"
                                Text="{shuxm:ResourceString Name=ViewPageAvatarPropertyAddBothToPlan}"/>
                        </MenuFlyout>
                    </Grid.ContextFlyout>

                    <Border
                        Grid.ColumnSpan="3"
                        Margin="-6"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <shuxci:CachedImage
                            MaxWidth="368"
                            MaxHeight="101"
                            VerticalAlignment="Center"
                            Opacity="0.5"
                            Source="{x:Bind NameCard, Mode=OneWay}"
                            Stretch="UniformToFill"/>
                    </Border>

                    <Border Margin="-6" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"/>

                    <Grid
                        Padding="6"
                        HorizontalAlignment="Left"
                        BackgroundSizing="OuterBorderEdge"
                        ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <shuxcc:VerticalCard Grid.Column="0">
                            <shuxcc:VerticalCard.Top>
                                <Grid cw:UIElementExtensions.ClipToBounds="True" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <shuxc:ItemIcon
                                        Width="64"
                                        Height="64"
                                        Icon="{x:Bind Icon, Mode=OneWay}"
                                        Quality="{x:Bind Quality, Mode=OneWay}"/>

                                    <Border
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        Background="#80000000">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <Image
                                                Width="16"
                                                Height="16"
                                                Margin="2,0,0,2"
                                                VerticalAlignment="Center"
                                                Source="ms-appx:///Resource/Icon/UI_Icon_Fetter.png"/>
                                            <TextBlock
                                                Margin="0,0,6,2"
                                                VerticalAlignment="Center"
                                                Foreground="#FFFFFFFF"
                                                Text="{x:Bind FetterLevel, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#80000000"
                                        CornerRadius="0,0,0,6">
                                        <TextBlock
                                            Margin="6,0,6,2"
                                            Foreground="#FFFFFFFF"
                                            Text="{x:Bind ActivatedConstellationCount, Mode=OneWay}"/>
                                    </Border>
                                </Grid>
                            </shuxcc:VerticalCard.Top>
                            <shuxcc:VerticalCard.Bottom>
                                <TextBlock Text="{x:Bind Level, Mode=OneWay}"/>
                            </shuxcc:VerticalCard.Bottom>
                        </shuxcc:VerticalCard>
                        <shuxcc:VerticalCard Grid.Column="1">
                            <shuxcc:VerticalCard.Top>
                                <Grid cw:UIElementExtensions.ClipToBounds="True" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <shuxc:ItemIcon
                                        Width="64"
                                        Height="64"
                                        Icon="{x:Bind Weapon.Icon, Mode=OneWay}"
                                        Quality="{x:Bind Weapon.Quality, Mode=OneWay}"/>
                                    <Border
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#80000000"
                                        CornerRadius="0,0,0,6">
                                        <TextBlock
                                            Margin="6,0,6,2"
                                            Foreground="#FFFFFFFF"
                                            Text="{x:Bind Weapon.AffixLevelNumber, Mode=OneWay}"/>
                                    </Border>
                                </Grid>
                            </shuxcc:VerticalCard.Top>
                            <shuxcc:VerticalCard.Bottom>
                                <TextBlock Text="{x:Bind Weapon.Level, Mode=OneWay}"/>
                            </shuxcc:VerticalCard.Bottom>
                        </shuxcc:VerticalCard>
                        <ItemsControl
                            Grid.Column="2"
                            VerticalAlignment="Stretch"
                            ItemTemplate="{StaticResource AvatarGridViewSkillTemplate}"
                            ItemsPanel="{StaticResource HorizontalStackPanelSpacing6Template}"
                            ItemsSource="{x:Bind Skills, Mode=OneWay}"/>
                    </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="AvatarListViewTemplate" x:DataType="shva:AvatarView">
                <Grid Background="Transparent">
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Command="{Binding ElementName=RootPage, Path=DataContext.AddAvatarToPlanCommand}"
                                CommandParameter="{x:Bind Mode=OneWay}"
                                Text="{shuxm:ResourceString Name=ViewPageAvatarPropertyAddAvatarToPlan}"/>
                            <MenuFlyoutItem
                                Command="{Binding ElementName=RootPage, Path=DataContext.AddWeaponToPlanCommand}"
                                CommandParameter="{x:Bind Mode=OneWay}"
                                Text="{shuxm:ResourceString Name=ViewPageAvatarPropertyAddWeaponToPlan}"/>
                            <MenuFlyoutItem
                                Command="{Binding ElementName=RootPage, Path=DataContext.CultivateCommand}"
                                CommandParameter="{x:Bind Mode=OneWay}"
                                Text="{shuxm:ResourceString Name=ViewPageAvatarPropertyAddBothToPlan}"/>
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <shuxci:CachedImage
                        Grid.Column="0"
                        Width="48"
                        Height="48"
                        Margin="0,0,12,12"
                        Source="{x:Bind SideIcon, Mode=OneWay}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Margin="12,0,0,0"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"/>
                        <TextBlock
                            Margin="12,0,0,0"
                            Opacity="0.7"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Level, Mode=OneWay}"
                            TextWrapping="NoWrap"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="AvatarConstellationTemplate" x:DataType="shva:ConstellationView">
                <cwc:SwitchPresenter
                    x:Name="GlassPresenter_15494"
                    Margin="0,0,2,0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False"
                    Tag="LiquidGlass:Button"
                    Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                    <cwc:Case>
                        <cwc:Case.Value>
                            <x:Int32>0</x:Int32>
                        </cwc:Case.Value>
                        <Button
                            Padding="2"
                            Background="Transparent"
                            BorderBrush="{x:Null}">
                            <Button.Content>
                                <Grid>
                                    <shuxci:CachedImage
                                        Width="36"
                                        Height="36"
                                        Opacity="{x:Bind IsActivated, Converter={StaticResource BoolToOpacityConverter}, Mode=OneWay}"
                                        Source="{x:Bind Icon, Mode=OneWay}"/>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Source="ms-appx:///Resource/Icon/UI_Icon_Locked.png"
                                        Visibility="{x:Bind IsActivated, Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}"/>
                                </Grid>
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel MaxWidth="320">
                                        <Border
                                            Padding="8,4"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionBaseBackgroundColor}"/>
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionBaseBorderColor}"/>
                                            </Border.BorderBrush>
                                            <shuxct:DescriptionTextBlock Description="{x:Bind Description, Mode=OneWay}" TextStyle="{StaticResource BodyTextBlockStyle}"/>
                                        </Border>
                                        <shuxct:DescriptionTextBlock
                                            Description="{x:Bind Description, Mode=OneWay}"
                                            TextStyle="{StaticResource BodyTextBlockStyle}"
                                            Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityRevertConverter}, Mode=OneWay}"/>
                                        <Border
                                            Margin="0,8,0,0"
                                            Padding="8,4"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionSpecialBackgroundColor}"/>
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionSpecialBorderColor}"/>
                                            </Border.BorderBrush>
                                            <shuxct:DescriptionTextBlock Description="{x:Bind SpecialDescription, Mode=OneWay}" TextStyle="{StaticResource BodyTextBlockStyle}"/>
                                        </Border>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </cwc:Case>
                    <cwc:Case>
                        <cwc:Case.Value>
                            <x:Int32>1</x:Int32>
                        </cwc:Case.Value>
                        <wl:LiquidGlassButton
                            Padding="2"
                            shuxcth:ControlMaterialState.IsManaged="True"
                            BorderBrush="{x:Null}">
                            <wl:LiquidGlassButton.Content>
                                <Grid>
                                    <shuxci:CachedImage
                                        Width="36"
                                        Height="36"
                                        Opacity="{x:Bind IsActivated, Converter={StaticResource BoolToOpacityConverter}, Mode=OneWay}"
                                        Source="{x:Bind Icon, Mode=OneWay}"/>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Source="ms-appx:///Resource/Icon/UI_Icon_Locked.png"
                                        Visibility="{x:Bind IsActivated, Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}"/>
                                </Grid>
                            </wl:LiquidGlassButton.Content>
                            <wl:LiquidGlassButton.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel MaxWidth="320">
                                        <Border
                                            Padding="8,4"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionBaseBackgroundColor}"/>
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionBaseBorderColor}"/>
                                            </Border.BorderBrush>
                                            <shuxct:DescriptionTextBlock Description="{x:Bind Description, Mode=OneWay}" TextStyle="{StaticResource BodyTextBlockStyle}"/>
                                        </Border>
                                        <shuxct:DescriptionTextBlock
                                            Description="{x:Bind Description, Mode=OneWay}"
                                            TextStyle="{StaticResource BodyTextBlockStyle}"
                                            Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityRevertConverter}, Mode=OneWay}"/>
                                        <Border
                                            Margin="0,8,0,0"
                                            Padding="8,4"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionSpecialBackgroundColor}"/>
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionSpecialBorderColor}"/>
                                            </Border.BorderBrush>
                                            <shuxct:DescriptionTextBlock Description="{x:Bind SpecialDescription, Mode=OneWay}" TextStyle="{StaticResource BodyTextBlockStyle}"/>
                                        </Border>
                                    </StackPanel>
                                </Flyout>
                            </wl:LiquidGlassButton.Flyout>
                        </wl:LiquidGlassButton>
                    </cwc:Case>
                </cwc:SwitchPresenter>
            </DataTemplate>

            <DataTemplate x:Key="AvatarSkillTemplate" x:DataType="shva:SkillView">
                <cwc:SwitchPresenter
                    x:Name="GlassPresenter_19283"
                    Margin="0,2,0,0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False"
                    Tag="LiquidGlass:Button"
                    Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                    <cwc:Case>
                        <cwc:Case.Value>
                            <x:Int32>0</x:Int32>
                        </cwc:Case.Value>
                        <Button
                            Padding="4"
                            Background="Transparent"
                            BorderBrush="{x:Null}">
                            <Button.Content>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <shuxci:CachedImage
                                        Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        Source="{x:Bind Icon, Mode=OneWay}"/>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="6,0,0,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Foreground="#FFFFFFFF"
                                        Style="{StaticResource BaseTextBlockStyle}"
                                        Text="{x:Bind Level, Mode=OneWay}"/>
                                </Grid>
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout Placement="Left">
                                    <StackPanel MaxWidth="320">
                                        <StackPanel.Resources>
                                            <!--  ReSharper disable Xaml.RedundantResource  -->
                                            <Thickness x:Key="SettingsCardPadding">16</Thickness>
                                            <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                                            <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                                            <x:Double x:Key="SettingsCardMinHeight">0</x:Double>
                                            <!--  ReSharper restore Xaml.RedundantResource  -->
                                        </StackPanel.Resources>
                                        <Border
                                            Padding="8,4"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionBaseBackgroundColor}"/>
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionBaseBorderColor}"/>
                                            </Border.BorderBrush>
                                            <shuxct:DescriptionTextBlock Description="{x:Bind Description, Mode=OneWay}" TextStyle="{StaticResource BodyTextBlockStyle}"/>
                                        </Border>
                                        <shuxct:DescriptionTextBlock
                                            Description="{x:Bind Description, Mode=OneWay}"
                                            TextStyle="{StaticResource BodyTextBlockStyle}"
                                            Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityRevertConverter}, Mode=OneWay}"/>
                                        <Border
                                            Margin="0,8,0,0"
                                            Padding="8,4"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionSpecialBackgroundColor}"/>
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionSpecialBorderColor}"/>
                                            </Border.BorderBrush>
                                            <shuxct:DescriptionTextBlock Description="{x:Bind SpecialDescription, Mode=OneWay}" TextStyle="{StaticResource BodyTextBlockStyle}"/>
                                        </Border>
                                        <ItemsControl Margin="0,12,0,0" ItemsSource="{x:Bind Info.Parameters, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <cwc:SettingsCard
                                                        Margin="0,2,0,0"
                                                        Padding="12,0"
                                                        Background="{Binding IsSpecial, Converter={StaticResource BoolToSpecialBackgroundConverter}}"
                                                        Header="{Binding Description}">
                                                        <TextBlock Margin="0,8" Text="{Binding Parameter}"/>
                                                    </cwc:SettingsCard>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </cwc:Case>
                    <cwc:Case>
                        <cwc:Case.Value>
                            <x:Int32>1</x:Int32>
                        </cwc:Case.Value>
                        <wl:LiquidGlassButton
                            Padding="4"
                            shuxcth:ControlMaterialState.IsManaged="True"
                            BorderBrush="{x:Null}">
                            <wl:LiquidGlassButton.Content>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <shuxci:CachedImage
                                        Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        Source="{x:Bind Icon, Mode=OneWay}"/>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="6,0,0,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Foreground="#FFFFFFFF"
                                        Style="{StaticResource BaseTextBlockStyle}"
                                        Text="{x:Bind Level, Mode=OneWay}"/>
                                </Grid>
                            </wl:LiquidGlassButton.Content>
                            <wl:LiquidGlassButton.Flyout>
                                <Flyout Placement="Left">
                                    <StackPanel MaxWidth="320">
                                        <StackPanel.Resources>
                                            <!--  ReSharper disable Xaml.RedundantResource  -->
                                            <Thickness x:Key="SettingsCardPadding">16</Thickness>
                                            <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                                            <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                                            <x:Double x:Key="SettingsCardMinHeight">0</x:Double>
                                            <!--  ReSharper restore Xaml.RedundantResource  -->
                                        </StackPanel.Resources>
                                        <Border
                                            Padding="8,4"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionBaseBackgroundColor}"/>
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionBaseBorderColor}"/>
                                            </Border.BorderBrush>
                                            <shuxct:DescriptionTextBlock Description="{x:Bind Description, Mode=OneWay}" TextStyle="{StaticResource BodyTextBlockStyle}"/>
                                        </Border>
                                        <shuxct:DescriptionTextBlock
                                            Description="{x:Bind Description, Mode=OneWay}"
                                            TextStyle="{StaticResource BodyTextBlockStyle}"
                                            Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityRevertConverter}, Mode=OneWay}"/>
                                        <Border
                                            Margin="0,8,0,0"
                                            Padding="8,4"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionSpecialBackgroundColor}"/>
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{StaticResource SpecialDescriptionSpecialBorderColor}"/>
                                            </Border.BorderBrush>
                                            <shuxct:DescriptionTextBlock Description="{x:Bind SpecialDescription, Mode=OneWay}" TextStyle="{StaticResource BodyTextBlockStyle}"/>
                                        </Border>
                                        <ItemsControl Margin="0,12,0,0" ItemsSource="{x:Bind Info.Parameters, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <cwc:SettingsCard
                                                        Margin="0,2,0,0"
                                                        Padding="12,0"
                                                        Background="{Binding IsSpecial, Converter={StaticResource BoolToSpecialBackgroundConverter}}"
                                                        Header="{Binding Description}">
                                                        <TextBlock Margin="0,8" Text="{Binding Parameter}"/>
                                                    </cwc:SettingsCard>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </wl:LiquidGlassButton.Flyout>
                        </wl:LiquidGlassButton>
                    </cwc:Case>
                </cwc:SwitchPresenter>
            </DataTemplate>

            <DataTemplate x:Key="AvatarPropertyTemplate" x:DataType="shva:AvatarProperty">
                <Grid
                    Margin="-1,0"
                    Padding="16,12"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"

<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.RoleCombatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shmi="using:Snap.Hutao.Remastered.Model.Intrinsic"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcp="using:Snap.Hutao.Remastered.UI.Xaml.Control.Panel"
    xmlns:shuxct="using:Snap.Hutao.Remastered.UI.Xaml.Control.TextBlock"
    xmlns:shuxdcs="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter.Specialized"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvcom="using:Snap.Hutao.Remastered.ViewModel.Complex"
    xmlns:shvr="using:Snap.Hutao.Remastered.ViewModel.RoleCombat"
    d:DataContext="{d:DesignInstance shvr:RoleCombatViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shvr:RoleCombatViewModel)DataContext).LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <shuxc:ScopedPage.Resources>
        <shuxdcs:RoleCombatDifficultyIconConverter x:Key="RoleCombatDifficultyIconConverter"/>
        <shuxdcs:ElementTypeIconConverter x:Key="ElementTypeIconConverter"/>

        <shvr:RoleCombatAvatarTypeTemplateSelector
            x:Key="RoleCombatAvatarTypeTemplateSelector"
            SupportTemplate="{StaticResource SupportTemplate}"
            TrialTemplate="{StaticResource TrialTemplate}"/>

        <DataTemplate x:Key="RoleCombatListTemplate" x:DataType="shvr:RoleCombatView">
            <StackPanel Margin="0,6,0,8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind Schedule, Mode=OneWay}"/>
                    <TextBlock
                        Grid.Column="1"
                        Opacity="0.8"
                        Text="{x:Bind MaxRound, Mode=OneWay}"/>
                </Grid>
                <MenuFlyoutSeparator Margin="3,2"/>
                <TextBlock
                    Opacity="0.6"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind FormattedTime, Mode=OneWay}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="EnemyTemplate" x:DataType="shvr:EnemyView">
            <Grid>
                <ToolTipService.ToolTip>
                    <StackPanel Spacing="{StaticResource SettingsCardContentControlSpacing}">
                        <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{x:Bind Level, Mode=OneWay}"/>
                    </StackPanel>
                </ToolTipService.ToolTip>
                <Grid Height="48" CornerRadius="24">
                    <shuxc:ItemIcon
                        Width="48"
                        Height="48"
                        Icon="{x:Bind Icon, Mode=OneWay}"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TrialTemplate">
            <Border Background="#80000000" CornerRadius="{ThemeResource ControlCornerRadiusTopRightAndBottomLeft}">
                <TextBlock
                    Margin="6,0,6,2"
                    Foreground="#FFFFFFFF"
                    Text="{shuxm:ResourceString Name=ViewPageRoleCombatAvatarTrialHint}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SupportTemplate">
            <Border Background="#80000000" CornerRadius="{ThemeResource ControlCornerRadiusTopRightAndBottomLeft}">
                <TextBlock
                    Margin="6,0,6,2"
                    Foreground="#FFFFFFFF"
                    Text="{shuxm:ResourceString Name=ViewPageRoleCombatAvatarSupportHint}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AvatarTemplate" x:DataType="shvr:AvatarView">
            <Grid>
                <shuxc:ItemIcon
                    Width="48"
                    Height="48"
                    Icon="{x:Bind Icon, Mode=OneWay}"
                    Quality="{x:Bind Quality, Mode=OneWay}"/>
                <ContentControl
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Content="{x:Bind Type, Mode=OneWay}"
                    ContentTemplateSelector="{StaticResource RoleCombatAvatarTypeTemplateSelector}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BuffTemplate" x:DataType="shvr:BuffView">
            <Grid>
                <ToolTipService.ToolTip>
                    <StackPanel Spacing="{StaticResource SettingsCardContentControlSpacing}">
                        <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}"/>
                        <shuxct:DescriptionTextBlock Description="{x:Bind Description, Mode=OneWay}" TextStyle="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                </ToolTipService.ToolTip>
                <Grid Height="40" CornerRadius="20">
                    <shuxc:ItemIcon
                        Width="40"
                        Height="40"
                        Background="#A4000000"
                        Icon="{x:Bind Icon, Mode=OneWay}"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SplendourBuffLevelEffectTemplate" x:DataType="x:String">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="• "/>
                <shuxct:DescriptionTextBlock
                    Grid.Column="1"
                    Description="{Binding Mode=OneWay}"
                    TextStyle="{StaticResource CaptionTextBlockStyle}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SplendourBuffTemplate" x:DataType="shvr:SplendourBuffView">
            <Grid>
                <ToolTipService.ToolTip>
                    <StackPanel Spacing="{StaticResource SettingsCardContentControlSpacing}">
                        <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{x:Bind Name, Mode=OneTime}"/>
                        <ItemsControl ItemTemplate="{StaticResource SplendourBuffLevelEffectTemplate}" ItemsSource="{x:Bind Effects, Mode=OneTime}"/>
                    </StackPanel>
                </ToolTipService.ToolTip>
                <Grid Height="40" CornerRadius="20">
                    <shuxc:ItemIcon
                        Width="40"
                        Height="40"
                        Background="#A4000000"
                        Icon="{x:Bind Icon, Mode=OneTime}"/>
                </Grid>
                <InfoBadge
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Value="{x:Bind Level, Mode=OneTime}">
                    <InfoBadge.RenderTransform>
                        <CompositeTransform TranslateX="4" TranslateY="4"/>
                    </InfoBadge.RenderTransform>
                </InfoBadge>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ElementTemplate" x:DataType="shmi:ElementType">
            <shuxci:CachedImage
                Width="24"
                Height="24"
                ShowAsMonoChrome="True"
                Source="{Binding Converter={StaticResource ElementTypeIconConverter}, Mode=OneWay}"/>
        </DataTemplate>

        <DataTemplate x:Key="RoundTemplate" x:DataType="shvr:RoundView">
            <Grid RowSpacing="8" Style="{StaticResource GridShimmerStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"/>
                <TextBlock
                    Grid.Row="0"
                    Margin="8"
                    HorizontalAlignment="Right"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind FinishTimeString, Mode=OneWay}"
                    TextAlignment="Center"/>
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="8"
                    Orientation="Horizontal"
                    Spacing="2">
                    <BitmapIcon
                        Width="20"
                        ShowAsMonochrome="False"
                        UriSource="ms-appx:///Resource/Icon/UI_Icon_Tower_Star1.png"
                        Visibility="{x:Bind IsGetMedal, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                    <BitmapIcon
                        Width="20"
                        Foreground="#FF808080"
                        UriSource="ms-appx:///Resource/Icon/UI_Icon_Tower_Star2.png"
                        Visibility="{x:Bind IsGetMedal, Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{x:Bind RoundId, Mode=OneWay}"/>
                </StackPanel>

                <Grid
                    Grid.Row="1"
                    Margin="8,0"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl
                        Grid.Column="0"
                        ItemTemplate="{StaticResource EnemyTemplate}"
                        ItemsPanel="{ThemeResource WrapPanelSpacing6Template}"
                        ItemsSource="{x:Bind Enemies, Mode=OneWay}"/>
                    <ItemsControl
                        Grid.Column="1"
                        ItemTemplate="{StaticResource AvatarTemplate}"
                        ItemsPanel="{ThemeResource WrapPanelSpacing6Template}"
                        ItemsSource="{x:Bind Avatars, Mode=OneWay}"/>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Margin="8,0,8,8"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <!--  辉彩祝福  -->
                    <StackPanel Grid.Column="0" Margin="0,0,0,0">
                        <TextBlock Style="{ThemeResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageRoleCombatSplendourBuffsHeader}"/>
                        <shuxct:DescriptionTextBlock
                            Margin="0,0,0,5"
                            Description="{x:Bind SplendourSummary, Mode=OneWay}"
                            TextStyle="{StaticResource CaptionTextBlockStyle}"/>
                        <ItemsControl
                            ItemTemplate="{StaticResource SplendourBuffTemplate}"
                            ItemsPanel="{ThemeResource WrapPanelSpacing6Template}"
                            ItemsSource="{x:Bind SplendourBuffs, Mode=OneWay}"/>
                    </StackPanel>
                    <!--  神秘收获  -->
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Style="{ThemeResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageRoleCombatChoiceCardsHeader}"/>
                        <ItemsControl ItemTemplate="{StaticResource BuffTemplate}" ItemsSource="{x:Bind ChoiceCards, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <shuxcp:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </shuxc:ScopedPage.Resources>

    <Grid>
        <Pivot Style="{ThemeResource CardPivotStyle}">
            <Pivot.RightHeader>
                <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
                    <AppBarButton
                        Command="{x:Bind ((shvr:RoleCombatViewModel)DataContext).UploadRoleCombatRecordCommand, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xE898;}"
                        Label="{shuxm:ResourceString Name=ViewSpiralAbyssUploadRecord}"/>
                    <AppBarButton
                        Command="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RefreshCommand, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xE72C;}"
                        Label="{shuxm:ResourceString Name=ViewSpiralAbyssRefresh}"/>
                </CommandBar>
            </Pivot.RightHeader>

            <PivotItem Header="{shuxm:ResourceString Name=ViewSpiralAbyssDetail}">
                <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <SplitView
                            DisplayMode="Inline"
                            IsPaneOpen="True"
                            OpenPaneLength="248"
                            PaneBackground="Transparent">
                            <SplitView.Pane>
                                <ListView
                                    Padding="{ThemeResource ListViewInSplitPanePadding}"
                                    shuxcth:MaterialBackground.NativeBrush="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoCardBrush}"
                                    ItemTemplate="{StaticResource RoleCombatListTemplate}"
                                    ItemsSource="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries, Mode=OneWay}"
                                    SelectedItem="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem, Mode=TwoWay}"/>
                            </SplitView.Pane>
                            <SplitView.Content>
                                <ScrollViewer>
                                    <Grid
                                        Padding="16"
                                        DataContext="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem, Mode=OneWay}"
                                        RowSpacing="8"
                                        Visibility="{Binding Converter={StaticResource EmptyObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <!--  元素类型  -->
                                        <Border
                                            Grid.Row="0"
                                            Padding="8"
                                            Style="{ThemeResource BorderShimmerStyle}">
                                            <ItemsControl ItemTemplate="{StaticResource ElementTemplate}" ItemsSource="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.Elements, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <shuxcp:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </Border>
                                        <!--  开幕/特邀角色  -->
                                        <Grid Grid.Row="1">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{ThemeResource BorderShimmerStyle}">
                                                    <StackPanel Margin="8" Spacing="{ThemeResource SettingsCardSpacing}">
                                                        <TextBlock Style="{ThemeResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageRoleCombatInitialAvatarsHeader}"/>
                                                        <ItemsControl
                                                            ItemTemplate="{StaticResource AvatarTemplate}"
                                                            ItemsPanel="{ThemeResource WrapPanelSpacing6Template}"
                                                            ItemsSource="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.InitialAvatars, Mode=OneWay}"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="1" Style="{ThemeResource BorderShimmerStyle}">
                                                    <StackPanel Margin="8" Spacing="{ThemeResource SettingsCardSpacing}">
                                                        <TextBlock Style="{ThemeResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageRoleCombatSpecialAvatarsHeader}"/>
                                                        <ItemsControl
                                                            ItemTemplate="{StaticResource AvatarTemplate}"
                                                            ItemsPanel="{ThemeResource WrapPanelSpacing6Template}"
                                                            ItemsSource="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.SpecialAvatars, Mode=OneWay}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                        <!--  挑战记录  -->
                                        <Border Grid.Row="2" Style="{ThemeResource BorderShimmerStyle}">
                                            <shuxc:StandardView ShowCondition="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.Engaged, Mode=OneWay}">
                                                <shuxc:StandardView.EmptyContent>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Image
                                                            Height="200"
                                                            Source="ms-appx:///Resource/Icon/UI_Img_RoleCombat_EventDetail_Pic_Chance.png"
                                                            Stretch="Uniform"/>
                                                        <TextBlock
                                                            Margin="0,16,0,0"
                                                            HorizontalAlignment="Center"
                                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                                            Text="{shuxm:ResourceString Name=ViewPageRoleCombatNotEngagedHeader}"/>
                                                    </StackPanel>
                                                </shuxc:StandardView.EmptyContent>
                                                <StackPanel Margin="8" Spacing="8">
                                                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.Difficulty, Mode=OneWay}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.FormattedHeraldry, Mode=OneWay}"/>
                                                        <BitmapIcon
                                                            Width="20"
                                                            ShowAsMonochrome="False"
                                                            UriSource="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.Stat.Heraldry, Converter={StaticResource RoleCombatDifficultyIconConverter}, Mode=OneWay}"/>
                                                    </StackPanel>
                                                    <Border>
                                                        <Border.Resources>
                                                            <!--  ReSharper disable Xaml.RedundantResource  -->
                                                            <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                                                            <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                                                            <x:Double x:Key="SettingsCardMinHeight">0</x:Double>
                                                            <!--  ReSharper restore Xaml.RedundantResource  -->
                                                        </Border.Resources>

                                                        <ItemsControl>
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <shuxcp:UniformPanel
                                                                        ColumnSpacing="8"
                                                                        MinItemWidth="360"
                                                                        RowSpacing="8"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <cwc:SettingsCard
                                                                shuxcth:MaterialBackground.NativeBrush="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                                shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoSurfaceBrush}"
                                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                Header="{shuxm:ResourceString Name=ViewSpiralAbyssDefeat}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock
                                                                        Margin="0,0,16,0"
                                                                        VerticalAlignment="Center"
                                                                        Text="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.Defeat.Value, Mode=OneWay}"
                                                                        TextTrimming="None"
                                                                        TextWrapping="NoWrap"/>
                                                                    <shuxci:CachedImage
                                                                        Width="36"
                                                                        Height="36"
                                                                        Margin="-10,-20,-8,-10"
                                                                        Source="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.Defeat.SideIcon, Mode=OneWay}"/>
                                                                </StackPanel>
                                                            </cwc:SettingsCard>

                                                            <cwc:SettingsCard
                                                                shuxcth:MaterialBackground.NativeBrush="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                                shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoSurfaceBrush}"
                                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                Header="{shuxm:ResourceString Name=ViewSpiralAbyssDamage}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock
                                                                        Margin="0,0,16,0"
                                                                        VerticalAlignment="Center"
                                                                        Text="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.Damage.Value, Mode=OneWay}"
                                                                        TextTrimming="None"
                                                                        TextWrapping="NoWrap"/>
                                                                    <shuxci:CachedImage
                                                                        Width="36"
                                                                        Height="36"
                                                                        Margin="-10,-20,-8,-10"
                                                                        Source="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.Damage.SideIcon, Mode=OneWay}"/>
                                                                </StackPanel>
                                                            </cwc:SettingsCard>

                                                            <cwc:SettingsCard
                                                                shuxcth:MaterialBackground.NativeBrush="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                                shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoSurfaceBrush}"
                                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                Header="{shuxm:ResourceString Name=ViewSpiralAbyssTakeDamage}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock
                                                                        Margin="0,0,16,0"
                                                                        VerticalAlignment="Center"
                                                                        Text="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.TakeDamage.Value, Mode=OneWay}"
                                                                        TextTrimming="None"
                                                                        TextWrapping="NoWrap"/>
                                                                    <shuxci:CachedImage
                                                                        Width="36"
                                                                        Height="36"
                                                                        Margin="-10,-20,-8,-10"
                                                                        Source="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.TakeDamage.SideIcon, Mode=OneWay}"/>
                                                                </StackPanel>
                                                            </cwc:SettingsCard>

                                                            <cwc:SettingsCard
                                                                shuxcth:MaterialBackground.NativeBrush="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                                shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoSurfaceBrush}"
                                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                Header="{shuxm:ResourceString Name=ViewPageRoleCombatCoinNumber}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        Text="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.Stat.CoinNumber, Mode=OneWay}"
                                                                        TextTrimming="None"
                                                                        TextWrapping="NoWrap"/>
                                                                </StackPanel>
                                                            </cwc:SettingsCard>

                                                            <cwc:SettingsCard
                                                                shuxcth:MaterialBackground.NativeBrush="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                                shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoSurfaceBrush}"
                                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                Header="{shuxm:ResourceString Name=ViewPageRoleCombatMedalRound}">
                                                                <ItemsControl ItemsSource="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.Rounds, Mode=OneWay}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="shvr:RoundView">
                                                                            <Grid>
                                                                                <Grid Visibility="{x:Bind IsTarot, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                                                                    <BitmapIcon
                                                                                        Width="20"
                                                                                        Height="20"
                                                                                        ShowAsMonochrome="False"
                                                                                        UriSource="ms-appx:///Resource/Icon/UI_Icon_RoleCombat_Reward_Tarot_04.png"
                                                                                        Visibility="{x:Bind IsGetMedal, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                                                                                    <BitmapIcon
                                                                                        Width="20"
                                                                                        Height="20"
                                                                                        Foreground="#FF808080"
                                                                                        UriSource="ms-appx:///Resource/Icon/UI_Icon_RoleCombat_Reward_Tarot_05.png"
                                                                                        Visibility="{x:Bind IsGetMedal, Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}"/>
                                                                                </Grid>
                                                                                <Grid Visibility="{x:Bind IsTarot, Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}">
                                                                                    <BitmapIcon
                                                                                        Width="20"
                                                                                        Height="20"
                                                                                        ShowAsMonochrome="False"
                                                                                        UriSource="ms-appx:///Resource/Icon/UI_Icon_Tower_Star1.png"
                                                                                        Visibility="{x:Bind IsGetMedal, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                                                                                    <BitmapIcon
                                                                                        Width="20"
                                                                                        Height="20"
                                                                                        Foreground="#FF808080"
                                                                                        UriSource="ms-appx:///Resource/Icon/UI_Icon_Tower_Star2.png"
                                                                                        Visibility="{x:Bind IsGetMedal, Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}"/>
                                                                                </Grid>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </cwc:SettingsCard>

                                                            <cwc:SettingsCard
                                                                shuxcth:MaterialBackground.NativeBrush="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                                shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoSurfaceBrush}"
                                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                Content="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.FormattedTotalBattleTimes, Mode=OneWay}"
                                                                Header="{shuxm:ResourceString Name=ViewPageRoleCombatTotalBattleTime}"/>

                                                            <cwc:SettingsCard
                                                                shuxcth:MaterialBackground.NativeBrush="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                                shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoSurfaceBrush}"
                                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                Content="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.MaxRound, Mode=OneWay}"
                                                                Header="{shuxm:ResourceString Name=ViewPageRoleCombatMaxRound}"/>

                                                            <cwc:SettingsCard
                                                                shuxcth:MaterialBackground.NativeBrush="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                                shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoSurfaceBrush}"
                                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                Content="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.Stat.AvatarBonusNumber, Mode=OneWay}"
                                                                Header="{shuxm:ResourceString Name=ViewPageRoleCombatStatAvatarBonus}"/>

                                                            <cwc:SettingsCard
                                                                shuxcth:MaterialBackground.NativeBrush="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                                shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoSurfaceBrush}"
                                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                Content="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.Stat.RentCount, Mode=OneWay}"
                                                                Header="{shuxm:ResourceString Name=ViewPageRoleCombatStatRent}"/>

                                                            <cwc:SettingsCard
                                                                shuxcth:MaterialBackground.NativeBrush="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                                shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoSurfaceBrush}"
                                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                Header="{shuxm:ResourceString Name=ViewPageRoleCombatShortest}">
                                                                <ItemsControl ItemsPanel="{ThemeResource HorizontalStackPanelSpacing4Template}" ItemsSource="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.Shortest, Mode=OneWay}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <shuxci:CachedImage
                                                                                Width="36"
                                                                                Height="36"
                                                                                Margin="-10,-20,-8,-10"
                                                                                Source="{Binding SideIcon}"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </cwc:SettingsCard>
                                                        </ItemsControl>
                                                    </Border>

                                                    <Border Padding="8" Style="{ThemeResource BorderShimmerStyle}">
                                                        <StackPanel Spacing="{ThemeResource SettingsCardSpacing}">
                                                            <TextBlock Style="{ThemeResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageRoleCombatBackupAvatars}"/>
                                                            <ItemsControl
                                                                ItemTemplate="{StaticResource AvatarTemplate}"
                                                                ItemsPanel="{ThemeResource WrapPanelSpacing6Template}"
                                                                ItemsSource="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.BackupAvatars, Mode=OneWay}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <ItemsControl ItemTemplate="{StaticResource RoundTemplate}" ItemsSource="{x:Bind ((shvr:RoleCombatViewModel)DataContext).RoleCombatEntries.CurrentItem.Rounds, Mode=OneWay}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <shuxcp:UniformStaggeredPanel
                                                                    ColumnSpacing="8"
                                                                    MinItemWidth="480"
                                                                    RowSpacing="8"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </shuxc:StandardView>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </SplitView.Content>
                        </SplitView>
                    </Border>
                </Border>

            </PivotItem>

            <PivotItem Header="{shuxm:ResourceString Name=ViewSpiralAbyssHutaoStatistics}">
                <Grid DataContext="{x:Bind ((shvr:RoleCombatViewModel)DataContext).HutaoRoleCombatDatabaseViewModel, Mode=OneWay}">
                    <mxi:Interaction.Behaviors>
                        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shvr:RoleCombatViewModel)DataContext).HutaoRoleCombatDatabaseViewModel.LoadCommand, Mode=OneWay}"/>
                    </mxi:Interaction.Behaviors>

                    <Grid.Resources>
                        <DataTemplate x:Key="RatedAvatarTemplate" x:DataType="shvcom:AvatarView">
                            <shuxcc:HorizontalCard>
                                <shuxcc:HorizontalCard.Left>
                                    <shuxc:ItemIcon
                                        Width="56"
                                        Height="56"
                                        Icon="{x:Bind Icon, Mode=OneTime}"
                                        Quality="{x:Bind Quality, Mode=OneTime}"/>
                                </shuxcc:HorizontalCard.Left>
                                <shuxcc:HorizontalCard.Right>
                                    <TextBlock
                                        Width="64"
                                        Margin="8"
                                        HorizontalAlignment="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="{x:Bind Rate, Mode=OneTime}"/>
                                </shuxcc:HorizontalCard.Right>
                            </shuxcc:HorizontalCard>
                        </DataTemplate>
                    </Grid.Resources>

                    <Pivot Style="{ThemeResource CardPivotStyle}" Visibility="{x:Bind ((shvr:RoleCombatViewModel)DataContext).HutaoRoleCombatDatabaseViewModel.RecordTotal, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}">
                        <Pivot.RightHeader>
                            <CommandBar DefaultLabelPosition="Right">
                                <AppBarButton Icon="{shuxm:FontIcon Glyph=&#xE946;}" Label="{shuxm:ResourceString Name=ViewPageHutaoDatabaseOverview}">
                                    <AppBarButton.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <StackPanel
                                                MinWidth="260"
                                                Margin="0,-29,0,0"
                                                Spacing="{StaticResource SettingsCardSpacing}">
                                                <StackPanel.Resources>
                                                    <!--  ReSharper disable Xaml.RedundantResource  -->
                                                    <Thickness x:Key="SettingsCardPadding">16</Thickness>
                                                    <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                                                    <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
                                                    <x:Double x:Key="SettingsCardMinHeight">0</x:Double>
                                                    <!--  ReSharper restore Xaml.RedundantResource  -->
                                                </StackPanel.Resources>
                                                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageHutaoDatabaseOverviewDataCollect}"/>
                                                <cwc:SettingsCard Content="{x:Bind ((shvr:RoleCombatViewModel)DataContext).HutaoRoleCombatDatabaseViewModel.RecordTotal, Mode=OneWay}" Header="{shuxm:ResourceString Name=ViewPageHutaoDatabaseOverviewRecordTotal}"/>
                                            </StackPanel>
                                        </Flyout>
                                    </AppBarButton.Flyout>
                                </AppBarButton>
                            </CommandBar>
                        </Pivot.RightHeader>
                        <PivotItem Header="{shuxm:ResourceString Name=ViewPageHutaoDatabaseOverviewAvatarAppearanceRank}">
                            <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                                <Grid Style="{ThemeResource AcrylicGridCardStyle}">
                                    <GridView
                                        Padding="16,16,4,4"
                                        ItemContainerStyle="{StaticResource LargeGridViewItemStyle}"
                                        ItemTemplate="{StaticResource RatedAvatarTemplate}"
                                        ItemsSource="{x:Bind ((shvr:RoleCombatViewModel)DataContext).HutaoRoleCombatDatabaseViewModel.AvatarAppearances, Mode=OneWay}"
                                        SelectionMode="None"/>
                                </Grid>
                            </Border>
                        </PivotItem>
                    </Pivot>
                    <shuxc:Loading
                        Margin="16"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        IsLoading="{Binding Converter={StaticResource EmptyObjectToBoolRevertConverter}}"
                        Style="{ThemeResource DefaultLoadingViewStyle}"/>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</shuxc:ScopedPage>

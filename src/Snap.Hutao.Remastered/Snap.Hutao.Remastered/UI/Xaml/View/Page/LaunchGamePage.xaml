<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.LaunchGamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shas="using:Snap.Hutao.Remastered.Service.Game.AdvancedStart.Model"
    xmlns:shme="using:Snap.Hutao.Remastered.Model.Entity"
    xmlns:shsg="using:Snap.Hutao.Remastered.Service.Game"
    xmlns:shsgp="using:Snap.Hutao.Remastered.Service.Game.PathAbstraction"
    xmlns:shuil="using:Snap.Hutao.Remastered.UI.Input.LowLevel"
    xmlns:shux="using:Snap.Hutao.Remastered.UI.Xaml"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxba="using:Snap.Hutao.Remastered.UI.Xaml.Behavior.Action"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxdcs="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter.Specialized"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvg="using:Snap.Hutao.Remastered.ViewModel.Game"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance shvg:LaunchGameViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind DataContext.LoadCommand, Mode=OneWay}"/>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind DataContext.GamePackageInstallViewModel.LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <shux:BindingProxy x:Key="BindingProxy" DataContext="{x:Bind DataContext, Mode=OneWay}"/>

        <DataTemplate x:Key="GameAccountListTemplate" x:DataType="shme:GameAccount">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,16"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}"/>
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchAccountExpired}"
                        Visibility="{x:Bind IsExpired, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                </StackPanel>
                <StackPanel
                    x:Name="ButtonPanel"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                    <wl:LiquidGlassButton
                        Margin="4,8"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        MinWidth="35.2"
                        VerticalAlignment="Stretch"
                        Command="{Binding DataContext.ModifyGameAccountCommand, Source={StaticResource BindingProxy}}"
                        CommandParameter="{Binding Mode=OneWay}"
                        Content="&#xE8AC;"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchAccountRenameToolTip}"/>
                    <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                    <wl:LiquidGlassButton
                        Margin="4,8,0,8"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        MinWidth="35.2"
                        VerticalAlignment="Stretch"
                        Command="{Binding DataContext.RemoveGameAccountCommand, Source={StaticResource BindingProxy}}"
                        CommandParameter="{x:Bind Mode=OneWay}"
                        Content="&#xE74D;"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchAccountRemoveToolTip}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GamePathEntryListTemplate" x:DataType="shsgp:GamePathEntry">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Padding="0,16"
                    VerticalAlignment="Center"
                    Text="{x:Bind Path, Mode=OneWay}"/>
                <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                <wl:LiquidGlassButton
                    Grid.Column="1"
                    Margin="4,8,0,8"
                    shuxcth:ControlMaterialState.IsManaged="True"
                    MinWidth="48"
                    VerticalAlignment="Stretch"
                    Command="{Binding DataContext.RemoveGamePathEntryCommand, Source={StaticResource BindingProxy}}"
                    CommandParameter="{x:Bind Mode=OneWay}"
                    Content="&#xE74D;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchAccountRemoveToolTip}"/>
            </Grid>
        </DataTemplate>

        <shvg:AspectRatioComboBoxTemplateSelector x:Key="AspectRatioComboBoxTemplateSelector">
            <shvg:AspectRatioComboBoxTemplateSelector.ListTemplate>
                <DataTemplate x:DataType="shsg:AspectRatio">
                    <!--  ComboBoxItemThemePadding 11,5,11,7  -->
                    <Grid Margin="1,-1,-7,-3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center" Text="{Binding Mode=OneWay}"/>
                        <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                        <wl:LiquidGlassButton
                            Grid.Column="1"
                            shuxcth:ControlMaterialState.IsManaged="True"
                            MinWidth="32"
                            MinHeight="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.RemoveAspectRatioCommand, Source={StaticResource BindingProxy}}"
                            CommandParameter="{Binding Mode=OneWay}"
                            Content="&#xE711;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Style="{ThemeResource SettingButtonStyle}"/>
                    </Grid>
                </DataTemplate>
            </shvg:AspectRatioComboBoxTemplateSelector.ListTemplate>
        </shvg:AspectRatioComboBoxTemplateSelector>

        <shuxdcs:IntToNameValueVirtualKeyConverter x:Key="IntToNameValueVirtualKeyConverter"/>
    </Page.Resources>

    <shuxc:StandardView ShowCondition="{x:Bind DataContext.GamePathEntryValid.Value, Mode=OneWay}" Style="{ThemeResource DefaultStandardViewStyle}">
        <shuxc:StandardView.EmptyContent>
            <Border
                Margin="128,0"
                Padding="16"
                VerticalAlignment="Center"
                Style="{ThemeResource AcrylicBorderCardStyle}">
                <StackPanel
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="3">
                    <shuxci:CachedImage
                        Height="120"
                        MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                        Source="{StaticResource UI_EmotionIcon445}"/>
                    <TextBlock
                        Margin="0,5,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{shuxm:ResourceString Name=ViewPageLaunchGameSelectGamePath}"/>
                    <TextBlock
                        Margin="0,5,0,21"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource SystemErrorTextColor}"
                        Text="{shuxm:ResourceString Name=ViewPageLaunchGameSelectGamePathHint}"/>
                    <Border Style="{ThemeResource BorderCardStyle}" Visibility="{x:Bind DataContext.LaunchOptions.GamePathEntries.Value.Length, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}">
                        <ListView
                            ItemTemplate="{StaticResource GamePathEntryListTemplate}"
                            ItemsSource="{x:Bind DataContext.LaunchOptions.GamePathEntries.Value, Mode=OneWay}"
                            SelectedItem="{x:Bind DataContext.GamePathEntry.Value, Mode=TwoWay}"/>
                    </Border>
                    <cwc:SettingsCard
                        ActionIcon="{shuxm:FontIcon Glyph=&#xE76C;}"
                        ActionIconToolTip="{shuxm:ResourceString Name=ViewPageSettingSetGamePathAction}"
                        Command="{x:Bind DataContext.PickGamePathCommand, Mode=OneWay}"
                        Header="{shuxm:ResourceString Name=ViewPageSettingSetGamePathHeader}"
                        HeaderIcon="{shuxm:FontIcon Glyph=&#xE7FC;}"
                        IsClickEnabled="True">
                        <cwc:SettingsCard.Description>
                            <TextBlock Foreground="{ThemeResource SystemErrorTextColor}" Text="{shuxm:ResourceString Name=ViewPageSettingSetGamePathHint}"/>
                        </cwc:SettingsCard.Description>
                    </cwc:SettingsCard>
                    <cwc:SettingsCard
                        Padding="{ThemeResource SettingsExpanderItemHasIconPadding}"
                        Command="{x:Bind DataContext.GamePackageInstallViewModel.StartCommand, Mode=OneWay}"
                        Description="{x:Bind DataContext.GamePackageInstallViewModel.RemoteVersionText, Mode=OneWay}"
                        Header="{shuxm:ResourceString Name=ViewPageLaunchGamePackageOperationInstall}"
                        HeaderIcon="{shuxm:FontIcon Glyph={StaticResource FontIconContentCloudDownload}}"
                        IsClickEnabled="True"
                        IsEnabled="{shuxm:IsProcessElevated}">
                        <shuxc:Elevation Visibility="{shuxm:CollapsedWhenProcessElevated}"/>
                    </cwc:SettingsCard>
                </StackPanel>
            </Border>
        </shuxc:StandardView.EmptyContent>

        <Pivot Style="{ThemeResource CardPivotStyle}">
            <Pivot.RightHeader>
                <CommandBar DefaultLabelPosition="Right">
                    <CommandBar.Content>
                        <TextBlock
                            Margin="12,14,12,0"
                            VerticalAlignment="Center"
                            Text="{x:Bind DataContext.LaunchStatusOptions.LaunchStatus.Description, Mode=OneWay}"/>
                    </CommandBar.Content>
                    <AppBarButton
                        Command="{x:Bind DataContext.OpenScreenshotFolderCommand, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xED25;}"
                        Label="{shuxm:ResourceString Name=ViewPageOpenScreenshotFolderAction}"/>
                    <AppBarButton
                        Command="{x:Bind DataContext.ResetGamePathCommand, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xEBC4;}"
                        IsEnabled="{x:Bind shsg:LaunchOptions.IsGameRunning.Value, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                        Label="{shuxm:ResourceString Name=ViewPageResetGamePathAction}"
                        ToolTipService.ToolTip="{x:Bind DataContext.DisplayGamePath.Value, Mode=OneWay}"/>
                    <AppBarButton
                        Command="{x:Bind DataContext.KillGameProcessCommand, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xE733;}"
                        IsEnabled="{x:Bind shsg:LaunchOptions.CanKillGameProcess.Value, Mode=OneWay}"
                        Label="{shuxm:ResourceString Name=ViewPageLaunchGameKillGameProcessAction}"/>
                    <AppBarButton
                        Command="{x:Bind DataContext.LaunchCommand, Mode=OneWay}"
                        Icon="{shuxm:FontIcon Glyph=&#xE7FC;}"
                        IsEnabled="{x:Bind shsg:LaunchOptions.IsGameRunning.Value, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                        Label="{shuxm:ResourceString Name=ViewPageLaunchGameAction}"/>
                </CommandBar>
            </Pivot.RightHeader>

            <PivotItem Header="{shuxm:ResourceString Name=ViewPageLaunchGameOptionsHeader}">
                <ScrollViewer>
                    <StackPanel Margin="16" Spacing="16">
                        <StackPanel.ChildrenTransitions>
                            <EntranceThemeTransition FromVerticalOffset="50"/>
                            <RepositionThemeTransition IsStaggeringEnabled="False"/>
                        </StackPanel.ChildrenTransitions>
                        <!--  需要管理员权限的操作  -->
                        <Border cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                            <Grid Style="{ThemeResource AcrylicGridCardStyle}">
                                <Grid
                                    Margin="16"
                                    ColumnSpacing="12"
                                    Visibility="{shuxm:VisibleWhenProcessElevated}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <!--  修复/更新/预下载  -->
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Top"
                                        Spacing="12">
                                        <Grid Style="{ThemeResource GridCardStyle}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid
                                                Padding="16"
                                                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1"
                                                ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <shuxci:CachedImage
                                                    shux:FrameworkElementHelper.SquareLength="48"
                                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                                    Source="{StaticResource IconGame}"/>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Vertical"
                                                    Spacing="{ThemeResource SettingsCardSpacing}">
                                                    <TextBlock Text="{x:Bind DataContext.GamePackageViewModel.LocalVersionText, Mode=OneWay}"/>
                                                    <TextBlock Text="{x:Bind DataContext.GamePackageViewModel.RemoteVersionText, Mode=OneWay}"/>
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Opacity="0.7"
                                                            Text="{x:Bind DataContext.GamePackageViewModel.VersionSourcesText, Mode=OneWay}"
                                                            TextWrapping="Wrap"/>
                                                        <TeachingTip
                                                            x:Name="GameInstallationInfoTeachingTip"
                                                            Title="{shuxm:ResourceString Name=ViewPageGameInstallationInfoTitle}"
                                                            IsLightDismissEnabled="True"
                                                            Subtitle="{shuxm:ResourceString Name=ViewPageGameInstallationInfoDescription}"
                                                            Target="{x:Bind GameInstallationInfoButton}"/>
                                                        <Button
                                                            x:Name="GameInstallationInfoButton"
                                                            Grid.Column="1"
                                                            MinWidth="24"
                                                            MinHeight="24"
                                                            Padding="1"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="{shuxm:ResourceString Name=ViewPageGameInstallationInfoTitle}"
                                                            ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageGameInstallationInfoTitle}">
                                                            <mxi:Interaction.Behaviors>
                                                                <mxi:EventTriggerBehavior EventName="Click">
                                                                    <mxi:EventTriggerBehavior.Actions>
                                                                        <shuxba:ShowTeachingTipAction TeachingTip="{x:Bind GameInstallationInfoTeachingTip}"/>
                                                                    </mxi:EventTriggerBehavior.Actions>
                                                                </mxi:EventTriggerBehavior>
                                                            </mxi:Interaction.Behaviors>
                                                            <FontIcon FontSize="12" Glyph="&#xE946;"/>
                                                        </Button>
                                                    </Grid>
                                                    <InfoBar
                                                        IsClosable="False"
                                                        IsOpen="{x:Bind DataContext.GamePackageViewModel.HasInstallationWarning, Mode=OneWay}"
                                                        Message="{x:Bind DataContext.GamePackageViewModel.InstallationStatusText, Mode=OneWay}"
                                                        Severity="Warning"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel
                                                Grid.Row="1"
                                                Margin="-2,-6"
                                                Padding="16"
                                                Orientation="Horizontal">
                                                <AppBarButton
                                                    Command="{x:Bind DataContext.GamePackageViewModel.RefreshInstallationCommand, Mode=OneWay}"
                                                    Icon="Refresh"
                                                    IsEnabled="{x:Bind DataContext.GamePackageViewModel.IsNotRefreshing, Mode=OneWay}"
                                                    Label="{shuxm:ResourceString Name=ViewPageGameRefreshInstallation}"/>
                                                <AppBarButton
                                                    Command="{x:Bind DataContext.GamePackageViewModel.StartCommand, Mode=OneWay}"
                                                    CommandParameter="Verify"
                                                    Icon="{shuxm:FontIcon Glyph={StaticResource FontIconContentDeveloperTools}}"
                                                    IsEnabled="{x:Bind DataContext.GamePackageViewModel.CanOperate, Mode=OneWay}"
                                                    Label="{x:Bind DataContext.GamePackageViewModel.VerifyOperationLabel, Mode=OneWay}"
                                                    Style="{StaticResource DefaultAppBarButtonStyle}"/>
                                                <AppBarButton
                                                    Command="{x:Bind DataContext.GamePackageViewModel.StartCommand, Mode=OneWay}"
                                                    CommandParameter="Update"
                                                    Icon="{shuxm:FontIcon Glyph={StaticResource FontIconContentUpArrowShiftKey}}"
                                                    IsEnabled="{x:Bind DataContext.GamePackageViewModel.IsUpdateAvailable, Mode=OneWay}"
                                                    Label="{shuxm:ResourceString Name=ViewPageLaunchGamePackageOperationUpdate}"/>
                                                <Grid>
                                                    <AppBarButton
                                                        Command="{x:Bind DataContext.GamePackageViewModel.StartCommand, Mode=OneWay}"
                                                        CommandParameter="Predownload"
                                                        Icon="{shuxm:FontIcon Glyph={StaticResource FontIconContentDownload}}"
                                                        IsEnabled="{x:Bind DataContext.GamePackageViewModel.IsPredownloadButtonEnabled, Mode=OneWay}"
                                                        Label="{shuxm:ResourceString Name=ViewPageLaunchGamePackageOperationPredownload}"/>
                                                    <!--  预下载开放 Icon  -->
                                                    <Grid
                                                        Margin="4,8"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        ToolTipService.ToolTip="{x:Bind DataContext.GamePackageViewModel.PreVersionText, Mode=OneWay}"
                                                        Visibility="{x:Bind DataContext.GamePackageViewModel.IsPredownloadButtonEnabled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                                        <FontIcon
                                                            FontSize="16"
                                                            Foreground="{ThemeResource InfoBarInformationalSeverityIconBackground}"
                                                            Glyph="{ThemeResource InfoBarIconBackgroundGlyph}"/>
                                                        <FontIcon
                                                            FontSize="16"
                                                            Foreground="{ThemeResource InfoBarInformationalSeverityIconForeground}"
                                                            Glyph="{ThemeResource InfoBarInformationalIconGlyph}"/>
                                                    </Grid>
                                                    <!--  预下载进度  -->
                                                    <InfoBadge
                                                        Margin="4,8"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        ToolTipService.ToolTip="{x:Bind DataContext.GamePackageViewModel.PredownloadProgressText, Mode=OneWay}"
                                                        Visibility="{x:Bind DataContext.GamePackageViewModel.IsPredownloadInProgress, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                                        Value="{x:Bind DataContext.GamePackageViewModel.PredownloadProgress, Mode=OneWay}"/>
                                                    <!--  预下载完成 Icon  -->
                                                    <Grid
                                                        Margin="4,8"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGamePackageOperationPredownloadCompleteBadgeContent}"
                                                        Visibility="{x:Bind DataContext.GamePackageViewModel.IsPredownloadFinished, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                                        <FontIcon
                                                            FontSize="16"
                                                            Foreground="{ThemeResource InfoBarSuccessSeverityIconBackground}"
                                                            Glyph="{ThemeResource InfoBarIconBackgroundGlyph}"/>
                                                        <FontIcon
                                                            FontSize="16"
                                                            Foreground="{ThemeResource InfoBarSuccessSeverityIconForeground}"
                                                            Glyph="{ThemeResource InfoBarSuccessIconGlyph}"/>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="12">
                                        <!--  切换服务器  -->
                                        <cwc:SettingsCard
                                            VerticalAlignment="Top"
                                            Description="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchSchemeDescription}"
                                            Header="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchSchemeHeader}"
                                            HeaderIcon="{shuxm:FontIcon Glyph=&#xE8AB;}">
                                            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SettingsCardContentControlSpacing}">
                                                <wl:LiquidGlassButton
                                                    shuxcth:ControlMaterialState.IsManaged="True"
                                                    Command="{x:Bind DataContext.ConvertCommand, Mode=OneWay}"
                                                    Content="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchSchemeAction}"
                                                    Style="{ThemeResource SettingButtonStyle}"/>
                                                <shuxc:SizeRestrictedContentControl>
                                                    <shuxc:ComboBox2
                                                        DisplayMemberPath="DisplayName"
                                                        EnableMemberPath="IsNotCompatOnly"
                                                        IsEnabled="{x:Bind shsg:LaunchOptions.IsGameRunning.Value, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                                                        ItemsSource="{x:Bind DataContext.KnownSchemes, Mode=OneWay}"
                                                        SelectedItem="{x:Bind DataContext.TargetSchemeFilteredGameAccountsView.Scheme, Mode=TwoWay}"
                                                        Style="{StaticResource DefaultComboBoxStyle}"/>
                                                </shuxc:SizeRestrictedContentControl>
                                            </StackPanel>
                                        </cwc:SettingsCard>
                                        <!--  悬浮窗  -->
                                        <ScrollViewer>
                                            <cwc:SettingsExpander
                                                shuxc:SettingsExpanderHelper.IsItemsEnabled="{x:Bind DataContext.LaunchOptions.UsingOverlay.Value, Mode=OneWay}"
                                                Description="{shuxm:ResourceString Name=ViewPageLaunchGameOverlayDescription}"
                                                Header="{shuxm:ResourceString Name=ViewPageLaunchGameOverlayHeader}"
                                                HeaderIcon="{shuxm:FontIcon Glyph=&#xEB91;}"
                                                IsExpanded="True">
                                                <wl:LiquidGlassToggleSwitch
                                                    shuxcth:ControlMaterialState.IsManaged="True"
                                                    IsEnabled="{x:Bind shsg:LaunchOptions.IsGameRunning.Value, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                                                    IsOn="{x:Bind DataContext.LaunchOptions.UsingOverlay.Value, Mode=TwoWay}"/>
                                                <cwc:SettingsExpander.Items>
                                                    <cwc:SettingsCard
                                                        Padding="{ThemeResource SettingsCardAlignSettingsExpanderPadding}"
                                                        Description="{shuxm:ResourceString Name=ViewPageLaunchGameOverlayHideDescription}"
                                                        Header="{shuxm:ResourceString Name=ViewPageLaunchGameOverlayHideHeader}"
                                                        HeaderIcon="{shuxm:FontIcon Glyph=&#xED1A;}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <shuxc:SizeRestrictedContentControl VerticalAlignment="Center">
                                                                <wl:LiquidGlassComboBox
                                                                    shuxcth:ControlMaterialState.IsManaged="True"
                                                                    MinWidth="120"
                                                                    VerticalAlignment="Center"
                                                                    shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                                                    DisplayMemberPath="Name"
                                                                    ItemsSource="{x:Bind shuil:LowLevelKeyOptions.VirtualKeys}"
                                                                    SelectedItem="{x:Bind DataContext.LowLevelKeyOptions.OverlayHideKey, Mode=TwoWay}"/>
                                                            </shuxc:SizeRestrictedContentControl>
                                                        </StackPanel>
                                                    </cwc:SettingsCard>
                                                </cwc:SettingsExpander.Items>
                                            </cwc:SettingsExpander>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Grid>
                                <Border
                                    Grid.RowSpan="2"
                                    Padding="32"
                                    Visibility="{shuxm:CollapsedWhenProcessElevated}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <shuxc:Elevation HorizontalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBlock
                                            Margin="0,16,0,0"
                                            HorizontalAlignment="Center"
                                            Text="{shuxm:ResourceString Name=ViewPageLaunchGameElevationDescription}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!--  账户操作  -->
                        <Border Padding="0" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                            <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                                <StackPanel Spacing="{ThemeResource SettingsCardSpacing}">
                                    <cwc:SettingsCard
                                        Description="{shuxm:ResourceString Name=ViewPageLaunchGameUseHoyolabAccountDescription}"
                                        Header="{shuxm:ResourceString Name=ViewPageLaunchGameUseHoyolabAccountHeader}"
                                        HeaderIcon="{shuxm:FontIcon Glyph=&#xE748;}"
                                        IsEnabled="{x:Bind DataContext.LaunchOptions.AreCommandLineArgumentsEnabled.Value, Mode=OneWay}">
                                        <wl:LiquidGlassToggleSwitch
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                                            IsOn="{x:Bind DataContext.LaunchOptions.UsingHoyolabAccount.Value, Mode=TwoWay}"/>
                                    </cwc:SettingsCard>
                                    <cwc:SettingsCard
                                        ActionIconToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchAccountDetectAction}"
                                        Command="{x:Bind DataContext.DetectGameAccountCommand, Mode=OneWay}"
                                        Description="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchAccountDescription}"
                                        Header="{shuxm:ResourceString Name=ViewPageLaunchGameSwitchAccountHeader}"
                                        HeaderIcon="{shuxm:FontIcon Glyph=&#xE748;}"
                                        IsClickEnabled="True"
                                        IsEnabled="{x:Bind DataContext.LaunchOptions.UsingHoyolabAccount.Value, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"/>
                                    <Border Style="{StaticResource BorderCardStyle}" Visibility="{x:Bind DataContext.TargetSchemeFilteredGameAccountsView.View.Count, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}">
                                        <ListView
                                            Padding="{StaticResource ListViewInSplitPanePadding}"
                                            AllowDrop="{shuxm:IsProcessNotElevated}"
                                            CanReorderItems="{shuxm:IsProcessNotElevated}"
                                            IsEnabled="{x:Bind DataContext.LaunchOptions.UsingHoyolabAccount.Value, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                                            ItemTemplate="{StaticResource GameAccountListTemplate}"
                                            ItemsSource="{x:Bind DataContext.TargetSchemeFilteredGameAccountsView.View, Mode=OneWay}"
                                            SelectedItem="{x:Bind DataContext.TargetSchemeFilteredGameAccountsView.View.CurrentItem, Mode=TwoWay}">
                                            <ListView.Header>
                                                <InfoBar
                                                    Title="{shuxm:ResourceString Name=ViewListViewDragElevatedHint}"
                                                    Margin="4,2,4,2"
                                                    IsClosable="True"
                                                    IsOpen="True"
                                                    Severity="Warning"
                                                    Visibility="{shuxm:VisibleWhenProcessElevated}"/>
                                            </ListView.Header>
                                        </ListView>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!--  进程  -->
                        <Border Padding="0" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                            <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                                <StackPanel Spacing="{ThemeResource SettingsCardSpacing}">
                                    <StackPanel.ChildrenTransitions>

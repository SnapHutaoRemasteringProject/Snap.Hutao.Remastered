<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Snap.Hutao.Plugin.Services</AssemblyName>
    <RootNamespace>Snap.Hutao.Plugin.Services</RootNamespace>
    <CsWinRTComponent>true</CsWinRTComponent>
    <!-- Generate the complete component: CsWinRT 2.3.1 emits ExportsType.g.cs
         even in WinMD-only mode, where its WinRT.Module dependency is absent.
         Consumers still use only the staged WinMD, not this assembly. -->
    <CsWinRTGenerateProjection>false</CsWinRTGenerateProjection>
    <CsWinRTAotExportsEnabled>false</CsWinRTAotExportsEnabled>
    <IsPackable>false</IsPackable>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="StageAuthoredServicesWinMD" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).winmd')" Text="CsWinRT Authoring did not generate the services WinMD." />
    <MakeDir Directories="$(HutaoArtifacts)metadata" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).winmd" DestinationFiles="$(HutaoServicesWinmd)" SkipUnchangedFiles="true" />
  </Target>
</Project>

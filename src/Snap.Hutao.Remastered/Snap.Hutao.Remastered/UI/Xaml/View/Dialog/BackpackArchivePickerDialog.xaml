<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.BackpackArchivePickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:wl="using:WinUI.LiquidGlass"
    Title="{shuxm:ResourceString Name=ViewDialogBackpackArchivePickerTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid>
        <wl:LiquidGlassComboBox
            x:Name="ArchiveComboBox"
            Margin="0,0,0,8"
            VerticalAlignment="Top"
            shuxcth:ControlMaterialState.IsManaged="True"
            shuxcth:ComboBoxPopupLifetime.IsManaged="True"
            MinWidth="240"
            DisplayMemberPath="Name"/>
    </Grid>
</ContentDialog>

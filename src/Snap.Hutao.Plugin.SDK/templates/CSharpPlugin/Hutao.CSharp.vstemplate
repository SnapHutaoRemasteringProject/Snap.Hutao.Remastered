<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Snap Hutao Plugin (C# Native AOT)</Name>
    <Description>Creates an x64 C# Native AOT plugin for Snap Hutao Plugin SDK 2.0.</Description>
    <Icon>Icon.ico</Icon>
    <TemplateID>Snap.Hutao.Plugin.CSharp.NativeAot</TemplateID>
    <ProjectType>CSharp</ProjectType>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>MyHutaoPlugin</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LanguageTag>csharp</LanguageTag>
    <PlatformTag>windows</PlatformTag>
    <ProjectTypeTag>library</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <Project File="MyPlugin.csproj" TargetFileName="$safeprojectname$.csproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="false">Plugin.cs</ProjectItem>
      <ProjectItem ReplaceParameters="true">manifest.template.json</ProjectItem>
      <ProjectItem ReplaceParameters="false">Pack-Plugin.ps1</ProjectItem>
      <Folder Name="Properties">
        <Folder Name="PublishProfiles">
          <ProjectItem ReplaceParameters="false">NativeAot.pubxml</ProjectItem>
        </Folder>
      </Folder>
    </Project>
  </TemplateContent>
</VSTemplate>

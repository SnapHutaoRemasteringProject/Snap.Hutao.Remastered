<UserControl
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.OverlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxdcs="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter.Specialized"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvo="using:Snap.Hutao.Remastered.ViewModel.Overlay"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance shvo:OverlayViewModel}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{Binding LoadCommand}"/>
    </mxi:Interaction.Behaviors>

    <Grid
        Padding="4"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BackgroundSizing="OuterBorderEdge"
        BorderBrush="{x:Null}"
        BorderThickness="0"
        ColumnSpacing="4"
        CornerRadius="{ThemeResource OverlayCornerRadius}">

        <Grid.Resources>
            <SolidColorBrush
                x:Key="SolidBackgroundFillColorBaseBrush"
                Opacity="0.4"
                Color="{ThemeResource SolidBackgroundFillColorBase}"/>

            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorPrimary}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="{ThemeResource TextFillColorPrimary}"/>

            <SolidColorBrush x:Key="SplitButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}"/>
            <SolidColorBrush x:Key="SplitButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}"/>
            <SolidColorBrush x:Key="SplitButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorPrimary}"/>
            <SolidColorBrush x:Key="SplitButtonForegroundCheckedDisabled" Color="{ThemeResource TextFillColorPrimary}"/>

            <SolidColorBrush x:Key="SplitButtonForegroundSecondaryChecked" Color="{ThemeResource TextFillColorPrimary}"/>
            <SolidColorBrush x:Key="SplitButtonForegroundSecondaryCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}"/>
            <SolidColorBrush x:Key="SplitButtonForegroundSecondaryCheckedPressed" Color="{ThemeResource TextFillColorPrimary}"/>
            <SolidColorBrush x:Key="SplitButtonForegroundSecondaryCheckedDisabled" Color="{ThemeResource TextFillColorPrimary}"/>

            <SolidColorBrush
                x:Key="ToggleButtonBackgroundChecked"
                Opacity="0.4"
                Color="{ThemeResource SystemAccentColorDark1}"/>
            <SolidColorBrush
                x:Key="ToggleButtonBackgroundCheckedPointerOver"
                Opacity="0.36"
                Color="{ThemeResource SystemAccentColorDark1}"/>
            <SolidColorBrush
                x:Key="ToggleButtonBackgroundCheckedPressed"
                Opacity="0.32"
                Color="{ThemeResource SystemAccentColorDark1}"/>
            <SolidColorBrush
                x:Key="ToggleButtonBackgroundCheckedDisabled"
                Opacity="0.4"
                Color="{ThemeResource AccentFillColorDisabled}"/>
            <SolidColorBrush
                x:Key="SplitButtonBackgroundChecked"
                Opacity="0.4"
                Color="{ThemeResource SystemAccentColorDark1}"/>
            <SolidColorBrush
                x:Key="SplitButtonBackgroundCheckedPointerOver"
                Opacity="0.36"
                Color="{ThemeResource SystemAccentColorDark1}"/>
            <SolidColorBrush
                x:Key="SplitButtonBackgroundCheckedPressed"
                Opacity="0.32"
                Color="{ThemeResource SystemAccentColorDark1}"/>
            <SolidColorBrush
                x:Key="SplitButtonBackgroundCheckedDisabled"
                Opacity="0.4"
                Color="{ThemeResource AccentFillColorDisabled}"/>

            <shuxdcs:FrameRateStringConverter x:Key="FrameRateStringConverter"/>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <SplitButton
            Grid.Column="0"
            VerticalAlignment="Stretch"
            BorderThickness="0"
            Command="{Binding SwitchToNextCatalogCommand}">
            <SplitButton.Content>
                <FontIcon FontSize="16" Glyph="{Binding SelectedCatalog.Icon}"/>
            </SplitButton.Content>
            <SplitButton.Flyout>
                <Flyout
                    FlyoutPresenterStyle="{ThemeResource FlyoutPresenterPadding0And2Style}"
                    Placement="Bottom"
                    ShouldConstrainToRootBounds="False">
                    <ListView ItemsSource="{Binding Catalogs}" SelectedItem="{Binding SelectedCatalog, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        FontSize="16"
                                        Glyph="{Binding Icon}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Flyout>
            </SplitButton.Flyout>
        </SplitButton>

        <cwc:SwitchPresenter
            Grid.Column="1"
            ContentTransitions="{ThemeResource ContentThemeTransitions}"
            Value="{Binding SelectedCatalog.Id}">
            <cwc:Case Value="HotKey">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <cwc:SwitchPresenter
                        x:Name="GlassPresenter_6772"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:ToggleButton"
                        Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleButtonMaterial, Mode=OneWay}">
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>0</x:Int32>
                            </cwc:Case.Value>
                            <ToggleButton
                                Padding="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                BorderThickness="0"
                                IsChecked="{Binding HotKeyOptions.MouseClickRepeatForeverKeyCombination.IsOn, Mode=OneWay}"
                                IsEnabled="{Binding HotKeyOptions.MouseClickRepeatForeverKeyCombination.IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False">
                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{shuxm:ResourceString Name=ViewTitleAutoClicking}"/>
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding HotKeyOptions.MouseClickRepeatForeverKeyCombination.DisplayName, Mode=OneWay}"/>
                                </Grid>
                            </ToggleButton>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>1</x:Int32>
                            </cwc:Case.Value>
                            <wl:LiquidGlassToggleButton
                                Padding="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                shuxcth:ControlMaterialState.IsManaged="True"
                                BorderThickness="0"
                                IsChecked="{Binding HotKeyOptions.MouseClickRepeatForeverKeyCombination.IsOn, Mode=OneWay}"
                                IsEnabled="{Binding HotKeyOptions.MouseClickRepeatForeverKeyCombination.IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False">
                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{shuxm:ResourceString Name=ViewTitleAutoClicking}"/>
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding HotKeyOptions.MouseClickRepeatForeverKeyCombination.DisplayName, Mode=OneWay}"/>
                                </Grid>
                            </wl:LiquidGlassToggleButton>
                        </cwc:Case>
                    </cwc:SwitchPresenter>
                    <cwc:SwitchPresenter
                        x:Name="GlassPresenter_8313"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:ToggleButton"
                        Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleButtonMaterial, Mode=OneWay}">
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>0</x:Int32>
                            </cwc:Case.Value>
                            <ToggleButton
                                Padding="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                BorderThickness="0"
                                IsChecked="{Binding HotKeyOptions.KeyPressRepeatForeverKeyCombination.IsOn, Mode=OneWay}"
                                IsEnabled="{Binding HotKeyOptions.KeyPressRepeatForeverKeyCombination.IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False">
                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{shuxm:ResourceString Name=ViewTitleAutoPressing}"/>
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding HotKeyOptions.KeyPressRepeatForeverKeyCombination.DisplayName, Mode=OneWay}"/>
                                </Grid>
                            </ToggleButton>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>1</x:Int32>
                            </cwc:Case.Value>
                            <wl:LiquidGlassToggleButton
                                Padding="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                shuxcth:ControlMaterialState.IsManaged="True"
                                BorderThickness="0"
                                IsChecked="{Binding HotKeyOptions.KeyPressRepeatForeverKeyCombination.IsOn, Mode=OneWay}"
                                IsEnabled="{Binding HotKeyOptions.KeyPressRepeatForeverKeyCombination.IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False">
                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{shuxm:ResourceString Name=ViewTitleAutoPressing}"/>
                                    <TextBlock
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding HotKeyOptions.KeyPressRepeatForeverKeyCombination.DisplayName, Mode=OneWay}"/>
                                </Grid>
                            </wl:LiquidGlassToggleButton>
                        </cwc:Case>
                    </cwc:SwitchPresenter>
                </Grid>
            </cwc:Case>
            <cwc:Case Value="Island">
                <ContentControl
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsEnabled="{Binding LaunchOptions.IsIslandEnabled.Value}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleSplitButton
                            Padding="4,2"
                            VerticalAlignment="Stretch"
                            BorderThickness="0"
                            IsChecked="{Binding LaunchOptions.IsSetTargetFrameRateEnabled.Value, Mode=TwoWay}"
                            ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameTargetFpsHeader}">
                            <ToggleSplitButton.Flyout>
                                <Flyout FlyoutPresenterStyle="{ThemeResource FlyoutPresenterPadding4Style}" ShouldConstrainToRootBounds="False">
                                    <ContentControl IsEnabled="{Binding LaunchOptions.IsSetTargetFrameRateEnabled.Value}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <cwc:SwitchPresenter
                                                x:Name="GlassPresenter_11178"
                                                Margin="12,0"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsTabStop="False"
                                                Tag="LiquidGlass:Slider"
                                                Value="{x:Bind shuxcth:MaterialBindingSource.Current.SliderMaterial, Mode=OneWay}">
                                                <cwc:Case>
                                                    <cwc:Case.Value>
                                                        <x:Int32>0</x:Int32>
                                                    </cwc:Case.Value>
                                                    <Slider
                                                        Width="240"
                                                        VerticalAlignment="Center"
                                                        LargeChange="10"
                                                        Maximum="160"
                                                        Minimum="1"
                                                        SmallChange="1"
                                                        Value="{Binding LaunchOptions.TargetFps.Value, Mode=TwoWay}"/>
                                                </cwc:Case>
                                                <cwc:Case>
                                                    <cwc:Case.Value>
                                                        <x:Int32>1</x:Int32>
                                                    </cwc:Case.Value>
                                                    <wl:LiquidGlassSlider
                                                        Width="240"
                                                        VerticalAlignment="Center"
                                                        shuxcth:ControlMaterialState.IsManaged="True"
                                                        LargeChange="10"
                                                        Maximum="160"
                                                        Minimum="1"
                                                        SmallChange="1"
                                                        Value="{Binding LaunchOptions.TargetFps.Value, Mode=TwoWay}"/>
                                                </cwc:Case>
                                            </cwc:SwitchPresenter>
                                        </StackPanel>
                                    </ContentControl>

                                </Flyout>
                            </ToggleSplitButton.Flyout>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontWeight="Bold"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="FPS"/>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{Binding LaunchOptions.TargetFps.Value, Converter={StaticResource FrameRateStringConverter}}"/>
                            </StackPanel>
                        </ToggleSplitButton>

                        <ToggleSplitButton
                            Padding="4,2"
                            VerticalAlignment="Stretch"
                            BorderThickness="0"
                            IsChecked="{Binding LaunchOptions.IsSetFieldOfViewEnabled.Value, Mode=TwoWay}"
                            ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameTargetFovHeader}">
                            <ToggleSplitButton.Flyout>
                                <Flyout FlyoutPresenterStyle="{ThemeResource FlyoutPresenterPadding4Style}" ShouldConstrainToRootBounds="False">
                                    <ContentControl IsEnabled="{Binding LaunchOptions.IsSetFieldOfViewEnabled.Value}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <cwc:SwitchPresenter
                                                x:Name="GlassPresenter_13579"
                                                Margin="12,0"
                                                VerticalAlignment="Center"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsTabStop="False"
                                                Tag="LiquidGlass:Slider"
                                                Value="{x:Bind shuxcth:MaterialBindingSource.Current.SliderMaterial, Mode=OneWay}">
                                                <cwc:Case>
                                                    <cwc:Case.Value>
                                                        <x:Int32>0</x:Int32>
                                                    </cwc:Case.Value>
                                                    <Slider
                                                        Width="120"
                                                        VerticalAlignment="Center"
                                                        LargeChange="10"
                                                        Maximum="100"
                                                        Minimum="0"
                                                        SmallChange="1"
                                                        Value="{Binding LaunchOptions.TargetFov.Value, Mode=TwoWay}"/>
                                                </cwc:Case>
                                                <cwc:Case>
                                                    <cwc:Case.Value>
                                                        <x:Int32>1</x:Int32>
                                                    </cwc:Case.Value>
                                                    <wl:LiquidGlassSlider
                                                        Width="120"
                                                        VerticalAlignment="Center"
                                                        shuxcth:ControlMaterialState.IsManaged="True"
                                                        LargeChange="10"
                                                        Maximum="100"
                                                        Minimum="0"
                                                        SmallChange="1"
                                                        Value="{Binding LaunchOptions.TargetFov.Value, Mode=TwoWay}"/>
                                                </cwc:Case>
                                            </cwc:SwitchPresenter>
                                            <cwc:SwitchPresenter
                                                x:Name="GlassPresenter_14190"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsTabStop="False"
                                                Tag="LiquidGlass:ToggleButton"
                                                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleButtonMaterial, Mode=OneWay}">
                                                <cwc:Case>
                                                    <cwc:Case.Value>
                                                        <x:Int32>0</x:Int32>
                                                    </cwc:Case.Value>
                                                    <ToggleButton
                                                        Padding="8"
                                                        VerticalAlignment="Stretch"
                                                        IsChecked="{Binding LaunchOptions.DisablePlayerPerspective.Value, Mode=TwoWay}"
                                                        Style="{ThemeResource DefaultToggleButtonStyle}"
                                                        ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameDisablePlayerPerspectiveDescription}">
                                                        <FontIcon FontSize="16" Glyph="&#xF19D;"/>
                                                    </ToggleButton>
                                                </cwc:Case>
                                                <cwc:Case>
                                                    <cwc:Case.Value>
                                                        <x:Int32>1</x:Int32>
                                                    </cwc:Case.Value>
                                                    <wl:LiquidGlassToggleButton
                                                        Padding="8"
                                                        VerticalAlignment="Stretch"
                                                        shuxcth:ControlMaterialState.IsManaged="True"
                                                        IsChecked="{Binding LaunchOptions.DisablePlayerPerspective.Value, Mode=TwoWay}"
                                                        Style="{ThemeResource DefaultToggleButtonStyle}"
                                                        ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameDisablePlayerPerspectiveDescription}">
                                                        <FontIcon FontSize="16" Glyph="&#xF19D;"/>
                                                    </wl:LiquidGlassToggleButton>
                                                </cwc:Case>
                                            </cwc:SwitchPresenter>
                                            <cwc:SwitchPresenter
                                                x:Name="GlassPresenter_14916"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsTabStop="False"
                                                Tag="LiquidGlass:ToggleButton"
                                                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleButtonMaterial, Mode=OneWay}">
                                                <cwc:Case>
                                                    <cwc:Case.Value>
                                                        <x:Int32>0</x:Int32>
                                                    </cwc:Case.Value>
                                                    <ToggleButton
                                                        Padding="8"
                                                        VerticalAlignment="Stretch"
                                                        IsChecked="{Binding LaunchOptions.DisableFog.Value, Mode=TwoWay}"
                                                        Style="{ThemeResource DefaultToggleButtonStyle}"
                                                        ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameDisableFogHeader}">
                                                        <FontIcon FontSize="16" Glyph="&#xEC9C;"/>
                                                    </ToggleButton>
                                                </cwc:Case>
                                                <cwc:Case>
                                                    <cwc:Case.Value>
                                                        <x:Int32>1</x:Int32>
                                                    </cwc:Case.Value>
                                                    <wl:LiquidGlassToggleButton
                                                        Padding="8"
                                                        VerticalAlignment="Stretch"
                                                        shuxcth:ControlMaterialState.IsManaged="True"
                                                        IsChecked="{Binding LaunchOptions.DisableFog.Value, Mode=TwoWay}"
                                                        Style="{ThemeResource DefaultToggleButtonStyle}"
                                                        ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameDisableFogHeader}">
                                                        <FontIcon FontSize="16" Glyph="&#xEC9C;"/>
                                                    </wl:LiquidGlassToggleButton>
                                                </cwc:Case>
                                            </cwc:SwitchPresenter>
                                        </StackPanel>
                                    </ContentControl>
                                </Flyout>
                            </ToggleSplitButton.Flyout>
                            <StackPanel Spacing="4">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    Glyph="&#xE890;"/>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{Binding LaunchOptions.TargetFov.Value}"/>
                            </StackPanel>
                        </ToggleSplitButton>

                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_16423"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:ToggleButton"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleButtonMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <ToggleButton
                                    Padding="8"
                                    VerticalAlignment="Stretch"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    IsChecked="{Binding LaunchOptions.RemoveOpenTeamProgress.Value, Mode=TwoWay}"
                                    ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameRemoveOpenTeamProgressHeader}">
                                    <Grid>
                                        <FontIcon FontSize="16" Glyph="&#xE805;"/>
                                        <FontIcon FontSize="16" Glyph="&#xE894;"/>
                                    </Grid>
                                </ToggleButton>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassToggleButton
                                    Padding="8"
                                    VerticalAlignment="Stretch"
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    IsChecked="{Binding LaunchOptions.RemoveOpenTeamProgress.Value, Mode=TwoWay}"
                                    ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameRemoveOpenTeamProgressHeader}">
                                    <Grid>
                                        <FontIcon FontSize="16" Glyph="&#xE805;"/>
                                        <FontIcon FontSize="16" Glyph="&#xE894;"/>
                                    </Grid>
                                </wl:LiquidGlassToggleButton>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_17184"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:ToggleButton"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleButtonMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <ToggleButton
                                    Padding="8"
                                    VerticalAlignment="Stretch"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    IsChecked="{Binding LaunchOptions.HideQuestBanner.Value, Mode=TwoWay}"
                                    ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewOverlayLaunchGameHideQuestBannerToolTip}">
                                    <Grid>
                                        <FontIcon FontSize="16" Glyph="&#xE81E;"/>
                                        <FontIcon FontSize="16" Glyph="&#xE894;"/>
                                    </Grid>
                                </ToggleButton>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassToggleButton
                                    Padding="8"
                                    VerticalAlignment="Stretch"
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    IsChecked="{Binding LaunchOptions.HideQuestBanner.Value, Mode=TwoWay}"
                                    ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewOverlayLaunchGameHideQuestBannerToolTip}">
                                    <Grid>
                                        <FontIcon FontSize="16" Glyph="&#xE81E;"/>
                                        <FontIcon FontSize="16" Glyph="&#xE894;"/>
                                    </Grid>
                                </wl:LiquidGlassToggleButton>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_17935"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:ToggleButton"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleButtonMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <ToggleButton
                                    Padding="8"
                                    VerticalAlignment="Stretch"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    IsChecked="{Binding LaunchOptions.DisableEventCameraMove.Value, Mode=TwoWay}"
                                    ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameEventCameraMoveHotSwitchHeader}">
                                    <Grid>
                                        <FontIcon FontSize="16" Glyph="&#xE89E;"/>
                                        <FontIcon FontSize="16" Glyph="&#xE894;"/>
                                    </Grid>
                                </ToggleButton>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassToggleButton
                                    Padding="8"
                                    VerticalAlignment="Stretch"
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    IsChecked="{Binding LaunchOptions.DisableEventCameraMove.Value, Mode=TwoWay}"
                                    ToolTipService.ToolTip="{shuxm:ResourceString Name=ViewPageLaunchGameEventCameraMoveHotSwitchHeader}">
                                    <Grid>
                                        <FontIcon FontSize="16" Glyph="&#xE89E;"/>

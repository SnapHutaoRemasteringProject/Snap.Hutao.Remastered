<UserControl
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Specialized.HutaoStatisticsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shux="using:Snap.Hutao.Remastered.UI.Xaml"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvg="using:Snap.Hutao.Remastered.ViewModel.GachaLog"
    cw:Effects.Shadow="{ThemeResource CompatCardShadow}"
    d:DataContext="{d:DesignInstance shvg:HutaoWishSummary}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="GridTemplate" x:DataType="shvg:StatisticsItem">
            <shuxcc:VerticalCard>
                <shuxcc:VerticalCard.Top>
                    <shuxc:ItemIcon
                        shux:FrameworkElementHelper.SquareLength="40"
                        Icon="{x:Bind Icon, Mode=OneWay}"
                        Quality="{x:Bind Quality, Mode=OneWay}"/>
                </shuxcc:VerticalCard.Top>
                <shuxcc:VerticalCard.Bottom>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Count, Mode=OneWay}"/>
                </shuxcc:VerticalCard.Bottom>
            </shuxcc:VerticalCard>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{ThemeResource AcrylicGridCardStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            cw:UIElementExtensions.ClipToBounds="True"
            CornerRadius="{StaticResource ControlCornerRadiusTop}"
            Style="{ThemeResource GridCardStyle}">
            <cwc:ConstrainedBox
                Margin="-1"
                HorizontalAlignment="Center"
                AspectRatio="1080:533"
                CornerRadius="{ThemeResource ControlCornerRadiusTop}">
                <shuxci:CachedImage Source="{x:Bind DataContext.Event.Banner, Mode=OneWay}" Stretch="UniformToFill"/>
            </cwc:ConstrainedBox>
            <Border
                Margin="-1"
                Background="{ThemeResource DarkOnlyOverlayMaskColorBrush}"
                IsHitTestVisible="False"/>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16,0,12,16">
                <TextBlock
                    Margin="0,16,0,8"
                    Foreground="{ThemeResource UpPullColorBrush}"
                    Style="{StaticResource BaseTextBlockStyle}"
                    Text="{shuxm:ResourceString Name=ViewControlStatisticsCardUpText}"
                    Visibility="{x:Bind DataContext.UpItems.Length, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}"/>
                <ItemsControl
                    ItemTemplate="{StaticResource GridTemplate}"
                    ItemsPanel="{StaticResource WrapPanelSpacing4Template}"
                    ItemsSource="{x:Bind shux:ItemsSourceHelper.Create(DataContext.UpItems, DataContext.UpItems.IsDefaultOrEmpty), Mode=OneWay}"
                    Visibility="{x:Bind DataContext.UpItems.Length, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}"/>

                <TextBlock
                    Margin="0,16,0,8"
                    Foreground="{ThemeResource OrangeColorBrush}"
                    Style="{StaticResource BaseTextBlockStyle}"
                    Text="{shuxm:ResourceString Name=ViewControlStatisticsCardOrangeText}"
                    Visibility="{x:Bind DataContext.OrangeItems.Length, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}"/>
                <ItemsControl
                    ItemTemplate="{StaticResource GridTemplate}"
                    ItemsPanel="{StaticResource WrapPanelSpacing4Template}"
                    ItemsSource="{x:Bind shux:ItemsSourceHelper.Create(DataContext.OrangeItems, DataContext.OrangeItems.IsDefaultOrEmpty), Mode=OneWay}"
                    Visibility="{x:Bind DataContext.OrangeItems.Length, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}"/>

                <TextBlock
                    Margin="0,16,0,8"
                    Foreground="{ThemeResource PurpleColorBrush}"
                    Style="{StaticResource BaseTextBlockStyle}"
                    Text="{shuxm:ResourceString Name=ViewControlStatisticsCardPurpleText}"
                    Visibility="{x:Bind DataContext.PurpleItems.Length, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}"/>
                <ItemsControl
                    ItemTemplate="{StaticResource GridTemplate}"
                    ItemsPanel="{StaticResource WrapPanelSpacing4Template}"
                    ItemsSource="{x:Bind shux:ItemsSourceHelper.Create(DataContext.PurpleItems, DataContext.PurpleItems.IsDefaultOrEmpty), Mode=OneWay}"
                    Visibility="{x:Bind DataContext.PurpleItems.Length, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}"/>

                <TextBlock
                    Margin="0,16,0,8"
                    Foreground="{ThemeResource BlueColorBrush}"
                    Style="{StaticResource BaseTextBlockStyle}"
                    Text="{shuxm:ResourceString Name=ViewControlStatisticsCardBlueText}"
                    Visibility="{x:Bind DataContext.BlueItems.Length, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}"/>
                <ItemsControl
                    ItemTemplate="{StaticResource GridTemplate}"
                    ItemsPanel="{StaticResource WrapPanelSpacing4Template}"
                    ItemsSource="{x:Bind shux:ItemsSourceHelper.Create(DataContext.BlueItems, DataContext.BlueItems.IsDefaultOrEmpty), Mode=OneWay}"
                    Visibility="{x:Bind DataContext.BlueItems.Length, Converter={StaticResource Int32ToVisibilityConverter}, Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Snap.Hutao.Remastered</RootNamespace>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.EntityFrameworkCore.GeneratedInterceptors</InterceptorsNamespaces>
    <!-- Explicit experimental API opt-in in the design-time host. -->
    <NoWarn>$(NoWarn);EF9100</NoWarn>
    <ApplicationSource>../../src/Snap.Hutao.Remastered/Snap.Hutao.Remastered</ApplicationSource>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);HUTAO_NATIVEAOT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.3.26522.148" PrivateAssets="all" IncludeAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.VisualStudio.Validation" Version="17.13.22" />
    <PackageReference Include="Snap.Hutao.Remastered.SourceGeneration" Version="1.3.17" PrivateAssets="all" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Include="Sentry.Extensions.Logging" Version="7.0.0-rc.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <Compile Remove="QueryCompiler.cs;FixtureBuilder.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Sentry" />
    <Compile Include="$(ApplicationSource)/Core/Diagnostics/SentrySpanScope.cs;$(ApplicationSource)/Core/Database/SentryDbCommandInterceptor.cs" Link="Production/Diagnostics/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(ApplicationSource)/Model/Entity/**/*.cs" Exclude="$(ApplicationSource)/Model/Entity/**/*.Factory.cs;$(ApplicationSource)/Model/Entity/**/*.Presentation.cs;$(ApplicationSource)/Model/Entity/**/Extension/*.cs;$(ApplicationSource)/Model/Entity/Primitive/Converter/*.cs;$(ApplicationSource)/Model/Entity/BackpackItemCategoryExtension.cs" Link="Production/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(ApplicationSource)/Model/Intrinsic/*.cs" Link="Production/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(ApplicationSource)/Model/Primitive/**/*.cs" Link="Production/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(ApplicationSource)/Core/Database/Abstraction/*.cs" Link="Production/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(ApplicationSource)/Core/Database/*Queries.cs;$(ApplicationSource)/Core/Database/DatabaseCommands.cs;$(ApplicationSource)/Core/Database/DatabaseSchema.cs;$(ApplicationSource)/Core/Database/Schema/DatabaseMigrations.g.cs" Link="Production/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(ApplicationSource)/UI/Xaml/Data/IPropertyValuesProvider.cs" Link="Production/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(ApplicationSource)/Core/Text/Json/PersistenceJsonContext.cs;$(ApplicationSource)/Core/Text/Json/JsonWireOptions.cs;$(ApplicationSource)/Core/Text/Json/Converter/*.cs;$(ApplicationSource)/Core/Text/Json/Annotation/*.cs" Link="Production/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(ApplicationSource)/Web/Hoyolab/Takumi/GameRecord/**/*.cs" Exclude="$(ApplicationSource)/Web/Hoyolab/Takumi/GameRecord/**/*Client*.cs;$(ApplicationSource)/Web/Hoyolab/Takumi/GameRecord/*Headers.cs;$(ApplicationSource)/Web/Hoyolab/Takumi/GameRecord/Avatar/CharacterData.cs;$(ApplicationSource)/Web/Hoyolab/Takumi/GameRecord/RoleIdServer.cs" Link="Production/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(ApplicationSource)/Web/Hoyolab/Takumi/Event/Calculate/Item.cs;$(ApplicationSource)/Extension/StringBuilderExtension.cs;$(ApplicationSource)/Model/InterChange/Achievement/UIAFItem.cs;$(ApplicationSource)/Web/Hoyolab/Hk4e/Event/GachaInfo/GachaType.cs;$(ApplicationSource)/Web/Response/ListWrapper.cs;$(ApplicationSource)/Core/DependencyInjection/Annotation/HttpClient/HttpClientConfiguration.cs" Link="Production/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(ApplicationSource)/Web/Hoyolab/Cookie.cs;$(ApplicationSource)/Web/Hoyolab/Cookie.Constant.cs;$(ApplicationSource)/Web/Hoyolab/CookieExtension.cs" Link="Production/%(RecursiveDir)%(Filename)%(Extension)" />
    <AdditionalFiles Include="$(ApplicationSource)/IdentityStructs.json;$(ApplicationSource)/Resource/Localization/SH.resx" />
    <EmbeddedResource Include="$(ApplicationSource)/Resource/Localization/SH.resx" LogicalName="Snap.Hutao.Remastered.Resource.Localization.SH.resources" />
    <EmbeddedResource Include="Fixtures/*.json" LogicalName="Hutao.Database.Fixtures.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(GenerateEfQueries)' == 'true'">
    <Compile Remove="$(ApplicationSource)/Model/Entity/Database/Compiled/*EFInterceptors*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(ApplicationSource)/Service/Abstraction/IAppService.cs;$(ApplicationSource)/Service/Abstraction/IAppInfrastructureService.cs;$(ApplicationSource)/Service/Abstraction/IRepository.cs;$(ApplicationSource)/Service/Abstraction/Repository*.cs;$(ApplicationSource)/Service/Abstraction/ServiceScopeExtension.cs;$(ApplicationSource)/Core/Database/DbSetExtension.cs;$(ApplicationSource)/Web/Hutao/GachaLog/GachaItem.cs;$(ApplicationSource)/Core/ExceptionService/HutaoException.cs;$(ApplicationSource)/Service/Achievement/*Repository.cs;$(ApplicationSource)/Service/Backpack/*Repository.cs;$(ApplicationSource)/Service/Cultivation/*Repository.cs;$(ApplicationSource)/Service/GachaLog/*Repository.cs;$(ApplicationSource)/Service/AvatarInfo/*Repository.cs;$(ApplicationSource)/Service/DailyNote/*Repository.cs;$(ApplicationSource)/Service/Inventory/*Repository.cs;$(ApplicationSource)/Service/SpiralAbyss/*Repository.cs;$(ApplicationSource)/Service/RoleCombat/*Repository.cs;$(ApplicationSource)/Service/HardChallenge/*Repository.cs;$(ApplicationSource)/Service/User/*Repository.cs;$(ApplicationSource)/Service/Hutao/AvatarStrategyRepository.cs;$(ApplicationSource)/Service/Hutao/IAvatarStrategyRepository.cs" Link="Production/Repositories/%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="../../src/Snap.Hutao.Remastered/Snap.Hutao.Remastered/Build/DatabaseSchema.targets" />
  <Target Name="ConfigureDatabaseModelSourceRoot" BeforeTargets="CoreCompile">
    <!-- Keep real MSBuild ProjectDir for EF; override only the linked resource generator input. -->
    <WriteLinesToFile File="$(IntermediateOutputPath)DatabaseModel.globalconfig" Lines="is_global = true;global_level = 200;build_property.ProjectDir = $([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(ApplicationSource)'))/" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><EditorConfigFiles Include="$(IntermediateOutputPath)DatabaseModel.globalconfig" /></ItemGroup>
  </Target>
</Project>

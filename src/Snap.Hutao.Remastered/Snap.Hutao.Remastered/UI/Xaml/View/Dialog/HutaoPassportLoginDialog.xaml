<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.HutaoPassportLoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:wl="using:WinUI.LiquidGlass"
    Title="{shuxm:ResourceString Name=ViewDialogHutaoPassportLoginTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Margin="0,8,0,0" Spacing="16">
        <cwc:SwitchPresenter
            x:Name="GlassPresenter_836"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:TextBox"
            Value="{x:Bind shuxcth:MaterialBindingSource.Current.TextBoxMaterial, Mode=OneWay}">
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>0</x:Int32>
                </cwc:Case.Value>
                <TextBox
                    InputScope="EmailSmtpAddress"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{x:Bind PassportUserNameHint}"
                    Text="{x:Bind UserName, Mode=TwoWay}"/>
            </cwc:Case>
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>1</x:Int32>
                </cwc:Case.Value>
                <wl:LiquidGlassTextBox
                    shuxcth:ControlMaterialState.IsManaged="True"
                    InputScope="EmailSmtpAddress"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{x:Bind PassportUserNameHint}"
                    Text="{x:Bind UserName, Mode=TwoWay}"/>
            </cwc:Case>
        </cwc:SwitchPresenter>
        <cwc:SwitchPresenter
            x:Name="GlassPresenter_1047"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Tag="LiquidGlass:PasswordBox"
            Visibility="{x:Bind GlassNative_1047.Visibility, Mode=OneWay}"
            Value="{x:Bind shuxcth:MaterialBindingSource.Current.PasswordBoxMaterial, Mode=OneWay}">
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>0</x:Int32>
                </cwc:Case.Value>
                <PasswordBox
                    x:Name="GlassNative_1047"
                    DataContext="{x:Bind GlassPresenter_1047.DataContext, Mode=OneWay}"
                    Password="{x:Bind Password, Mode=TwoWay}"
                    PasswordChar="*"
                    PlaceholderText="{shuxm:ResourceString Name=ViewPageHutaoPassportPasswordHint}"
                    shuxcth:ThemeSynchronization.Source="{x:Bind GlassPresenter_1047}"/>
            </cwc:Case>
            <cwc:Case>
                <cwc:Case.Value>
                    <x:Int32>1</x:Int32>
                </cwc:Case.Value>
                <wl:LiquidGlassPasswordBox
                    x:Name="GlassNative_1047Glass"
                    Width="{x:Bind GlassNative_1047.Width, Mode=OneWay}"
                    Height="{x:Bind GlassNative_1047.Height, Mode=OneWay}"
                    MinWidth="{x:Bind GlassNative_1047.MinWidth, Mode=OneWay}"
                    MinHeight="{x:Bind GlassNative_1047.MinHeight, Mode=OneWay}"
                    MaxWidth="{x:Bind GlassNative_1047.MaxWidth, Mode=OneWay}"
                    MaxHeight="{x:Bind GlassNative_1047.MaxHeight, Mode=OneWay}"
                    Padding="{x:Bind GlassNative_1047.Padding, Mode=OneWay}"
                    shuxcth:ControlMaterialState.IsManaged="True"
                    shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassNative_1047, Mode=OneWay}"
                    shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                    BorderThickness="{x:Bind GlassNative_1047.BorderThickness, Mode=OneWay}"
                    FlowDirection="{x:Bind GlassNative_1047.FlowDirection, Mode=OneWay}"
                    FontFamily="{x:Bind GlassNative_1047.FontFamily, Mode=OneWay}"
                    FontSize="{x:Bind GlassNative_1047.FontSize, Mode=OneWay}"
                    FontStyle="{x:Bind GlassNative_1047.FontStyle, Mode=OneWay}"
                    FontWeight="{x:Bind GlassNative_1047.FontWeight, Mode=OneWay}"
                    IsEnabled="{x:Bind GlassNative_1047.IsEnabled, Mode=OneWay}"
                    Password="{x:Bind GlassNative_1047.Password, Mode=TwoWay}"
                    PlaceholderText="{x:Bind GlassNative_1047.PlaceholderText, Mode=OneWay}"/>
            </cwc:Case>
        </cwc:SwitchPresenter>
    </StackPanel>
</ContentDialog>

<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.TestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwh="using:CommunityToolkit.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxba="using:Snap.Hutao.Remastered.UI.Xaml.Behavior.Action"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shuxvww="using:Snap.Hutao.Remastered.UI.Xaml.View.Window.WebView2"
    xmlns:shv="using:Snap.Hutao.Remastered.ViewModel"
    xmlns:shwhr="using:Snap.Hutao.Remastered.Web.Hutao.Redeem"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance shv:TestViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind DataContext.LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Border Margin="16" Style="{ThemeResource AcrylicBorderCardStyle}">
        <ScrollViewer>
            <StackPanel Margin="16" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock
                    Margin="1,0,0,5"
                    Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}"
                    Text="WebView"/>
                <cwc:SettingsCard Header="Adopt Calculator" IsClickEnabled="True">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Click">
                            <shuxba:ShowWebView2WindowAction>
                                <shuxba:ShowWebView2WindowAction.ContentProvider>
                                    <shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                        <shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                            <shuxvww:StaticJSBridgeUriSourceProvider ChineseSource="http://webstatic.mihoyo.com/ys/event/e20200923adopt_calculator/index.html?bbs_presentation_style=fullscreen&amp;bbs_auth_required=true&amp;utm_source=bbs&amp;utm_medium=mys&amp;utm_campaign=GameRecord"/>
                                        </shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                    </shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                </shuxba:ShowWebView2WindowAction.ContentProvider>
                            </shuxba:ShowWebView2WindowAction>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Community Game Record" IsClickEnabled="True">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Click">
                            <shuxba:ShowWebView2WindowAction>
                                <shuxba:ShowWebView2WindowAction.ContentProvider>
                                    <shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                        <shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                            <shuxvww:StaticJSBridgeUriSourceProvider ChineseSource="https://webstatic.mihoyo.com/app/community-game-records/index.html"/>
                                        </shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                    </shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                </shuxba:ShowWebView2WindowAction.ContentProvider>
                            </shuxba:ShowWebView2WindowAction>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="SignIn Reward" IsClickEnabled="True">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Click">
                            <shuxba:ShowWebView2WindowAction>
                                <shuxba:ShowWebView2WindowAction.ContentProvider>
                                    <shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                        <shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                            <shuxvww:StaticJSBridgeUriSourceProvider ChineseSource="https://act.mihoyo.com/bbs/event/signin/hk4e/index.html?act_id=e202311201442471"/>
                                        </shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                    </shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                </shuxba:ShowWebView2WindowAction.ContentProvider>
                            </shuxba:ShowWebView2WindowAction>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                </cwc:SettingsCard>

                <TextBlock Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" Text="State"/>
                <cwc:SettingsCard Header="Reset Guide State">
                    <wl:LiquidGlassButton
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Command="{x:Bind shv:TestViewModel.ResetGuideStateCommand}"
                        Content="Reset (No restart)"
                        Style="{ThemeResource SettingButtonStyle}"/>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Resize MainWindow">
                    <wl:LiquidGlassButton
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Command="{x:Bind DataContext.ResetMainWindowSizeCommand, Mode=OneWay}"
                        Content="Reset"
                        Style="{ThemeResource SettingButtonStyle}"/>
                </cwc:SettingsCard>

                <TextBlock Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" Text="Condition Override"/>

                <cwc:SettingsCard Header="Override Elevation Requirement">
                    <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.OverrideElevationRequirement, Mode=TwoWay}"/>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Override Update Version Comparison">
                    <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.OverrideUpdateVersionComparison, Mode=TwoWay}"/>
                </cwc:SettingsCard>

                <cwc:SettingsCard
                    Command="{x:Bind DataContext.ForceUpdateDialogCommand, Mode=OneWay}"
                    Description="Show the update dialog without requiring an actual new version"
                    Header="Force Show Update Dialog"
                    IsClickEnabled="True"/>

                <cwc:SettingsCard
                    Command="{x:Bind DataContext.OpenStoreTestCommand, Mode=OneWay}"
                    Description="Open product 9P1LDJFJFJQQ using the same Store link and web fallback as updates; works in packaged and unpackaged builds"
                    Header="Open Microsoft Store (Test)"
                    IsClickEnabled="True"/>

                <cwc:SettingsCard Header="Override Package Convert Directory Permission Requirement">
                    <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.OverridePackageConvertDirectoryPermissionsRequirement, Mode=TwoWay}"/>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Override Hard Drive Type">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SettingsCardContentControlSpacing}">
                        <wl:LiquidGlassToggleSwitch
                            shuxcth:ControlMaterialState.IsManaged="True"
                            IsEnabled="{x:Bind HardDriveTypeToggle.IsOn, Mode=OneWay}"
                            IsOn="{x:Bind DataContext.OverrideHardDriveTypeIsSolidState, Mode=TwoWay}"
                            OffContent="HDD"
                            OnContent="SSD"/>
                        <wl:LiquidGlassToggleSwitch
                            x:Name="HardDriveTypeToggle"
                            shuxcth:ControlMaterialState.IsManaged="True"
                            IsOn="{x:Bind DataContext.OverrideHardDriveType, Mode=TwoWay}"/>
                    </StackPanel>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Always Treat As First Run After Update">
                    <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.AlwaysIsFirstRunAfterUpdate, Mode=TwoWay}"/>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Alpha Build Generic API Endpoint">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SettingsCardContentControlSpacing}">
                        <wl:LiquidGlassToggleSwitch
                            x:Name="GenericApiEndPointToggle"
                            shuxcth:ControlMaterialState.IsManaged="True"
                            IsOn="{x:Bind DataContext.AlphaBuildUseCNPatchEndpoint, Mode=TwoWay}"
                            OffContent="Oversea Endpoints"
                            OnContent="Chinese Endpoints"/>
                        <wl:LiquidGlassToggleSwitch
                            shuxcth:ControlMaterialState.IsManaged="True"
                            IsEnabled="{x:Bind GenericApiEndPointToggle.IsOn, Mode=OneWay}"
                            IsOn="{x:Bind DataContext.AlphaBuildUseFJPatchEndpoint, Mode=TwoWay}"
                            OffContent="No Secondary Endpoints"
                            OnContent="Fujian Endpoints"/>
                    </StackPanel>
                </cwc:SettingsCard>

                <TextBlock Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" Text="Hutao Cloud"/>
                <cwc:SettingsCard
                    Command="{x:Bind DataContext.CompensationGachaLogServiceTimeCommand, Mode=OneWay}"
                    Header="Compensation GachaLog Service Time"
                    IsClickEnabled="True">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <NumberBox
                            MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                            VerticalAlignment="Center"
                            AcceptsExpression="False"
                            Value="{x:Bind DataContext.GachaLogCompensationDays, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" Text="Days"/>
                    </StackPanel>
                </cwc:SettingsCard>

                <cwc:SettingsCard
                    Command="{x:Bind DataContext.DesignationGachaLogServiceTimeCommand, Mode=OneWay}"
                    Header="Designation GachaLog Service Time"
                    IsClickEnabled="True">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="UserName"/>
                        <wl:LiquidGlassTextBox
                            shuxcth:ControlMaterialState.IsManaged="True"
                            MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                            VerticalAlignment="Center"
                            Text="{x:Bind DataContext.GachaLogDesignationOptions.UserName, Mode=TwoWay}"/>
                        <NumberBox
                            MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                            VerticalAlignment="Center"
                            AcceptsExpression="False"
                            Value="{x:Bind DataContext.GachaLogDesignationOptions.Days, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" Text="Days"/>
                    </StackPanel>
                </cwc:SettingsCard>

                <cwc:SettingsCard
                    Command="{x:Bind DataContext.CompensationCdnServiceTimeCommand, Mode=OneWay}"
                    Header="Compensation Cdn Service Time"
                    IsClickEnabled="True">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <NumberBox
                            MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                            VerticalAlignment="Center"
                            AcceptsExpression="False"
                            Value="{x:Bind DataContext.CdnCompensationDays, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" Text="Days"/>
                    </StackPanel>
                </cwc:SettingsCard>

                <cwc:SettingsCard
                    Command="{x:Bind DataContext.DesignationCdnServiceTimeCommand, Mode=OneWay}"
                    Header="Designation Cdn Service Time"
                    IsClickEnabled="True">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="UserName"/>
                        <wl:LiquidGlassTextBox
                            shuxcth:ControlMaterialState.IsManaged="True"
                            MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                            VerticalAlignment="Center"
                            Text="{x:Bind DataContext.CdnDesignationOptions.UserName, Mode=TwoWay}"/>
                        <NumberBox
                            MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                            VerticalAlignment="Center"
                            AcceptsExpression="False"
                            Value="{x:Bind DataContext.CdnDesignationOptions.Days, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" Text="Days"/>
                    </StackPanel>
                </cwc:SettingsCard>

                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Generate Redeem Code"
                    IsExpanded="True">
                    <StackPanel Spacing="8">
                        <NumberBox
                            Header="Count"
                            PlaceholderText="Code count"
                            Text="{x:Bind DataContext.RedeemCodeGenerateOption.Count, Mode=TwoWay}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <wl:LiquidGlassCheckBox shuxcth:ControlMaterialState.IsManaged="True" Content="IsTimeLimited" IsChecked="{x:Bind DataContext.RedeemCodeGenerateOption.IsTimeLimited, Mode=TwoWay}"/>
                            <wl:LiquidGlassCheckBox shuxcth:ControlMaterialState.IsManaged="True" Content="IsTimesLimited" IsChecked="{x:Bind DataContext.RedeemCodeGenerateOption.IsTimesLimited, Mode=TwoWay}"/>
                        </StackPanel>
                        <shuxc:SizeRestrictedContentControl>
                            <wl:LiquidGlassComboBox
                                shuxcth:ControlMaterialState.IsManaged="True"
                                shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                Header="ServiceType"
                                ItemsSource="{cwh:EnumValues Type=shwhr:RedeemCodeTargetServiceType}"
                                SelectedItem="{x:Bind DataContext.RedeemCodeGenerateOption.ServiceType, Mode=TwoWay}"/>
                        </shuxc:SizeRestrictedContentControl>
                        <NumberBox
                            Header="Value"
                            PlaceholderText="Days"
                            Text="{x:Bind DataContext.RedeemCodeGenerateOption.Value, Mode=TwoWay}"/>
                        <wl:LiquidGlassTextBox
                            shuxcth:ControlMaterialState.IsManaged="True"
                            Header="Description"
                            PlaceholderText="Code description"
                            Text="{x:Bind DataContext.RedeemCodeGenerateOption.Description, Mode=TwoWay}"/>
                        <NumberBox
                            Header="Expire Hours"
                            IsEnabled="{x:Bind DataContext.RedeemCodeGenerateOption.IsTimeLimited, Mode=OneWay}"
                            PlaceholderText="72"
                            Text="{x:Bind DataContext.RedeemCodeGenerateOption.ExpireHours, Mode=TwoWay}"/>
                        <NumberBox
                            Header="Times"
                            IsEnabled="{x:Bind DataContext.RedeemCodeGenerateOption.IsTimesLimited, Mode=OneWay}"
                            PlaceholderText="Limited times"
                            Text="{x:Bind DataContext.RedeemCodeGenerateOption.Times, Mode=TwoWay}"/>
                        <wl:LiquidGlassButton shuxcth:ControlMaterialState.IsManaged="True" Command="{x:Bind DataContext.GenerateRedeemCodeCommand, Mode=OneWay}" Content="Generate"/>
                    </StackPanel>
                </Expander>

                <TextBlock Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" Text="Testing"/>

                <cwc:SettingsCard
                    Command="{x:Bind shv:TestViewModel.FileOperationRenameCommand}"
                    Header="Rename Desktop TestFolder"
                    IsClickEnabled="True"/>

                <cwc:SettingsCard
                    Command="{x:Bind shv:TestViewModel.ExceptionCommand}"
                    Header="Crash"
                    IsClickEnabled="True"/>

                <cwc:SettingsCard
                    Command="{x:Bind DataContext.SendRandomInfoBarNotificationCommand, Mode=OneWay}"
                    Header="Random InfoBar"
                    IsClickEnabled="True"/>

                <cwc:SettingsCard
                    Command="{x:Bind DataContext.CheckPathBelongsToSSDCommand, Mode=OneWay}"
                    Header="Check path belongs to a SSD"
                    IsClickEnabled="True"/>

                <cwc:SettingsCard
                    Command="{x:Bind DataContext.RunCodeCommand, Mode=OneWay}"
                    Header="Run Script Code"
                    IsClickEnabled="True"/>

                <cwc:SettingsCard Header="SpeedGraphTest" IsClickEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <wl:LiquidGlassButton
                            shuxcth:ControlMaterialState.IsManaged="True"
                            Command="{x:Bind DataContext.OpenSpeedGraphTestWindowCommand, Mode=OneWay}"
                            Content="{shuxm:ResourceString Name=ViewPageTestSpeedGraphWindowHeader}"
                            Style="{ThemeResource SettingButtonStyle}"/>
                        <wl:LiquidGlassButton
                            shuxcth:ControlMaterialState.IsManaged="True"
                            Command="{x:Bind DataContext.OpenGamePackageWindowCommand, Mode=OneWay}"
                            Content="Open The Game Package Window"
                            Style="{ThemeResource SettingButtonStyle}"/>
                    </StackPanel>
                </cwc:SettingsCard>

                <TextBlock Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" Text="Game Package"/>
                <cwc:SettingsCard Header="Treat Predownload As Main">
                    <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.TreatPredownloadAsMain, Mode=TwoWay}"/>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Enable Beta Game Install">
                    <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind DataContext.EnableBetaGameInstall, Mode=TwoWay}"/>
                </cwc:SettingsCard>

                <cwc:SettingsCard
                    Command="{x:Bind DataContext.ExtractGameBlocksCommand, Mode=OneWay}"
                    Header="Extract Game Blocks"
                    IsClickEnabled="True"/>

                <cwc:SettingsCard
                    Command="{x:Bind DataContext.ExtractGameExeCommand, Mode=OneWay}"
                    Header="Extract Game Executable"
                    IsClickEnabled="True">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SettingsCardContentControlSpacing}">
                        <wl:LiquidGlassCheckBox shuxcth:ControlMaterialState.IsManaged="True" Content="IsOversea" IsChecked="{x:Bind DataContext.ExtractExeOptions.IsOversea, Mode=TwoWay}"/>
                        <wl:LiquidGlassCheckBox shuxcth:ControlMaterialState.IsManaged="True" Content="IsPredownload" IsChecked="{x:Bind DataContext.ExtractExeOptions.IsPreDownload, Mode=TwoWay}"/>
                    </StackPanel>
                </cwc:SettingsCard>

                <TextBlock Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" Text="Announcement"/>
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="Upload Announcement"
                    IsExpanded="True">
                    <StackPanel Spacing="8">
                        <wl:LiquidGlassTextBox
                            shuxcth:ControlMaterialState.IsManaged="True"
                            Header="Title"
                            PlaceholderText="Please input title"
                            Text="{x:Bind DataContext.Announcement.Title, Mode=TwoWay}"/>
                        <wl:LiquidGlassTextBox
                            shuxcth:ControlMaterialState.IsManaged="True"
                            Header="Link"
                            PlaceholderText="Please input link"
                            Text="{x:Bind DataContext.Announcement.Link, Mode=TwoWay}"/>
                        <wl:LiquidGlassTextBox
                            shuxcth:ControlMaterialState.IsManaged="True"
                            Header="Version Threshold"
                            PlaceholderText="Max present version(leave empty to present in all version)"
                            Text="{x:Bind DataContext.Announcement.MaxPresentVersion, Mode=TwoWay}"/>
                        <wl:LiquidGlassTextBox
                            shuxcth:ControlMaterialState.IsManaged="True"
                            AcceptsReturn="True"
                            Header="Content"
                            PlaceholderText="Please input content"
                            Text="{x:Bind DataContext.Announcement.Content, Mode=TwoWay}"/>
                        <shuxc:SizeRestrictedContentControl>
                            <wl:LiquidGlassComboBox
                                shuxcth:ControlMaterialState.IsManaged="True"
                                shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                                Header="Severity"
                                ItemsSource="{cwh:EnumValues Type=InfoBarSeverity}"
                                SelectedItem="{x:Bind DataContext.Announcement.Severity, Mode=TwoWay}"/>
                        </shuxc:SizeRestrictedContentControl>
                        <wl:LiquidGlassButton shuxcth:ControlMaterialState.IsManaged="True" Command="{x:Bind DataContext.UploadAnnouncementCommand, Mode=OneWay}" Content="Upload"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Border>

</shuxc:ScopedPage>

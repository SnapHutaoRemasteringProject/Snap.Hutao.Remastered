                        Width="12"
                        Foreground="#FF808080"
                        UriSource="ms-appx:///Resource/Icon/UI_IconKira.png"
                        Visibility="{Binding Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <shuxc:StandardView HideCondition="{x:Bind ((shva:AvatarPropertyViewModel)DataContext).IsInitialized, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" ShowCondition="{x:Bind ((shva:AvatarPropertyViewModel)DataContext).Summary, Converter={StaticResource EmptyObjectToBoolConverter}, Mode=OneWay}">

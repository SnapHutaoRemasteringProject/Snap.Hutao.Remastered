<shuxcth:MaterialCardButton
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Card.TravelersDiaryCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxdc="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvt="using:Snap.Hutao.Remastered.ViewModel.TravelersDiary"
    Height="{ThemeResource HomeAdaptiveCardHeight}"
    Padding="0"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    d:DataContext="{d:DesignInstance shvt:TravelersDiaryViewModel}"
    Background="Transparent"
    BorderBrush="{x:Null}"
    BorderThickness="0"
    mc:Ignorable="d">

    <shuxcth:MaterialCardButton.Resources>
        <Style x:Key="TravelersDiarySectionBorderStyle" TargetType="Border">
            <Setter Property="shuxcth:MaterialBackground.NativeBrush" Value="{ThemeResource ControlAltFillColorSecondaryBrush}"/>
            <Setter Property="shuxcth:MaterialBackground.GlassBrush" Value="{ThemeResource HutaoSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
        </Style>
    </shuxcth:MaterialCardButton.Resources>

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Grid>
        <Grid Visibility="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).IsInitialized, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <Grid Visibility="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).Ledger, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                <Grid
                    Margin="12"
                    DataContext="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).Ledger, Mode=OneWay}"
                    RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!--  Header  -->
                    <Grid
                        Grid.Row="0"
                        Height="48"
                        Padding="12"
                        Style="{ThemeResource GridShimmerStyle}">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <Image
                                Height="32"
                                Margin="-5"
                                Source="ms-appx:///Resource/Icon/UI_TravelersDiary_Logo.png"/>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BaseTextBlockStyle}"
                                Text="{shuxm:ResourceString Name=ViewTravelersDiaryHeader}"/>
                        </StackPanel>
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).Ledger.Uid, Mode=OneWay}"/>
                    </Grid>

                    <FlipView
                        x:Name="RootFlipView"
                        Grid.Row="1"
                        Background="{x:Null}">
                        <FlipViewItem>
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <!--  Today  -->
                                <Border
                                    Grid.Row="0"
                                    Padding="8"
                                    Style="{StaticResource TravelersDiarySectionBorderStyle}">
                                    <Grid RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Opacity="0.6"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{shuxm:ResourceString Name=ViewTravelersDiaryToday}"/>
                                        <Grid Grid.Row="1" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel
                                                Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <Image
                                                    Width="20"
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    Source="{StaticResource UI_ItemIcon_201}"/>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).Ledger.DayData.FormattedPrimogems, Mode=OneWay}"/>
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <Image
                                                    Width="20"
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    Source="{StaticResource UI_ItemIcon_202}"/>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).Ledger.DayData.FormattedMora, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!--  Month  -->
                                <Border
                                    Grid.Row="1"
                                    Padding="8"
                                    Style="{StaticResource TravelersDiarySectionBorderStyle}">
                                    <Grid RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Opacity="0.6"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{shuxm:ResourceString Name=ViewTravelersDiaryMonth}"/>
                                        <Grid Grid.Row="1" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel
                                                Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <Image
                                                    Width="20"
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    Source="{StaticResource UI_ItemIcon_201}"/>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).Ledger.MonthData.FormattedPrimogems, Mode=OneWay}"/>
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <Image
                                                    Width="20"
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    Source="{StaticResource UI_ItemIcon_202}"/>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).Ledger.MonthData.FormattedMora, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </FlipViewItem>

                        <FlipViewItem>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.ColumnSpan="2"
                                    Padding="12"
                                    Style="{StaticResource TravelersDiarySectionBorderStyle}"
                                    Visibility="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).Ledger.MonthData.GroupBy, Converter={StaticResource EmptyCollectionToVisibilityRevertConverter}, Mode=OneWay}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Opacity="0.6"
                                        Text="{shuxm:ResourceString Name=ViewTravelersDiaryNoIncomeSourceHint}"/>
                                </Border>

                                <Grid
                                    Grid.Column="0"
                                    Width="104"
                                    Height="104"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).Ledger.MonthData.GroupBy, Converter={StaticResource EmptyCollectionToVisibilityConverter}, Mode=OneWay}">
                                    <ItemsControl ItemsSource="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).Ledger.MonthData.GroupBy, Converter={StaticResource LedgerIncomeSourceToDonutSliceConverter}, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="shuxdc:LedgerIncomeSlice">
                                                <Path
                                                    Width="104"
                                                    Height="104"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="{x:Bind Data, Mode=OneWay}"
                                                    Fill="{x:Bind Fill, Mode=OneWay}"
                                                    Stretch="None"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            Source="{StaticResource UI_ItemIcon_201}"/>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).Ledger.MonthData.FormattedPrimogems, Mode=OneWay}"/>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer
                                    Grid.Column="1"
                                    Padding="0,0,0,16"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto"
                                    Visibility="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).Ledger.MonthData.GroupBy, Converter={StaticResource EmptyCollectionToVisibilityConverter}, Mode=OneWay}">
                                    <ItemsControl ItemsSource="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).Ledger.MonthData.GroupBy, Converter={StaticResource LedgerIncomeSourceToDonutSliceConverter}, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="shuxdc:LedgerIncomeSlice">
                                                <Grid Margin="0,2" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle
                                                        Grid.Column="0"
                                                        Width="4"
                                                        Height="12"
                                                        VerticalAlignment="Center"
                                                        Fill="{x:Bind Fill, Mode=OneWay}"
                                                        RadiusX="2"
                                                        RadiusY="2"/>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Action, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind FormattedNum, Mode=OneWay}"/>
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Width="36"
                                                        VerticalAlignment="Center"
                                                        Opacity="0.6"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind FormattedPercent, Mode=OneWay}"
                                                        TextAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </FlipViewItem>
                    </FlipView>

                    <PipsPager
                        Grid.Row="1"
                        Height="16"
                        Margin="0,0,0,2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        NumberOfPages="2"
                        SelectedPageIndex="{x:Bind Path=RootFlipView.SelectedIndex, Mode=TwoWay}"/>
                </Grid>
            </Grid>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).Ledger, Converter={StaticResource EmptyObjectToVisibilityRevertConverter}, Mode=OneWay}">
                <Image
                    Width="96"
                    Height="96"
                    Source="ms-appx:///Resource/Icon/UI_ItemIcon_201.png"/>
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{shuxm:ResourceString Name=ViewTravelersDiaryHeader}"/>
            </StackPanel>
        </Grid>

        <shuxc:Loading IsLoading="{x:Bind ((shvt:TravelersDiaryViewModel)DataContext).IsInitialized, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" Style="{ThemeResource DefaultLoadingCardStyle}"/>
    </Grid>
</shuxcth:MaterialCardButton>

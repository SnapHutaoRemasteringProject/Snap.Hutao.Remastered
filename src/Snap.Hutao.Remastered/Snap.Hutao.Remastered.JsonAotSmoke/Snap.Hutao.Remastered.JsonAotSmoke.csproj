<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Keep this optional native check independent of WinUI, application startup and user data. -->
  <ItemGroup>
    <Compile Include="../Snap.Hutao.Remastered/Core/Text/Json/JsonSerialize.cs" Link="Production/JsonSerialize.cs" />
    <Compile Include="../Snap.Hutao.Remastered/Core/Text/Json/JsonWireOptions.cs" Link="Production/JsonWireOptions.cs" />
    <Compile Include="../Snap.Hutao.Remastered/Core/Text/Json/Converter/InternStringConverter.cs" Link="Production/InternStringConverter.cs" />
    <Compile Include="../Snap.Hutao.Remastered/Core/Text/Json/Converter/ObjectDictionaryConverter.cs" Link="Production/ObjectDictionaryConverter.cs" />
    <Compile Include="../Snap.Hutao.Remastered/Core/Text/Json/Contexts/DiagnosticsJsonContext.cs" Link="Production/DiagnosticsJsonContext.cs" />
    <Compile Include="../Snap.Hutao.Remastered/Core/Text/Json/Contexts/AgentJsonContext.cs" Link="Production/AgentJsonContext.cs" />
    <Compile Include="../Snap.Hutao.Remastered/Service/AI/Migration/LegacyModelProfile.cs" Link="Production/LegacyModelProfile.cs" />
    <Compile Include="../Snap.Hutao.Remastered/Service/AI/Migration/LegacyConversation.cs" Link="Production/LegacyConversation.cs" />
    <Compile Include="../Snap.Hutao.Remastered/Service/AI/Migration/LegacyChatMessage.cs" Link="Production/LegacyChatMessage.cs" />
  </ItemGroup>
</Project>

<UserControl
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.GuideView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hlsl="using:WinUI.Composition.Hlsl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shm="using:Snap.Hutao.Remastered.Model"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxce="using:Snap.Hutao.Remastered.UI.Xaml.Control.Effect"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvg="using:Snap.Hutao.Remastered.ViewModel.Guide"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance shvg:GuideViewModel}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{Binding LoadCommand}"/>
    </mxi:Interaction.Behaviors>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <x:String x:Key="LogoCrowdin">ms-appx:///Resource/GuideLocalization/crowdin-symbol-cDark-64.png</x:String>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <x:String x:Key="LogoCrowdin">ms-appx:///Resource/GuideLocalization/crowdin-symbol-cWhite-64.png</x:String>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:String x:Key="LogoDGPStudio">ms-appx:///Resource/GuideLocalization/DGP-v3-white-64.png</x:String>
            <x:String x:Key="LogoGemini">ms-appx:///Resource/GuideLocalization/Gemini-64.png</x:String>

            <DataTemplate x:Key="LanguageTemplate" x:DataType="shm:NameCultureInfoValue">
                <Grid MinWidth="280" Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Name, Mode=OneTime}"/>
                        <TextBlock Opacity="0.8" Text="{x:Bind Value, Mode=OneTime}"/>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Border
                            VerticalAlignment="Center"
                            CornerRadius="8"
                            Visibility="{x:Bind IsMaintainedByHutao, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneTime}">
                            <Image
                                Width="32"
                                Height="32"
                                VerticalAlignment="Center"
                                Source="{ThemeResource LogoDGPStudio}"
                                Stretch="Uniform"/>
                        </Border>
                        <Border
                            VerticalAlignment="Center"
                            CornerRadius="8"
                            Visibility="{x:Bind IsMaintainedByCrowdin, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneTime}">
                            <Image
                                Width="32"
                                Height="32"
                                VerticalAlignment="Center"
                                Source="{ThemeResource LogoCrowdin}"
                                Stretch="Uniform"/>
                        </Border>
                        <Border
                            VerticalAlignment="Center"
                            CornerRadius="8"
                            Visibility="{x:Bind IsMaintainedByGemini, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneTime}">
                            <Image
                                Width="32"
                                Height="32"
                                VerticalAlignment="Center"
                                Source="{ThemeResource LogoGemini}"
                                Stretch="Uniform"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="DownloadSummaryTemplate" x:DataType="shvg:DownloadSummary">
                <Border
                    Width="220"
                    Margin="0,0,4,4"
                    Style="{StaticResource BorderCardStyle}">
                    <StackPanel Margin="8">
                        <TextBlock Text="{x:Bind FileName, Mode=OneWay}"/>
                        <ProgressBar
                            Margin="0,4,0,0"
                            Maximum="1"
                            Value="{x:Bind ProgressValue, Mode=OneWay}"/>
                        <TextBlock Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}">
                            <Run Text="{x:Bind Description, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run Text="{x:Bind Speed, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{ThemeResource HutaoSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Image
            Grid.RowSpan="2"
            MaxWidth="480"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Opacity="0.20"
            Source="ms-appx:///Resource/WelcomeView_Background.png"/>
        <cwc:SwitchPresenter
            Grid.Row="0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            ContentTransitions="{ThemeResource EntranceThemeTransitions}"
            Value="{x:Bind shvg:GuideNavigation.VisibleState(((shvg:GuideViewModel)DataContext).State), Mode=OneWay}">
            <!--  Language  -->
            <cwc:Case Value="{shuxm:UInt32 Value=0}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                        <RowDefinition/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <shuxce:TextMorphEffect
                        Grid.Row="0"
                        BlurAmount="5"
                        ColorBrush="{ThemeResource TextFillColorPrimary}"
                        Delimiter="+"
                        EffectFontSize="36"
                        EffectHorizontalAlignment="Center"
                        EffectVerticalAlignment="Center"
                        Text="{Binding AllCulturesWelcomeText}"/>
                    <Border
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{ThemeResource BorderShimmerStyle}">
                        <GridView
                            Padding="0,0,-12,-12"
                            ItemContainerStyle="{ThemeResource LargeGridViewItemStyle}"
                            ItemTemplate="{StaticResource LanguageTemplate}"
                            ItemsSource="{Binding CultureOptions.Cultures}"
                            SelectedItem="{Binding SelectedCulture, Mode=TwoWay}"
                            SelectionMode="Single"/>
                    </Border>

                    <StackPanel
                        Grid.Row="2"
                        Margin="16"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <shuxcc:HorizontalCard>
                            <shuxcc:HorizontalCard.Left>
                                <Border VerticalAlignment="Center" CornerRadius="8">
                                    <Image
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Center"
                                        Source="{ThemeResource LogoDGPStudio}"
                                        Stretch="Uniform"/>
                                </Border>
                            </shuxcc:HorizontalCard.Left>
                            <shuxcc:HorizontalCard.Right>
                                <TextBlock
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    Text="{shuxm:ResourceString Name=ViewGuideStepLanguageMaintainedByHutao}"/>
                            </shuxcc:HorizontalCard.Right>
                        </shuxcc:HorizontalCard>
                        <shuxcc:HorizontalCard>
                            <shuxcc:HorizontalCard.Left>
                                <Border VerticalAlignment="Center" CornerRadius="8">
                                    <Image
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Center"
                                        Source="{ThemeResource LogoCrowdin}"
                                        Stretch="Uniform"/>
                                </Border>
                            </shuxcc:HorizontalCard.Left>
                            <shuxcc:HorizontalCard.Right>
                                <TextBlock
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    Text="{shuxm:ResourceString Name=ViewGuideStepLanguageMaintainedByCrowdin}"/>
                            </shuxcc:HorizontalCard.Right>
                        </shuxcc:HorizontalCard>
                        <shuxcc:HorizontalCard>
                            <shuxcc:HorizontalCard.Left>
                                <Border VerticalAlignment="Center" CornerRadius="8">
                                    <Image
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Center"
                                        Source="{ThemeResource LogoGemini}"
                                        Stretch="Uniform"/>
                                </Border>
                            </shuxcc:HorizontalCard.Left>
                            <shuxcc:HorizontalCard.Right>
                                <TextBlock
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    Text="{shuxm:ResourceString Name=ViewGuideStepLanguageMaintainedByGemini}"/>
                            </shuxcc:HorizontalCard.Right>
                        </shuxcc:HorizontalCard>
                    </StackPanel>
                </Grid>
            </cwc:Case>

            <!--  Document  -->
            <cwc:Case Value="{shuxm:UInt32 Value=1}">
                <Grid
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>

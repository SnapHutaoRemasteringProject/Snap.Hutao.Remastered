            <shvh:ActivityTemplateSelector.OtherTemplate>
                <DataTemplate x:DataType="shwhtga:ActOther">
                    <Grid ColumnSpacing="6" Style="{ThemeResource GridShimmerStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

<UserControl
    x:Class="Snap.Hutao.Remastered.UI.Xaml.Control.ChatElements.ChatToolApprovalRequestSegmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Converters"
    xmlns:snuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.ChatElements"
    xmlns:snuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup">

    <UserControl.Resources>
        <cwc:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <snuxcc:ChatToolApprovalResultToObjectConverter
            x:Key="ApprovalBackgroundBrushConverter"
            ApprovedValue="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
            PendingValue="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            RejectedValue="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
        <snuxcc:ChatToolApprovalResultToObjectConverter
            x:Key="ApprovalForegroundBrushConverter"
            ApprovedValue="{ThemeResource SystemFillColorSuccessBrush}"
            PendingValue="{ThemeResource TextFillColorPrimaryBrush}"
            RejectedValue="{ThemeResource SystemFillColorCriticalBrush}" />
        <snuxcc:ChatToolApprovalResultToObjectConverter
            x:Key="ApprovalGlyphConverter"
            ApprovedValue="&#xE73E;"
            PendingValue=""
            RejectedValue="&#xE711;" />
    </UserControl.Resources>

    <Border
        Padding="8"
        Background="{x:Bind ToolApprovalRequest.Approved, Mode=OneWay, Converter={StaticResource ApprovalBackgroundBrushConverter}}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource ControlCornerRadius}">
        <StackPanel Spacing="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Glyph="&#xF5B4;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{snuxm:ResourceString Name=UIXamlControlsChatToolApprovalRequestSegmentViewLabelTitle}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{snuxm:ResourceString Name=UIXamlControlsChatToolApprovalRequestSegmentViewLabelPending}"
                    Visibility="{x:Bind ToolApprovalRequest.IsHandled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />
                <!--<FontIcon
                    x:Name="StatusIcon"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{x:Bind ToolApprovalRequest.Approved, Mode=OneWay, Converter={StaticResource ApprovalForegroundBrushConverter}}"
                    Glyph="{x:Bind ToolApprovalRequest.Approved, Mode=OneWay, Converter={StaticResource ApprovalGlyphConverter}}"
                    Visibility="{x:Bind ToolApprovalRequest.IsHandled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />-->
            </Grid>

            <snuxcc:ChatToolCallSegmentView ToolCall="{x:Bind ToolApprovalRequest.ToolCall, Mode=OneWay}" Visibility="{x:Bind ToolApprovalRequest.IsHandled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />

            <StackPanel
                Orientation="Horizontal"
                Spacing="6"
                Visibility="{x:Bind ToolApprovalRequest.CanRespond, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Command="{x:Bind ApproveCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE73E;" />
                        <TextBlock Text="{snuxm:ResourceString Name=UIXamlControlsChatToolApprovalRequestSegmentViewLabelAllow}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind DenyCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                        <TextBlock Text="{snuxm:ResourceString Name=UIXamlControlsChatToolApprovalRequestSegmentViewLabelDeny}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

<Page
    x:Class="PrototypeHost.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel
            x:Name="panel"
            Padding="16"
            Spacing="12">
            <TextBox x:Name="pathBox" Header="Trusted development DLL or .hutao package" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="nativeChoice" Content="C++ core" />
                <Button x:Name="compiledChoice" Content="C++ compiled (experimental)" />
                <Button x:Name="aotChoice" Content="C# AOT sample" />
                <Button x:Name="load" Content="Inspect and load" />
            </StackPanel>
            <ComboBox
                x:Name="views"
                Header="Plugin view"
                IsEnabled="False" />
            <ContentControl x:Name="content" HorizontalContentAlignment="Stretch" />
            <ComboBox
                x:Name="commands"
                Header="Plugin command"
                IsEnabled="False" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="exercise"
                    Content="Run command"
                    IsEnabled="False" />
                <Button
                    x:Name="restart"
                    Content="Disable and re-enable"
                    IsEnabled="False" />
                <Button
                    x:Name="uninstall"
                    Content="Uninstall session"
                    IsEnabled="False" />
            </StackPanel>
            <TextBlock
                x:Name="log"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>

<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.DailyNoteNotificationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shme="using:Snap.Hutao.Remastered.Model.Entity"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:wl="using:WinUI.LiquidGlass"
    Title="{shuxm:ResourceString Name=ViewDialogDailyNoteNotificationTitle}"
    d:DataContext="{d:DesignInstance shme:DailyNoteEntry}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogSavePrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
            <StackPanel.Resources>
                <x:Double x:Key="SettingsCardMinHeight">0</x:Double>
                <x:Double x:Key="SettingsCardWrapThreshold">0</x:Double>
                <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
            </StackPanel.Resources>
            <TextBlock
                Margin="0,3,0,3"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="{x:Bind Entry.UserGameRole, Mode=OneWay}"/>
            <cwc:SettingsCard
                Width="480"
                Padding="16,8"
                Header="{shuxm:ResourceString Name=ViewDialogDailyNoteNotificationResinNotifyThreshold}">
                <shuxcth:MaterialSwap Margin="32,0,0,0">
                    <shuxcth:MaterialSwap.Native>
                        <Slider
                            MinWidth="160"
                            Maximum="{x:Bind Entry.DailyNote.MaxResin, Mode=OneWay}"
                            Minimum="0"
                            Value="{x:Bind Entry.ResinNotifyThreshold, Mode=TwoWay}"/>
                    </shuxcth:MaterialSwap.Native>
                    <shuxcth:MaterialSwap.Glass>
                        <wl:LiquidGlassSlider
                            MinWidth="160"
                            shuxcth:ControlMaterialState.IsManaged="True"
                            Maximum="{x:Bind Entry.DailyNote.MaxResin, Mode=OneWay}"
                            Minimum="0"
                            Value="{x:Bind Entry.ResinNotifyThreshold, Mode=TwoWay}"/>
                    </shuxcth:MaterialSwap.Glass>
                </shuxcth:MaterialSwap>
            </cwc:SettingsCard>
            <cwc:SettingsCard Padding="16,8" Header="{shuxm:ResourceString Name=ViewDialogDailyNoteNotificationHomeCoinNotifyThreshold}">
                <shuxcth:MaterialSwap>
                    <shuxcth:MaterialSwap.Native>
                        <Slider
                            MinWidth="160"
                            Maximum="{x:Bind Entry.DailyNote.MaxHomeCoin, Mode=OneWay}"
                            Minimum="0"
                            Value="{x:Bind Entry.HomeCoinNotifyThreshold, Mode=TwoWay}"/>
                    </shuxcth:MaterialSwap.Native>
                    <shuxcth:MaterialSwap.Glass>
                        <wl:LiquidGlassSlider
                            MinWidth="160"
                            shuxcth:ControlMaterialState.IsManaged="True"
                            Maximum="{x:Bind Entry.DailyNote.MaxHomeCoin, Mode=OneWay}"
                            Minimum="0"
                            Value="{x:Bind Entry.HomeCoinNotifyThreshold, Mode=TwoWay}"/>
                    </shuxcth:MaterialSwap.Glass>
                </shuxcth:MaterialSwap>
            </cwc:SettingsCard>
            <cwc:SettingsCard Padding="16,8" Header="{shuxm:ResourceString Name=ViewDialogDailyNoteNotificationTransformerNotify}">
                <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind Entry.TransformerNotify, Mode=TwoWay}"/>
            </cwc:SettingsCard>
            <cwc:SettingsCard Padding="16,8" Header="{shuxm:ResourceString Name=ViewDialogDailyNoteNotificationDailyTaskNotify}">
                <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind Entry.DailyTaskNotify, Mode=TwoWay}"/>
            </cwc:SettingsCard>
            <cwc:SettingsCard Padding="16,8" Header="{shuxm:ResourceString Name=ViewDialogDailyNoteNotificationExpeditionNotify}">
                <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind Entry.ExpeditionNotify, Mode=TwoWay}"/>
            </cwc:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

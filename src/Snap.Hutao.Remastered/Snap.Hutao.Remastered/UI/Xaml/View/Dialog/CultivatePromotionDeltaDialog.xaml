<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.CultivatePromotionDeltaDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:wl="using:WinUI.LiquidGlass"
    Title="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <x:Double x:Key="NumberBoxMinWidth">180</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>

        <DataTemplate x:Key="SkillTemplate">
            <Border Margin="0,2,0,0" Style="{StaticResource BorderCardStyle}">
                <Grid Margin="8" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <shuxci:CachedImage
                        Grid.Column="0"
                        Width="36"
                        Height="36"
                        ShowAsMonoChrome="True"
                        Source="{Binding Icon}"/>
                    <TextBlock
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"/>
                    <NumberBox
                        Grid.Column="3"
                        MinWidth="{StaticResource NumberBoxMinWidth}"
                        VerticalAlignment="Center"
                        Maximum="{Binding LevelMax}"
                        Minimum="{Binding LevelMin}"
                        SpinButtonPlacementMode="Inline"
                        Value="{Binding LevelCurrent, Mode=TwoWay}"/>
                    <FontIcon
                        Grid.Column="4"
                        Margin="8"
                        FontSize="12"
                        Glyph="&#xEBE7;"/>
                    <NumberBox
                        Grid.Column="5"
                        MinWidth="{StaticResource NumberBoxMinWidth}"
                        VerticalAlignment="Center"
                        Maximum="{Binding LevelMax}"
                        Minimum="{Binding LevelCurrent, Mode=OneWay}"
                        SpinButtonPlacementMode="Inline"
                        Value="{Binding LevelTarget, Mode=TwoWay}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentDialog.Resources>
    <Grid Margin="0,8,0,0" RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Visibility="{x:Bind Avatar, Converter={StaticResource EmptyObjectToVisibilityConverter}}">
            <Grid
                Padding="8"
                ColumnSpacing="6"
                DataContext="{x:Bind Avatar}"
                Style="{ThemeResource GridCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <shuxc:ItemIcon
                    Grid.Column="0"
                    Width="36"
                    Height="36"
                    Icon="{Binding Icon}"
                    Quality="{Binding Quality}"/>
                <TextBlock
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"/>
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding IsPromotionAvailable}">
                    <cwc:SwitchPresenter
                        x:Name="GlassPresenter_4947"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:CheckBox"
                        Value="{x:Bind shuxcth:MaterialBindingSource.Current.CheckBoxMaterial, Mode=OneWay}">
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>0</x:Int32>
                            </cwc:Case.Value>
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                IsChecked="{Binding IsPromoted, Mode=TwoWay}"/>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>1</x:Int32>
                            </cwc:Case.Value>
                            <wl:LiquidGlassCheckBox
                                VerticalAlignment="Center"
                                shuxcth:ControlMaterialState.IsManaged="True"
                                Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                IsChecked="{Binding IsPromoted, Mode=TwoWay}"/>
                        </cwc:Case>
                    </cwc:SwitchPresenter>
                </StackPanel>
                <NumberBox
                    Grid.Column="3"
                    MinWidth="{StaticResource NumberBoxMinWidth}"
                    VerticalAlignment="Center"
                    Maximum="{Binding LevelMax}"
                    Minimum="{Binding LevelMin}"
                    SpinButtonPlacementMode="Inline"
                    Value="{Binding LevelCurrent, Mode=TwoWay}"/>
                <FontIcon
                    Grid.Column="4"
                    Margin="8"
                    FontSize="12"
                    Glyph="&#xEBE7;"/>
                <NumberBox
                    Grid.Column="5"
                    MinWidth="{StaticResource NumberBoxMinWidth}"
                    VerticalAlignment="Center"
                    Maximum="{Binding LevelMax}"
                    Minimum="{Binding LevelCurrent, Mode=OneWay}"
                    SpinButtonPlacementMode="Inline"
                    Value="{Binding LevelTarget, Mode=TwoWay}"/>
            </Grid>

            <ItemsControl ItemTemplate="{StaticResource SkillTemplate}" ItemsSource="{x:Bind Avatar.Skills}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Visibility="{x:Bind Weapon, Converter={StaticResource EmptyObjectToVisibilityConverter}}">
            <Grid
                Padding="8"
                ColumnSpacing="6"
                DataContext="{x:Bind Weapon}"
                Style="{ThemeResource GridCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <shuxc:ItemIcon
                    Grid.Column="0"
                    Width="36"
                    Height="36"
                    Icon="{Binding Icon}"
                    Quality="{Binding Quality}"/>
                <TextBlock
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"/>
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding IsPromotionAvailable}">
                    <cwc:SwitchPresenter
                        x:Name="GlassPresenter_7724"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:CheckBox"
                        Value="{x:Bind shuxcth:MaterialBindingSource.Current.CheckBoxMaterial, Mode=OneWay}">
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>0</x:Int32>
                            </cwc:Case.Value>
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                IsChecked="{Binding IsPromoted, Mode=TwoWay}"/>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>1</x:Int32>
                            </cwc:Case.Value>
                            <wl:LiquidGlassCheckBox
                                VerticalAlignment="Center"
                                shuxcth:ControlMaterialState.IsManaged="True"
                                Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                IsChecked="{Binding IsPromoted, Mode=TwoWay}"/>
                        </cwc:Case>
                    </cwc:SwitchPresenter>
                </StackPanel>
                <NumberBox
                    Grid.Column="3"
                    MinWidth="{StaticResource NumberBoxMinWidth}"
                    VerticalAlignment="Center"
                    Maximum="{Binding LevelMax}"
                    Minimum="{Binding LevelMin}"
                    SpinButtonPlacementMode="Inline"
                    Value="{Binding LevelCurrent, Mode=TwoWay}"/>
                <FontIcon
                    Grid.Column="4"
                    Margin="8"
                    FontSize="12"
                    Glyph="&#xEBE7;"/>
                <NumberBox
                    Grid.Column="5"
                    MinWidth="{StaticResource NumberBoxMinWidth}"
                    VerticalAlignment="Center"
                    Maximum="{Binding LevelMax}"
                    Minimum="{Binding LevelCurrent, Mode=OneWay}"
                    SpinButtonPlacementMode="Inline"
                    Value="{Binding LevelTarget, Mode=TwoWay}"/>
            </Grid>
        </StackPanel>

        <cwc:SwitchPresenter
            x:Name="MaterialSelector_SaveModeSelector"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Value="{x:Bind shuxcth:MaterialBindingSource.Current.RadioButtonMaterial, Mode=OneWay}">
            <cwc:Case Value="{shuxm:Int32 Value=0}">
                <RadioButtons
                    x:Name="SaveModeSelector"
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    Header="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyHeader}"
                    SelectedIndex="0">
                    <RadioButton
                        x:Name="GlassNative_9260"
                        Content="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyPreserveExisting}"
                        DataContext="{x:Bind MaterialSelector_SaveModeSelector.DataContext, Mode=OneWay}"
                        shuxcth:ThemeSynchronization.Source="{x:Bind MaterialSelector_SaveModeSelector}"/>
                    <RadioButton
                        x:Name="GlassNative_9386"
                        Content="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyOverwriteExisting}"
                        DataContext="{x:Bind MaterialSelector_SaveModeSelector.DataContext, Mode=OneWay}"
                        shuxcth:ThemeSynchronization.Source="{x:Bind MaterialSelector_SaveModeSelector}"/>
                    <RadioButton
                        x:Name="GlassNative_9513"
                        Content="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyCreateNewEntry}"
                        DataContext="{x:Bind MaterialSelector_SaveModeSelector.DataContext, Mode=OneWay}"
                        shuxcth:ThemeSynchronization.Source="{x:Bind MaterialSelector_SaveModeSelector}"/>
                </RadioButtons>
            </cwc:Case>
            <cwc:Case Value="{shuxm:Int32 Value=1}">
                <RadioButtons
                    x:Name="SaveModeSelectorGlass"
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    Header="{shuxm:ResourceString Name=ViewDialogCultivationConsumptionSaveStrategyHeader}"
                    SelectedIndex="{x:Bind SaveModeSelector.SelectedIndex, Mode=TwoWay}">
                    <wl:LiquidGlassRadioButton
                        x:Name="GlassNative_9260Glass"
                        Width="{x:Bind GlassNative_9260.Width, Mode=OneWay}"
                        Height="{x:Bind GlassNative_9260.Height, Mode=OneWay}"
                        MinWidth="{x:Bind GlassNative_9260.MinWidth, Mode=OneWay}"
                        MinHeight="{x:Bind GlassNative_9260.MinHeight, Mode=OneWay}"
                        MaxWidth="{x:Bind GlassNative_9260.MaxWidth, Mode=OneWay}"
                        MaxHeight="{x:Bind GlassNative_9260.MaxHeight, Mode=OneWay}"
                        Padding="{x:Bind GlassNative_9260.Padding, Mode=OneWay}"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassNative_9260, Mode=OneWay}"
                        shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                        BorderThickness="{x:Bind GlassNative_9260.BorderThickness, Mode=OneWay}"
                        Command="{x:Bind GlassNative_9260.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind GlassNative_9260.CommandParameter, Mode=OneWay}"
                        Content="{x:Bind GlassNative_9260.Content, Mode=OneWay}"
                        FlowDirection="{x:Bind GlassNative_9260.FlowDirection, Mode=OneWay}"
                        FontFamily="{x:Bind GlassNative_9260.FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind GlassNative_9260.FontSize, Mode=OneWay}"
                        FontStyle="{x:Bind GlassNative_9260.FontStyle, Mode=OneWay}"
                        FontWeight="{x:Bind GlassNative_9260.FontWeight, Mode=OneWay}"
                        IsEnabled="{x:Bind GlassNative_9260.IsEnabled, Mode=OneWay}"/>
                    <wl:LiquidGlassRadioButton
                        x:Name="GlassNative_9386Glass"
                        Width="{x:Bind GlassNative_9386.Width, Mode=OneWay}"
                        Height="{x:Bind GlassNative_9386.Height, Mode=OneWay}"
                        MinWidth="{x:Bind GlassNative_9386.MinWidth, Mode=OneWay}"
                        MinHeight="{x:Bind GlassNative_9386.MinHeight, Mode=OneWay}"
                        MaxWidth="{x:Bind GlassNative_9386.MaxWidth, Mode=OneWay}"
                        MaxHeight="{x:Bind GlassNative_9386.MaxHeight, Mode=OneWay}"
                        Padding="{x:Bind GlassNative_9386.Padding, Mode=OneWay}"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassNative_9386, Mode=OneWay}"
                        shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                        BorderThickness="{x:Bind GlassNative_9386.BorderThickness, Mode=OneWay}"
                        Command="{x:Bind GlassNative_9386.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind GlassNative_9386.CommandParameter, Mode=OneWay}"
                        Content="{x:Bind GlassNative_9386.Content, Mode=OneWay}"
                        FlowDirection="{x:Bind GlassNative_9386.FlowDirection, Mode=OneWay}"
                        FontFamily="{x:Bind GlassNative_9386.FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind GlassNative_9386.FontSize, Mode=OneWay}"
                        FontStyle="{x:Bind GlassNative_9386.FontStyle, Mode=OneWay}"
                        FontWeight="{x:Bind GlassNative_9386.FontWeight, Mode=OneWay}"
                        IsEnabled="{x:Bind GlassNative_9386.IsEnabled, Mode=OneWay}"/>
                    <wl:LiquidGlassRadioButton
                        x:Name="GlassNative_9513Glass"
                        Width="{x:Bind GlassNative_9513.Width, Mode=OneWay}"
                        Height="{x:Bind GlassNative_9513.Height, Mode=OneWay}"
                        MinWidth="{x:Bind GlassNative_9513.MinWidth, Mode=OneWay}"
                        MinHeight="{x:Bind GlassNative_9513.MinHeight, Mode=OneWay}"
                        MaxWidth="{x:Bind GlassNative_9513.MaxWidth, Mode=OneWay}"
                        MaxHeight="{x:Bind GlassNative_9513.MaxHeight, Mode=OneWay}"
                        Padding="{x:Bind GlassNative_9513.Padding, Mode=OneWay}"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        shuxcth:ControlMaterialState.NativeControl="{x:Bind GlassNative_9513, Mode=OneWay}"
                        shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                        BorderThickness="{x:Bind GlassNative_9513.BorderThickness, Mode=OneWay}"
                        Command="{x:Bind GlassNative_9513.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind GlassNative_9513.CommandParameter, Mode=OneWay}"
                        Content="{x:Bind GlassNative_9513.Content, Mode=OneWay}"
                        FlowDirection="{x:Bind GlassNative_9513.FlowDirection, Mode=OneWay}"
                        FontFamily="{x:Bind GlassNative_9513.FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind GlassNative_9513.FontSize, Mode=OneWay}"
                        FontStyle="{x:Bind GlassNative_9513.FontStyle, Mode=OneWay}"
                        FontWeight="{x:Bind GlassNative_9513.FontWeight, Mode=OneWay}"
                        IsEnabled="{x:Bind GlassNative_9513.IsEnabled, Mode=OneWay}"/>
                </RadioButtons>
            </cwc:Case>
        </cwc:SwitchPresenter>
    </Grid>
</ContentDialog>

<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.CultivationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwconv="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxca="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shhuxcp="using:Snap.Hutao.Remastered.UI.Xaml.Control.Panel"
    xmlns:shux="using:Snap.Hutao.Remastered.UI.Xaml"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxba="using:Snap.Hutao.Remastered.UI.Xaml.Behavior.Action"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxca="using:Snap.Hutao.Remastered.UI.Xaml.Control.AutoSuggestBox"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcl="using:Snap.Hutao.Remastered.UI.Xaml.Control.Layout"
    xmlns:shuxcpd="using:Snap.Hutao.Remastered.UI.Xaml.Control.Panel.DataTable"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxdc="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvcu="using:Snap.Hutao.Remastered.ViewModel.Cultivation"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance shvcu:CultivationViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <cwconv:BoolToObjectConverter
                        x:Key="BoolToBrushSelector"
                        FalseValue="{StaticResource SolidBackgroundFillColorTransparentBrush}"
                        TrueValue="{StaticResource CultivationHighlightColorBrush}"/>
                    <cwconv:BoolToObjectConverter
                        x:Key="BoolToStatisticsBrushSelector"
                        FalseValue="{StaticResource CardBackgroundFillColorDefaultBrush}"
                        TrueValue="{StaticResource CultivationHighlightColorBrush}"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <cwconv:BoolToObjectConverter
                        x:Key="BoolToBrushSelector"
                        FalseValue="{StaticResource SolidBackgroundFillColorTransparentBrush}"
                        TrueValue="{StaticResource CultivationHighlightColorBrush}"/>
                    <cwconv:BoolToObjectConverter
                        x:Key="BoolToStatisticsBrushSelector"
                        FalseValue="{StaticResource CardBackgroundFillColorDefaultBrush}"
                        TrueValue="{StaticResource CultivationHighlightColorBrush}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <shux:BindingProxy x:Key="BindingProxy" DataContext="{x:Bind ((shvcu:CultivationViewModel)DataContext), Mode=OneWay}"/>

            <DataTemplate x:Key="FlyoutSkillTemplate">
                <Border Margin="0,2,0,0" Style="{StaticResource BorderCardStyle}">
                    <Grid Margin="8" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <shuxci:CachedImage
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            ShowAsMonoChrome="True"
                            Source="{Binding Icon}"/>
                        <TextBlock
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis"/>
                        <NumberBox
                            Grid.Column="3"
                            MinWidth="80"
                            VerticalAlignment="Center"
                            Maximum="{Binding LevelMax}"
                            Minimum="{Binding LevelMin}"
                            SpinButtonPlacementMode="Inline"
                            Value="{Binding LevelCurrent, Mode=TwoWay}"/>
                        <FontIcon
                            Grid.Column="4"
                            Margin="4,0"
                            FontSize="12"
                            Glyph="&#xEBE7;"/>
                        <NumberBox
                            Grid.Column="5"
                            MinWidth="80"
                            VerticalAlignment="Center"
                            Maximum="{Binding LevelMax}"
                            Minimum="{Binding LevelCurrent, Mode=OneWay}"
                            SpinButtonPlacementMode="Inline"
                            Value="{Binding LevelTarget, Mode=TwoWay}"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="CultivateEntryFlyoutContentTemplate" x:DataType="shvcu:CultivateEntryView">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <!--  Avatar section  -->
                    <StackPanel Grid.Row="0" Visibility="{x:Bind Avatar, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                        <Grid
                            Padding="8"
                            ColumnSpacing="6"
                            DataContext="{x:Bind Avatar, Mode=OneWay}"
                            Style="{ThemeResource GridCardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <shuxc:ItemIcon
                                Grid.Column="0"
                                Width="32"
                                Height="32"
                                Icon="{x:Bind Avatar.Icon, Mode=OneWay}"
                                Quality="{x:Bind Avatar.Quality, Mode=OneWay}"/>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind Avatar.Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"/>
                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Visibility="{x:Bind Avatar.IsPromotionAvailable, Mode=OneWay}">
                                <cwc:SwitchPresenter
                                    x:Name="GlassPresenter_8164"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    IsTabStop="False"
                                    Tag="LiquidGlass:CheckBox"
                                    Value="{x:Bind shuxcth:MaterialBindingSource.Current.CheckBoxMaterial, Mode=OneWay}">
                                    <cwc:Case>
                                        <cwc:Case.Value>
                                            <x:Int32>0</x:Int32>
                                        </cwc:Case.Value>
                                        <CheckBox
                                            VerticalAlignment="Center"
                                            Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                            IsChecked="{x:Bind Avatar.IsPromoted, Mode=TwoWay}"/>
                                    </cwc:Case>
                                    <cwc:Case>
                                        <cwc:Case.Value>
                                            <x:Int32>1</x:Int32>
                                        </cwc:Case.Value>
                                        <wl:LiquidGlassCheckBox
                                            VerticalAlignment="Center"
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                            IsChecked="{x:Bind Avatar.IsPromoted, Mode=TwoWay}"/>
                                    </cwc:Case>
                                </cwc:SwitchPresenter>
                            </StackPanel>
                            <NumberBox
                                Grid.Column="3"
                                MinWidth="80"
                                VerticalAlignment="Center"
                                Maximum="{x:Bind Avatar.LevelMax, Mode=OneWay}"
                                Minimum="{x:Bind Avatar.LevelMin, Mode=OneWay}"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind Avatar.LevelCurrent, Mode=TwoWay}"/>
                            <FontIcon
                                Grid.Column="4"
                                Margin="4,0"
                                FontSize="12"
                                Glyph="&#xEBE7;"/>
                            <NumberBox
                                Grid.Column="5"
                                MinWidth="80"
                                VerticalAlignment="Center"
                                Maximum="{x:Bind Avatar.LevelMax, Mode=OneWay}"
                                Minimum="{x:Bind Avatar.LevelCurrent, Mode=OneWay}"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind Avatar.LevelTarget, Mode=TwoWay}"/>
                        </Grid>

                        <ItemsControl ItemTemplate="{StaticResource FlyoutSkillTemplate}" ItemsSource="{x:Bind Avatar.Skills, Mode=OneWay}"/>
                    </StackPanel>

                    <!--  Weapon section  -->
                    <StackPanel Grid.Row="1" Visibility="{x:Bind Weapon, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                        <Grid
                            Padding="8"
                            ColumnSpacing="6"
                            DataContext="{x:Bind Weapon, Mode=OneWay}"
                            Style="{ThemeResource GridCardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <shuxc:ItemIcon
                                Grid.Column="0"
                                Width="32"
                                Height="32"
                                Icon="{x:Bind Weapon.Icon, Mode=OneWay}"
                                Quality="{x:Bind Weapon.Quality, Mode=OneWay}"/>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Text="{x:Bind Weapon.Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"/>
                            <StackPanel
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Visibility="{x:Bind Weapon.IsPromotionAvailable, Mode=OneWay}">
                                <cwc:SwitchPresenter
                                    x:Name="GlassPresenter_11656"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    IsTabStop="False"
                                    Tag="LiquidGlass:CheckBox"
                                    Value="{x:Bind shuxcth:MaterialBindingSource.Current.CheckBoxMaterial, Mode=OneWay}">
                                    <cwc:Case>
                                        <cwc:Case.Value>
                                            <x:Int32>0</x:Int32>
                                        </cwc:Case.Value>
                                        <CheckBox
                                            VerticalAlignment="Center"
                                            Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                            IsChecked="{x:Bind Weapon.IsPromoted, Mode=TwoWay}"/>
                                    </cwc:Case>
                                    <cwc:Case>
                                        <cwc:Case.Value>
                                            <x:Int32>1</x:Int32>
                                        </cwc:Case.Value>
                                        <wl:LiquidGlassCheckBox
                                            VerticalAlignment="Center"
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            Content="{shuxm:ResourceString Name=ViewDialogCultivatePromotionDeltaPromoted}"
                                            IsChecked="{x:Bind Weapon.IsPromoted, Mode=TwoWay}"/>
                                    </cwc:Case>
                                </cwc:SwitchPresenter>
                            </StackPanel>
                            <NumberBox
                                Grid.Column="3"
                                MinWidth="80"
                                VerticalAlignment="Center"
                                Maximum="{x:Bind Weapon.LevelMax, Mode=OneWay}"
                                Minimum="{x:Bind Weapon.LevelMin, Mode=OneWay}"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind Weapon.LevelCurrent, Mode=TwoWay}"/>
                            <FontIcon
                                Grid.Column="4"
                                Margin="4,0"
                                FontSize="12"
                                Glyph="&#xEBE7;"/>
                            <NumberBox
                                Grid.Column="5"
                                MinWidth="80"
                                VerticalAlignment="Center"
                                Maximum="{x:Bind Weapon.LevelMax, Mode=OneWay}"
                                Minimum="{x:Bind Weapon.LevelCurrent, Mode=OneWay}"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind Weapon.LevelTarget, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>

                    <!--  Action buttons  -->
                    <Grid
                        Grid.Row="2"
                        Margin="0,6,0,0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_13608"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:Button"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding Path=DataContext.ModifyEntryCommand, Source={StaticResource BindingProxy}}"
                                    CommandParameter="{x:Bind}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <mxi:Interaction.Behaviors>
                                        <mxi:EventTriggerBehavior EventName="Click">
                                            <shuxba:HideAttachedFlyoutAction/>
                                        </mxi:EventTriggerBehavior>
                                    </mxi:Interaction.Behaviors>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon FontSize="14" Glyph="&#xE73E;"/>
                                        <TextBlock Text="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"/>
                                    </StackPanel>
                                </Button>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassButton
                                    HorizontalAlignment="Stretch"
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    Command="{Binding Path=DataContext.ModifyEntryCommand, Source={StaticResource BindingProxy}}"
                                    CommandParameter="{x:Bind}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <mxi:Interaction.Behaviors>
                                        <mxi:EventTriggerBehavior EventName="Click">
                                            <shuxba:HideAttachedFlyoutAction/>
                                        </mxi:EventTriggerBehavior>
                                    </mxi:Interaction.Behaviors>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon FontSize="14" Glyph="&#xE73E;"/>
                                        <TextBlock Text="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"/>
                                    </StackPanel>
                                </wl:LiquidGlassButton>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_14661"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:Button"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <Button HorizontalAlignment="Stretch" Style="{StaticResource DefaultButtonStyle}">
                                    <mxi:Interaction.Behaviors>
                                        <mxi:EventTriggerBehavior EventName="Click">
                                            <shuxba:HideAttachedFlyoutAction/>
                                        </mxi:EventTriggerBehavior>
                                    </mxi:Interaction.Behaviors>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon FontSize="14" Glyph="&#xE711;"/>
                                        <TextBlock Text="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"/>
                                    </StackPanel>
                                </Button>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassButton
                                    HorizontalAlignment="Stretch"
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    Style="{StaticResource DefaultButtonStyle}">
                                    <mxi:Interaction.Behaviors>
                                        <mxi:EventTriggerBehavior EventName="Click">
                                            <shuxba:HideAttachedFlyoutAction/>
                                        </mxi:EventTriggerBehavior>
                                    </mxi:Interaction.Behaviors>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon FontSize="14" Glyph="&#xE711;"/>
                                        <TextBlock Text="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"/>
                                    </StackPanel>
                                </wl:LiquidGlassButton>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                    </Grid>
                </Grid>
            </DataTemplate>

            <Flyout
                x:Key="CultivateEntryFlyout"
                Placement="RightEdgeAlignedTop"
                ShouldConstrainToRootBounds="False">
                <Flyout.FlyoutPresenterStyle>
                    <Style BasedOn="{StaticResource FlyoutPresenterPadding8Style}" TargetType="FlyoutPresenter">
                        <Setter Property="MaxWidth" Value="Infinity"/>
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <ContentControl
                    HorizontalContentAlignment="Stretch"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource CultivateEntryFlyoutContentTemplate}"/>
            </Flyout>

            <cwconv:BoolToObjectConverter x:Key="BoolToOpacityConverter">
                <cwconv:BoolToObjectConverter.TrueValue>
                    <x:Double>0.4</x:Double>
                </cwconv:BoolToObjectConverter.TrueValue>
                <cwconv:BoolToObjectConverter.FalseValue>
                    <x:Double>1</x:Double>
                </cwconv:BoolToObjectConverter.FalseValue>
            </cwconv:BoolToObjectConverter>

            <cwconv:BoolToObjectConverter
                x:Key="BoolToStyleSelector"
                FalseValue="{StaticResource BodyTextBlockStyle}"
                TrueValue="{StaticResource BaseTextBlockStyle}"/>

            <shuxdc:SpecificStringToVisibilityConverter x:Key="MaterialListSelectedItemIsEntryViewConverter" Value="Entry"/>
            <shuxdc:SpecificStringToVisibilityConverter x:Key="MaterialListSelectedItemIsStatisticsViewConverter" Value="Statistics"/>
            <shuxdc:BoolToAnimatedIconStateConverter x:Key="BoolToAnimatedIconStateConverter"/>

            <DataTemplate x:Key="TokenTemplate" x:DataType="shuxca:SearchToken">
                <Grid Height="22" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Grid.Column="0"
                        Width="12"
                        Height="12"
                        Margin="1,1,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Visibility="{x:Bind Quality, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{x:Bind QualityColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <BitmapIcon
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="-3,2,7,0"
                        ShowAsMonochrome="True"
                        UriSource="{x:Bind PackageIconUri, Mode=OneTime}"
                        Visibility="{x:Bind PackageIconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}"/>
                    <shuxci:CachedImage
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="-3,2,7,0"
                        ShowAsMonoChrome="True"
                        Source="{x:Bind IconUri, Mode=OneTime}"
                        Visibility="{x:Bind IconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}"/>
                    <shuxci:CachedImage
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="-4,-2,8,2"
                        Source="{x:Bind SideIconUri, Mode=OneTime}"
                        Visibility="{x:Bind SideIconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}"/>
                    <TextBlock
                        Grid.Column="1"
                        Height="20"
                        VerticalAlignment="Center"
                        Text="{x:Bind Value, Mode=OneTime}"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CultivateEntryItemTemplate" x:DataType="shvcu:CultivateItemView">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <shuxc:ItemIcon
                            Width="32"
                            Height="32"
                            Icon="{x:Bind Inner.Icon, Converter={StaticResource ItemIconConverter}, Mode=OneWay}"
                            Opacity="{x:Bind IsFinished, Converter={StaticResource BoolToOpacityConverter}, Mode=OneWay}"
                            Quality="{x:Bind Inner.RankLevel, Mode=OneWay}"/>

                        <AnimatedIcon
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            State="{x:Bind IsFinished, Converter={StaticResource BoolToAnimatedIconStateConverter}, Mode=OneWay}">
                            <muxca:AnimatedAcceptVisualSource/>
                            <AnimatedIcon.FallbackIconSource>
                                <FontIconSource FontSize="24" Glyph="&#xE73E;"/>
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Grid>
                    <!--  ReSharper disable once Xaml.BindingWithContextNotResolved  -->
                    <cwc:SwitchPresenter
                        x:Name="GlassPresenter_20565"
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:Button"
                        Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>0</x:Int32>
                            </cwc:Case.Value>
                            <Button
                                Height="32"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="{Binding IsToday, Converter={ThemeResource BoolToBrushSelector}, Mode=OneWay}"
                                Command="{Binding Path=DataContext.FinishStateCommand, Source={StaticResource BindingProxy}}"
                                CommandParameter="{x:Bind Mode=OneWay}"
                                Style="{StaticResource ButtonRevealStyle}">
                                <Grid Opacity="{x:Bind IsFinished, Converter={StaticResource BoolToOpacityConverter}, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{x:Bind IsToday, Converter={StaticResource BoolToStyleSelector}, Mode=OneWay}"
                                        Text="{x:Bind Inner.Name, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"/>
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{x:Bind IsToday, Converter={StaticResource BoolToStyleSelector}, Mode=OneWay}"
                                        Text="{x:Bind Entity.Count, Mode=OneWay}"/>
                                </Grid>
                            </Button>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>1</x:Int32>
                            </cwc:Case.Value>
                            <wl:LiquidGlassButton
                                Height="32"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                shuxcth:ControlMaterialState.IsManaged="True"
                                Command="{Binding Path=DataContext.FinishStateCommand, Source={StaticResource BindingProxy}}"
                                CommandParameter="{x:Bind Mode=OneWay}"
                                Style="{StaticResource ButtonRevealStyle}">
                                <Grid Opacity="{x:Bind IsFinished, Converter={StaticResource BoolToOpacityConverter}, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{x:Bind IsToday, Converter={StaticResource BoolToStyleSelector}, Mode=OneWay}"
                                        Text="{x:Bind Inner.Name, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"/>
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{x:Bind IsToday, Converter={StaticResource BoolToStyleSelector}, Mode=OneWay}"
                                        Text="{x:Bind Entity.Count, Mode=OneWay}"/>
                                </Grid>
                            </wl:LiquidGlassButton>
                        </cwc:Case>
                    </cwc:SwitchPresenter>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CultivateEntryTemplate" x:DataType="shvcu:CultivateEntryView">
                <Border cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="PointerPressed">
                            <shuxba:ShowAttachedFlyoutAction/>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                    <FlyoutBase.AttachedFlyout>
                        <StaticResource ResourceKey="CultivateEntryFlyout"/>
                    </FlyoutBase.AttachedFlyout>
                    <Grid Style="{ThemeResource AcrylicGridCardStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <shuxc:ItemIcon
                                Width="52"
                                Height="52"
                                Icon="{x:Bind Icon, Mode=OneWay}"
                                Quality="{x:Bind Quality, Mode=OneWay}"/>
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"/>
                                <TextBlock
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"

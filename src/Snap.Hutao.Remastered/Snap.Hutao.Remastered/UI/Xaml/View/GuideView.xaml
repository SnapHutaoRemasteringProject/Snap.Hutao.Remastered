                            <cwc:SwitchPresenter
                                x:Name="GlassPresenter_17141"
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsTabStop="False"
                                Tag="LiquidGlass:CheckBox"
                                Value="{x:Bind shuxcth:MaterialBindingSource.Current.CheckBoxMaterial, Mode=OneWay}">
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>0</x:Int32>
                                    </cwc:Case.Value>
                                    <CheckBox IsChecked="{Binding IsAgreementCopyAgreed, Mode=TwoWay}">
                                        <TextBlock Text="{Binding AgreementCopyTarget}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </cwc:Case>
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>1</x:Int32>
                                    </cwc:Case.Value>

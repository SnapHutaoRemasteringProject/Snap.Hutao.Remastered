<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.TestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwh="using:CommunityToolkit.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxba="using:Snap.Hutao.Remastered.UI.Xaml.Behavior.Action"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shuxvww="using:Snap.Hutao.Remastered.UI.Xaml.View.Window.WebView2"
    xmlns:shv="using:Snap.Hutao.Remastered.ViewModel"
    xmlns:shwhr="using:Snap.Hutao.Remastered.Web.Hutao.Redeem"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance shv:TestViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shv:TestViewModel)DataContext).LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Border Margin="16" Style="{ThemeResource AcrylicBorderCardStyle}">
        <ScrollViewer>
            <StackPanel Margin="16" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock
                    Margin="1,0,0,5"
                    Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}"
                    Text="WebView"/>
                <cwc:SettingsCard Header="Adopt Calculator" IsClickEnabled="True">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Click">
                            <shuxba:ShowWebView2WindowAction>
                                <shuxba:ShowWebView2WindowAction.ContentProvider>
                                    <shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                        <shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                            <shuxvww:StaticJSBridgeUriSourceProvider ChineseSource="http://webstatic.mihoyo.com/ys/event/e20200923adopt_calculator/index.html?bbs_presentation_style=fullscreen&amp;bbs_auth_required=true&amp;utm_source=bbs&amp;utm_medium=mys&amp;utm_campaign=GameRecord"/>
                                        </shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                    </shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                </shuxba:ShowWebView2WindowAction.ContentProvider>
                            </shuxba:ShowWebView2WindowAction>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Community Game Record" IsClickEnabled="True">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Click">
                            <shuxba:ShowWebView2WindowAction>
                                <shuxba:ShowWebView2WindowAction.ContentProvider>
                                    <shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                        <shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                            <shuxvww:StaticJSBridgeUriSourceProvider ChineseSource="https://webstatic.mihoyo.com/app/community-game-records/index.html"/>
                                        </shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                    </shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                </shuxba:ShowWebView2WindowAction.ContentProvider>
                            </shuxba:ShowWebView2WindowAction>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="SignIn Reward" IsClickEnabled="True">
                    <mxi:Interaction.Behaviors>
                        <mxi:EventTriggerBehavior EventName="Click">
                            <shuxba:ShowWebView2WindowAction>
                                <shuxba:ShowWebView2WindowAction.ContentProvider>
                                    <shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                        <shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                            <shuxvww:StaticJSBridgeUriSourceProvider ChineseSource="https://act.mihoyo.com/bbs/event/signin/hk4e/index.html?act_id=e202311201442471"/>
                                        </shuxvww:MiHoYoJSBridgeWebView2ContentProvider.SourceProvider>
                                    </shuxvww:MiHoYoJSBridgeWebView2ContentProvider>
                                </shuxba:ShowWebView2WindowAction.ContentProvider>
                            </shuxba:ShowWebView2WindowAction>
                        </mxi:EventTriggerBehavior>
                    </mxi:Interaction.Behaviors>
                </cwc:SettingsCard>

                <TextBlock Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" Text="State"/>
                <cwc:SettingsCard Header="Reset Guide State">
                    <cwc:SwitchPresenter
                        x:Name="GlassPresenter_5460"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:Button"
                        Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>0</x:Int32>
                            </cwc:Case.Value>
                            <Button
                                Command="{x:Bind shv:TestViewModel.ResetGuideStateCommand}"
                                Content="Reset (No restart)"
                                Style="{ThemeResource SettingButtonStyle}"/>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>1</x:Int32>
                            </cwc:Case.Value>
                            <wl:LiquidGlassButton
                                shuxcth:ControlMaterialState.IsManaged="True"
                                Command="{x:Bind shv:TestViewModel.ResetGuideStateCommand}"
                                Content="Reset (No restart)"
                                Style="{ThemeResource SettingButtonStyle}"/>
                        </cwc:Case>
                    </cwc:SwitchPresenter>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Resize MainWindow">
                    <cwc:SwitchPresenter
                        x:Name="GlassPresenter_5776"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:Button"
                        Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>0</x:Int32>
                            </cwc:Case.Value>
                            <Button
                                Command="{x:Bind ((shv:TestViewModel)DataContext).ResetMainWindowSizeCommand, Mode=OneWay}"
                                Content="Reset"
                                Style="{ThemeResource SettingButtonStyle}"/>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>1</x:Int32>
                            </cwc:Case.Value>
                            <wl:LiquidGlassButton
                                shuxcth:ControlMaterialState.IsManaged="True"
                                Command="{x:Bind ((shv:TestViewModel)DataContext).ResetMainWindowSizeCommand, Mode=OneWay}"
                                Content="Reset"
                                Style="{ThemeResource SettingButtonStyle}"/>
                        </cwc:Case>
                    </cwc:SwitchPresenter>
                </cwc:SettingsCard>

                <TextBlock Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" Text="Condition Override"/>

                <cwc:SettingsCard Header="Override Elevation Requirement">
                    <cwc:SwitchPresenter
                        x:Name="GlassPresenter_6212"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:ToggleSwitch"
                        Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleSwitchMaterial, Mode=OneWay}">
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>0</x:Int32>
                            </cwc:Case.Value>
                            <ToggleSwitch IsOn="{x:Bind ((shv:TestViewModel)DataContext).OverrideElevationRequirement, Mode=TwoWay}"/>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>1</x:Int32>
                            </cwc:Case.Value>
                            <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind ((shv:TestViewModel)DataContext).OverrideElevationRequirement, Mode=TwoWay}"/>
                        </cwc:Case>
                    </cwc:SwitchPresenter>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Override Update Version Comparison">
                    <cwc:SwitchPresenter
                        x:Name="GlassPresenter_6423"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:ToggleSwitch"
                        Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleSwitchMaterial, Mode=OneWay}">
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>0</x:Int32>
                            </cwc:Case.Value>
                            <ToggleSwitch IsOn="{x:Bind ((shv:TestViewModel)DataContext).OverrideUpdateVersionComparison, Mode=TwoWay}"/>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>1</x:Int32>
                            </cwc:Case.Value>
                            <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind ((shv:TestViewModel)DataContext).OverrideUpdateVersionComparison, Mode=TwoWay}"/>
                        </cwc:Case>
                    </cwc:SwitchPresenter>
                </cwc:SettingsCard>

                <cwc:SettingsCard
                    Command="{x:Bind ((shv:TestViewModel)DataContext).ForceUpdateDialogCommand, Mode=OneWay}"
                    Description="Show the update dialog without requiring an actual new version"
                    Header="Force Show Update Dialog"
                    IsClickEnabled="True"/>

                <cwc:SettingsCard Header="Override Package Convert Directory Permission Requirement">
                    <cwc:SwitchPresenter
                        x:Name="GlassPresenter_6955"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:ToggleSwitch"
                        Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleSwitchMaterial, Mode=OneWay}">
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>0</x:Int32>
                            </cwc:Case.Value>
                            <ToggleSwitch IsOn="{x:Bind ((shv:TestViewModel)DataContext).OverridePackageConvertDirectoryPermissionsRequirement, Mode=TwoWay}"/>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>1</x:Int32>
                            </cwc:Case.Value>
                            <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind ((shv:TestViewModel)DataContext).OverridePackageConvertDirectoryPermissionsRequirement, Mode=TwoWay}"/>
                        </cwc:Case>
                    </cwc:SwitchPresenter>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Override Hard Drive Type">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SettingsCardContentControlSpacing}">
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_7303"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:ToggleSwitch"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleSwitchMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <ToggleSwitch
                                    IsEnabled="{x:Bind HardDriveTypeToggle.IsOn, Mode=OneWay}"
                                    IsOn="{x:Bind ((shv:TestViewModel)DataContext).OverrideHardDriveTypeIsSolidState, Mode=TwoWay}"
                                    OffContent="HDD"
                                    OnContent="SSD"/>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassToggleSwitch
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    IsEnabled="{x:Bind HardDriveTypeToggle.IsOn, Mode=OneWay}"
                                    IsOn="{x:Bind ((shv:TestViewModel)DataContext).OverrideHardDriveTypeIsSolidState, Mode=TwoWay}"
                                    OffContent="HDD"
                                    OnContent="SSD"/>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_7611"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:ToggleSwitch"
                            Visibility="{x:Bind HardDriveTypeToggle.Visibility, Mode=OneWay}"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleSwitchMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <ToggleSwitch
                                    x:Name="HardDriveTypeToggle"
                                    DataContext="{x:Bind GlassPresenter_7611.DataContext, Mode=OneWay}"
                                    IsOn="{x:Bind ((shv:TestViewModel)DataContext).OverrideHardDriveType, Mode=TwoWay}"
                                    shuxcth:ThemeSynchronization.Source="{x:Bind GlassPresenter_7611}"/>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassToggleSwitch
                                    x:Name="HardDriveTypeToggleGlass"
                                    Width="{x:Bind HardDriveTypeToggle.Width, Mode=OneWay}"
                                    MinWidth="{x:Bind HardDriveTypeToggle.MinWidth, Mode=OneWay}"
                                    MinHeight="{x:Bind HardDriveTypeToggle.MinHeight, Mode=OneWay}"
                                    MaxWidth="{x:Bind HardDriveTypeToggle.MaxWidth, Mode=OneWay}"
                                    MaxHeight="{x:Bind HardDriveTypeToggle.MaxHeight, Mode=OneWay}"
                                    Padding="{x:Bind HardDriveTypeToggle.Padding, Mode=OneWay}"
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    shuxcth:ControlMaterialState.NativeControl="{x:Bind HardDriveTypeToggle, Mode=OneWay}"
                                    shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                                    BorderThickness="{x:Bind HardDriveTypeToggle.BorderThickness, Mode=OneWay}"
                                    FlowDirection="{x:Bind HardDriveTypeToggle.FlowDirection, Mode=OneWay}"
                                    FontFamily="{x:Bind HardDriveTypeToggle.FontFamily, Mode=OneWay}"
                                    FontSize="{x:Bind HardDriveTypeToggle.FontSize, Mode=OneWay}"
                                    FontStyle="{x:Bind HardDriveTypeToggle.FontStyle, Mode=OneWay}"
                                    FontWeight="{x:Bind HardDriveTypeToggle.FontWeight, Mode=OneWay}"
                                    Header="{x:Bind HardDriveTypeToggle.Header, Mode=OneWay}"
                                    HeaderTemplate="{x:Bind HardDriveTypeToggle.HeaderTemplate, Mode=OneWay}"
                                    IsEnabled="{x:Bind HardDriveTypeToggle.IsEnabled, Mode=OneWay}"
                                    IsOn="{x:Bind HardDriveTypeToggle.IsOn, Mode=TwoWay}"
                                    OffContent="{x:Bind HardDriveTypeToggle.OffContent, Mode=OneWay}"
                                    OffContentTemplate="{x:Bind HardDriveTypeToggle.OffContentTemplate, Mode=OneWay}"
                                    OnContent="{x:Bind HardDriveTypeToggle.OnContent, Mode=OneWay}"
                                    OnContentTemplate="{x:Bind HardDriveTypeToggle.OnContentTemplate, Mode=OneWay}"/>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                    </StackPanel>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Always Treat As First Run After Update">
                    <cwc:SwitchPresenter
                        x:Name="GlassPresenter_7882"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False"
                        Tag="LiquidGlass:ToggleSwitch"
                        Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleSwitchMaterial, Mode=OneWay}">
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>0</x:Int32>
                            </cwc:Case.Value>
                            <ToggleSwitch IsOn="{x:Bind ((shv:TestViewModel)DataContext).AlwaysIsFirstRunAfterUpdate, Mode=TwoWay}"/>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>1</x:Int32>
                            </cwc:Case.Value>
                            <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind ((shv:TestViewModel)DataContext).AlwaysIsFirstRunAfterUpdate, Mode=TwoWay}"/>
                        </cwc:Case>
                    </cwc:SwitchPresenter>
                </cwc:SettingsCard>

                <cwc:SettingsCard Header="Alpha Build Generic API Endpoint">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SettingsCardContentControlSpacing}">
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_8212"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:ToggleSwitch"
                            Visibility="{x:Bind GenericApiEndPointToggle.Visibility, Mode=OneWay}"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleSwitchMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <ToggleSwitch
                                    x:Name="GenericApiEndPointToggle"
                                    DataContext="{x:Bind GlassPresenter_8212.DataContext, Mode=OneWay}"
                                    IsOn="{x:Bind ((shv:TestViewModel)DataContext).AlphaBuildUseCNPatchEndpoint, Mode=TwoWay}"
                                    OffContent="Oversea Endpoints"
                                    OnContent="Chinese Endpoints"
                                    shuxcth:ThemeSynchronization.Source="{x:Bind GlassPresenter_8212}"/>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassToggleSwitch
                                    x:Name="GenericApiEndPointToggleGlass"
                                    Width="{x:Bind GenericApiEndPointToggle.Width, Mode=OneWay}"
                                    MinWidth="{x:Bind GenericApiEndPointToggle.MinWidth, Mode=OneWay}"
                                    MinHeight="{x:Bind GenericApiEndPointToggle.MinHeight, Mode=OneWay}"
                                    MaxWidth="{x:Bind GenericApiEndPointToggle.MaxWidth, Mode=OneWay}"
                                    MaxHeight="{x:Bind GenericApiEndPointToggle.MaxHeight, Mode=OneWay}"
                                    Padding="{x:Bind GenericApiEndPointToggle.Padding, Mode=OneWay}"
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    shuxcth:ControlMaterialState.NativeControl="{x:Bind GenericApiEndPointToggle, Mode=OneWay}"
                                    shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"
                                    BorderThickness="{x:Bind GenericApiEndPointToggle.BorderThickness, Mode=OneWay}"
                                    FlowDirection="{x:Bind GenericApiEndPointToggle.FlowDirection, Mode=OneWay}"
                                    FontFamily="{x:Bind GenericApiEndPointToggle.FontFamily, Mode=OneWay}"
                                    FontSize="{x:Bind GenericApiEndPointToggle.FontSize, Mode=OneWay}"
                                    FontStyle="{x:Bind GenericApiEndPointToggle.FontStyle, Mode=OneWay}"
                                    FontWeight="{x:Bind GenericApiEndPointToggle.FontWeight, Mode=OneWay}"
                                    Header="{x:Bind GenericApiEndPointToggle.Header, Mode=OneWay}"
                                    HeaderTemplate="{x:Bind GenericApiEndPointToggle.HeaderTemplate, Mode=OneWay}"
                                    IsEnabled="{x:Bind GenericApiEndPointToggle.IsEnabled, Mode=OneWay}"
                                    IsOn="{x:Bind GenericApiEndPointToggle.IsOn, Mode=TwoWay}"
                                    OffContent="{x:Bind GenericApiEndPointToggle.OffContent, Mode=OneWay}"
                                    OffContentTemplate="{x:Bind GenericApiEndPointToggle.OffContentTemplate, Mode=OneWay}"
                                    OnContent="{x:Bind GenericApiEndPointToggle.OnContent, Mode=OneWay}"
                                    OnContentTemplate="{x:Bind GenericApiEndPointToggle.OnContentTemplate, Mode=OneWay}"/>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_8518"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:ToggleSwitch"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleSwitchMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <ToggleSwitch
                                    IsEnabled="{x:Bind GenericApiEndPointToggle.IsOn, Mode=OneWay}"
                                    IsOn="{x:Bind ((shv:TestViewModel)DataContext).AlphaBuildUseFJPatchEndpoint, Mode=TwoWay}"
                                    OffContent="No Secondary Endpoints"
                                    OnContent="Fujian Endpoints"/>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassToggleSwitch
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    IsEnabled="{x:Bind GenericApiEndPointToggle.IsOn, Mode=OneWay}"
                                    IsOn="{x:Bind ((shv:TestViewModel)DataContext).AlphaBuildUseFJPatchEndpoint, Mode=TwoWay}"
                                    OffContent="No Secondary Endpoints"
                                    OnContent="Fujian Endpoints"/>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                    </StackPanel>
                </cwc:SettingsCard>

                <TextBlock Style="{ThemeResource SettingsSectionHeaderTextBlockStyle}" Text="Hutao Cloud"/>
                <cwc:SettingsCard
                    Command="{x:Bind ((shv:TestViewModel)DataContext).CompensationGachaLogServiceTimeCommand, Mode=OneWay}"
                    Header="Compensation GachaLog Service Time"
                    IsClickEnabled="True">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <NumberBox
                            MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                            VerticalAlignment="Center"
                            AcceptsExpression="False"
                            Value="{x:Bind ((shv:TestViewModel)DataContext).GachaLogCompensationDays, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" Text="Days"/>
                    </StackPanel>
                </cwc:SettingsCard>

                <cwc:SettingsCard
                    Command="{x:Bind ((shv:TestViewModel)DataContext).DesignationGachaLogServiceTimeCommand, Mode=OneWay}"
                    Header="Designation GachaLog Service Time"
                    IsClickEnabled="True">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="UserName"/>
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_10360"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:TextBox"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.TextBoxMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <TextBox
                                    MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ((shv:TestViewModel)DataContext).GachaLogDesignationOptions.UserName, Mode=TwoWay}"/>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>
                                <wl:LiquidGlassTextBox
                                    MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                                    VerticalAlignment="Center"
                                    shuxcth:ControlMaterialState.IsManaged="True"
                                    Text="{x:Bind ((shv:TestViewModel)DataContext).GachaLogDesignationOptions.UserName, Mode=TwoWay}"/>
                            </cwc:Case>
                        </cwc:SwitchPresenter>
                        <NumberBox
                            MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                            VerticalAlignment="Center"
                            AcceptsExpression="False"
                            Value="{x:Bind ((shv:TestViewModel)DataContext).GachaLogDesignationOptions.Days, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" Text="Days"/>
                    </StackPanel>
                </cwc:SettingsCard>

                <cwc:SettingsCard
                    Command="{x:Bind ((shv:TestViewModel)DataContext).CompensationCdnServiceTimeCommand, Mode=OneWay}"
                    Header="Compensation Cdn Service Time"
                    IsClickEnabled="True">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <NumberBox
                            MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                            VerticalAlignment="Center"
                            AcceptsExpression="False"
                            Value="{x:Bind ((shv:TestViewModel)DataContext).CdnCompensationDays, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" Text="Days"/>
                    </StackPanel>
                </cwc:SettingsCard>

                <cwc:SettingsCard
                    Command="{x:Bind ((shv:TestViewModel)DataContext).DesignationCdnServiceTimeCommand, Mode=OneWay}"
                    Header="Designation Cdn Service Time"
                    IsClickEnabled="True">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="UserName"/>
                        <cwc:SwitchPresenter
                            x:Name="GlassPresenter_12406"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsTabStop="False"
                            Tag="LiquidGlass:TextBox"
                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.TextBoxMaterial, Mode=OneWay}">
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </cwc:Case.Value>
                                <TextBox
                                    MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ((shv:TestViewModel)DataContext).CdnDesignationOptions.UserName, Mode=TwoWay}"/>
                            </cwc:Case>
                            <cwc:Case>
                                <cwc:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </cwc:Case.Value>

<Window
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Window.WebView2.WebView2Window"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:wl="using:WinUI.LiquidGlass"
    mc:Ignorable="d">

    <Grid ActualThemeChanged="OnActualThemeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <cwc:SwitchPresenter
                x:Name="GlassPresenter_871"
                Grid.Column="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:Button"
                Visibility="{x:Bind GoBackButton.Visibility, Mode=OneWay}"
                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>0</x:Int32>
                    </cwc:Case.Value>
                    <Button
                        x:Name="GoBackButton"
                        MinWidth="44"
                        Command="{x:Bind GoBackCommand}"
                        DataContext="{x:Bind GlassPresenter_871.DataContext, Mode=OneWay}"
                        FontSize="12"
                        RequestedTheme="{x:Bind GlassPresenter_871.ActualTheme, Mode=OneWay}"
                        Style="{StaticResource NavigationBackButtonSmallStyle}"/>
                </cwc:Case>
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>1</x:Int32>
                    </cwc:Case.Value>
                    <wl:LiquidGlassButton
                        x:Name="GoBackButtonGlass"
                        Width="{x:Bind GoBackButton.Width, Mode=OneWay}"
                        Height="{x:Bind GoBackButton.Height, Mode=OneWay}"
                        MinWidth="{x:Bind GoBackButton.MinWidth, Mode=OneWay}"
                        MinHeight="{x:Bind GoBackButton.MinHeight, Mode=OneWay}"
                        MaxWidth="{x:Bind GoBackButton.MaxWidth, Mode=OneWay}"
                        MaxHeight="{x:Bind GoBackButton.MaxHeight, Mode=OneWay}"
                        Padding="{x:Bind GoBackButton.Padding, Mode=OneWay}"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        shuxcth:ControlMaterialState.NativeControl="{x:Bind GoBackButton, Mode=OneWay}"
                        BorderThickness="{x:Bind GoBackButton.BorderThickness, Mode=OneWay}"
                        Command="{x:Bind GoBackButton.Command, Mode=OneWay}"
                        CommandParameter="{x:Bind GoBackButton.CommandParameter, Mode=OneWay}"
                        Content="{x:Bind GoBackButton.Content, Mode=OneWay}"
                        FlowDirection="{x:Bind GoBackButton.FlowDirection, Mode=OneWay}"
                        FontFamily="{x:Bind GoBackButton.FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind GoBackButton.FontSize, Mode=OneWay}"
                        FontStyle="{x:Bind GoBackButton.FontStyle, Mode=OneWay}"
                        FontWeight="{x:Bind GoBackButton.FontWeight, Mode=OneWay}"
                        Foreground="{x:Bind GoBackButton.Foreground, Mode=OneWay}"
                        IsEnabled="{x:Bind GoBackButton.IsEnabled, Mode=OneWay}"
                        Style="{StaticResource NavigationBackButtonSmallStyle}"
                        shuxcth:ControlMaterialState.UsesCompiledEnabledBinding="True"/>
                </cwc:Case>
            </cwc:SwitchPresenter>
            <cwc:SwitchPresenter
                x:Name="GlassPresenter_1144"
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:Button"
                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>0</x:Int32>
                    </cwc:Case.Value>
                    <Button
                        MinWidth="44"
                        Command="{x:Bind RefreshCommand}"
                        Content="&#xE72C;"
                        FontSize="12"
                        Style="{StaticResource NavigationBackButtonSmallStyle}"/>
                </cwc:Case>
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>1</x:Int32>
                    </cwc:Case.Value>
                    <wl:LiquidGlassButton
                        MinWidth="44"
                        shuxcth:ControlMaterialState.IsManaged="True"
                        Command="{x:Bind RefreshCommand}"
                        Content="&#xE72C;"
                        FontSize="12"
                        Style="{StaticResource NavigationBackButtonSmallStyle}"/>
                </cwc:Case>
            </cwc:SwitchPresenter>
            <Grid
                x:Name="TitleArea"
                Grid.Column="2"
                IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="DocumentTitle"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"/>
            </Grid>
        </Grid>
        <TextBlock
            x:Name="WebView2LoadFailedHintText"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{shuxm:ResourceString Name=ViewWebView2WindowLoadFailedHint}"
            Visibility="Collapsed"/>
        <WebView2
            x:Name="WebView"
            Grid.Row="1"
            DefaultBackgroundColor="Transparent"/>
    </Grid>
</Window>

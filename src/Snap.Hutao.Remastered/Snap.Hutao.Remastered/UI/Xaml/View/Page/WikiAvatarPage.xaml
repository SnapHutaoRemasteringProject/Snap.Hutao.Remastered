<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.WikiAvatarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shmma="using:Snap.Hutao.Remastered.Model.Metadata.Avatar"
    xmlns:shmmi="using:Snap.Hutao.Remastered.Model.Metadata.Item"
    xmlns:shux="using:Snap.Hutao.Remastered.UI.Xaml"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxca="using:Snap.Hutao.Remastered.UI.Xaml.Control.AutoSuggestBox"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcp="using:Snap.Hutao.Remastered.UI.Xaml.Control.Panel"
    xmlns:shuxct="using:Snap.Hutao.Remastered.UI.Xaml.Control.TextBlock"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxdc="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter"
    xmlns:shuxdcs="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter.Specialized"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shuxvs="using:Snap.Hutao.Remastered.UI.Xaml.View.Specialized"
    xmlns:shvc="using:Snap.Hutao.Remastered.ViewModel.Complex"
    xmlns:shvw="using:Snap.Hutao.Remastered.ViewModel.Wiki"
    xmlns:wl="using:WinUI.LiquidGlass"
    x:Name="RootPage"
    d:DataContext="{d:DesignInstance Type=shvw:WikiAvatarViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>
    <Page.Resources>
        <shuxdc:VisibilityToObjectConverter
            x:Key="VisibilityToColumnSpanConverter"
            CollapsedValue="{shuxm:Int32 Value=2}"
            VisibleValue="{shuxm:Int32 Value=1}"/>

        <shuxdcs:RangedInt32Converter x:Key="RangedInt32Converter"/>

        <shux:BindingProxy x:Key="BindingProxy" DataContext="{x:Bind ((shvw:WikiAvatarViewModel)DataContext), Mode=OneWay}"/>

        <DataTemplate x:Key="SkillDataTemplate" x:DataType="shmma:ProudSkill">
            <Grid Margin="0,16,0,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="{x:Bind ProudSelector.Visibility, Converter={StaticResource VisibilityToColumnSpanConverter}, Mode=OneWay}">
                    <Border
                        Padding="8,4"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource SpecialDescriptionBaseBackgroundColor}"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource SpecialDescriptionBaseBorderColor}"/>
                        </Border.BorderBrush>
                        <shuxct:DescriptionTextBlock
                            VerticalAlignment="Top"
                            Description="{x:Bind Description, Mode=OneWay}"
                            LinkContext="{Binding DataContext.LinkContext, Source={StaticResource BindingProxy}}"
                            TextStyle="{StaticResource BodyTextBlockStyle}"/>
                    </Border>
                    <shuxct:DescriptionTextBlock
                        VerticalAlignment="Top"
                        Description="{x:Bind Description, Mode=OneWay}"
                        LinkContext="{Binding DataContext.LinkContext, Source={StaticResource BindingProxy}}"
                        TextStyle="{StaticResource BodyTextBlockStyle}"
                        Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityRevertConverter}, Mode=OneWay}"/>
                    <Border
                        Margin="0,8,0,0"
                        Padding="8,4"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource SpecialDescriptionSpecialBackgroundColor}"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource SpecialDescriptionSpecialBorderColor}"/>
                        </Border.BorderBrush>
                        <shuxct:DescriptionTextBlock
                            VerticalAlignment="Top"
                            Description="{x:Bind SpecialDescription, Mode=OneWay}"
                            LinkContext="{Binding DataContext.LinkContext, Source={StaticResource BindingProxy}}"
                            TextStyle="{StaticResource BodyTextBlockStyle}"/>
                    </Border>
                </StackPanel>
                <shuxvs:DescParamComboBox
                    x:Name="ProudSelector"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    PreferredSelectedIndex="9"
                    Source="{x:Bind Proud, Mode=OneWay, Converter={StaticResource DescParamDescriptor}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TalentDataTemplate" x:DataType="shmma:Skill">
            <StackPanel Margin="0,12,0,0">
                <Border
                    Padding="8,4"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                    <Border.Background>
                        <SolidColorBrush Color="{StaticResource SpecialDescriptionBaseBackgroundColor}"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="{StaticResource SpecialDescriptionBaseBorderColor}"/>
                    </Border.BorderBrush>
                    <shuxct:DescriptionTextBlock
                        Description="{x:Bind Description, Mode=OneWay}"
                        LinkContext="{Binding DataContext.LinkContext, Source={StaticResource BindingProxy}}"
                        TextStyle="{StaticResource BodyTextBlockStyle}"/>
                </Border>
                <shuxct:DescriptionTextBlock
                    Description="{x:Bind Description, Mode=OneWay}"
                    LinkContext="{Binding DataContext.LinkContext, Source={StaticResource BindingProxy}}"
                    TextStyle="{StaticResource BodyTextBlockStyle}"
                    Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityRevertConverter}, Mode=OneWay}"/>
                <Border
                    Margin="0,8,0,0"
                    Padding="8,4"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{x:Bind SpecialDescription, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                    <Border.Background>
                        <SolidColorBrush Color="{StaticResource SpecialDescriptionSpecialBackgroundColor}"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="{StaticResource SpecialDescriptionSpecialBorderColor}"/>
                    </Border.BorderBrush>
                    <shuxct:DescriptionTextBlock
                        Description="{x:Bind SpecialDescription, Mode=OneWay}"
                        LinkContext="{Binding DataContext.LinkContext, Source={StaticResource BindingProxy}}"
                        TextStyle="{StaticResource BodyTextBlockStyle}"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TokenTemplate" x:DataType="shuxca:SearchToken">
            <Grid Height="22" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Ellipse
                    Grid.Column="0"
                    Width="12"
                    Height="12"
                    Margin="1,1,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Visibility="{x:Bind Quality, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{x:Bind QualityColor}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <shuxci:CachedImage
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    Margin="-3,2,7,0"
                    ShowAsMonoChrome="True"
                    Source="{x:Bind IconUri, Mode=OneTime}"
                    Visibility="{x:Bind IconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}"/>
                <shuxci:CachedImage
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    Margin="-4,-2,8,2"
                    Source="{x:Bind SideIconUri, Mode=OneTime}"
                    Visibility="{x:Bind SideIconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneTime}"/>
                <TextBlock
                    Grid.Column="1"
                    Height="20"
                    VerticalAlignment="Center"
                    Text="{x:Bind Value, Mode=OneTime}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AvatarListTemplate" x:DataType="shmma:Avatar">
            <Grid>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Command="{Binding ElementName=RootPage, Path=DataContext.CultivateCommand}"
                            CommandParameter="{x:Bind Mode=OneWay}"
                            Text="{shuxm:ResourceString Name=ViewPageWiKiGeneralAddToDevPlanButtonLabel}"/>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <shuxci:CachedImage
                    Grid.Column="0"
                    Width="48"
                    Height="48"
                    Margin="0,0,12,12"
                    Source="{x:Bind SideIcon, Converter={StaticResource AvatarSideIconConverter}, Mode=OneWay}"/>
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Text="{x:Bind Name, Mode=OneWay}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CultivationItemTemplate" x:DataType="shmmi:Material">
            <shuxcc:HorizontalCard>
                <shuxcc:HorizontalCard.Left>
                    <shuxc:ItemIcon
                        Width="40"
                        Height="40"
                        Icon="{x:Bind Icon, Converter={StaticResource ItemIconConverter}, Mode=OneWay}"
                        Quality="{x:Bind RankLevel, Mode=OneWay}"/>
                </shuxcc:HorizontalCard.Left>
                <shuxcc:HorizontalCard.Right>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{x:Bind Name, Mode=OneWay}"/>
                </shuxcc:HorizontalCard.Right>
            </shuxcc:HorizontalCard>
        </DataTemplate>

        <DataTemplate x:Key="CollocationTemplate" x:DataType="shvc:CollocationView">
            <shuxcc:HorizontalCard>
                <shuxcc:HorizontalCard.Left>
                    <shuxc:ItemIcon
                        Width="48"
                        Height="48"
                        Icon="{x:Bind Icon, Mode=OneWay}"
                        Quality="{x:Bind Quality, Mode=OneWay}"/>
                </shuxcc:HorizontalCard.Left>
                <shuxcc:HorizontalCard.Right>
                    <StackPanel Margin="8,0,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Rate, Mode=OneWay}"/>
                            <shuxct:RateDeltaTextBlock
                                Opacity="0.7"
                                Text="{x:Bind RateDelta, Mode=OneWay}"
                                TextStyle="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </shuxcc:HorizontalCard.Right>
            </shuxcc:HorizontalCard>
        </DataTemplate>

        <DataTemplate x:Key="CollocationReliquaryTemplate" x:DataType="shvc:ReliquarySetView">
            <shuxcc:HorizontalCard>
                <shuxcc:HorizontalCard.Left>
                    <cwc:SwitchPresenter Value="{x:Bind Icons.Count, Mode=OneWay}">
                        <cwc:Case IsDefault="True">
                            <cwc:Case.Value>
                                <x:Int32>0</x:Int32>
                            </cwc:Case.Value>
                            <Grid>
                                <shuxc:ItemIcon
                                    Width="48"
                                    Height="48"
                                    Icon="{StaticResource UI_ItemIcon_None}"
                                    Quality="QUALITY_ORANGE"/>
                            </Grid>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>1</x:Int32>
                            </cwc:Case.Value>
                            <Grid>
                                <shuxc:ItemIcon
                                    Width="48"
                                    Height="48"
                                    Icon="{Binding Icons[0]}"
                                    Quality="QUALITY_ORANGE"/>
                            </Grid>
                        </cwc:Case>
                        <cwc:Case>
                            <cwc:Case.Value>
                                <x:Int32>2</x:Int32>
                            </cwc:Case.Value>
                            <Grid>
                                <shuxc:ItemIcon
                                    Width="48"
                                    Height="48"
                                    Quality="QUALITY_ORANGE"/>
                                <shuxci:CachedImage
                                    Width="32"
                                    Margin="2,2,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Source="{Binding Icons[0]}"/>
                                <shuxci:CachedImage
                                    Width="32"
                                    Margin="0,0,2,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Source="{Binding Icons[1]}"/>
                            </Grid>
                        </cwc:Case>
                    </cwc:SwitchPresenter>
                </shuxcc:HorizontalCard.Left>
                <shuxcc:HorizontalCard.Right>
                    <StackPanel Margin="8,0,8,0" HorizontalAlignment="Left">
                        <TextBlock
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Rate, Mode=OneWay}"/>
                            <shuxct:RateDeltaTextBlock
                                Opacity="0.7"
                                Text="{x:Bind RateDelta, Mode=OneWay}"
                                TextStyle="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </shuxcc:HorizontalCard.Right>
            </shuxcc:HorizontalCard>
        </DataTemplate>

        <DataTemplate x:Key="CostumeTemplate" x:DataType="shmma:Costume">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <shuxci:CachedImage
                    Width="80"
                    Height="80"
                    Margin="0,0,16,0"
                    Source="{StaticResource UI_AvatarIcon_Costume_Card}"/>
                <shuxci:CachedImage
                    Grid.Column="0"
                    Width="80"
                    Height="80"
                    Margin="0,0,16,0"
                    Source="{x:Bind FrontIcon, Converter={StaticResource AvatarCardConverter}, Mode=OneWay}"/>
                <StackPanel Grid.Column="1" Margin="0,0,16,-4">
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}"/>
                    <shuxct:DescriptionTextBlock
                        Margin="0,8,0,16"
                        Description="{x:Bind Description, Mode=OneWay}"
                        TextStyle="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FetterStoryTemplate" x:DataType="shmma:Fetter">
            <cwc:SettingsCard Padding="16,8,8,8" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                <cwc:SettingsCard.Header>
                    <shuxct:DescriptionTextBlock Description="{x:Bind Title, Mode=OneWay}" TextStyle="{StaticResource BaseTextBlockStyle}"/>
                </cwc:SettingsCard.Header>
                <cwc:SettingsCard.Description>
                    <shuxct:DescriptionTextBlock Description="{x:Bind Context, Mode=OneWay}" TextStyle="{StaticResource CaptionTextBlockStyle}"/>
                </cwc:SettingsCard.Description>
            </cwc:SettingsCard>
        </DataTemplate>
        <DataTemplate x:Key="AvatarGridTemplate" x:DataType="shmma:Avatar">
            <shuxcc:VerticalCard Width="82">
                <shuxcc:VerticalCard.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Command="{Binding ElementName=RootPage, Path=DataContext.CultivateCommand}"
                            CommandParameter="{x:Bind Mode=OneWay}"
                            Text="{shuxm:ResourceString Name=ViewPageWiKiGeneralAddToDevPlanButtonLabel}"/>
                    </MenuFlyout>
                </shuxcc:VerticalCard.ContextFlyout>
                <shuxcc:VerticalCard.Top>
                    <shuxc:ItemIcon Icon="{x:Bind Icon, Converter={StaticResource AvatarIconConverter}, Mode=OneWay}" Quality="{x:Bind Quality, Mode=OneWay}"/>
                </shuxcc:VerticalCard.Top>
                <shuxcc:VerticalCard.Bottom>
                    <TextBlock
                        Margin="2,0"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"/>
                </shuxcc:VerticalCard.Bottom>
            </shuxcc:VerticalCard>
        </DataTemplate>
    </Page.Resources>

    <shuxc:StandardView ShowCondition="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars, Converter={StaticResource EmptyObjectToBoolConverter}, Mode=OneWay}">
        <shuxc:StandardView.EmptyContent>
            <shuxc:Loading IsLoading="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars, Converter={StaticResource EmptyObjectToBoolRevertConverter}, Mode=OneWay}" Style="{ThemeResource DefaultLoadingViewStyle}"/>
        </shuxc:StandardView.EmptyContent>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                    <CommandBar
                        Grid.Row="0"
                        BorderBrush="{x:Null}"
                        BorderThickness="0"
                        DefaultLabelPosition="Right">
                        <CommandBar.Content>
                            <shuxc:LayoutSwitch
                                x:Name="ItemsPanelSelector"
                                Margin="8,8,0,0"
                                LocalSettingKeySuffixForCurrent="WikiAvatarPage.Avatars"/>
                        </CommandBar.Content>
                        <AppBarElementContainer>
                            <shuxca:AutoSuggestTokenBox
                                Width="600"
                                Height="44"
                                Margin="6,-2,6,6"
                                HorizontalAlignment="Right"
                                VerticalContentAlignment="Center"
                                AvailableTokens="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).SearchData.AvailableTokens, Mode=OneWay}"
                                FilterCommand="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).FilterCommand, Mode=OneWay}"
                                ItemsSource="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).SearchData.FilterTokens, Mode=OneWay}"
                                MaximumTokens="5"
                                PlaceholderText="{shuxm:ResourceString Name=ViewPageWiKiAvatarAutoSuggestBoxPlaceHolder}"
                                QueryIcon="{cw:FontIconSource Glyph=&#xE721;}"
                                Style="{StaticResource DefaultAutoSuggestTokenBoxStyle}"
                                SuggestedItemTemplate="{StaticResource TokenTemplate}"
                                SuggestedItemsSource="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).SearchData.AvailableTokens.Values, Mode=OneWay}"
                                Text="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).SearchData.FilterToken, Mode=TwoWay}"
                                TokenItemTemplate="{StaticResource TokenTemplate}"/>
                        </AppBarElementContainer>
                        <AppBarButton
                            Command="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).CultivateCommand, Mode=OneWay}"
                            CommandParameter="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem, Mode=OneWay}"
                            Icon="{shuxm:FontIcon Glyph=&#xE8EF;}"
                            Label="{shuxm:ResourceString Name=ViewPageWiKiGeneralAddToDevPlanButtonLabel}"/>
                    </CommandBar>
                </Border>
            </Border>

            <cwc:SwitchPresenter
                Grid.Row="1"
                ContentTransitions="{ThemeResource EntranceThemeTransitions}"
                Value="{x:Bind ItemsPanelSelector.Current, Mode=OneWay}">
                <cwc:Case Value="List">
                    <Border Margin="16,0,16,16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                        <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                            <SplitView
                                DisplayMode="Inline"
                                IsPaneOpen="True"
                                OpenPaneLength="{StaticResource CompatSplitViewOpenPaneLength}"
                                shuxcth:MaterialBackground.NativePaneBrush="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                shuxcth:MaterialBackground.GlassPaneBrush="{ThemeResource HutaoSurfaceBrush}">
                                <SplitView.Pane>
                                    <ListView
                                        Padding="{ThemeResource ListViewInSplitPanePadding}"
                                        ItemTemplate="{StaticResource AvatarListTemplate}"
                                        ItemsSource="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars, Mode=OneWay}"
                                        SelectedItem="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <mxi:Interaction.Behaviors>
                                            <shuxb:SelectedItemInViewBehavior/>
                                        </mxi:Interaction.Behaviors>
                                    </ListView>
                                </SplitView.Pane>
                                <SplitView.Content>
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Visibility="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem, Converter={StaticResource EmptyObjectToVisibilityRevertConverter}, Mode=OneWay}">
                                            <shuxci:CachedImage
                                                Height="120"
                                                MinWidth="{ThemeResource SettingsCardContentControlMinWidth}"
                                                Source="{StaticResource UI_EmotionIcon89}"/>
                                            <TextBlock
                                                Margin="0,5,0,21"
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                Text="{shuxm:ResourceString Name=ControlAutoSuggestBoxNotFoundValue}"/>
                                        </StackPanel>
                                        <ScrollViewer
                                            Padding="16,0"
                                            shuxc:ScrollViewerHelper.ScrollToTopAssociatedObject="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem, Mode=OneWay}"
                                            Visibility="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                                            <StackPanel
                                                Margin="0,16"
                                                HorizontalAlignment="Left"
                                                Spacing="16">
                                                <StackPanel.ChildrenTransitions>
                                                    <EntranceThemeTransition FromVerticalOffset="50"/>
                                                    <RepositionThemeTransition IsStaggeringEnabled="False"/>
                                                </StackPanel.ChildrenTransitions>
                                                <!--  简介  -->
                                                <Grid Style="{ThemeResource GridShimmerStyle}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="16">
                                                        <Grid Margin="0,0,0,12" ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="auto"/>
                                                                <ColumnDefinition Width="auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <shuxci:CachedImage
                                                                Grid.Column="0"
                                                                Width="32"
                                                                Height="32"
                                                                HorizontalAlignment="Left"
                                                                ShowAsMonoChrome="True"
                                                                Source="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.FetterInfo.VisionBefore, Converter={StaticResource ElementNameIconConverter}, Mode=OneWay}"/>
                                                            <shuxci:CachedImage
                                                                Grid.Column="1"
                                                                Width="32"
                                                                Height="32"
                                                                ShowAsMonoChrome="True"
                                                                Source="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.Weapon, Converter={StaticResource WeaponTypeIconConverter}, Mode=OneWay}"/>
                                                        </Grid>
                                                        <Border Style="{ThemeResource BorderCardStyle}">
                                                            <shuxc:ItemIcon
                                                                Width="128"
                                                                Height="128"
                                                                Icon="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.Icon, Converter={StaticResource AvatarIconConverter}, Mode=OneWay}"
                                                                Quality="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.Quality, Mode=OneWay}"/>
                                                        </Border>

                                                    </StackPanel>

                                                    <StackPanel
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Margin="16">
                                                        <StackPanel Margin="0,0,0,2" Orientation="Horizontal">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                                Text="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.Name, Mode=OneWay}"
                                                                TextWrapping="NoWrap"/>
                                                            <TextBlock
                                                                Margin="24,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                                Text="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.FetterInfo.Title, Mode=OneWay}"
                                                                TextWrapping="NoWrap"/>
                                                        </StackPanel>

                                                        <TextBlock
                                                            Opacity="0.7"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.FetterInfo.Detail, Mode=OneWay}"
                                                            TextWrapping="NoWrap"/>

                                                        <cwc:UniformGrid
                                                            Margin="0,16,0,0"
                                                            ColumnSpacing="6"
                                                            Columns="4">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageWiKiAvatarDateofBirthTitle}"/>
                                                                <TextBlock
                                                                    Margin="0,6,0,0"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.FetterInfo.BirthFormatted, Mode=OneWay}"
                                                                    TextWrapping="NoWrap"/>
                                                            </StackPanel>
                                                            <StackPanel>

<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.HutaoPassportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwb="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvh="using:Snap.Hutao.Remastered.ViewModel.HutaoPassport"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance shvh:HutaoPassportViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind DataContext.LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <ScrollViewer>
        <StackPanel Padding="16" Spacing="16">
            <Border VerticalAlignment="Top" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                    <StackPanel Spacing="{ThemeResource SettingsCardSpacing}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="{ThemeResource SettingsCardSpacing}">
                                <cwc:SettingsCard
                                    Description="{x:Bind DataContext.HutaoUserOptions.UserName, Mode=OneWay}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE716;}">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <wl:LiquidGlassButton
                                            Visibility="{x:Bind DataContext.HutaoUserOptions.IsLoggedIn, Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}"
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            Command="{x:Bind DataContext.LoginCommand, Mode=OneWay}"
                                            Content="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportLoginAction}"
                                            Style="{ThemeResource SettingButtonStyle}"/>
                                        <wl:LiquidGlassButton
                                            Visibility="{x:Bind DataContext.HutaoUserOptions.IsLoggedIn, Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}"
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            Command="{x:Bind DataContext.RegisterCommand, Mode=OneWay}"
                                            Content="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportRegisterAction}"
                                            Style="{ThemeResource SettingButtonStyle}"/>
                                        <wl:LiquidGlassButton
                                            Visibility="{x:Bind DataContext.HutaoUserOptions.IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            Command="{x:Bind DataContext.RefreshUserInfoCommand, Mode=OneWay}"
                                            Content="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportRefreshAction}"
                                            Style="{ThemeResource SettingButtonStyle}"/>
                                        <wl:LiquidGlassButton
                                            Visibility="{x:Bind DataContext.HutaoUserOptions.IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            Command="{x:Bind DataContext.LogoutCommand, Mode=OneWay}"
                                            Content="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportLogoutAction}"
                                            Style="{ThemeResource SettingButtonStyle}"/>
                                    </StackPanel>
                                </cwc:SettingsCard>
                                <cwc:SettingsCard
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    Description="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportLicensedDeveloperDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportLicensedDeveloperHeader}"
                                    Visibility="{x:Bind DataContext.HutaoUserOptions.IsDeveloper, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <wl:LiquidGlassButton
                                        shuxcth:ControlMaterialState.IsManaged="True"
                                        Command="{x:Bind DataContext.OpenTestPageCommand, Mode=OneWay}"
                                        Content="TEST"
                                        Style="{ThemeResource SettingButtonStyle}"/>
                                </cwc:SettingsCard>
                                <cwc:SettingsCard
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    Description="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportMaintainerDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportMaintainerHeader}"
                                    Visibility="{x:Bind DataContext.HutaoUserOptions.IsMaintainer, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                                <cwc:SettingsCard
                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    Description="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportDangerZoneDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportDangerZoneHeader}">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <wl:LiquidGlassButton
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            Command="{x:Bind DataContext.ResetUsernameCommand, Mode=OneWay}"
                                            Content="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportResetUserNameAction}"
                                            Style="{ThemeResource SettingButtonStyle}"/>
                                        <wl:LiquidGlassButton
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            Command="{x:Bind DataContext.ResetPasswordCommand, Mode=OneWay}"
                                            Content="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportResetPasswordAction}"
                                            Style="{ThemeResource SettingButtonStyle}"/>
                                        <wl:LiquidGlassButton
                                            shuxcth:ControlMaterialState.IsManaged="True"
                                            Command="{x:Bind DataContext.UnregisterCommand, Mode=OneWay}"
                                            Content="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportUnregisterAction}"
                                            Style="{ThemeResource SettingButtonStyle}"/>
                                    </StackPanel>
                                </cwc:SettingsCard>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Border>

            <Border VerticalAlignment="Top" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                    <StackPanel Spacing="{ThemeResource SettingsCardSpacing}">
                        <InfoBar
                            Title="{shuxm:ResourceString Name=ViewPageHutaoPassportGachaLogCloudHeader}"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{shuxm:ResourceString Name=ViewPageHutaoPassportGachaLogCloudDescription}"/>
                        <cwc:SettingsCard Description="{x:Bind DataContext.HutaoUserOptions.CloudExpireAt, Mode=OneWay}" Header="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportGachaLogExpiredAtHeader}">
                            <wl:LiquidGlassButton
                                Visibility="Collapsed"
                                shuxcth:ControlMaterialState.IsManaged="True"
                                Content="{shuxm:ResourceString Name=ViewPageHutaoPassportSponsorAction}"
                                Style="{ThemeResource SettingButtonStyle}">
                                <mxi:Interaction.Behaviors>
                                    <mxi:EventTriggerBehavior EventName="Click">
                                        <cwb:NavigateToUriAction NavigateUri="https://afdian.com/item/80d3b9decf9011edb5f452540025c377"/>
                                    </mxi:EventTriggerBehavior>
                                </mxi:Interaction.Behaviors>
                            </wl:LiquidGlassButton>
                        </cwc:SettingsCard>
                        <InfoBar
                            Title="{shuxm:ResourceString Name=ViewPageHutaoPassportCDNCloudHeader}"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{shuxm:ResourceString Name=ViewPageHutaoPassportCDNCloudDescription}"
                            Visibility="Collapsed"/>
                        <cwc:SettingsCard
                            Description="{x:Bind DataContext.HutaoUserOptions.CdnExpireAt, Mode=OneWay}"
                            Header="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportCdnExpiredAtHeader}"
                            Visibility="Collapsed">
                            <wl:LiquidGlassButton
                                shuxcth:ControlMaterialState.IsManaged="True"
                                Content="{shuxm:ResourceString Name=ViewPageHutaoPassportSponsorAction}"
                                Style="{ThemeResource SettingButtonStyle}">
                                <mxi:Interaction.Behaviors>
                                    <mxi:EventTriggerBehavior EventName="Click">
                                        <cwb:NavigateToUriAction NavigateUri="https://afdian.com/item/274f5a7cbe9911efab6552540025c377"/>
                                    </mxi:EventTriggerBehavior>
                                </mxi:Interaction.Behaviors>
                            </wl:LiquidGlassButton>
                        </cwc:SettingsCard>
                        <cwc:SettingsCard
                            Command="{x:Bind DataContext.UseRedeemCodeCommand, Mode=OneWay}"
                            Description="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportRedeemCodeDescription}"
                            Header="{shuxm:ResourceString Name=ViewPageSettingHutaoPassportRedeemCodeHeader}"
                            IsClickEnabled="True"/>
                    </StackPanel>
                </Border>
            </Border>
        </StackPanel>

    </ScrollViewer>
</shuxc:ScopedPage>

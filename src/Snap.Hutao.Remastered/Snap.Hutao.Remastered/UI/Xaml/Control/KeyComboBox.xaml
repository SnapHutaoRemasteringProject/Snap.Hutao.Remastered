<UserControl
    x:Class="Snap.Hutao.Remastered.UI.Xaml.Control.KeyComboBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:wl="using:WinUI.LiquidGlass">
    <wl:LiquidGlassComboBox
        x:Name="KeySelector"
        MinWidth="120"
        VerticalAlignment="Center"
        shuxcth:ComboBoxPopupLifetime.IsManaged="True"
        shuxcth:ControlMaterialState.IsManaged="True"
        DisplayMemberPath="Name"
        Header="{x:Bind Header, Mode=OneWay}"
        ItemsSource="{x:Bind Keys, Mode=OneWay}"
        SelectedItem="{x:Bind SelectedItem, Mode=TwoWay}"/>
</UserControl>

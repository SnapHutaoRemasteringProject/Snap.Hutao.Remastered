<shuxcth:MaterialCardButton
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Card.CalendarCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwconv="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxci="using:Snap.Hutao.Remastered.UI.Xaml.Control.Image"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvc="using:Snap.Hutao.Remastered.ViewModel.Calendar"
    xmlns:wl="using:WinUI.LiquidGlass"
    Height="{ThemeResource HomeAdaptiveCardHeight}"
    Padding="0"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    d:DataContext="{d:DesignInstance shvc:CalendarViewModel}"
    Background="Transparent"
    BorderBrush="{x:Null}"
    BorderThickness="0"
    Command="{x:Bind ((shvc:CalendarViewModel)DataContext).NavigateCommand, Mode=OneWay}"
    mc:Ignorable="d">

    <shuxcth:MaterialCardButton.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <cwconv:BoolToObjectConverter x:Key="BoolToBrushSelector" FalseValue="{StaticResource ControlAltFillColorSecondaryBrush}">
                        <cwconv:BoolToObjectConverter.TrueValue>
                            <SolidColorBrush Color="#206A890A"/>
                        </cwconv:BoolToObjectConverter.TrueValue>
                    </cwconv:BoolToObjectConverter>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <cwconv:BoolToObjectConverter x:Key="BoolToBrushSelector" FalseValue="{StaticResource ControlAltFillColorSecondaryBrush}">
                        <cwconv:BoolToObjectConverter.TrueValue>
                            <SolidColorBrush Color="#20A5D610"/>
                        </cwconv:BoolToObjectConverter.TrueValue>
                    </cwconv:BoolToObjectConverter>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!--  ReSharper disable once Xaml.RedundantResource  -->
            <Thickness x:Key="DefaultSegmentedItemContentPadding">0</Thickness>
            <cwconv:BoolToObjectConverter x:Key="BoolToOpacityConverter">
                <cwconv:BoolToObjectConverter.TrueValue>
                    <x:Double>1</x:Double>
                </cwconv:BoolToObjectConverter.TrueValue>
                <cwconv:BoolToObjectConverter.FalseValue>
                    <x:Double>0.3</x:Double>
                </cwconv:BoolToObjectConverter.FalseValue>
            </cwconv:BoolToObjectConverter>
        </ResourceDictionary>
    </shuxcth:MaterialCardButton.Resources>

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shvc:CalendarViewModel)DataContext).LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Grid
        Padding="12"
        RowSpacing="6"
        Visibility="{x:Bind ((shvc:CalendarViewModel)DataContext).IsInitialized, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <cwc:Segmented
            Grid.Row="0"
            Height="48"
            HorizontalAlignment="Stretch"
            ItemsSource="{x:Bind ((shvc:CalendarViewModel)DataContext).WeekDays, Mode=OneWay}"
            Style="{ThemeResource DefaultSegmentedStyle}">
            <cwc:Segmented.ItemTemplate>
                <DataTemplate x:DataType="shvc:CalendarDay">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            Text="{x:Bind DayInMonth, Mode=OneWay}"/>
                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            Opacity="0.7"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind DayName, Mode=OneWay}"/>
                    </Grid>
                </DataTemplate>
            </cwc:Segmented.ItemTemplate>
        </cwc:Segmented>

        <Grid
            Grid.Row="1"
            DataContext="{x:Bind ((shvc:CalendarViewModel)DataContext).WeekDays.CurrentItem, FallbackValue={x:Null}, Mode=OneWay}"
            RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <shuxc:StandardView Grid.Row="0" ShowCondition="{x:Bind ((shvc:CalendarViewModel)DataContext).WeekDays.CurrentItem.BirthDayAvatars.IsEmpty, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                <shuxc:StandardView.EmptyContent>
                    <Border Padding="12" Style="{ThemeResource BorderShimmerStyle}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{shuxm:ResourceString Name=ViewCardCalendarNoBirthdayAvatarHint}"/>
                    </Border>
                </shuxc:StandardView.EmptyContent>
                <ItemsControl
                    HorizontalAlignment="Left"
                    ItemsPanel="{StaticResource WrapPanelSpacing6Template}"
                    ItemsSource="{x:Bind ((shvc:CalendarViewModel)DataContext).WeekDays.CurrentItem.BirthDayAvatars, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <shuxcc:HorizontalCard>
                                <shuxcc:HorizontalCard.Left>
                                    <shuxc:ItemIcon
                                        Width="32"
                                        Height="32"
                                        Icon="{Binding Icon}"
                                        Quality="{Binding Quality}"/>
                                </shuxcc:HorizontalCard.Left>
                                <shuxcc:HorizontalCard.Right>
                                    <TextBlock Margin="6,0" Text="{Binding Name}"/>
                                </shuxcc:HorizontalCard.Right>
                            </shuxcc:HorizontalCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </shuxc:StandardView>

            <Border
                Grid.Row="1"
                Padding="12"
                Style="{ThemeResource BorderShimmerStyle}"
                Visibility="{x:Bind ((shvc:CalendarViewModel)DataContext).WeekDays.CurrentItem.Materials.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{shuxm:ResourceString Name=ViewCardCalendarAllMaterialsHint}"/>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ((shvc:CalendarViewModel)DataContext).WeekDays.CurrentItem.Materials, Mode=OneWay}" Visibility="{x:Bind ((shvc:CalendarViewModel)DataContext).WeekDays.CurrentItem.Materials.IsEmpty, Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <cwc:UniformGrid
                                ColumnSpacing="4"
                                Columns="7"
                                RowSpacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <cwc:SwitchPresenter
                                x:Name="GlassPresenter_8182"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsTabStop="False"
                                Tag="LiquidGlass:Button"
                                Value="{Binding ButtonMaterial, Source={StaticResource ControlMaterialState}, Mode=OneWay}">
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>0</x:Int32>
                                    </cwc:Case.Value>
                                    <Button
                                        MinWidth="0"
                                        Padding="0"
                                        VerticalAlignment="Stretch"
                                        Background="{Binding Highlight, Converter={ThemeResource BoolToBrushSelector}}"
                                        Style="{ThemeResource ShimmerButtonStyle}">

                                        <shuxci:CachedImage
                                            Width="24"
                                            Height="24"
                                            Source="{Binding Inner.Icon, Converter={StaticResource ItemIconConverter}}"/>
                                        <Button.Flyout>
                                            <Flyout FlyoutPresenterStyle="{ThemeResource FlyoutPresenterPadding6Style}">
                                                <Grid RowSpacing="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>
                                                    <shuxcc:HorizontalCard Grid.Row="0">
                                                        <shuxcc:HorizontalCard.Left>
                                                            <shuxc:ItemIcon
                                                                Width="48"
                                                                Height="48"
                                                                Icon="{Binding Inner.Icon, Converter={StaticResource ItemIconConverter}}"
                                                                Quality="{Binding Inner.RankLevel}"/>
                                                        </shuxcc:HorizontalCard.Left>
                                                        <shuxcc:HorizontalCard.Right>
                                                            <StackPanel Margin="12,0">
                                                                <TextBlock Text="{Binding Inner.Name}"/>
                                                                <TextBlock
                                                                    Opacity="0.7"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{Binding Inner.TypeDescription}"/>
                                                            </StackPanel>
                                                        </shuxcc:HorizontalCard.Right>
                                                    </shuxcc:HorizontalCard>
                                                    <Border
                                                        Grid.Row="1"
                                                        HorizontalAlignment="Stretch"
                                                        Style="{ThemeResource BorderShimmerStyle}">
                                                        <ItemsControl ItemsPanel="{StaticResource UniformGridColumns4Spacing6Template}" ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <shuxc:ItemIcon
                                                                        Width="48"
                                                                        Height="48"
                                                                        Icon="{Binding Icon}"
                                                                        Opacity="{Binding Highlight, Converter={StaticResource BoolToOpacityConverter}}"
                                                                        Quality="{Binding Quality}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </Grid>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </cwc:Case>
                                <cwc:Case>
                                    <cwc:Case.Value>
                                        <x:Int32>1</x:Int32>
                                    </cwc:Case.Value>
                                    <wl:LiquidGlassButton
                                        MinWidth="0"
                                        Padding="0"
                                        VerticalAlignment="Stretch"
                                        shuxcth:ControlMaterialState.IsManaged="True"
                                        Style="{ThemeResource ShimmerButtonStyle}">

                                        <shuxci:CachedImage
                                            Width="24"
                                            Height="24"
                                            Source="{Binding Inner.Icon, Converter={StaticResource ItemIconConverter}}"/>
                                        <wl:LiquidGlassButton.Flyout>
                                            <Flyout FlyoutPresenterStyle="{ThemeResource FlyoutPresenterPadding6Style}">
                                                <Grid RowSpacing="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>
                                                    <shuxcc:HorizontalCard Grid.Row="0">
                                                        <shuxcc:HorizontalCard.Left>
                                                            <shuxc:ItemIcon
                                                                Width="48"
                                                                Height="48"
                                                                Icon="{Binding Inner.Icon, Converter={StaticResource ItemIconConverter}}"
                                                                Quality="{Binding Inner.RankLevel}"/>
                                                        </shuxcc:HorizontalCard.Left>
                                                        <shuxcc:HorizontalCard.Right>
                                                            <StackPanel Margin="12,0">
                                                                <TextBlock Text="{Binding Inner.Name}"/>
                                                                <TextBlock
                                                                    Opacity="0.7"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{Binding Inner.TypeDescription}"/>
                                                            </StackPanel>
                                                        </shuxcc:HorizontalCard.Right>
                                                    </shuxcc:HorizontalCard>
                                                    <Border
                                                        Grid.Row="1"
                                                        HorizontalAlignment="Stretch"
                                                        Style="{ThemeResource BorderShimmerStyle}">
                                                        <ItemsControl ItemsPanel="{StaticResource UniformGridColumns4Spacing6Template}" ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <shuxc:ItemIcon
                                                                        Width="48"
                                                                        Height="48"
                                                                        Icon="{Binding Icon}"
                                                                        Opacity="{Binding Highlight, Converter={StaticResource BoolToOpacityConverter}}"
                                                                        Quality="{Binding Quality}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </Grid>
                                            </Flyout>
                                        </wl:LiquidGlassButton.Flyout>
                                    </wl:LiquidGlassButton>
                                </cwc:Case>
                            </cwc:SwitchPresenter>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</shuxcth:MaterialCardButton>

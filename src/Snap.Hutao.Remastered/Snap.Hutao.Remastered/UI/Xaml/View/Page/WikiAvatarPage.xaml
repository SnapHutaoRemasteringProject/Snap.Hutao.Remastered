                                                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                                <TextBlock Text="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.TraceEffect.Name, Mode=OneWay}" TextWrapping="Wrap"/>
                                                                <TextBlock
                                                                    Margin="0,16,0,0"
                                                                    Text="{x:Bind ((shvw:WikiAvatarViewModel)DataContext).Avatars.CurrentItem.TraceEffect.Description, Mode=OneWay}"

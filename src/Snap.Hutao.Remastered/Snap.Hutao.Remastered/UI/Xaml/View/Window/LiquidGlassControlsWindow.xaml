<Window
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Window.LiquidGlassControlsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup">
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="DragRegion" Grid.Row="0">
            <TextBlock
                Margin="12,0,160,0"
                VerticalAlignment="Center"
                Text="{shuxm:ResourceString Name=LiquidGlassControlsWindowTitle}"/>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Margin="24,12,24,16"
            Spacing="12">
            <TextBlock Text="{shuxm:ResourceString Name=GlassControlsIntro}" TextWrapping="Wrap"/>
            <ComboBox shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                MinWidth="220"
                SelectedIndex="{x:Bind Settings.Value, Mode=OneWay}"
                SelectionChanged="MaterialChanged">
                <ComboBoxItem Content="{shuxm:ResourceString Name=GlassNativeMaterial}"/>
                <ComboBoxItem Content="{shuxm:ResourceString Name=ViewPageSettingControlMaterialLiquidGlass}"/>
            </ComboBox>
        </StackPanel>
        <Grid
            Grid.Row="2"
            Margin="24,0,24,24"
            ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <ItemsControl ItemsSource="{x:Bind Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="shuxcth:LiquidGlassProfile">
                            <cwc:SettingsCard Margin="0,0,8,6" Header="{x:Bind Name}">
                                <ToggleSwitch AutomationProperties.Name="{x:Bind Name}" IsOn="{x:Bind Enabled, Mode=TwoWay}"/>
                            </cwc:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{shuxm:ResourceString Name=GlassPreviewHeading}"/>
                <ComboBox shuxcth:ComboBoxPopupLifetime.IsManaged="True"
                    x:Name="TypeSelector"
                    MinWidth="230"
                    ItemsSource="{x:Bind Profiles}"
                    Loaded="SelectorLoaded"
                    SelectionChanged="TypeChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="shuxcth:LiquidGlassProfile">
                            <TextBlock Text="{x:Bind Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border x:Name="PreviewHost" CornerRadius="12"/>
                <TextBlock Text="{shuxm:ResourceString Name=GlassControlsPreviewHint}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PrototypeHost</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <SelfContained>true</SelfContained>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <CsWinRTGenerateProjection>false</CsWinRTGenerateProjection>
  </PropertyGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\AppIcon.ico" />
    <ProjectReference Include="..\..\Snap.Hutao.Plugin.Projection\Snap.Hutao.Plugin.Projection.csproj" />
    <ProjectReference Include="..\..\Snap.Hutao.Plugin.Packaging\Snap.Hutao.Plugin.Packaging.csproj" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <Compile Include="..\..\..\Snap.Hutao.Remastered\Snap.Hutao.Remastered\Service\Plugin\NativePluginLoader.cs" Link="Host\NativePluginLoader.cs" />
    <Compile Include="..\..\..\Snap.Hutao.Remastered\Snap.Hutao.Remastered\Service\Plugin\PluginHostContext.cs" Link="Host\PluginHostContext.cs" />
    <Compile Include="..\..\..\Snap.Hutao.Remastered\Snap.Hutao.Remastered\Service\Plugin\PluginResidency.cs" Link="Host\PluginResidency.cs" />
    <Compile Include="..\..\..\Snap.Hutao.Remastered\Snap.Hutao.Remastered\Service\Plugin\PluginSession.cs" Link="Host\PluginSession.cs" />
    <Compile Include="..\..\..\Snap.Hutao.Remastered\Snap.Hutao.Remastered\Service\Plugin\SettingStore.cs" Link="Host\SettingStore.cs" />
  </ItemGroup>
  <Target Name="VerifyPrototypeResources" AfterTargets="Publish">
    <Error Condition="!Exists('$(PublishDir)resources.pri')" Text="PrototypeHost publish is missing resources.pri. Inspect PRI generation before running." />
  </Target>
</Project>

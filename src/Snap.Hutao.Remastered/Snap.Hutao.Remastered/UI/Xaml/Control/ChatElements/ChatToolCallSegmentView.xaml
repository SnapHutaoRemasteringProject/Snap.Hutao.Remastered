<UserControl
    x:Class="Snap.Hutao.Remastered.UI.Xaml.Control.ChatElements.ChatToolCallSegmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:snsao="using:Snap.Hutao.Remastered.Service.AI.Observables"
    xmlns:snuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.ChatElements"
    xmlns:snuxd="using:Snap.Hutao.Remastered.UI.Xaml.Data.AI">

    <UserControl.Resources>
        <snuxd:EmptyObjectToVisibilityConverter x:Key="ContentVisibilityConverter" />
        <snuxd:EmptyStringToVisibilityConverter x:Key="TextVisibilityConverter" />

        <DataTemplate x:Key="FunctionToolCallTemplate" x:DataType="snsao:ObservableFunctionCallContent">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xEC7A;" />
                    <FontIcon
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xE76C;" />
                    <TextBlock
                        Grid.Column="2"
                        Opacity="0.8"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding Name}" />
                    <TextBlock
                        Grid.Column="3"
                        Opacity="0.6"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding Arguments}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CodeInterpreterToolCallTemplate" x:DataType="snsao:ObservableCodeInterpreterToolCallContent">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xEC7A;" />
                        <FontIcon
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xE943;" />
                        <TextBlock
                            Grid.Column="2"
                            Opacity="0.7"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding CallId}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Inputs}" Visibility="{Binding Inputs, Converter={StaticResource ContentVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <snuxcc:ChatObjectSegmentView Value="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ImageGenerationToolCallTemplate" x:DataType="snsao:ObservableImageGenerationToolCallContent">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xEC7A;" />
                    <FontIcon
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xEB9F;" />
                    <TextBlock
                        Grid.Column="2"
                        Opacity="0.7"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding CallId}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="McpServerToolCallTemplate" x:DataType="snsao:ObservableMcpServerToolCallContent">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xEC7A;" />
                    <FontIcon
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xE8B7;" />
                    <TextBlock
                        Grid.Column="2"
                        Opacity="0.8"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding Name}" />
                    <TextBlock
                        Grid.Column="3"
                        Opacity="0.6"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding ServerName}"
                        Visibility="{Binding ServerName, Converter={StaticResource TextVisibilityConverter}}" />
                    <TextBlock
                        Grid.Column="4"
                        Opacity="0.6"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding Arguments}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{Binding Arguments, Converter={StaticResource TextVisibilityConverter}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WebSearchToolCallTemplate" x:DataType="snsao:ObservableWebSearchToolCallContent">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xEC7A;" />
                    <FontIcon
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xE721;" />
                    <ItemsControl
                        Grid.Column="2"
                        ItemsSource="{Binding Queries}"
                        Visibility="{Binding Queries, Converter={StaticResource ContentVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Opacity="0.7"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{Binding}"
                                    TextWrapping="WrapWholeWords" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FallbackToolCallTemplate" x:DataType="snsao:ObservableToolCallContent">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xEC7A;" />
                    <TextBlock
                        Grid.Column="1"
                        Opacity="0.8"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding DisplayName}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="2"
                        Opacity="0.6"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding DisplayArguments}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{Binding DisplayArguments, Converter={StaticResource TextVisibilityConverter}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <snuxcc:ChatToolCallTemplateSelector
            x:Key="ToolCallTemplateSelector"
            CodeInterpreterTemplate="{StaticResource CodeInterpreterToolCallTemplate}"
            FallbackTemplate="{StaticResource FallbackToolCallTemplate}"
            FunctionTemplate="{StaticResource FunctionToolCallTemplate}"
            ImageGenerationTemplate="{StaticResource ImageGenerationToolCallTemplate}"
            McpServerTemplate="{StaticResource McpServerToolCallTemplate}"
            WebSearchTemplate="{StaticResource WebSearchToolCallTemplate}" />
    </UserControl.Resources>

    <ContentControl
        HorizontalContentAlignment="Stretch"
        Content="{x:Bind ToolCall, Mode=OneWay}"
        ContentTemplateSelector="{StaticResource ToolCallTemplateSelector}" />
</UserControl>

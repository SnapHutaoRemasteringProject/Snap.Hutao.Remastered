<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control">

    <BitmapImage x:Key="MarkIcon_Icon" UriSource="ms-appx:///Resource/Icon/UI_Icon_UGC_Collect.png"/>

    <Style BasedOn="{StaticResource DefaultMarkIconStyle}" TargetType="shuxc:MarkIcon"/>

    <Style x:Key="DefaultMarkIconStyle" TargetType="shuxc:MarkIcon">
        <Setter Property="Height" Value="80"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shuxc:MarkIcon">
                    <Border
                        Background="#FFF3F3F3"
                        BorderBrush="#FFCCCCCC"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <Image x:Name="IconImage" Source="{StaticResource MarkIcon_Icon}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Width" Value="80"/>
    </Style>

</ResourceDictionary>

<Window
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Window.ExceptionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:wl="using:WinUI.LiquidGlass"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid
            x:Name="DraggableGrid"
            Grid.Row="0"
            Height="32">
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{shuxm:ResourceString Name=ViewWindowExceptionTitle}"/>
        </Grid>
        <Grid
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource SubheaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewWindowExceptionHeader}"/>
                <TextBlock
                    Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind TraceId}"/>
            </StackPanel>
            <cwc:SwitchPresenter
                x:Name="GlassPresenter_1754"
                Grid.Row="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:TextBox"
                Value="{x:Bind shuxcth:MaterialBindingSource.Current.TextBoxMaterial, Mode=OneWay}">
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>0</x:Int32>
                    </cwc:Case.Value>
                    <TextBox
                        AcceptsReturn="True"
                        Header="{shuxm:ResourceString Name=ViewExceptionWindowStacktraceHeader}"
                        IsReadOnly="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        Text="{x:Bind Exception}"/>
                </cwc:Case>
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>1</x:Int32>
                    </cwc:Case.Value>
                    <wl:LiquidGlassTextBox
                        shuxcth:ControlMaterialState.IsManaged="True"
                        AcceptsReturn="True"
                        Header="{shuxm:ResourceString Name=ViewExceptionWindowStacktraceHeader}"
                        IsReadOnly="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        Text="{x:Bind Exception}"/>
                </cwc:Case>
            </cwc:SwitchPresenter>
            <cwc:SwitchPresenter
                x:Name="GlassPresenter_2074"
                Grid.Row="2"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Tag="LiquidGlass:TextBox"
                Value="{x:Bind shuxcth:MaterialBindingSource.Current.TextBoxMaterial, Mode=OneWay}">
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>0</x:Int32>
                    </cwc:Case.Value>
                    <TextBox
                        AcceptsReturn="True"
                        Description="{shuxm:ResourceString Name=ViewExceptionWindowCommentDescription}"
                        Header="{shuxm:ResourceString Name=ViewExceptionWindowCommentHeader}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        Text="{x:Bind Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </cwc:Case>
                <cwc:Case>
                    <cwc:Case.Value>
                        <x:Int32>1</x:Int32>
                    </cwc:Case.Value>
                    <wl:LiquidGlassTextBox
                        shuxcth:ControlMaterialState.IsManaged="True"
                        AcceptsReturn="True"
                        Description="{shuxm:ResourceString Name=ViewExceptionWindowCommentDescription}"
                        Header="{shuxm:ResourceString Name=ViewExceptionWindowCommentHeader}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        Text="{x:Bind Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </cwc:Case>
            </cwc:SwitchPresenter>
            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <cwc:SwitchPresenter
                    x:Name="GlassPresenter_2644"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False"
                    Tag="LiquidGlass:Button"
                    Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                    <cwc:Case>
                        <cwc:Case.Value>
                            <x:Int32>0</x:Int32>
                        </cwc:Case.Value>
                        <Button Command="{x:Bind CloseCommand}" Content="{shuxm:ResourceString Name=ViewWindowExceptionClose}"/>
                    </cwc:Case>
                    <cwc:Case>
                        <cwc:Case.Value>
                            <x:Int32>1</x:Int32>
                        </cwc:Case.Value>
                        <wl:LiquidGlassButton
                            shuxcth:ControlMaterialState.IsManaged="True"
                            Command="{x:Bind CloseCommand}"
                            Content="{shuxm:ResourceString Name=ViewWindowExceptionClose}"/>
                    </cwc:Case>
                </cwc:SwitchPresenter>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

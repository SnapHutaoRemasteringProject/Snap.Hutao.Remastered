        </shvh:ActivityTemplateSelector>
    </shuxc:ScopedPage.Resources>

    <Grid>
        <ScrollViewer Padding="0" Style="{StaticResource DefaultScrollViewerStyle}">
            <StackPanel Padding="16" Spacing="16">
                <Border cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Grid Style="{ThemeResource AcrylicGridCardStyle}">
                        <CommandBar DefaultLabelPosition="Right">
                            <CommandBar.Content>
                                <TextBlock
                                    Margin="12,12,0,0"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="{Binding GreetingText}"/>
                            </CommandBar.Content>
                            <AppBarButton
                                Icon="{shuxm:FontIcon Glyph=&#xE728;}"
                                Label="{shuxm:ResourceString Name=ViewPageAnnouncementRedeemCodeLabel}"
                                Visibility="{Binding RedeemCodes, Converter={StaticResource EmptyCollectionToVisibilityConverter}}">
                                <AppBarButton.Flyout>
                                    <Flyout FlyoutPresenterStyle="{ThemeResource FlyoutPresenterPadding12Style}" Placement="BottomEdgeAlignedRight">
                                        <ItemsControl ItemsPanel="{ThemeResource StackPanelSpacing8Template}" ItemsSource="{Binding RedeemCodes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid
                                                        Padding="8"
                                                        ColumnSpacing="12"
                                                        Style="{ThemeResource GridShimmerStyle}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock
                                                                IsTextSelectionEnabled="True"
                                                                Style="{ThemeResource BaseTextBlockStyle}"
                                                                Text="{Binding Code}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap"/>
                                                            <TextBlock
                                                                Opacity="0.7"
                                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                                Text="{Binding Title}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap"/>
                                                        </StackPanel>
                                                        <Button
                                                            Grid.Column="1"
                                                            VerticalAlignment="Stretch"
                                                            Background="Transparent"
                                                            Command="{Binding DataContext.CopyCodeCommand, Source={StaticResource ViewModelBindingProxy}}"
                                                            CommandParameter="{Binding Code}"
                                                            Content="{StaticResource FontIconContentCopy}"
                                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                            Style="{StaticResource ButtonRevealStyle}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Flyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                        </CommandBar>
                    </Grid>
                </Border>

                <ItemsControl
                    x:Name="HutaoAnnouncementControl"
                    x:Load="False"
                    ItemTemplate="{StaticResource HutaoAnnouncementTemplate}"
                    ItemsPanel="{ThemeResource StackPanelSpacing8Template}"
                    ItemsSource="{Binding HutaoAnnouncements}"
                    Transitions="{ThemeResource EntranceThemeTransitions}"
                    Visibility="{Binding HutaoAnnouncements.Count, Converter={StaticResource Int32ToVisibilityConverter}}"/>

                <Grid
                    x:Name="ActivityCalendarGrid"
                    MaxHeight="354.6"
                    Padding="8"
                    x:FieldModifier="internal"
                    x:Load="False"
                    ColumnSpacing="8"
                    DataContext="{Binding ActivityCalendar}"
                    Style="{ThemeResource AcrylicGridCardStyle}"
                    Visibility="{Binding DataContext.IsHomeAnnouncementActivityCalendarPresented, Source={StaticResource ViewModelBindingProxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <ItemsControl ItemsPanel="{ThemeResource StackPanelSpacing8Template}" ItemsSource="{Binding CompositeCardPools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid RowSpacing="6" Style="{ThemeResource GridShimmerStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="6,6,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Border
                                            Padding="4,1"
                                            VerticalAlignment="Center"
                                            CornerRadius="2">
                                            <Border.Background>
                                                <SolidColorBrush Opacity="0.3" Color="{ThemeResource SystemAccentColor}"/>
                                            </Border.Background>
                                            <TextBlock
                                                FontSize="10"
                                                IsTextSelectionEnabled="True"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{Binding VersionName}"
                                                TextTrimming="None"
                                                TextWrapping="NoWrap"/>
                                        </Border>
                                        <TextBlock Style="{ThemeResource BaseTextBlockStyle}" Text="{Binding PoolName}"/>
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0,6,6,0"
                                        HorizontalAlignment="Right"
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{Binding FormattedCountdown}"/>
                                    <ItemsControl
                                        Grid.Row="1"
                                        Margin="6,0"
                                        ItemsPanel="{ThemeResource HorizontalStackPanelSpacing6Template}"
                                        ItemsSource="{Binding CompositeItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <shuxc:ItemIcon
                                                    Width="40"
                                                    Height="40"
                                                    Icon="{Binding Icon}"
                                                    Quality="{Binding Rarity}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border
                                        Grid.Row="2"
                                        Padding="6"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0"
                                        CornerRadius="{ThemeResource ControlCornerRadiusBottom}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Opacity="0.7"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{Binding FormattedDuration}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Column="1" Style="{ThemeResource GridShimmerStyle}">
                        <ScrollViewer>
                            <ItemsControl
                                Margin="8"
                                VerticalAlignment="Top"
                                ItemTemplateSelector="{StaticResource ActivityTemplateSelector}"
                                ItemsSource="{Binding DataContext.DisplayedActivityCards, Source={StaticResource ViewModelBindingProxy}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <shuxcp:UniformPanel
                                            ColumnSpacing="8"
                                            MinItemWidth="360"
                                            RowSpacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <ItemsControl
                    ItemTemplate="{StaticResource CardTemplate}"
                    ItemsSource="{Binding Cards, Mode=OneWay}"
                    Visibility="{Binding Cards, Converter={StaticResource EmptyCollectionToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <shuxcp:UniformPanel
                                ColumnSpacing="12"
                                MinItemWidth="300"
                                RowSpacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ScrollViewer>
                    <Pivot
                        x:Name="GameAnnouncementPivot"
                        Margin="-16"
                        x:FieldModifier="internal"
                        x:Load="False"
                        Style="{ThemeResource CardPivotStyle}"
                        Transitions="{ThemeResource EntranceThemeTransitions}">
                        <PivotItem
                            Content="{Binding Announcement.List[1]}"
                            ContentTemplate="{StaticResource AnnouncementPivotItemContentTemplate}"
                            Header="{Binding Announcement.TypeList[1].MI18NName}"/>
                        <PivotItem
                            Content="{Binding Announcement.List[0]}"
                            ContentTemplate="{StaticResource AnnouncementPivotItemContentTemplate}"
                            Header="{Binding Announcement.TypeList[0].MI18NName}"/>
                        <PivotItem
                            Content="{Binding Announcement.List[2]}"
                            ContentTemplate="{StaticResource AnnouncementPivotItemContentTemplate}"
                            Header="{Binding Announcement.TypeList[2].MI18NName}"/>
                    </Pivot>
                </ScrollViewer>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</shuxc:ScopedPage>
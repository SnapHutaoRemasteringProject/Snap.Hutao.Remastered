            <DataTemplate x:Key="AvatarReliquarySubPropertyTemplate" x:DataType="shva:ReliquaryComposedSubProperty">
                <Grid Padding="12,0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource BaseTextBlockStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextWrapping="NoWrap"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneWay}"/>
                    <Grid Grid.Column="2" Opacity="1">
                        <Ellipse
                            Width="16"
                            Height="16"
                            Margin="0,0,0,0"
                            Opacity="0.8"
                            StrokeThickness="1">
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="{Binding EnhancedCount, Converter={ThemeResource CountToGradientColorConverter}, Mode=OneWay}"/>
                            </Ellipse.Stroke>
                        </Ellipse>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{ThemeResource InfoBadgeValueFontSize}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind EnhancedCount, Mode=OneWay}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{Binding EnhancedCount, Converter={ThemeResource CountToGradientColorConverter}, Mode=OneWay}"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="AvatarReliquaryTemplate" x:DataType="shva:ReliquaryView">
                <Grid Style="{ThemeResource GridShimmerStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid
                        Grid.Row="0"
                        Padding="12"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <shuxc:ItemIcon
                            Grid.Column="0"
                            Width="48"
                            Height="48"
                            Icon="{x:Bind Icon, Mode=OneWay}"
                            Quality="{x:Bind Quality, Mode=OneWay}"/>
                        <Grid Grid.Column="1">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"/>
                                <TextBlock
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind SetName, Mode=OneWay}"/>
                            </StackPanel>
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Style="{StaticResource BaseTextBlockStyle}"
                                Text="{x:Bind Score, Mode=OneWay}">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding ScoreColorValue, Converter={ThemeResource ScoreToColorConverter}, Mode=OneWay}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <Rectangle
                        Grid.Row="1"
                        Height="1"
                        Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                    <!--  主属性  -->
                    <Grid Grid.Row="2" Padding="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontWeight="Bold"
                            Style="{StaticResource BaseTextBlockStyle}"
                            Text="{x:Bind MainProperty.Name, Mode=OneWay}"/>
                        <TextBlock
                            Grid.Column="1"
                            FontWeight="Bold"
                            Style="{StaticResource BaseTextBlockStyle}"
                            Text="{x:Bind MainProperty.Value, Mode=OneWay}"/>

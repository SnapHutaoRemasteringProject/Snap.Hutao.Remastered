<ResourceDictionary
    x:Class="Snap.Hutao.Remastered.UI.Xaml.Control.AutoSortBox.AutoSortListResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shuxcas="using:Snap.Hutao.Remastered.UI.Xaml.Control.AutoSortBox"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup">

    <Style BasedOn="{StaticResource DefaultAutoSortListStyle}" TargetType="shuxcas:AutoSortList"/>

    <Style x:Key="DefaultAutoSortListStyle" TargetType="shuxcas:AutoSortList">
        <Setter Property="Template" Value="{StaticResource AutoSortListTemplate}"/>
    </Style>

    <ControlTemplate x:Key="AutoSortListTemplate" TargetType="shuxcas:AutoSortList">
        <Border
            shuxcth:MaterialBackground.GlassBrush="{ThemeResource HutaoCardBrush}"
            shuxcth:MaterialBackground.NativeBrush="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Padding="12,10,12,6"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{shuxm:ResourceString Name=ViewPageBackpackSortHeader}"/>
                <ListView
                    x:Name="TokenListView"
                    Grid.Row="1"
                    IsItemClickEnabled="True"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="shuxcas:AutoSortToken">
                            <Grid Height="40" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!--  Order badge (only when selected)  -->
                                <Border
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="10"
                                    Visibility="{x:Bind IsSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind SortOrder, Mode=OneWay}"/>
                                </Border>

                                <!--  Icon + Name  -->
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Border
                                        Width="20"
                                        Height="20"
                                        Visibility="{x:Bind IconUri, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            Source="{x:Bind shuxcas:AutoSortListResources.CreateIcon(IconUri), Mode=OneWay}"/>
                                    </Border>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="{x:Bind Value, Mode=OneWay}"/>
                                </StackPanel>

                                <!--  Direction arrows (only when selected)  -->
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="{x:Bind IsSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <FontIcon
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE74A;"
                                        Visibility="{x:Bind IsDescending, Converter={StaticResource BoolToVisibilityRevertConverter}, Mode=OneWay}"/>
                                    <FontIcon
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE74B;"
                                        Visibility="{x:Bind IsDescending, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                                </StackPanel>

                                <!--  Remove button (only when selected)  -->
                                <Button
                                    Grid.Column="3"
                                    Width="24"
                                    Height="24"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    IsTabStop="False"
                                    Visibility="{x:Bind IsSelected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <FontIcon
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE894;"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </ControlTemplate>
</ResourceDictionary>

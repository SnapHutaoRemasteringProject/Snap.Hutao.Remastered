<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CsWinRTIncludes>Snap.Hutao.Plugin.Contracts</CsWinRTIncludes>
    <IsAotCompatible>true</IsAotCompatible>
    <HutaoWindowsSdkVersion Condition="'$(HutaoWindowsSdkVersion)' == ''">10.0.28000.0</HutaoWindowsSdkVersion>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <CsWinRTInputs Include="$(HutaoContractsWinmd)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Snap.Hutao.Plugin.Contracts\HutaoPlugin.idl" Link="Contracts\HutaoPlugin.idl" />
    <None Include="..\Snap.Hutao.Plugin.Contracts\HutaoPluginAbi.h" Link="Contracts\HutaoPluginAbi.h" />
  </ItemGroup>
  <Target Name="GenerateHutaoContracts" BeforeTargets="CsWinRTGenerateProjection" DependsOnTargets="ResolvePackageAssets" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_HutaoVsArgument Condition="'$(VSInstallDir)' != ''">-VisualStudioInstallDir &quot;$(VSInstallDir).&quot;</_HutaoVsArgument>
    </PropertyGroup>
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\build\Generate-Contracts.ps1&quot; -AssetsFile &quot;$(ProjectAssetsFile)&quot; -WindowsSdkVersion &quot;$(HutaoWindowsSdkVersion)&quot; -TargetPlatformVersion &quot;$(TargetPlatformVersion)&quot; $(_HutaoVsArgument)" />
    <ItemGroup>
      <CsWinRTInputs Include="$(HutaoArtifacts)references\*.winmd" />
    </ItemGroup>
    <Error Condition="!Exists('$(HutaoContractsWinmd)')" Text="MIDL did not generate the plugin contract." />
  </Target>
</Project>

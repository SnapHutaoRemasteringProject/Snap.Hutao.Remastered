<UserControl
    x:Class="TestPlugin.Native.PluginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8" Padding="12">
        <TextBlock Text="{x:Bind TitleText, Mode=OneTime}" FontWeight="SemiBold" />
        <Button x:Name="ClickButton" Content="Click compiled C++ XAML" Click="OnClick" />
        <TextBlock x:Name="StatusText" Text="XBF loaded" />
    </StackPanel>
</UserControl>

<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:cwb="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cwcvt="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shs="using:Snap.Hutao.Remastered.Service"
    xmlns:shsu="using:Snap.Hutao.Remastered.Service.UIGF"
    xmlns:shuih="using:Snap.Hutao.Remastered.UI.Input.HotKey"
    xmlns:shuil="using:Snap.Hutao.Remastered.UI.Input.LowLevel"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxdc="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shvs="using:Snap.Hutao.Remastered.ViewModel.Setting"
    xmlns:wl="using:WinUI.LiquidGlass"
    d:DataContext="{d:DesignInstance shvs:SettingViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{x:Bind ((shvs:SettingViewModel)DataContext).LoadCommand, Mode=OneWay}"/>
    </mxi:Interaction.Behaviors>

    <Page.Resources>
        <!--  Glass customization uses independent windows with native editors.  -->

        <shuxdc:UIGFVersionToStringConverter x:Key="UIGFVersionToStringConverter"/>
    </Page.Resources>

    <Grid x:Name="SettingPageGrid">
        <ScrollViewer x:Name="RootScrollViewer" Style="{StaticResource TwoPanelScrollViewerStyle}">
            <shuxc:ScrollViewerHelper.RightPanel>
                <Border
                    x:Name="ScrollViewerRightPanel"
                    Width="400"
                    Margin="0,16,16,16"
                    VerticalAlignment="Top"
                    cw:Effects.Shadow="{ThemeResource CompatCardShadow}"
                    Visibility="Collapsed">
                    <Grid Style="{ThemeResource AcrylicGridCardStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="16" Spacing="{ThemeResource SettingsCardSpacing}">

                                <Grid Style="{ThemeResource GridCardStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Image
                                        Grid.Row="0"
                                        MaxWidth="120"
                                        MaxHeight="120"
                                        Margin="48,48"
                                        Source="ms-appx:///Assets/InAppLogo.png"/>
                                    <cwc:UniformGrid
                                        Grid.Row="1"
                                        Margin="16"
                                        VerticalAlignment="Bottom"
                                        ColumnSpacing="8"
                                        Columns="2"
                                        RowSpacing="8">
                                        <cwc:SwitchPresenter
                                            x:Name="GlassPresenter_3381"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            IsTabStop="False"
                                            Tag="LiquidGlass:HyperlinkButton"
                                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.HyperlinkButtonMaterial, Mode=OneWay}">
                                            <cwc:Case>
                                                <cwc:Case.Value>
                                                    <x:Int32>0</x:Int32>
                                                </cwc:Case.Value>
                                                <HyperlinkButton
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingOfficialSiteNavigate}"
                                                    NavigateUri="{StaticResource DocumentLink_Home}"/>
                                            </cwc:Case>
                                            <cwc:Case>
                                                <cwc:Case.Value>
                                                    <x:Int32>1</x:Int32>
                                                </cwc:Case.Value>
                                                <wl:LiquidGlassHyperlinkButton
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    shuxcth:ControlMaterialState.IsManaged="True"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingOfficialSiteNavigate}"
                                                    NavigateUri="{StaticResource DocumentLink_Home}"/>
                                            </cwc:Case>
                                        </cwc:SwitchPresenter>
                                        <cwc:SwitchPresenter
                                            x:Name="GlassPresenter_3803"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            IsTabStop="False"
                                            Tag="LiquidGlass:HyperlinkButton"
                                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.HyperlinkButtonMaterial, Mode=OneWay}">
                                            <cwc:Case>
                                                <cwc:Case.Value>
                                                    <x:Int32>0</x:Int32>
                                                </cwc:Case.Value>
                                                <HyperlinkButton
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingFeedbackNavigate}"
                                                    NavigateUri="{StaticResource DocumentLink_BugReport}"/>
                                            </cwc:Case>
                                            <cwc:Case>
                                                <cwc:Case.Value>
                                                    <x:Int32>1</x:Int32>
                                                </cwc:Case.Value>
                                                <wl:LiquidGlassHyperlinkButton
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    shuxcth:ControlMaterialState.IsManaged="True"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingFeedbackNavigate}"
                                                    NavigateUri="{StaticResource DocumentLink_BugReport}"/>
                                            </cwc:Case>
                                        </cwc:SwitchPresenter>
                                        <cwc:SwitchPresenter
                                            x:Name="GlassPresenter_4226"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            IsTabStop="False"
                                            Tag="LiquidGlass:HyperlinkButton"
                                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.HyperlinkButtonMaterial, Mode=OneWay}">
                                            <cwc:Case>
                                                <cwc:Case.Value>
                                                    <x:Int32>0</x:Int32>
                                                </cwc:Case.Value>
                                                <HyperlinkButton
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingSponsorNavigate}"
                                                    NavigateUri="{StaticResource DocumentLink_Sponsor}"/>
                                            </cwc:Case>
                                            <cwc:Case>
                                                <cwc:Case.Value>
                                                    <x:Int32>1</x:Int32>
                                                </cwc:Case.Value>
                                                <wl:LiquidGlassHyperlinkButton
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    shuxcth:ControlMaterialState.IsManaged="True"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingSponsorNavigate}"
                                                    NavigateUri="{StaticResource DocumentLink_Sponsor}"/>
                                            </cwc:Case>
                                        </cwc:SwitchPresenter>
                                    </cwc:UniformGrid>
                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="8"
                                        HorizontalAlignment="Center"
                                        Opacity="0.7"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Copyright © 2022 - 2025 DGP Studio. All Rights Reserved."/>
                                    <TextBlock
                                        Grid.Row="3"
                                        Margin="8"
                                        HorizontalAlignment="Center"
                                        Opacity="0.7"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Copyright © 2026 SnapHutaoRemasteringProject. All Rights Reserved."
                                        TextWrapping="NoWrap"/>
                                </Grid>

                                <!--  应用行为 - 宽屏  -->
                                <TextBlock Style="{StaticResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageSettingAppBehaviorHeader}"/>

                                <cwc:SettingsCard
                                    Command="{x:Bind ((shvs:SettingViewModel)DataContext).CheckUpdateCommand, Mode=OneWay}"
                                    Description="{x:Bind ((shvs:SettingViewModel)DataContext).UpdateInfo, Mode=OneWay}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingCheckUpdateHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE895;}"
                                    IsClickEnabled="True"/>

                                <!--  Administor  -->
                                <cwc:SettingsExpander HeaderIcon="{shuxm:FontIcon Glyph=&#xE7EF;}" IsExpanded="True">
                                    <cwc:SettingsExpander.Header>
                                        <TextBlock Text="{shuxm:ResourceString Name=ViewPageSettingElevatedModeHeader}"/>
                                    </cwc:SettingsExpander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <cwc:SwitchPresenter
                                            x:Name="GlassPresenter_6918"
                                            HorizontalAlignment="Right"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            IsTabStop="False"
                                            Tag="LiquidGlass:Button"
                                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                                            <cwc:Case>
                                                <cwc:Case.Value>
                                                    <x:Int32>0</x:Int32>
                                                </cwc:Case.Value>
                                                <Button
                                                    HorizontalAlignment="Right"
                                                    Command="{x:Bind ((shvs:SettingViewModel)DataContext).RestartAsElevatedCommand, Mode=OneWay}"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingElevatedModeRestartAction}"
                                                    IsEnabled="{shuxm:IsProcessNotElevated}"/>
                                            </cwc:Case>
                                            <cwc:Case>
                                                <cwc:Case.Value>
                                                    <x:Int32>1</x:Int32>
                                                </cwc:Case.Value>
                                                <wl:LiquidGlassButton
                                                    HorizontalAlignment="Right"
                                                    shuxcth:ControlMaterialState.IsManaged="True"
                                                    Command="{x:Bind ((shvs:SettingViewModel)DataContext).RestartAsElevatedCommand, Mode=OneWay}"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingElevatedModeRestartAction}"
                                                    IsEnabled="{shuxm:IsProcessNotElevated}"/>
                                            </cwc:Case>
                                        </cwc:SwitchPresenter>
                                    </StackPanel>
                                    <cwc:SettingsExpander.Items>
                                        <cwc:SettingsCard Description="{shuxm:ResourceString Name=ViewPageSettingAutoRestartAsAdminDescription}" Header="{shuxm:ResourceString Name=ViewPageSettingAutoRestartAsAdminHeader}">
                                            <cwc:SwitchPresenter
                                                x:Name="GlassPresenter_7679"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsTabStop="False"
                                                Tag="LiquidGlass:ToggleSwitch"
                                                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleSwitchMaterial, Mode=OneWay}">
                                                <cwc:Case>
                                                    <cwc:Case.Value>
                                                        <x:Int32>0</x:Int32>
                                                    </cwc:Case.Value>
                                                    <ToggleSwitch IsOn="{x:Bind ((shvs:SettingViewModel)DataContext).AutoRestartAsAdminEnabled, Mode=TwoWay}"/>
                                                </cwc:Case>
                                                <cwc:Case>
                                                    <cwc:Case.Value>
                                                        <x:Int32>1</x:Int32>
                                                    </cwc:Case.Value>
                                                    <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind ((shvs:SettingViewModel)DataContext).AutoRestartAsAdminEnabled, Mode=TwoWay}"/>
                                                </cwc:Case>
                                            </cwc:SwitchPresenter>
                                        </cwc:SettingsCard>
                                    </cwc:SettingsExpander.Items>
                                </cwc:SettingsExpander>

                                <!--  Auto start  -->
                                <cwc:SettingsExpander
                                    Description="{shuxm:ResourceString Name=ViewPageSettingAutoStartDescription}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingAutoStartHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE7E8;}"
                                    IsEnabled="{shuxm:IsProcessElevated}">
                                    <cwc:SettingsExpander.Items>
                                        <cwc:SettingsCard
                                            Header="{shuxm:ResourceString Name=ViewPageSettingAutoStartEnableCardHeader}"
                                            HeaderIcon="{shuxm:FontIcon Glyph=&#xE7EE;}"
                                            IsClickEnabled="False">
                                            <cwc:SwitchPresenter
                                                x:Name="GlassPresenter_8862"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsTabStop="False"
                                                Tag="LiquidGlass:ToggleSwitch"
                                                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleSwitchMaterial, Mode=OneWay}">
                                                <cwc:Case>
                                                    <cwc:Case.Value>
                                                        <x:Int32>0</x:Int32>
                                                    </cwc:Case.Value>
                                                    <ToggleSwitch IsOn="{x:Bind ((shvs:SettingViewModel)DataContext).IsStartupEnabled, Mode=TwoWay}"/>
                                                </cwc:Case>
                                                <cwc:Case>
                                                    <cwc:Case.Value>
                                                        <x:Int32>1</x:Int32>
                                                    </cwc:Case.Value>
                                                    <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind ((shvs:SettingViewModel)DataContext).IsStartupEnabled, Mode=TwoWay}"/>
                                                </cwc:Case>
                                            </cwc:SwitchPresenter>
                                        </cwc:SettingsCard>

                                        <!--  Will keep enable if AutoRestartAsAdmin is enabled, because it will start as admin when startup and avoid UAC prompt and keep consistent with the behavior  -->
                                        <cwc:SettingsCard
                                            Description="{shuxm:ResourceString Name=ViewPageSettingAutoStartAdminActionCardDescription}"
                                            Header="{shuxm:ResourceString Name=ViewPageSettingAutoStartAdminActionCardHeader}"
                                            HeaderIcon="{shuxm:FontIcon Glyph=&#xE7EF;}"
                                            IsClickEnabled="False"
                                            IsEnabled="{x:Bind ((shvs:SettingViewModel)DataContext).IsStartupAsAdminCardEnabled, Mode=OneWay}">
                                            <cwc:SwitchPresenter
                                                x:Name="GlassPresenter_9821"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsTabStop="False"
                                                Tag="LiquidGlass:ToggleSwitch"
                                                Value="{x:Bind shuxcth:MaterialBindingSource.Current.ToggleSwitchMaterial, Mode=OneWay}">
                                                <cwc:Case>
                                                    <cwc:Case.Value>
                                                        <x:Int32>0</x:Int32>
                                                    </cwc:Case.Value>
                                                    <ToggleSwitch IsOn="{x:Bind ((shvs:SettingViewModel)DataContext).IsStartupAsAdminEnabled, Mode=TwoWay}"/>
                                                </cwc:Case>
                                                <cwc:Case>
                                                    <cwc:Case.Value>
                                                        <x:Int32>1</x:Int32>
                                                    </cwc:Case.Value>
                                                    <wl:LiquidGlassToggleSwitch shuxcth:ControlMaterialState.IsManaged="True" IsOn="{x:Bind ((shvs:SettingViewModel)DataContext).IsStartupAsAdminEnabled, Mode=TwoWay}"/>
                                                </cwc:Case>
                                            </cwc:SwitchPresenter>
                                        </cwc:SettingsCard>
                                    </cwc:SettingsExpander.Items>
                                </cwc:SettingsExpander>

                                <cwc:SettingsCard
                                    ActionIconToolTip="{shuxm:ResourceString Name=ViewPageSettingCreateDesktopShortcutAction}"
                                    Command="{x:Bind ((shvs:SettingViewModel)DataContext).CreateDesktopShortcutCommand, Mode=OneWay}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingCreateDesktopShortcutHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE72D;}"
                                    IsClickEnabled="True"/>
                                <cwc:SettingsCard
                                    ActionIconToolTip="{shuxm:ResourceString Name=ViewPageSettingCreateDesktopShortcutAction}"
                                    Command="{x:Bind ((shvs:SettingViewModel)DataContext).CreateGameLaunchShortcutCommand, Mode=OneWay}"
                                    Header="{shuxm:ResourceString Name=ViewPageLaunchGameCreateGameLaunchShortcut}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE72D;}"
                                    IsClickEnabled="True"/>

                                <cwc:SettingsCard Header="{shuxm:ResourceString Name=ViewPageSettingMirrorChyanLinkHeader}" IsClickEnabled="False">
                                    <cwc:SwitchPresenter
                                        x:Name="GlassPresenter_11300"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        IsTabStop="False"
                                        Tag="LiquidGlass:HyperlinkButton"
                                        Value="{x:Bind shuxcth:MaterialBindingSource.Current.HyperlinkButtonMaterial, Mode=OneWay}">
                                        <cwc:Case>
                                            <cwc:Case.Value>
                                                <x:Int32>0</x:Int32>
                                            </cwc:Case.Value>
                                            <HyperlinkButton Content="{shuxm:ResourceString Name=ViewPageSettingMirrorChyanLinkHeader}" NavigateUri="https://mirrorchyan.com?source=snap_hutao_app_settings"/>
                                        </cwc:Case>
                                        <cwc:Case>
                                            <cwc:Case.Value>
                                                <x:Int32>1</x:Int32>
                                            </cwc:Case.Value>
                                            <wl:LiquidGlassHyperlinkButton
                                                shuxcth:ControlMaterialState.IsManaged="True"
                                                Content="{shuxm:ResourceString Name=ViewPageSettingMirrorChyanLinkHeader}"
                                                NavigateUri="https://mirrorchyan.com?source=snap_hutao_app_settings"/>
                                        </cwc:Case>
                                    </cwc:SwitchPresenter>
                                </cwc:SettingsCard>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </shuxc:ScrollViewerHelper.RightPanel>
            <Grid HorizontalAlignment="Stretch">
                <StackPanel
                    Grid.Column="0"
                    Padding="16"
                    Spacing="16">

                    <!--  关于  -->
                    <Border x:Name="ScrollViewerTopPanel" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                        <Border Padding="16" Style="{ThemeResource AcrylicBorderCardStyle}">
                            <StackPanel Spacing="{StaticResource SettingsCardSpacing}" Visibility="Visible">
                                <Grid MaxHeight="176" Style="{ThemeResource GridCardStyle}">
                                    <Grid Padding="48,28,48,28" ColumnSpacing="48">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            MaxWidth="120"
                                            MaxHeight="120"
                                            Source="ms-appx:///Assets/InAppLogo.png"/>
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            VerticalAlignment="Center">
                                            <cwc:UniformGrid
                                                VerticalAlignment="Center"
                                                ColumnSpacing="8"
                                                Columns="2"
                                                RowSpacing="8">
                                                <cwc:SwitchPresenter
                                                    x:Name="GlassPresenter_13665"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    IsTabStop="False"
                                                    Tag="LiquidGlass:HyperlinkButton"
                                                    Value="{x:Bind shuxcth:MaterialBindingSource.Current.HyperlinkButtonMaterial, Mode=OneWay}">
                                                    <cwc:Case>
                                                        <cwc:Case.Value>
                                                            <x:Int32>0</x:Int32>
                                                        </cwc:Case.Value>
                                                        <HyperlinkButton
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Content="{shuxm:ResourceString Name=ViewPageSettingOfficialSiteNavigate}"
                                                            NavigateUri="{StaticResource DocumentLink_Home}"/>
                                                    </cwc:Case>
                                                    <cwc:Case>
                                                        <cwc:Case.Value>
                                                            <x:Int32>1</x:Int32>
                                                        </cwc:Case.Value>
                                                        <wl:LiquidGlassHyperlinkButton
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            shuxcth:ControlMaterialState.IsManaged="True"
                                                            Content="{shuxm:ResourceString Name=ViewPageSettingOfficialSiteNavigate}"
                                                            NavigateUri="{StaticResource DocumentLink_Home}"/>
                                                    </cwc:Case>
                                                </cwc:SwitchPresenter>
                                                <cwc:SwitchPresenter
                                                    x:Name="GlassPresenter_14127"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    IsTabStop="False"
                                                    Tag="LiquidGlass:HyperlinkButton"
                                                    Value="{x:Bind shuxcth:MaterialBindingSource.Current.HyperlinkButtonMaterial, Mode=OneWay}">
                                                    <cwc:Case>
                                                        <cwc:Case.Value>
                                                            <x:Int32>0</x:Int32>
                                                        </cwc:Case.Value>
                                                        <HyperlinkButton
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Content="{shuxm:ResourceString Name=ViewPageSettingFeedbackNavigate}"
                                                            NavigateUri="{StaticResource DocumentLink_BugReport}"/>
                                                    </cwc:Case>
                                                    <cwc:Case>
                                                        <cwc:Case.Value>
                                                            <x:Int32>1</x:Int32>
                                                        </cwc:Case.Value>
                                                        <wl:LiquidGlassHyperlinkButton
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            shuxcth:ControlMaterialState.IsManaged="True"
                                                            Content="{shuxm:ResourceString Name=ViewPageSettingFeedbackNavigate}"
                                                            NavigateUri="{StaticResource DocumentLink_BugReport}"/>
                                                    </cwc:Case>
                                                </cwc:SwitchPresenter>
                                                <cwc:SwitchPresenter
                                                    x:Name="GlassPresenter_14590"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    IsTabStop="False"
                                                    Tag="LiquidGlass:HyperlinkButton"
                                                    Value="{x:Bind shuxcth:MaterialBindingSource.Current.HyperlinkButtonMaterial, Mode=OneWay}">
                                                    <cwc:Case>
                                                        <cwc:Case.Value>
                                                            <x:Int32>0</x:Int32>
                                                        </cwc:Case.Value>
                                                        <HyperlinkButton
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Content="{shuxm:ResourceString Name=ViewPageSettingSponsorNavigate}"
                                                            NavigateUri="{StaticResource DocumentLink_Sponsor}"/>
                                                    </cwc:Case>
                                                    <cwc:Case>
                                                        <cwc:Case.Value>
                                                            <x:Int32>1</x:Int32>
                                                        </cwc:Case.Value>
                                                        <wl:LiquidGlassHyperlinkButton
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            shuxcth:ControlMaterialState.IsManaged="True"
                                                            Content="{shuxm:ResourceString Name=ViewPageSettingSponsorNavigate}"
                                                            NavigateUri="{StaticResource DocumentLink_Sponsor}"/>
                                                    </cwc:Case>
                                                </cwc:SwitchPresenter>
                                            </cwc:UniformGrid>
                                            <TextBlock
                                                Margin="12,0,0,0"
                                                Opacity="0.7"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="Copyright © 2022 - 2025 DGP Studio. All Rights Reserved."/>
                                            <TextBlock
                                                Margin="12,0,0,0"
                                                Opacity="0.7"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="Copyright © 2026 SnapHutaoRemasteringProject. All Rights Reserved."/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!--  应用行为 - 窄屏  -->
                                <TextBlock Style="{StaticResource SettingsCardHeaderTextBlockStyle}" Text="{shuxm:ResourceString Name=ViewPageSettingAppBehaviorHeader}"/>

                                <cwc:SettingsCard
                                    Command="{x:Bind ((shvs:SettingViewModel)DataContext).CheckUpdateCommand, Mode=OneWay}"
                                    Description="{x:Bind ((shvs:SettingViewModel)DataContext).UpdateInfo, Mode=OneWay}"
                                    Header="{shuxm:ResourceString Name=ViewPageSettingCheckUpdateHeader}"
                                    HeaderIcon="{shuxm:FontIcon Glyph=&#xE895;}"
                                    IsClickEnabled="True"/>

                                <!--  Administor  -->
                                <cwc:SettingsExpander HeaderIcon="{shuxm:FontIcon Glyph=&#xE7EF;}" IsExpanded="True">
                                    <cwc:SettingsExpander.Header>
                                        <TextBlock Text="{shuxm:ResourceString Name=ViewPageSettingElevatedModeHeader}"/>
                                    </cwc:SettingsExpander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <cwc:SwitchPresenter
                                            x:Name="GlassPresenter_17208"
                                            HorizontalAlignment="Right"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            IsTabStop="False"
                                            Tag="LiquidGlass:Button"
                                            Value="{x:Bind shuxcth:MaterialBindingSource.Current.ButtonMaterial, Mode=OneWay}">
                                            <cwc:Case>
                                                <cwc:Case.Value>
                                                    <x:Int32>0</x:Int32>
                                                </cwc:Case.Value>
                                                <Button
                                                    HorizontalAlignment="Right"
                                                    Command="{x:Bind ((shvs:SettingViewModel)DataContext).RestartAsElevatedCommand, Mode=OneWay}"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingElevatedModeRestartAction}"
                                                    IsEnabled="{shuxm:IsProcessNotElevated}"/>
                                            </cwc:Case>
                                            <cwc:Case>
                                                <cwc:Case.Value>
                                                    <x:Int32>1</x:Int32>
                                                </cwc:Case.Value>
                                                <wl:LiquidGlassButton
                                                    HorizontalAlignment="Right"
                                                    shuxcth:ControlMaterialState.IsManaged="True"
                                                    Command="{x:Bind ((shvs:SettingViewModel)DataContext).RestartAsElevatedCommand, Mode=OneWay}"
                                                    Content="{shuxm:ResourceString Name=ViewPageSettingElevatedModeRestartAction}"
                                                    IsEnabled="{shuxm:IsProcessNotElevated}"/>
                                            </cwc:Case>
                                        </cwc:SwitchPresenter>

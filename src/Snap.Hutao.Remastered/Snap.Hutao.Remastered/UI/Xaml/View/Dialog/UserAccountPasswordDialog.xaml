<ContentDialog
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Dialog.UserAccountPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shuxcth="using:Snap.Hutao.Remastered.UI.Xaml.Control.Theme"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:wl="using:WinUI.LiquidGlass"
    Title="{shuxm:ResourceString Name=ViewDialogUserAccountPasswordTitle}"
    CloseButtonText="{shuxm:ResourceString Name=ContentDialogCancelCloseButtonText}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind IsLoginEnabled, Mode=OneWay}"
    PrimaryButtonText="{shuxm:ResourceString Name=ContentDialogConfirmPrimaryButtonText}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <wl:LiquidGlassTextBox
            shuxcth:ControlMaterialState.IsManaged="True"
            KeyDown="OnTextKeyDown"
            KeyUp="OnTextKeyUp"
            PlaceholderText="{shuxm:ResourceString Name=ViewDialogUserAccountPasswordAccountHint}"
            Text="{x:Bind Account, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <shuxcth:MaterialSwap>
            <shuxcth:MaterialSwap.Native>
                <PasswordBox
                    x:Name="GlassNative_1159"
                    KeyDown="OnTextKeyDown"
                    KeyUp="OnTextKeyUp"
                    Password="{x:Bind Password, Mode=TwoWay}"
                    PasswordChar="*"
                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogUserAccountPasswordPasswordHint}"/>
            </shuxcth:MaterialSwap.Native>
            <shuxcth:MaterialSwap.Glass>
                <wl:LiquidGlassPasswordBox
                    shuxcth:ControlMaterialState.IsManaged="True"
                    KeyDown="OnTextKeyDown"
                    KeyUp="OnTextKeyUp"
                    Password="{x:Bind Password, Mode=TwoWay}"

                    PlaceholderText="{shuxm:ResourceString Name=ViewDialogUserAccountPasswordPasswordHint}"/>
            </shuxcth:MaterialSwap.Glass>
        </shuxcth:MaterialSwap>
    </StackPanel>
</ContentDialog>
